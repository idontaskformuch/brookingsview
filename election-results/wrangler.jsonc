{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cron-only Worker: no routes, no public URL. Secret DATABASE_URL via `npx wrangler secret put
  // DATABASE_URL`. The JSON endpoint lives in the sites' own worker (site/server/election-results.ts).
  "name": "viewmedia-election-results",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}

{
  "_note": "Source discovery pilot (.claude/specs/source-discovery-engine.md, owner 2026-11-18): Fas 1-3 in read mode for all four towns, run by .github/workflows/discovery-pilot.yml. No database (no read, no write); results are workflow artifacts. Every limit here is tested in tests/test_discovery_pilot.py.",
  "run_dates": ["2026-11-20", "2026-11-21", "2026-11-22"],
  "_run_dates_note": "Moved forward one day from the spec's 19-21 Nov (owner 2026-11-18: the workflow is not pushed before 19 Nov). The job does nothing on any other UTC date, so the workflow switches itself off after the last one.",
  "brave": {
    "max_queries_per_town_per_day": 40,
    "results_per_query": 20,
    "queries": [
      { "q": "{city} christmas market", "months": [10, 11, 12] },
      { "q": "{city} holiday bazaar", "months": [10, 11, 12] },
      { "q": "{city} tree lighting", "months": [11, 12] },
      { "q": "{city} craft fair" },
      { "q": "{city} live music" },
      { "q": "{city} farmers market" },
      { "q": "{city} events calendar" },
      { "q": "{city} community calendar" },
      { "q": "{city} church events" },
      { "q": "{city} brewery events" },
      { "q": "{city} trivia night" },
      { "q": "{city} concerts" },
      { "q": "{city} theatre performances" },
      { "q": "{city} museum events" },
      { "q": "{city} library events" },
      { "q": "{city} art gallery events" },
      { "q": "{city} kids activities" },
      { "q": "{city} festival" },
      { "q": "{city} fundraiser" },
      { "q": "{city} comedy night" },
      { "q": "{city} open mic" },
      { "q": "{city} book club" },
      { "q": "{city} 5k run" },
      { "q": "{city} things to do this weekend" }
    ]
  },
  "osm": {
    "_note": "POIs with a website tag inside the town (spec Fas 1). Data (c) OpenStreetMap contributors, ODbL: credit it if a page ever shows OSM data.",
    "tags": [
      ["amenity", "place_of_worship"], ["amenity", "pub"], ["amenity", "bar"], ["amenity", "biergarten"],
      ["craft", "brewery"], ["amenity", "theatre"], ["amenity", "arts_centre"], ["amenity", "community_centre"],
      ["tourism", "museum"], ["amenity", "library"], ["amenity", "school"], ["amenity", "marketplace"],
      ["shop", "farm"], ["shop", "garden_centre"], ["amenity", "events_venue"]
    ]
  },
  "towns": {
    "brookings_sd": { "search_name": "Brookings SD", "brave_country": "US", "nominatim_countrycodes": "us" },
    "moreno_valley_ca": { "search_name": "Moreno Valley CA", "brave_country": "US", "nominatim_countrycodes": "us" },
    "broomfield_co": { "search_name": "Broomfield CO", "brave_country": "US", "nominatim_countrycodes": "us" },
    "glasgow": { "search_name": "Glasgow Scotland", "brave_country": "GB", "nominatim_countrycodes": "gb", "osm_radius_km": 10,
                 "_note": "No Census-style boundary file for Glasgow (site/src/data/town-boundaries/ has the three US towns): OSM is asked around the centre in configs/glasgow.json instead." }
  },
  "exclude_hosts": {
    "_note": "Never candidates: social networks (spec: no Facebook) and our own sites. Existing sources (every URL in configs/<town>.json) and scripts/blocked-domains.json are excluded too.",
    "suffixes": ["facebook.com", "fb.com", "fb.me", "instagram.com", "twitter.com", "x.com", "tiktok.com", "youtube.com", "youtu.be",
                 "linkedin.com", "pinterest.com", "reddit.com", "threads.net",
                 "brookingsview.com", "morenovalleyview.com", "broomfieldview.com", "glasgowloop.co.uk"]
  },
  "probe": {
    "pages": ["/", "/events", "/calendar", "/whats-on", "/christmas"],
    "max_new_probes_per_town_per_day": 300,
    "tribe_per_page": 50
  },
  "geocode": {
    "max_lookups_per_town_per_day": 250
  },
  "admission": {
    "structured_formats": ["tribe_rest", "ics", "google_calendar", "jsonld", "rss", "eventbrite_organizer"],
    "min_in_area_share": 0.8,
    "nearby_radius_miles": 25,
    "_nearby_note": "The existing radius rule: inside the town's own boundary, or within NEARBY_RADIUS_MILES of the centre (site/src/lib/town-boundary.ts). A test keeps the two numbers equal.",
    "max_days_ahead": 365,
    "earliest_year": 2000,
    "min_reasonable_date_share": 1.0,
    "min_successful_days": 3,
    "max_duplicate_share": 0.5
  },
  "report": { "examples_per_town": 10, "seed": 20261118 }
}

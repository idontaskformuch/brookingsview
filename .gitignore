.env
.ai_budget.json
__pycache__/
*.pyc

# Manuellt nedladdad kvartalsfil (rivcoacr.org:s robots.txt blockerar
# AI-agenter explicit, så filen hämtas av en människa, aldrig av scrapern).
# Innehållet hör inte hemma i git-historiken (stor, omdöps varje kvartal,
# ingen anledning att versionshantera den). OBS: bara den här undermappen --
# data/facilities/*.json är tvärtom SMÅ, handskrivna referensdata som SKA
# versionshanteras (upptäckt när en bredare "data/"-regel tyst hade uteslutit
# dem också).
data/property_sales/
# Astro/Node (site/)
node_modules/
dist/
.astro/
site/node_modules/
site/dist/
site/.astro/

# Generated audit CSVs (scripts/audit_page_metadata.mjs,
# scripts/audit_noindex_inbound_links.mjs) -- regenerated on demand
# against a real build, never a source of truth to carry forward.
reports/

# Local-only side-by-side comparison pages for a specific eval run (see
# scripts/eval_tone_v2.py) -- regenerated on demand, never a build artifact
# the site itself needs, so not versioned.
.eval_tone_v2/

# scripts/source_category_images.py --montage output -- contact-sheet grids
# for human review before filling in CATEGORY_SEARCHES' `chosen` field.
# Regenerated on demand, never read by the site itself.
.review_montages/

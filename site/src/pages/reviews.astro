---
/** Arkiv för media_recension -- dagens recension flyttar hit dagen efter att den
 *  varit ettan på förstasidan (se index.astro / getTodaysFeature).
 *
 *  AdSense "low value content" remediation, Phase 0 (2026-10-07): media_recension
 *  stopped generating and this page was unlinked from nav/footer/homepage --
 *  kept building (not 404ed) but noindexed, per the handoff spec's "keep data,
 *  stop rendering" rule. getTodaysFeature() itself is now dead code (nothing
 *  calls it from index.astro any more), kept only for the comment above. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getContentByType } from '../lib/db';
import { siteConfig } from '../lib/site-config';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { buildClusterBreadcrumbTrail, resolveHubBacklink } from '../lib/clusters';

// Folded into /columns/ for Moreno Valley, originally (see columns.astro's
// own comment and NEEDS-HUMAN-REVIEW.md "3.3 Reviews") because its reviews
// cadence was too thin for a dedicated nav slot -- house rule 4. That
// rationale is now moot: AdSense remediation Phase 0 (2026-10-07) already
// unlinked /reviews/ from nav/footer/homepage for EVERY town, so there's no
// nav slot left to avoid giving this one a thin version of. Left pointing
// at /columns/ anyway until 2026-10-09, when it was caught redirecting a
// real visitor/crawler from one unconditionally-noindex page straight to
// another (columns.astro's own BaseLayout also carries `noindex`, same
// Phase 0 rule) -- a redirect to a dead end, not a fix. Points at the
// homepage instead: still real, still indexed, and (unlike /events/, which
// has no editorial relationship to "reviews") the conventional destination
// for a retired content-track archive with nothing currently worth
// promoting a visitor to specifically.
if (siteConfig.townId === 'moreno_valley_ca') {
  return Astro.redirect('/', 301);
}

const stories = await getContentByType(['media_recension'], 60);
const canonicalUrl = new URL('/reviews/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('reviews', siteConfig, { label: 'Reviews', href: canonicalUrl });
const hubBacklink = resolveHubBacklink('reviews', siteConfig);
---
<BaseLayout title={`Reviews — ${siteConfig.siteName}`} wide noindex
  description="Reviews of what's currently playing, AI-written and clearly labeled as such.">
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>Reviews</h1>
    <p>Reviews of what's currently in theaters, written by AI and disclosed as such
    on every piece below.
    {hubBacklink && <> For more of what makes {siteConfig.cityName} feel local, see <a href={hubBacklink.hubHref}>{hubBacklink.clusterLabel}</a>.</>}</p>
  </header>

  <SectionRule label="Latest" />
  {stories.length > 0 ? (
    <div class="grid">{stories.map((story) => <StoryCard story={story} />)}</div>
  ) : (
    <p class="empty">Nothing published yet.</p>
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede { max-width: 40rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
.empty { color: var(--ink-soft); }
</style>

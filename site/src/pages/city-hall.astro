---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import ShareButton from '../components/ShareButton.astro';
import RelatedContent from '../components/RelatedContent.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getUpcomingStories, getPastStories, getProjects } from '../lib/db';
import { siteConfig } from '../lib/site-config';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';

const upcoming = await getUpcomingStories(['meeting'], 40);
const past = await getPastStories(['meeting', 'meeting_followup'], 30);
const projects = await getProjects();
const canonicalUrl = new URL('/city-hall/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'City hall', href: canonicalUrl },
];
---
<BaseLayout title={`City Hall in ${siteConfig.cityName} — ${siteConfig.siteName}`} wide ogSlug="section-city-hall"
  description={`City council, county commission and committee meetings in ${siteConfig.cityName}, ${siteConfig.stateName}, in plain language.`}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <SectionHero category="city_hall" />
  <header class="lede">
    <h1>City hall</h1>
    <p>What {siteConfig.cityName}'s city council, county commission and committees
    are deciding — summarised from the published agendas, in plain language,
    without taking sides. Updated as new agendas and outcomes are published.</p>
    <ShareButton title={`City Hall in ${siteConfig.cityName} — ${siteConfig.siteName}`} />
  </header>

  {projects.length > 0 && (
    <p class="projects-teaser">
      Tracking a real development or ordinance through every meeting that
      touches it? See <a href="/city-hall/projects/">active city hall projects →</a>
    </p>
  )}

  <SectionRule label="Coming up" />
  {upcoming.length > 0 ? (
    <div class="stack">{upcoming.map((story) => <StoryCard story={story} />)}</div>
  ) : (
    <p class="empty">No meetings scheduled at the moment.</p>
  )}

  {past.length > 0 && (
    <>
      <SectionRule label="Recent meetings" href="/city-hall/archive/" />
      <div class="stack">{past.map((story) => <StoryCard story={story} />)}</div>
    </>
  )}

  <RelatedContent pageType="city_hall" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.stack { display: grid; gap: 0.75rem; max-width: 44rem; }
.empty { color: var(--ink-soft); }
.projects-teaser {
  margin: 0 0 1.25rem;
  padding: 0.625rem 0.875rem;
  background: var(--navy-tint);
  border-left: 4px solid var(--navy);
  font-size: 0.9375rem;
}
</style>

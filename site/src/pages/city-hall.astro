---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import ShareButton from '../components/ShareButton.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ClusterNav from '../components/ClusterNav.astro';
import SectionHero from '../components/SectionHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MeetingsUpcoming from '../components/meetings/MeetingsUpcoming.astro';
import { getUpcomingStories, getPastStories, getProjects, formatMeetingDate, getMeetingRowsForView } from '../lib/db';
import {
  MEETINGS_TOWNS, buildMeetings, isUpcoming, buildMeetingJsonLd, nextMeetingDescription,
} from '../lib/meetings-view';
import { siteConfig } from '../lib/site-config';
import { metaDescription } from '../lib/meta-description';
import { placeLabel, forCountry } from '../lib/country-profile';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubNavItems } from '../lib/clusters';

// A town is on the structured meetings layout only when lib/meetings-view.ts lists it; every other town keeps the story list below.
const meetingsTown = MEETINGS_TOWNS[siteConfig.townId] ?? null;
const upcoming = meetingsTown ? [] : await getUpcomingStories(['meeting'], 40);
const pastAll = await getPastStories(['meeting', 'meeting_followup'], meetingsTown ? 40 : 30);
// A notice of quorum is a story about a meeting that is not one (see StoryCard); it stays out of the recent list.
const past = meetingsTown ? pastAll.filter((s) => !s.title.startsWith('Notice: possible quorum')).slice(0, 10) : pastAll;
const projects = await getProjects();
const canonicalUrl = new URL('/city-hall/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'City hall', href: canonicalUrl },
];
// Sitewide title/H1/lede handoff, Phase 1: this is the spec's own
// reference example -- title/H1 now come from the shared pattern catalog
// (site/src/config/page-meta.ts) instead of a hardcoded per-page string.
// The lede below is UNCHANGED -- it's the one the handoff itself called
// "good," and the whole point of resolvePageMeta() is to leave working
// prose alone (see that helper's own doc comment on why ledes stay in
// content, not config).
const pageMeta = resolvePageMeta('city-hall', siteConfig);
const clusterNavItems = resolveHubNavItems('city-hall', siteConfig);

const ledeText = `What ${siteConfig.cityName}'s ${forCountry(siteConfig.country, 'city council, county commission and committees', 'council and committees')} are deciding — ${forCountry(siteConfig.country, 'summarized', 'summarised')} from the published agendas, in plain language, without taking sides. Every summary is checked against its own agenda before publishing, and links back to the original document.`;
const todayYmd = new Intl.DateTimeFormat('en-CA', { timeZone: siteConfig.timezone, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const upcomingMeetings = meetingsTown
  ? buildMeetings(await getMeetingRowsForView(), siteConfig.timezone, siteConfig.meetingsHaveTime)
      .filter((m) => isUpcoming(m, Date.now(), todayYmd))
  : [];
const description = (upcomingMeetings[0] && nextMeetingDescription(upcomingMeetings[0], siteConfig.cityName)) || metaDescription('city-hall', siteConfig);
const eventJsonLd = meetingsTown
  ? upcomingMeetings.slice(0, 10)
      .map((m) => buildMeetingJsonLd(m, siteConfig.timezone, meetingsTown.place, meetingsTown.organizer, canonicalUrl))
      .filter((x): x is Record<string, unknown> => x !== null)
  : [];
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-city-hall"
  description={description}>
  <Breadcrumbs trail={breadcrumbTrail} />
  {meetingsTown ? (
    <>
      <header class="lede">
        <h1>{pageMeta.h1}</h1>
        <ShareButton title={pageMeta.title} />
      </header>

      <MeetingsUpcoming
        meetings={upcomingMeetings}
        todayYmd={todayYmd}
        timezone={siteConfig.timezone}
        commentHref={meetingsTown.comment?.href ?? null}
        commentBodyKeys={meetingsTown.comment?.bodyKeys ?? []}
      />

      {past.length > 0 && (
        <>
          <SectionRule label="Recent meetings" />
          <div class="stack">{past.map((story) => <StoryCard story={story} />)}</div>
          <p class="all-past"><a href="/city-hall/archive/">All past meetings →</a></p>
        </>
      )}

      <SectionRule label="About this page" />
      <div class="lede">
        <p>{ledeText}{past[0]?.occurs_at && <> Last updated {formatMeetingDate(past[0].occurs_at)}.</>}</p>
      </div>
      {projects.length > 0 && (
        <p class="projects-teaser">
          Tracking a real development or ordinance through every meeting that
          touches it? See <a href="/city-hall/projects/">active city hall projects →</a>
        </p>
      )}
      <p class="projects-teaser">
        New to following the council? <a href="/how-city-council-works/">How it works, how to watch and how to speak →</a>
      </p>
      <p class="projects-teaser">
        Garbage, recycling and yard waste: <a href="/trash-recycling/">pickup days and what goes where →</a>
      </p>
    </>
  ) : (
    <>
      <SectionHero section="city_hall" />
      <header class="lede">
        <h1>{pageMeta.h1}</h1>
        <p>{ledeText}{past[0]?.occurs_at && <> Last updated {formatMeetingDate(past[0].occurs_at)}.</>}</p>
        <ShareButton title={pageMeta.title} />
      </header>

      {projects.length > 0 && (
        <p class="projects-teaser">
          Tracking a real development or ordinance through every meeting that
          touches it? See <a href="/city-hall/projects/">active city hall projects →</a>
        </p>
      )}

      <SectionRule label="Coming up" />
      {upcoming.length > 0 ? (
        <div class="stack">{upcoming.map((story) => <StoryCard story={story} />)}</div>
      ) : (
        <p class="empty">No meetings scheduled at the moment.</p>
      )}

      {past.length > 0 && (
        <>
          <SectionRule label="Recent meetings" href="/city-hall/archive/" />
          <div class="stack">{past.map((story) => <StoryCard story={story} />)}</div>
        </>
      )}
    </>
  )}

  <ClusterNav clusterLabel="City hall" items={clusterNavItems} />

  <RelatedContent pageType="city_hall" exclude={clusterNavItems.map((i) => i.href)} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  {eventJsonLd.length > 0 && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd)} />
  )}
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.stack { display: grid; gap: 0.75rem; max-width: 44rem; }
.empty { color: var(--ink-soft); }
.all-past { margin: 0.875rem 0 0; font-weight: 600; }
.projects-teaser {
  margin: 0 0 1.25rem;
  padding: 0.625rem 0.875rem;
  background: var(--navy-tint);
  border-left: 4px solid var(--navy);
  font-size: 0.9375rem;
}
</style>

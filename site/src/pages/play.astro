---
/** Brookings-gated (samma mönster som /university/-jackrabbits) -- spelet
 *  är uttryckligen SDSU-/Brookings-tematiserat ("SDSU Campus"-bana, "a
 *  flappy hare from Brookings, SD"), skulle inte göra sajtmässig mening på
 *  morenovalleyview.com. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site-config';

if (siteConfig.townId !== 'brookings_sd') {
  return Astro.redirect('/', 302);
}
---

<BaseLayout
  title={`Play Jackrabbit — ${siteConfig.siteName}`}
  description="A free retro arcade game starring a jackrabbit, built for Brookings, SD. Play Prairie, unlock SDSU Campus and Main Street."
>
  <section class="play-hero">
    <h1>🐇 Arcade</h1>
    <p class="tagline">
      A little side project: <strong>Jackrabbit</strong>, a Flappy-Bird-style
      game starring a jackrabbit hopping through Brookings. Clear 20 on
      Prairie to unlock SDSU Campus, clear 30 there to unlock Main Street.
    </p>

    <div class="game-frame">
      <iframe
        src="/games/jackrabbit.html"
        title="Jackrabbit game"
        loading="lazy"
        allow="autoplay"
      ></iframe>
    </div>

    <p class="more-games">
      More mini-games are on the way. Got a suggestion? Let us know.
    </p>
  </section>
</BaseLayout>

<style>
  .play-hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
    text-align: center;
  }
  .play-hero h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .tagline {
    opacity: 0.85;
    max-width: 560px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }
  .game-frame {
    display: flex;
    justify-content: center;
  }
  .game-frame iframe {
    width: 420px;
    max-width: 100%;
    height: 780px;
    border: none;
    border-radius: 12px;
  }
  .more-games {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }
</style>

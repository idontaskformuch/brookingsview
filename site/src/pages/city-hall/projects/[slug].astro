---
/** One URL per civic project, accumulating a real, sourced timeline as
 *  meetings touch it -- see NEEDS-HUMAN-REVIEW.md, "Week 3 -- City Hall
 *  Project Pages". Every timeline entry and the project's own `status`
 *  come straight from ai_pipeline/project_updates.py's real meeting-
 *  outcome matching (lib/db.ts:getProjectUpdates() only reads what that
 *  pipeline already verified) -- this page never infers a status from an
 *  agenda item's staff recommendation text, only from a confirmed outcome
 *  document (or shows "pending" honestly when none exists yet). */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  getProjects, getProjectBySlug, getProjectUpdates, PROJECT_STATUS_LABELS,
  PROJECT_PENDING_OUTCOME_LABEL, formatDate, projectActivityState, STALLED_AFTER_DAYS, isSandboxUrl,
} from '../../../lib/db';
import type { ProjectUpdate } from '../../../lib/db';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../../lib/article-jsonld';
import { siteConfig } from '../../../lib/site-config';
import SectionHero from '../../../components/SectionHero.astro';
import { shouldNoindexProject } from '../../../lib/project-noindex';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect('/city-hall/projects/', 302);
}

const updates = await getProjectUpdates(slug!);
const statusLabel = PROJECT_STATUS_LABELS[project.status] ?? project.status;
const canonicalUrl = new URL(`/city-hall/projects/${project.slug}/`, Astro.site ?? siteConfig.siteUrl).href;

// Story Threads extension: a project's real-world approval/construction
// status (project.status, above) and its ACTIVITY state (is anyone still
// adding to this thread?) are two independent facts -- a project can be
// 'under_construction' and simultaneously 'stalled' (no new entry in a
// while). Computed fresh from updated_at every render, never a stored
// flag -- see projectActivityState()'s own comment in lib/db.ts.
const activityState = projectActivityState(project);
// Phase 6: noindex until >=2 updates or a real confirmed outcome exists
// -- see lib/project-noindex.ts's own docstring for exactly what counts.
const noindexThisProject = shouldNoindexProject(updates);

function outcomeLabel(u: ProjectUpdate): string {
  return u.outcome;
}

/** The short "what changed" line takes priority when a story-threads
 *  synthesis exists; older/exact-matched rows fall back to the source's
 *  own agenda title, which is still real, sourced text, just not a
 *  purpose-written summary. */
function entryHeadline(u: ProjectUpdate): string {
  return u.synthesis ?? u.agenda_title ?? 'Update';
}

/** Always ties the vote tally to what was actually decided (the real
 *  outcome word, from an Action Summary/Legistar result -- never guessed
 *  from the agenda) in a single sentence, never a bare "5-0" a reader
 *  could misattribute to the wrong motion on a multi-item agenda. Returns
 *  null (never a bare number) when no outcome is confirmed yet -- callers
 *  must not render a vote tally against a 'pending' row at all. */
/** Same spirit as ai_pipeline/project_registry.py's status_for_outcome()
 *  (order matters there too: "not approved" contains "approved") -- just
 *  for this page's own data-outcome styling hook, so a hand-verified
 *  override still gets the right Approved/Denied color instead of
 *  rendering unstyled or (worse) green for a real denial. */
function overrideOutcomeAttr(override: string): string {
  const lowered = override.toLowerCase();
  if (lowered.includes('denied') || lowered.includes('fail') || lowered.includes('not approved')) return 'Denied';
  if (lowered.includes('approved') || lowered.includes('passed') || lowered.includes('adopted')) return 'Approved';
  return override;
}

function voteSentence(u: ProjectUpdate): string | null {
  if (u.vote_yes == null && u.vote_no == null) return null;
  if (u.outcome === 'pending') return null;
  const parts = [`${u.vote_yes ?? 0}-${u.vote_no ?? 0}`];
  if (u.vote_abstain) parts.push(`${u.vote_abstain} abstain`);
  if (u.vote_absent) parts.push(`${u.vote_absent} absent`);
  return `${u.outcome} by a vote of ${parts.join(', ')}`;
}

// "Pending" is honest, not a placeholder for a guess -- shown inline so a
// reader (or Google) never mistakes it for missing data. ONE wording for
// this everywhere (PROJECT_PENDING_OUTCOME_LABEL) regardless of town or
// body -- Moreno Valley's Planning Commission never posts an outcome
// document on its eSCRIBE portal at all (verified live against ~20 real
// meetings), while Brookings' own "Planning Commission" body DOES get real
// outcomes via Legistar (see NEEDS-HUMAN-REVIEW.md, "Brookings -- City Hall
// Project Pages") -- but a reader doesn't need that platform-level reason
// to understand "not published yet," and two different sentences for the
// identical fact is exactly what this constant exists to stop.

const earliestDate = updates[0]?.meeting_date ?? project.updated_at;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'City hall', href: '/city-hall/' },
  { label: 'Projects', href: '/city-hall/projects/' },
  { label: project.title, href: canonicalUrl },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonicalUrl,
  url: canonicalUrl,
  headline: project.title,
  description: project.description,
  datePublished: earliestDate,
  dateModified: project.updated_at,
  author: { '@type': 'Organization', name: siteConfig.siteName },
  publisher: { '@type': 'Organization', name: siteConfig.siteName },
};

const itemListJsonLd = updates.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${project.title} — timeline`,
  itemListElement: updates.map((u, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${formatDate(u.entry_date)}: ${entryHeadline(u)}`,
    url: (u.source_url && !isSandboxUrl(u.source_url) ? u.source_url : null)
      ?? (u.agenda_url && !isSandboxUrl(u.agenda_url) ? u.agenda_url : null)
      ?? canonicalUrl,
  })),
} : null;
---
<BaseLayout title={`${project.title} — ${siteConfig.siteName}`} ogSlug="section-city-hall"
  description={project.description.slice(0, 155)} noindex={noindexThisProject}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <SectionHero category="city_hall" />
  <article class="project">
    <header class="lede">
      <p class="status" data-status={project.status}>{statusLabel}</p>
      {activityState !== 'active' && (
        <p class="activity-state" data-activity={activityState}>
          {activityState === 'resolved' ? 'Resolved' : `No update in ${STALLED_AFTER_DAYS}+ days`}
        </p>
      )}
      <h1>{project.title}</h1>
      <p class="desc">{project.description}</p>
      {project.rolling_summary && (
        <p class="rolling-summary">{project.rolling_summary}</p>
      )}
      {project.location_text && (
        <p class="location">
          📍 {project.location_text}
          {' '}<a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(project.location_text)}`}
                 target="_blank" rel="noopener">Map</a>
          {project.home_sales_zip && (
            <> · <a href={`/home-sales/?zip=${project.home_sales_zip}`}>Home sales in this ZIP</a></>
          )}
        </p>
      )}
      {siteConfig.hasWorkplaceWatch && project.workplace_watch_employer_name && (
        <p class="cross-link">
          This project may affect a tracked local employer —{' '}
          <a href="/workplace-watch/">see {project.workplace_watch_employer_name} in Worker Pulse →</a>
        </p>
      )}
      <ShareButton title={`${project.title} — ${siteConfig.siteName}`} url={canonicalUrl} />
    </header>

    <h2 class="timeline-heading">Timeline</h2>
    {updates.length > 0 ? (
      <ol class="timeline">
        {updates.map((u) => (
          <li class="timeline__item" data-outcome={u.outcome_override ? overrideOutcomeAttr(u.outcome_override) : u.outcome}>
            <p class="timeline__date">{formatDate(u.entry_date)} · {u.body ?? 'Traffic update'}</p>
            <p class="timeline__title">{entryHeadline(u)}</p>
            <p class="timeline__outcome">
              {u.outcome_override ? (
                <>{u.outcome_override}{u.outcome_override_source_url && (
                  <> · <a href={u.outcome_override_source_url} target="_blank" rel="noopener">Minute Order</a></>
                )}</>
              ) : u.outcome === 'pending' ? (
                <>On the agenda. <span class="reason">{PROJECT_PENDING_OUTCOME_LABEL}</span></>
              ) : (
                voteSentence(u) ?? outcomeLabel(u)
              )}
            </p>
            <p class="timeline__sources">
              {u.agenda_url && !isSandboxUrl(u.agenda_url) && <a href={u.agenda_url} target="_blank" rel="noopener">Agenda</a>}
              {u.source_url && !isSandboxUrl(u.source_url) && u.source_url !== u.agenda_url && (
                <> · <a href={u.source_url} target="_blank" rel="noopener">
                  {u.outcome === 'pending' ? 'Source' : 'Minutes / action summary'}
                </a></>
              )}
            </p>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">No meeting updates recorded yet for this project.</p>
    )}

    <p class="back"><a href="/city-hall/projects/">← All active projects</a> · <a href="/city-hall/">City hall</a></p>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  {itemListJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  )}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.status {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--navy);
  background: var(--navy-tint);
  border-radius: 999px;
  padding: 0.25rem 0.7rem;
  margin: 0 0 0.5rem;
}
.status[data-status="approved"], .status[data-status="permitted"],
.status[data-status="under_construction"], .status[data-status="complete"] {
  color: var(--status-good-ink);
  background: var(--status-good-tint);
}
.status[data-status="denied"] { color: var(--status-bad-ink); background: var(--status-bad-tint); }
.activity-state {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--ink-soft);
  background: var(--rule);
  border-radius: 999px;
  padding: 0.25rem 0.7rem;
  margin: 0 0 0.5rem 0.4rem;
}
.activity-state[data-activity="resolved"] { color: var(--status-good-ink); background: var(--status-good-tint); }
.desc { color: var(--ink-soft); margin: 0.5rem 0 0; }
.rolling-summary {
  margin: 0.75rem 0 0;
  padding: 0.75rem 0.875rem;
  background: var(--navy-tint);
  border-left: 4px solid var(--navy);
  font-size: 0.9375rem;
}
.location { color: var(--ink-soft); font-size: 0.9375rem; margin: 0.75rem 0 0; }
.cross-link { color: var(--ink-soft); font-size: 0.9375rem; margin: 0.75rem 0 0; }
.timeline-heading { margin-top: 2rem; }
.timeline { list-style: none; margin: 0; padding: 0; max-width: 44rem; }
.timeline__item {
  padding: 0.875rem 0;
  border-top: 1px solid var(--rule);
}
.timeline__date { font-family: var(--font-ui); font-size: 0.8125rem; color: var(--ink-soft); margin: 0; }
.timeline__title { font-weight: 600; margin: 0.25rem 0; }
.timeline__outcome { margin: 0.25rem 0; }
.timeline__item[data-outcome="Approved"] .timeline__outcome { color: var(--status-ok-text); }
.timeline__item[data-outcome="Denied"] .timeline__outcome,
.timeline__item[data-outcome="Failed"] .timeline__outcome { color: var(--alert); }
.timeline__outcome .reason { color: var(--ink-soft); font-size: 0.875rem; }
.timeline__sources { font-size: 0.8125rem; margin: 0.25rem 0 0; }
.empty { color: var(--ink-soft); }
.back { margin-top: 2rem; font-size: 0.9375rem; }
</style>

---
/** SEO Fas 2.2 — full meeting archive, month-grouped, so past meetings
 *  never become orphans once they roll off city-hall.astro's 30-item
 *  "Recent meetings" cap (confirmed live via site/scripts/find-orphan-
 *  pages.mjs, see NEEDS-HUMAN-REVIEW.md §25 -- ~48 real /s/meeting-N/
 *  pages on Brookings had zero inbound links before this page existed).
 *  A single flat, month-grouped page rather than year-subpages: real data
 *  only spans a few months since launch, so year-splitting would be
 *  premature structure for data that doesn't exist yet -- add it later if
 *  the archive genuinely grows past what one page should hold.
 *  meeting_date is a bare calendar date (no real time-of-day), so grouping
 *  uses formatMonthYear()/calendarDateParts() directly -- no timezone
 *  conversion, same discipline as formatCalendarDate throughout this
 *  codebase.
 *
 *  getContentByType(), not getPastStories(): a real, non-hypothetical find
 *  from verifying this page (see NEEDS-HUMAN-REVIEW.md §26) -- a handful
 *  of very early rows (launch-day scraper runs, 2026-07-18) have
 *  occurs_at = NULL and are therefore invisible to EVERY occurs_at-based
 *  query (getPastStories' `occurs_at < now() - interval` never matches
 *  NULL), which had silently kept them unreachable from anywhere on the
 *  site. getContentByType has no date filter at all, so they land in the
 *  'undated' bucket below instead of vanishing. Filtered to exclude
 *  genuinely FUTURE meetings (still shown on city-hall.astro's "Coming
 *  up," not duplicated here) -- but null-date and already-past rows both
 *  belong in an archive. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getContentByType, formatMonthYear, calendarDateParts } from '../../lib/db';
import type { Story } from '../../lib/db';
import { siteConfig } from '../../lib/site-config';

const allMeetings = await getContentByType(['meeting', 'meeting_followup'], 5000);
const meetings = allMeetings.filter((m) => !m.occurs_at || new Date(m.occurs_at) < new Date());

function monthKey(story: Story): string {
  const parts = calendarDateParts(story.occurs_at);
  return parts ? `${parts.y}-${String(parts.m + 1).padStart(2, '0')}` : 'undated';
}

const groups = new Map<string, Story[]>();
for (const m of meetings) {
  const key = monthKey(m);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(m);
}
// "Oldest to newest within each month" per the intro copy below --
// getContentByType() orders by published_at, not occurs_at, so each
// group needs its own explicit sort.
for (const group of groups.values()) {
  group.sort((a, b) => (a.occurs_at ? new Date(a.occurs_at).getTime() : 0) - (b.occurs_at ? new Date(b.occurs_at).getTime() : 0));
}
const sortedMonths = [...groups.keys()].sort().reverse();

const title = `City Hall Meeting Archive — ${siteConfig.cityName}`;
const description = `Every past city council, county commission and committee meeting covered in ${siteConfig.cityName}, ${siteConfig.stateName}, grouped by month.`;
const canonicalUrl = new URL('/city-hall/archive/', Astro.site ?? siteConfig.siteUrl).href;

const itemListJsonLd = meetings.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  itemListElement: meetings.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.title,
    url: new URL(`/s/${m.slug}/`, Astro.site ?? siteConfig.siteUrl).href,
  })),
} : null;
---
<BaseLayout title={title} wide ogSlug="section-city-hall" description={description}>
  <header class="lede">
    <h1>Meeting archive</h1>
    <p>Every city hall meeting covered on this site, oldest to newest within
    each month. Looking for what's coming up? See <a href="/city-hall/">City hall →</a>.</p>
    <ShareButton title={title} url={canonicalUrl} />
  </header>

  {sortedMonths.length > 0 ? sortedMonths.map((key) => (
    <section class="month">
      <h2 class="month__heading">{key === 'undated' ? 'Undated' : formatMonthYear(`${key}-01`)}</h2>
      <div class="stack">
        {groups.get(key)!.map((story) => <StoryCard story={story} compact />)}
      </div>
    </section>
  )) : (
    <p class="empty">No past meetings recorded yet.</p>
  )}

  {itemListJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  )}
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.month { margin-top: 2rem; }
.month__heading {
  font-size: 1.0625rem;
  border-top: 2px solid var(--rule-strong);
  padding-top: 0.4375rem;
  margin: 0 0 0.875rem;
}
.stack { display: grid; gap: 0.75rem; max-width: 44rem; }
.empty { color: var(--ink-soft); }
</style>

---
/** SDSU-hubb -- "vad händer på State", inte en databasdump av
 *  event-kalendern. Brookings-specifik (SDSU finns bara här), samma
 *  redirect-gate-mönster som /sports/-home-sales.
 *
 *  Struktur: hero (nästa 1-3 stora Athletics/Music-evenemang) -> "This week
 *  at State" i samma Today/This weekend/Coming up/Further out-hinkar som
 *  /events.astro (se den filens kommentar för varför tidszons-aritmetiken
 *  görs precis så här -- en tidigare version av /events fick veckoslutet
 *  fel varje bygge genom att återanvända en redan konverterad tidszon) ->
 *  akademisk "next up"-ribbon -> Jackrabbits-teaser.
 *
 *  Teasers är källans EGNA korta sammanfattningar, aldrig hela
 *  eventbeskrivningar -- se scrapers/parsers/sdsu_events_v1.py:s
 *  moduldocstring för upphovsrättsresonemanget. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import type { SdsuEvent } from '../lib/db';
import {
  getUpcomingSdsuEvents, getUpcomingArtsEvents, getUpcomingAcademicDates, getContentByType,
  formatCalendarDate, formatDate, formatTime,
} from '../lib/db';
import { siteConfig } from '../lib/site-config';

if (siteConfig.townId !== 'brookings_sd') {
  return Astro.redirect('/', 302);
}

const [events, artsEvents, academicDates, digests] = await Promise.all([
  getUpcomingSdsuEvents(60),
  getUpcomingArtsEvents(6),
  // Full remaining calendar for the current/next term, not just a 2-date
  // ribbon (see NEEDS-HUMAN-REVIEW.md "University Coverage Rebuild", A.2 --
  // the underlying data already covers registration/breaks/finals/
  // commencement, the page just wasn't showing more than the next 2).
  getUpcomingAcademicDates(10),
  getContentByType(['university_digest'], 12),
]);

const CATEGORY_ICONS: Record<string, string> = {
  Music: '🎵',
  'Theatre/Dance': '🎭',
  'Special Events': '🎉',
  'Camps/Conferences': '🏕️',
};
// Athletics used to get a single 🏈 regardless of actual sport (soccer,
// volleyball, a road race, wrestling all showed a football) -- see
// NEEDS-HUMAN-REVIEW.md "University Coverage Rebuild", A.2. primary_category
// is too coarse to distinguish sports (SDSU's calendar has one "Athletics"
// bucket for all of them), but the title always names the actual sport, so
// icon selection for Athletics is keyword-matched against the title instead.
const ATHLETICS_ICONS: [RegExp, string][] = [
  [/\bfootball\b/i, '🏈'],
  [/\bsoccer\b/i, '⚽'],
  [/\bvolleyball\b/i, '🏐'],
  [/\bbasketball\b|\bvs\b.*\bMBB\b|\bWBB\b/i, '🏀'],
  [/\bwrestling\b/i, '🤼'],
  [/\btrack\b|\broad race\b|\bcross country\b|\bXC\b/i, '🏃'],
  [/\bgolf\b/i, '⛳'],
  [/\btennis\b/i, '🎾'],
  [/\bsoftball\b/i, '🥎'],
  [/\bbaseball\b/i, '⚾'],
];
const iconFor = (cat: string | null, title: string = '') => {
  if (cat === 'Athletics') {
    return ATHLETICS_ICONS.find(([re]) => re.test(title))?.[1] ?? '🏟️';
  }
  return cat ? CATEGORY_ICONS[cat] ?? '📅' : '📅';
};

// "Marquee" = det som fyller hero-remsan: de närmaste Athletics/Music-
// evenemangen, eftersom de är det som drar flest läsare (matcher, konserter)
// -- inte nödvändigtvis det allra första i tidsordning oavsett kategori.
const marquee = events.filter((e) => e.primary_category === 'Athletics' || e.primary_category === 'Music').slice(0, 3);
const marqueeIds = new Set(marquee.map((e) => e.external_event_id));
const rest = events.filter((e) => !marqueeIds.has(e.external_event_id));

/** Samma bucketeringslogik som /events.astro -- se den filens kommentar
 *  för varför Y/M/D läses ut via Intl.DateTimeFormat och räknas om till
 *  UTC-midnatt i stället för att låta Date's egen lokala tidszon smyga sig
 *  in i jämförelsen. */
function localDateParts(instant: Date): { y: number; m: number; d: number } {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: siteConfig.timezone, year: 'numeric', month: '2-digit', day: '2-digit',
  }).formatToParts(instant);
  const get = (t: string) => Number(parts.find((p) => p.type === t)!.value);
  return { y: get('year'), m: get('month'), d: get('day') };
}
function utcMidnight({ y, m, d }: { y: number; m: number; d: number }): Date {
  return new Date(Date.UTC(y, m - 1, d));
}
function dayIndex(event: SdsuEvent, today: Date): number {
  const eventDay = utcMidnight(localDateParts(new Date(event.starts_at!)));
  return Math.round((eventDay.getTime() - today.getTime()) / 86_400_000);
}

const today = utcMidnight(localDateParts(new Date()));
const weekdayOfToday = today.getUTCDay();
const daysToFriday = (5 - weekdayOfToday + 7) % 7;

const buckets = { today: [] as SdsuEvent[], weekend: [] as SdsuEvent[], nextWeek: [] as SdsuEvent[], later: [] as SdsuEvent[] };
for (const event of rest) {
  if (!event.starts_at) { buckets.later.push(event); continue; }
  const offset = dayIndex(event, today);
  if (offset <= 0) buckets.today.push(event);
  else if (offset >= daysToFriday && offset <= daysToFriday + 2) buckets.weekend.push(event);
  else if (offset < 14) buckets.nextWeek.push(event);
  else buckets.later.push(event);
}
const sections = (
  [
    ['Today', buckets.today],
    ['This weekend', buckets.weekend],
    ['Coming up', buckets.nextWeek],
    ['Further out', buckets.later],
  ] as [string, SdsuEvent[]][]
).filter(([, list]) => list.length > 0);

---
<BaseLayout title={`University — ${siteConfig.siteName}`} wide
  description="What's happening at South Dakota State University -- athletics, music, theatre and campus events, plus key academic dates.">
  <header class="lede">
    <h1>University</h1>
    <p>What's on at South Dakota State University this week — games, concerts, shows
    and campus happenings, straight from SDSU's own event calendar.</p>
    <ShareButton title={`University — ${siteConfig.siteName}`} />
  </header>

  {digests.length > 0 && (
    <>
      <SectionRule label="Weekly preview" />
      <div class="grid">{digests.map((story) => <StoryCard story={story} />)}</div>
    </>
  )}

  {marquee.length > 0 && (
    <>
      <SectionRule label="Next up at State" />
      <div class="hero-grid">
        {marquee.map((event) => (
          <a class="hero-card" href={event.event_url} rel="noopener">
            <p class="hero-card__date data">
              {event.starts_at && formatDate(event.starts_at)}
              {event.starts_at && ` · ${formatTime(event.starts_at)}`}
            </p>
            <p class="hero-card__title">{iconFor(event.primary_category, event.title)} {event.title}</p>
            {event.location && <p class="hero-card__loc">{event.location}</p>}
            {event.teaser && <p class="hero-card__teaser">{event.teaser}</p>}
          </a>
        ))}
      </div>
    </>
  )}

  {artsEvents.length > 0 && (
    <>
      <SectionRule label="Arts &amp; culture at SDSU" href="/events/" />
      <div class="grid">
        {artsEvents.map((event) => (
          <a class="event-card" href={event.event_url} rel="noopener">
            <p class="event-card__meta data">
              {iconFor(event.primary_category, event.title)} {event.primary_category ?? 'Event'}
              {event.starts_at && ` · ${formatDate(event.starts_at)}`}
              {event.starts_at && ` · ${formatTime(event.starts_at)}`}
            </p>
            <p class="event-card__title">{event.title}</p>
            {event.location && <p class="event-card__loc">{event.location}</p>}
          </a>
        ))}
      </div>
    </>
  )}

  {academicDates.length > 0 && (
    <>
      <SectionRule label="Academic calendar" />
      <ul class="academic-list">
        {academicDates.map((d) => (
          <li>
            <span class="academic-list__date data">
              {formatCalendarDate(d.starts_on)}{d.ends_on && `–${formatCalendarDate(d.ends_on)}`}
            </span>
            <span class="academic-list__label">{d.label}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <a class="jackrabbits-card" href="/jackrabbits/">
    <p class="jackrabbits-card__title">🐰 SDSU Jackrabbits</p>
    <p class="jackrabbits-card__body">Full schedules and results for football, basketball and volleyball →</p>
  </a>

  {sections.length > 0 ? sections.map(([label, list]) => (
    <>
      <SectionRule label={label} />
      <div class="grid">
        {list.map((event) => (
          <a class="event-card" href={event.event_url} rel="noopener">
            <p class="event-card__meta data">
              {iconFor(event.primary_category, event.title)} {event.primary_category ?? 'Event'}
              {event.starts_at && ` · ${formatDate(event.starts_at)}`}
              {event.starts_at && ` · ${formatTime(event.starts_at)}`}
            </p>
            <p class="event-card__title">{event.title}</p>
            {event.location && <p class="event-card__loc">{event.location}</p>}
            {event.teaser && <p class="event-card__teaser">{event.teaser}</p>}
          </a>
        ))}
      </div>
    </>
  )) : (
    <p class="empty">No upcoming events listed right now.</p>
  )}

  <p class="source">
    Source: <a href="https://www.sdstate.edu/event-calendar" rel="noopener">SDSU Event Calendar</a>, refreshed regularly.
  </p>

  <RelatedContent pageType="university" />
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }

.hero-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin-bottom: 0.5rem; }
.hero-card {
  display: block;
  border: 0;
  border-left: 4px solid var(--navy);
  background: var(--navy-tint);
  padding: 0.875rem 1rem;
  color: inherit;
  text-decoration: none;
}
.hero-card__date { font-size: 0.75rem; color: var(--ink-soft); margin: 0 0 0.25rem; }
.hero-card__title {
  margin: 0 0 0.25rem;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.125rem;
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.hero-card:hover .hero-card__title { text-decoration: underline; }
.hero-card__loc { margin: 0; font-size: 0.8125rem; color: var(--ink-soft); }
.hero-card__teaser { margin: 0.375rem 0 0; font-size: 0.875rem; line-height: 1.4; }

.academic-list {
  list-style: none; margin: 0 0 1.25rem; padding: 0;
  background: var(--surface); border: 1px solid var(--rule); border-radius: 3px;
}
.academic-list li {
  display: flex; gap: 0.75rem; align-items: baseline;
  padding: 0.5rem 0.875rem; border-bottom: 1px solid var(--rule); font-size: 0.9375rem;
}
.academic-list li:last-child { border-bottom: 0; }
.academic-list__date { flex: 0 0 auto; color: var(--ink-soft); font-size: 0.8125rem; white-space: nowrap; }
.academic-list__label { flex: 1; }

.jackrabbits-card {
  display: block;
  border: 1px solid var(--rule);
  padding: 0.875rem 1rem;
  margin-bottom: 1.25rem;
  color: inherit;
  text-decoration: none;
}
.jackrabbits-card__title {
  margin: 0 0 0.25rem;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.0625rem;
}
.jackrabbits-card:hover .jackrabbits-card__title { text-decoration: underline; }
.jackrabbits-card__body { margin: 0; font-size: 0.875rem; color: var(--ink-soft); }

.grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
.event-card {
  display: block;
  border: 1px solid var(--rule);
  padding: 0.75rem 0.875rem;
  color: inherit;
  text-decoration: none;
}
.event-card__meta { font-size: 0.75rem; color: var(--ink-soft); margin: 0 0 0.25rem; }
.event-card__title {
  margin: 0 0 0.25rem;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.0625rem;
  letter-spacing: -0.01em;
  line-height: 1.25;
}
.event-card:hover .event-card__title { text-decoration: underline; }
.event-card__loc { margin: 0; font-size: 0.8125rem; color: var(--ink-soft); }
.event-card__teaser { margin: 0.375rem 0 0; font-size: 0.875rem; line-height: 1.4; }

.empty { color: var(--ink-soft); }
.source { margin-top: 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
</style>

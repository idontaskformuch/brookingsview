---
/** USDA-ag-marknad, meningsfull bara för Brookings (se configs/moreno_valley_ca.json
 *  _no_ag_markets_note). Samma redirect-mönster som jackrabbits.astro.
 *
 * Fördjupning 2026-08-23 (se NEEDS-HUMAN-REVIEW.md "Brookings — Farm Report
 * Depth"): tre bara-siffror utan datum eller riktning -> datumstämpel,
 * månad-för-månad/år-för-år-riktning, ett 12-månaders spann + sparkline, och
 * fyra nya serier (wheat/sunflowers/oats/hogs) utöver corn/soybeans/cattle.
 * All beräkningslogik lever i lib/farm-report.ts (testbar utan Astro, se
 * dess egen test-fil) -- den här filen bara hämtar och renderar.
 *
 * SDSU ag-research-bryggan (brevets Fix 5) är INTE byggd här: SDSU:s
 * newsroom-RSS är fortfarande bara specificerad i university-brevet, inte
 * ingested -- att bygga UI mot en källa som inte finns skulle betyda att
 * hitta på innehåll. Loggad som pending i NEEDS-HUMAN-REVIEW.md, inte
 * tystad. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAgPriceSeries, formatMonthYear } from '../lib/db';
import { buildSeriesDisplay } from '../lib/farm-report';
import { siteConfig } from '../lib/site-config';

if (siteConfig.townId !== 'brookings_sd') {
  return Astro.redirect('/', 302);
}

const series = await getAgPriceSeries();
const cards = series
  .map((s) => buildSeriesDisplay(s, formatMonthYear))
  .filter((c) => c !== null);
---
<BaseLayout title={`Farm report — ${siteConfig.siteName}`} ogSlug="section-farm-report"
  description={`Corn, soybean, wheat, sunflower, oat, cattle and hog prices for ${siteConfig.stateName} from USDA National Agricultural Statistics Service.`}>
  <header class="lede">
    <h1>Farm report</h1>
    <p>Prices received, from the USDA National Agricultural Statistics Service.
    Corn, soybeans, wheat, sunflowers, and oats are South Dakota figures.
    Cattle and hogs are national series — South Dakota doesn't get its own
    price-received series for those in USDA's data.</p>
  </header>

  {cards.length > 0 ? (
    <div class="grid">
      {cards.map((c) => (
        <article class="card">
          <p class="card__label">{c.label}</p>
          <p class="card__price data">
            {c.price}
            {c.unit && <span class="card__unit">{c.unit}</span>}
          </p>
          <p class="card__asof">as of {c.asOf}</p>

          {(c.momDelta || c.yoyDelta) && (
            <div class="card__deltas">
              {c.momDelta && (
                <p class:list={['delta', `delta--${c.momDelta.direction}`]}>
                  {c.momDelta.direction === 'up' && '▲'}
                  {c.momDelta.direction === 'down' && '▼'}
                  {c.momDelta.direction === 'flat' ? 'No change' : c.momDelta.text}
                  {' '}vs {c.momDelta.comparedTo}
                </p>
              )}
              {c.yoyDelta && (
                <p class:list={['delta', `delta--${c.yoyDelta.direction}`]}>
                  {c.yoyDelta.direction === 'up' && '▲'}
                  {c.yoyDelta.direction === 'down' && '▼'}
                  {c.yoyDelta.direction === 'flat' ? 'No change' : c.yoyDelta.text}
                  {' '}vs {c.yoyDelta.comparedTo} (a year ago)
                </p>
              )}
            </div>
          )}

          {c.sparkline.path && (
            <svg class="sparkline" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true">
              <path d={c.sparkline.path} fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          )}
          {c.rangeText && (
            <p class="card__range">12-month range: {c.rangeText}</p>
          )}
        </article>
      ))}
    </div>
  ) : (
    <p class="empty">Prices are not available right now.</p>
  )}

  <p class="note">
    USDA publishes these monthly, so the most recent figure may lag the current
    month — the "as of" date on each card is the actual reporting period, not
    today. Always check the <a href="https://quickstats.nass.usda.gov/" rel="noopener">USDA
    Quick Stats database</a> before making a decision that depends on the number.
  </p>
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.grid { display: grid; gap: 0.875rem; grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr)); margin-top: 1.5rem; }
.card { border: 1px solid var(--rule); background: var(--surface); padding: 0.875rem 1rem; }
.card__label {
  margin: 0 0 0.25rem;
  font-family: var(--font-ui);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.card__price { margin: 0; font-size: 1.5rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; }
.card__unit { margin-left: 0.375rem; font-size: 0.75rem; font-weight: 400; color: var(--ink-soft); }
.card__asof { margin: 0.25rem 0 0; font-size: 0.75rem; color: var(--ink-soft); }
.card__deltas { margin: 0.5rem 0 0; display: grid; gap: 0.125rem; }
.delta { margin: 0; font-size: 0.8125rem; color: var(--ink); }
/* Deliberately no red/green "good vs bad" coloring here -- a price going up
   is good news for a seller and bad news for a buyer, so the arrow carries
   the direction and the color stays neutral rather than implying a verdict. */
.delta--flat { color: var(--ink-soft); }
.sparkline { display: block; width: 100%; height: 2rem; margin-top: 0.625rem; color: var(--ink-soft); }
.card__range { margin: 0.375rem 0 0; font-size: 0.75rem; color: var(--ink-soft); }
.empty { color: var(--ink-soft); }
.note { margin-top: 2rem; font-size: 0.9375rem; color: var(--ink-soft); }
</style>

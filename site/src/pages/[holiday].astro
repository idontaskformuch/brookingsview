---
/** The holiday pages (/veterans-day/, /thanksgiving/, /christmas/), rendered from data by the shared template.
 *  One route so a town without a page simply gets no file: the host then answers a real 404 (wrangler
 *  not_found_handling), not a redirect. A page exists for a town only with at least one confirmed row from an
 *  official source (config/holiday-pages/registry.ts). Never noindex: inside the window the title carries the
 *  year, outside it the page is a standing page with last season's facts labelled by year
 *  (.claude/specs/evergreen-holidays.md). Rows from the town's own event calendars and venue register (and, on a season page,
 *  Ticketmaster's, owner 2026-11-15) are added here, at build
 *  time (lib/holiday-calendar-events.ts); every match is printed to the build log. Christmas in every town (layout 'festive') is
 *  rendered by holiday/HolidayFestivePage (owner 2026-11-26); the day-by-day season page it replaced is gone. */
import HolidayPage from '../components/HolidayPage.astro';
import HolidayFestivePage from '../components/holiday/HolidayFestivePage.astro';
import { siteConfig } from '../lib/site-config';
import { HOLIDAY_PAGE_DEFS } from '../config/holiday-pages/calendar';
import { holidayPageFor } from '../config/holiday-pages/registry';
import { evergreenLines, resolvePageState } from '../lib/holiday-calendar';
import { isTimeless } from '../lib/holiday-view';
import { holidayPageWithRows } from '../lib/holiday-page-build';

export function getStaticPaths() {
  return HOLIDAY_PAGE_DEFS.flatMap((d) => (holidayPageFor(d.slug, siteConfig.townId) ? [{ params: { holiday: d.slug } }] : []));
}

const entry = holidayPageFor(Astro.params.holiday as string, siteConfig.townId);
if (!entry) throw new Error(`no holiday page for ${Astro.params.holiday} / ${siteConfig.townId}`);
const state = resolvePageState(entry.def, entry.page.year, Date.now(), siteConfig.timezone);

// Calendar, venue-register and Ticketmaster rows (lib/holiday-page-build.ts, the same rows the evening layer's holiday group reads).
const page = await holidayPageWithRows(entry, Date.now(), true);
// The festive layout (owner 2026-11-26) shows this season's facts: inside the window, or before it with the coming season's data. A page
// whose facts are an earlier season's (timeless) keeps the standard template, where nothing reads as if it is about to happen.
const evergreen = state.kind === 'evergreen';
const festive = entry.def.layout === 'festive' && (state.kind === 'active' || (evergreen && !isTimeless(page, state.nextYear)));
const festiveNote = festive && state.kind === 'evergreen' ? evergreenLines(entry.def, page.year, state, page.locale).note : null;
---
{festive
  ? <HolidayFestivePage page={page} def={entry.def} evergreen={evergreen} note={festiveNote} />
  : <HolidayPage page={page} def={entry.def} state={state} hasClosures={!!siteConfig.hasClosureWatch} />}

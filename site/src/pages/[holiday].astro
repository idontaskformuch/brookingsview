---
/** The holiday pages (/veterans-day/, /thanksgiving/, /christmas/), rendered from data by the shared template.
 *  One route so a town without a page simply gets no file: the host then answers a real 404 (wrangler
 *  not_found_handling), not a redirect. A page exists for a town only with at least one confirmed row from an
 *  official source (config/holiday-pages/registry.ts). Never noindex: inside the window the title carries the
 *  year, outside it the page is a standing page with last season's facts labelled by year
 *  (.claude/specs/evergreen-holidays.md). Rows from the town's own event calendars and venue register (and, on a season page,
 *  Ticketmaster's, owner 2026-11-15) are added here, at build
 *  time (lib/holiday-calendar-events.ts); every match is printed to the build log. A page with day-by-day data (`season`) is
 *  rendered by HolidaySeasonPage while its window is open (Glasgow's Christmas and New Year, owner 2026-11-14). */
import HolidayPage from '../components/HolidayPage.astro';
import HolidaySeasonPage from '../components/HolidaySeasonPage.astro';
import { siteConfig } from '../lib/site-config';
import { HOLIDAY_PAGE_DEFS } from '../config/holiday-pages/calendar';
import { calendarExcludesFor, calendarIncludesFor, holidayPageFor } from '../config/holiday-pages/registry';
import { resolvePageState } from '../lib/holiday-calendar';
import { getEveningRegister, getFacilities, getUpcomingStories } from '../lib/db';
import { buildTownEventsView } from '../lib/events-town-view';
import { formatCalendarReport, matchCalendarEvents, matchRegisterRows, matchTicketmasterEvents } from '../lib/holiday-calendar-events';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';

export function getStaticPaths() {
  return HOLIDAY_PAGE_DEFS.flatMap((d) => (holidayPageFor(d.slug, siteConfig.townId) ? [{ params: { holiday: d.slug } }] : []));
}

const entry = holidayPageFor(Astro.params.holiday as string, siteConfig.townId);
if (!entry) throw new Error(`no holiday page for ${Astro.params.holiday} / ${siteConfig.townId}`);
const state = resolvePageState(entry.def, entry.page.year, Date.now(), siteConfig.timezone);

let page = entry.page;
const exclude = calendarExcludesFor(entry.def.slug, siteConfig.townId);
if (exclude) {
  // The same rows /events/ shows (frozen filter, merge, in-town / nearby), with room for the whole window.
  const [stories, facilities] = await Promise.all([getUpcomingStories(['event'], 600), getFacilities()]);
  const { displayed, distanceOf, nearbyRows } = buildTownEventsView(stories, [], facilities);
  const nearby = new Set(nearbyRows.map((r) => r.item));
  const { events, report } = matchCalendarEvents(
    entry.def, entry.page.year,
    displayed.map((item) => (nearby.has(item) ? { item, nearbyMiles: distanceOf.get(item) ?? null } : { item })),
    siteConfig.timezone, exclude, calendarIncludesFor(entry.def.slug, siteConfig.townId),
  );
  const reg = page.season
    ? matchRegisterRows(entry.def, entry.page.year, await getEveningRegister(), Date.now(), siteConfig.timezone, siteConfig.cityName, exclude)
    : { events: [], report: [] };
  // Ticketmaster: the build's shared fetch (no extra call), on a season page only (owner 2026-11-15).
  const tm = page.season && siteConfig.hasWhatsOn
    ? matchTicketmasterEvents(entry.def, entry.page.year, await getTicketmasterEventsForTown(siteConfig), Date.now(), siteConfig.timezone, exclude)
    : { events: [], report: [] };
  // A row the page already has by hand (same organizer page) is not listed twice.
  const handUrls = new Set(page.events.flatMap((e) => (e.status === 'confirmed' ? [e.url] : [])));
  const added = [...events, ...reg.events, ...tm.events].filter((e) => !handUrls.has(e.url));
  for (const line of formatCalendarReport(entry.def.slug, siteConfig.townId, [...report, ...reg.report, ...tm.report])) console.log(line);
  if (added.length > 0) page = { ...page, events: [...page.events, ...added] };
}
const season = !!page.season && state.kind === 'active';
---
{season
  ? <HolidaySeasonPage page={page} def={entry.def} />
  : <HolidayPage page={page} def={entry.def} state={state} hasClosures={!!siteConfig.hasClosureWatch} />}

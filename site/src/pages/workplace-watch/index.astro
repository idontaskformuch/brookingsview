---
/** Worker Pulse / Workplace Watch -- gated on siteConfig.hasWorkplaceWatch
 *  (samma mönster som play.astro/facilities), en jämförelsetabell över
 *  review-trender hos ortens större arbetsgivare. Enabled för Moreno Valley
 *  (logistik-/lagerarbetsgivare) och Broomfield (publika bolags huvudkontor,
 *  se data/employers/broomfield_co.json) -- HeatAdvisoryWidget/ShiftPollWidget
 *  nedan hålls ändå Moreno-Valley-specifika, se den kommentaren för varför.
 *  Se lib/db.ts (getLatestEmployerRatings)
 *  och ai_pipeline/workplace_watch_digest.py för varifrån datat kommer -- ett
 *  stjärnbetyg visas bara om det uttryckligen hittades i sökträffarna, annars
 *  "rating pending" i stället för en gissning. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeatAdvisoryWidget from '../../components/HeatAdvisoryWidget.astro';
import ShiftPollWidget from '../../components/ShiftPollWidget.astro';
import WorkerPulseComments from '../../components/WorkerPulseComments.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ShareButton from '../../components/ShareButton.astro';
import {
  getLatestEmployerRatings, getWeather, getActiveAlerts,
  getShiftPollResults, getWorkerPulseComments,
} from '../../lib/db';
import { siteConfig } from '../../lib/site-config';
import SectionHero from '../../components/SectionHero.astro';
import { EMPTY_STATES } from '../../lib/empty-states';
import { SECTION_THEME } from '../../lib/section-theme';

if (!siteConfig.hasWorkplaceWatch) {
  return Astro.redirect('/', 302);
}

// HeatAdvisoryWidget/ShiftPollWidget both assume hourly, shift-based
// warehouse/logistics work (see their own docstrings) -- true for Moreno
// Valley's employer set (Amazon/Skechers/Ross/Deckers/ALDI fulfillment and
// distribution), but a poor fit for Broomfield's, which is three corporate
// headquarters (Vail Resorts/Ball/Noodles & Company -- see
// data/employers/broomfield_co.json's facility_type). "How was your shift
// today?" doesn't read right for office employees. Kept Moreno-Valley-only
// rather than either hiding the mismatch or inventing new office-worker
// framing unasked -- worth a deliberate design pass if Broomfield's page
// wants its own version of this.
const isMorenoValley = siteConfig.townId === 'moreno_valley_ca';

const [employers, weatherPeriods, alerts, pollResults, comments] = await Promise.all([
  getLatestEmployerRatings(),
  getWeather(),
  getActiveAlerts(),
  getShiftPollResults(),
  getWorkerPulseComments('workplace-watch'),
]);

const todayPeriod = weatherPeriods.find((p) => p.is_daytime) ?? weatherPeriods[0] ?? null;

// Hide the Trend column entirely until at least one employer has a real
// month-over-month comparison (house rule 4: don't render an empty
// feature). rating_delta_vs_last_month is null for an employer's first-ever
// tracked month -- with 5 employers each 1 month in as of 2026-08-23, every
// cell would currently read the same flat "—" for everyone, which looks
// like "nothing changed" (a real signal) rather than "no prior month to
// compare" (not a signal at all) -- see NEEDS-HUMAN-REVIEW.md "3.6 Worker
// Pulse". Once true, an employer still on its first tracked month shows
// "New" instead of a dash, so those two states never look identical.
const hasTrendHistory = employers.some((e) => e.rating_delta_vs_last_month !== null);

function trend(delta: number | null): { symbol: string; cls: string } {
  if (delta === null) return { symbol: 'New', cls: 'new' };
  if (delta > 0) return { symbol: '▲', cls: 'up' };
  if (delta < 0) return { symbol: '▼', cls: 'down' };
  return { symbol: '▬', cls: 'flat' };
}
---
<BaseLayout
  title={`Worker Pulse in ${siteConfig.cityName} — ${siteConfig.siteName}`}
  wide
  description={`Monthly review-trend digests for ${siteConfig.cityName}'s major employers — check before your shift.`}
  ogSlug="section-workplace-watch"
  accentColor={SECTION_THEME.workplace_watch.accent}
>
  <SectionHero category="workplace_watch" />
  <header class="wp-hero">
    <h1>📦 Worker Pulse</h1>
    <p class="tagline">
      A monthly, plain-language look at review trends for {siteConfig.cityName}'s
      major employers{employers.length > 0 ? ` — ${employers.map((e) => e.name).join(', ')}` : ''}.
      Themes are summarized from recent Glassdoor/Indeed search results,
      always attributed to what reviews say, never stated as settled fact.
    </p>
    <ShareButton title={`Worker Pulse in ${siteConfig.cityName} — ${siteConfig.siteName}`} />
  </header>

  <p class="wp-methodology">
    <strong>How this works:</strong> ratings and themes below are
    <strong>company-wide</strong> figures (as reported in public review-site
    search results), not specific to any one {siteConfig.cityName} facility —
    Glassdoor and Indeed have no public API and don't allow automated
    scraping, so nothing here comes from directly accessing either site.
    Instead, a search API is used to find what's publicly indexed about each
    employer, and an AI summarizes the recurring themes from those search
    result snippets — paraphrased, never a verbatim review quote. A missing
    star rating means one wasn't reliably found in the search results that
    month, not that the employer has no reviews.
  </p>

  {isMorenoValley && (
    <HeatAdvisoryWidget
      tempF={todayPeriod?.temp ?? null}
      activeAlertTitles={alerts.map((a) => a.title)}
    />
  )}
  {isMorenoValley && <ShiftPollWidget results={pollResults} />}

  {employers.length > 0 ? (
    <div class="wp-table" role="table">
      <div class={`wp-row wp-row--head ${!hasTrendHistory ? 'wp-row--no-trend' : ''}`} role="row">
        <span role="columnheader">Employer</span>
        <span role="columnheader">Rating</span>
        {hasTrendHistory && <span role="columnheader">Trend</span>}
        <span role="columnheader">This month</span>
      </div>
      {employers.map((e) => {
        const t = trend(e.rating_delta_vs_last_month);
        const label = e.period_label;
        return (
          <div class={`wp-row ${!hasTrendHistory ? 'wp-row--no-trend' : ''}`} role="row" style={`--accent: ${e.accent_color ?? '#4b5563'}`}>
            <span class="wp-name" role="cell">
              <span class="wp-dot" aria-hidden="true"></span>
              <span>
                {e.name}
                <small>{e.facility_type}</small>
              </span>
            </span>
            <span class="wp-rating" role="cell">
              {e.overall_rating !== null ? e.overall_rating.toFixed(1) : 'Rating pending'}
            </span>
            {hasTrendHistory && <span class={`wp-trend wp-trend--${t.cls}`} role="cell">{t.symbol}</span>}
            <span class="wp-summary" role="cell">
              {e.theme_summary ? (
                <>
                  <span class="excerpt">{e.theme_summary}</span>
                  {e.digest_slug && (
                    <a href={`/s/${e.digest_slug}/`}>Read the full {label} digest →</a>
                  )}
                </>
              ) : (
                <span class="excerpt muted">No digest published yet — check back next month.</span>
              )}
            </span>
          </div>
        );
      })}
    </div>
  ) : (
    <p class="empty">{EMPTY_STATES.workplaceWatch}</p>
  )}

  <WorkerPulseComments pageSlug="workplace-watch" comments={comments} />

  <RelatedContent pageType="workplace_watch" />
</BaseLayout>

<style>
.wp-hero {
  max-width: 46rem; margin: 0 auto 1.5rem; text-align: center;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.wp-hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
.tagline { color: var(--ink-soft); line-height: 1.6; }
.wp-methodology {
  max-width: 46rem; margin: 0 auto 1.75rem; padding: 0.75rem 1rem;
  border: 1px solid var(--rule); border-radius: 8px;
  font-size: 0.8125rem; line-height: 1.6; color: var(--ink-soft);
}

.wp-table {
  display: grid;
  max-width: 60rem;
  margin: 0 auto;
  border: 1px solid var(--rule);
  border-radius: 10px;
  overflow: hidden;
}
.wp-row {
  display: grid;
  grid-template-columns: 1.4fr 0.6fr 0.4fr 2.2fr;
  gap: 0.75rem;
  align-items: center;
  padding: 0.9rem 1rem;
  border-top: 1px solid var(--rule);
}
.wp-row--no-trend { grid-template-columns: 1.4fr 0.6fr 2.2fr; }
.wp-row:first-child { border-top: none; }
.wp-row--head {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-soft);
  background: var(--panel, rgba(127, 127, 127, 0.06));
}
.wp-name { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; }
.wp-dot {
  width: 0.65rem; height: 0.65rem; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
}
.wp-name small { display: block; font-weight: 400; color: var(--ink-soft); font-size: 0.75rem; }
.wp-rating { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--accent); }
.wp-trend { font-size: 1.1rem; }
.wp-trend--up { color: #1a9850; }
.wp-trend--down { color: #d73027; }
.wp-trend--flat { color: var(--ink-soft); }
.wp-trend--new { font-size: 0.75rem; color: var(--ink-soft); font-style: italic; }
.wp-summary { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
.excerpt { color: var(--ink-soft); }
.excerpt.muted { font-style: italic; }
.wp-summary a { font-weight: 600; font-size: 0.85rem; }

.empty { text-align: center; color: var(--ink-soft); }

@media (max-width: 640px) {
  .wp-row { grid-template-columns: 1fr; row-gap: 0.35rem; }
  .wp-row--head { display: none; }
  .wp-rating::before { content: 'Rating: '; font-weight: 400; color: var(--ink-soft); }
}
</style>

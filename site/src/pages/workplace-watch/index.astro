---
/** Worker Pulse / Workplace Watch -- gated on siteConfig.hasWorkplaceWatch
 *  (samma mönster som play.astro/facilities), en jämförelsetabell över
 *  review-trender hos ortens större arbetsgivare. Enabled för Moreno Valley
 *  (logistik-/lagerarbetsgivare) och Broomfield (publika bolags huvudkontor,
 *  se data/employers/broomfield_co.json) -- HeatAdvisoryWidget/ShiftPollWidget
 *  nedan hålls ändå Moreno-Valley-specifika, se den kommentaren för varför.
 *  Se lib/db.ts (getLatestEmployerRatings) och
 *  ai_pipeline/workplace_watch_digest.py för varifrån datat kommer.
 *
 *  2026-10-02: ratings, trends OCH theme_summary-texten är withheld tills
 *  vidare (pending Glassdoor/Indeed ToS-review) -- se wp-methodology-
 *  stycket nedan för läsarfacing-förklaringen, och [slug].astro:s egen
 *  WORKER_PULSE_WITHHELD_NOTE för samma sak på den enskilda digest-sidan.
 *  Endast hiring-kolumnen (Adzuna, en separat källa) visas fortfarande. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeatAdvisoryWidget from '../../components/HeatAdvisoryWidget.astro';
import ShiftPollWidget from '../../components/ShiftPollWidget.astro';
import WorkerPulseComments from '../../components/WorkerPulseComments.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ShareButton from '../../components/ShareButton.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getLatestEmployerRatings, getEmployerJobStats, getWeather, getActiveAlerts,
  getShiftPollResults, getWorkerPulseComments,
} from '../../lib/db';
import { siteConfig } from '../../lib/site-config';
import { resolvePageMeta } from '../../lib/page-meta';
import SectionHero from '../../components/SectionHero.astro';
import { EMPTY_STATES } from '../../lib/empty-states';
import { SECTION_THEME } from '../../lib/section-theme';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { resolveHubNavItems } from '../../lib/clusters';
import ClusterNav from '../../components/ClusterNav.astro';
import { storyHref } from '../../lib/content-slugs';

if (!siteConfig.hasWorkplaceWatch) {
  return Astro.redirect('/', 302);
}

const pageMeta = resolvePageMeta('workplace-watch', siteConfig);
const clusterNavItems = resolveHubNavItems('workplace-watch', siteConfig);
const canonicalUrl = new URL('/workplace-watch/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Worker Pulse', href: canonicalUrl },
];

// HeatAdvisoryWidget/ShiftPollWidget both assume hourly, shift-based
// warehouse/logistics work (see their own docstrings) -- true for Moreno
// Valley's employer set (Amazon/Skechers/Ross/Deckers/ALDI fulfillment and
// distribution), but a poor fit for Broomfield's, which is three corporate
// headquarters (Vail Resorts/Ball/Noodles & Company -- see
// data/employers/broomfield_co.json's facility_type). "How was your shift
// today?" doesn't read right for office employees. Kept Moreno-Valley-only
// rather than either hiding the mismatch or inventing new office-worker
// framing unasked -- worth a deliberate design pass if Broomfield's page
// wants its own version of this.
const isMorenoValley = siteConfig.townId === 'moreno_valley_ca';

const [employers, jobStatsList, weatherPeriods, alerts, pollResults, comments] = await Promise.all([
  getLatestEmployerRatings(),
  getEmployerJobStats(),
  getWeather(),
  getActiveAlerts(),
  getShiftPollResults(),
  getWorkerPulseComments('workplace-watch'),
]);
// keyed by slug for an O(1) lookup per row below -- employer_job_stats is a
// SEPARATE query/table from employer_ratings (see lib/db.ts), joined here in
// JS rather than in SQL since the two features ship independently and
// either can be empty while the other has data.
const jobStatsBySlug = new Map(jobStatsList.map((s) => [s.slug, s]));

const todayPeriod = weatherPeriods.find((p) => p.is_daytime) ?? weatherPeriods[0] ?? null;

// 2026-10-01: the Rating and Trend columns (and trend()'s own helper) are
// removed here, pending a review of Glassdoor's and Indeed's Terms of Use
// on republishing their content -- both contain broad "personal,
// non-commercial use only" / "no reproduction or derivative works without
// permission" language that a search-API-sourced, AI-paraphrased rating
// may not clear, independent of how it's hedged. See
// WorkplaceWatchWidget.astro's own comment (the homepage card lost the
// same two fields) and ai_pipeline/workplace_watch_digest.py's
// extract_rating() for the separate, additional accuracy question (a bare
// regex over up to 20 concatenated search snippets, no verification the
// matched number is even about the right company). The theme_summary
// paragraph below is left in place -- it's prose, not a rating or a
// ranking, and carries its own hedging/attribution guardrails
// (guardrails.validate_employer_hedging()) -- revisit this scope if asked
// to hide more.

// Fas 4a: same house rule (don't render an empty
// feature) -- hidden entirely until the monthly digest has run at least
// once since this shipped, not shown as an all-zero/all-dash column that
// would read as "measured, nothing happening" instead of "not measured yet".
const hasJobStats = jobStatsList.some((s) => s.postings_now !== null);
---
<BaseLayout
  title={pageMeta.title}
  wide
  description={`Monthly review-trend digests for ${siteConfig.cityName}'s major employers — check before your shift.`}
  ogSlug="section-workplace-watch"
  accentColor={SECTION_THEME.workplace_watch.accent}
>
  <Breadcrumbs trail={breadcrumbTrail} />
  <SectionHero category="workplace_watch" />
  <header class="wp-hero">
    <h1>{pageMeta.h1}</h1>
    <p class="tagline">
      A monthly look at hiring activity for {siteConfig.cityName}'s
      major employers{employers.length > 0 ? ` — ${employers.map((e) => e.name).join(', ')}` : ''}.
      Review-theme summaries and star ratings are temporarily withheld (see below).
    </p>
    <ShareButton title={pageMeta.title} />
  </header>

  <p class="wp-methodology">
    <strong>How this works:</strong> this page used to summarize recurring
    themes from public Glassdoor/Indeed search-result snippets (never a
    verbatim quote, always attributed to what reviews say). Both the
    <strong>review-theme summaries and star ratings/rankings are temporarily
    withheld</strong> while we review Glassdoor's and Indeed's own terms of
    use on republishing their content -- the search-result text itself
    routinely restates a specific numeric rating, so hiding the rating
    column alone wasn't enough. Hiring data below (sourced from Adzuna, a
    separate, unrelated source) is unaffected.
  </p>
  {hasJobStats && (
    <p class="wp-methodology">
      <strong>Hiring column:</strong> a count of job postings for that employer
      observed via the Adzuna job board in the last 30 days — not a real-time
      "openings now" figure, and never a hiring, headcount, or growth claim.
      Some employers show 0: that's a real absence of Adzuna listings for
      that company today, not a missing measurement.
    </p>
  )}

  {isMorenoValley && (
    <HeatAdvisoryWidget
      tempF={todayPeriod?.temp ?? null}
      activeAlertTitles={alerts.map((a) => a.title)}
    />
  )}
  {isMorenoValley && <ShiftPollWidget results={pollResults} />}

  {employers.length > 0 ? (
    <div class="wp-table" role="table">
      <div class:list={['wp-row', 'wp-row--head', { 'wp-row--no-hiring': !hasJobStats }]} role="row">
        <span role="columnheader">Employer</span>
        {hasJobStats && <span role="columnheader">Hiring <abbr title="Job postings observed via Adzuna, last 30 days">ⓘ</abbr></span>}
        <span role="columnheader">This month</span>
      </div>
      {employers.map((e) => {
        const jobStats = jobStatsBySlug.get(e.slug);
        return (
          <div class:list={['wp-row', { 'wp-row--no-hiring': !hasJobStats }]} role="row" style={`--accent: ${e.accent_color ?? '#4b5563'}`}>
            <span class="wp-name" role="cell">
              <span class="wp-dot" aria-hidden="true"></span>
              <span>
                {e.name}
                <small>{e.facility_type}</small>
              </span>
            </span>
            {hasJobStats && (
              <span class="wp-hiring" role="cell">
                {jobStats?.postings_now !== null && jobStats?.postings_now !== undefined ? (
                  <>
                    {jobStats.postings_now} listing{jobStats.postings_now === 1 ? '' : 's'}
                    {jobStats.postings_change !== null && jobStats.postings_change !== undefined && (
                      <small class={jobStats.postings_change > 0 ? 'up' : jobStats.postings_change < 0 ? 'down' : ''}>
                        {' '}({jobStats.postings_change > 0 ? '+' : ''}{jobStats.postings_change} vs last month)
                      </small>
                    )}
                  </>
                ) : (
                  <span class="excerpt muted">Not yet measured</span>
                )}
              </span>
            )}
            <span class="wp-summary" role="cell">
              {e.theme_summary ? (
                <>
                  {/* 2026-10-02: the raw theme_summary excerpt is withheld here
                      too, not just the structured rating/trend columns -- it
                      routinely states the exact same numbers in prose ("rate
                      the company 2.9 out of 5 stars on Glassdoor"), found by
                      grepping the real built output. See lib/content-redaction.ts
                      for the full reasoning and the longer version of this
                      note used on the digest's own /s/ page; this is the
                      short, table-cell-sized version, not imported from
                      there since a dense comparison table needs a shorter
                      line than a full page does. period_label is kept visible
                      (it's just a month name, not a rating) so the "This
                      month" column header still has real content under it. */}
                  <small class="data">{e.period_label}</small>
                  <span class="excerpt muted">Review-theme summary withheld pending a sourcing review.</span>
                  {e.digest_slug && (
                    <a href={storyHref(e.digest_slug)}>Read more →</a>
                  )}
                </>
              ) : (
                <span class="excerpt muted">No digest published yet — check back next month.</span>
              )}
            </span>
          </div>
        );
      })}
    </div>
  ) : (
    <p class="empty">{EMPTY_STATES.workplaceWatch}</p>
  )}

  <WorkerPulseComments pageSlug="workplace-watch" comments={comments} />

  <ClusterNav clusterLabel="Work and money" items={clusterNavItems} />

  <RelatedContent pageType="workplace_watch" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.wp-hero {
  max-width: 46rem; margin: 0 auto 1.5rem; text-align: center;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.wp-hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
.tagline { color: var(--ink-soft); line-height: 1.6; }
.wp-methodology {
  max-width: 46rem; margin: 0 auto 1.75rem; padding: 0.75rem 1rem;
  border: 1px solid var(--rule); border-radius: 8px;
  font-size: 0.8125rem; line-height: 1.6; color: var(--ink-soft);
}

.wp-table {
  display: grid;
  max-width: 60rem;
  margin: 0 auto;
  border: 1px solid var(--rule);
  border-radius: 10px;
  overflow: hidden;
}
.wp-row {
  display: grid;
  /* 2026-10-01: was "1.4fr 0.6fr 0.4fr 0.7fr 2.2fr" (name/rating/trend/
     hiring/summary) -- rating and trend columns removed, see this file's
     own comment above hasJobStats. */
  grid-template-columns: 1.4fr 0.7fr 2.2fr;
  gap: 0.75rem;
  align-items: center;
  padding: 0.9rem 1rem;
  border-top: 1px solid var(--rule);
}
.wp-row--no-hiring { grid-template-columns: 1.4fr 2.2fr; }
.wp-row:first-child { border-top: none; }
.wp-row--head {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-soft);
  background: var(--panel, rgba(127, 127, 127, 0.06));
}
.wp-name { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; }
.wp-dot {
  width: 0.65rem; height: 0.65rem; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
}
.wp-name small { display: block; font-weight: 400; color: var(--ink-soft); font-size: 0.75rem; }
.wp-hiring { font-size: 0.85rem; font-variant-numeric: tabular-nums; }
.wp-hiring small { display: block; color: var(--ink-soft); font-size: 0.72rem; }
.wp-hiring small.up { color: var(--status-good); }
.wp-hiring small.down { color: var(--status-bad); }
.wp-summary { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; }
.excerpt { color: var(--ink-soft); }
.excerpt.muted { font-style: italic; }
.wp-summary a { font-weight: 600; font-size: 0.85rem; }

.empty { text-align: center; color: var(--ink-soft); }

@media (max-width: 640px) {
  .wp-row { grid-template-columns: 1fr; row-gap: 0.35rem; }
  .wp-row--head { display: none; }
  .wp-hiring::before { content: 'Hiring: '; font-weight: 400; color: var(--ink-soft); }
}
</style>

}
.rail__link { flex: 1 1 14rem; }
.rail__prices { flex-basis: 16rem; }
.rail__hint { flex-basis: 100%; }
.rail__link {
  display: block;
  color: inherit;
  text-decoration: none;
  border-radius: 3px;
  transition: background-color 0.12s ease;
}

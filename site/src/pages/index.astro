---
/**
 * The front page as a hub (Fas 2, owner 2026-11-19; specs/full-pages-no-ai-prose.md "Ny Fas 2"). The pattern of established local sites:
 *   status line (alert · next game · next meeting; the weather is the band right above it)
 *   lead (the town's photo, kicker, headline, 1-2 data lines) + 3-4 secondaries with 3:2 thumbnails
 *   section blocks (SectionBlock: cards or list, 3-4 items, "See all"), their order per town in config/home-sections.ts:
 *     `upper` full width, `beside` next to the rail (RailLayout, from 62rem), `lower` full width.
 * A block without data is not shown. Every card has an image (own -> venue -> category pool), and no two visible images are the same.
 * Only the lead photo loads with priority. Data and template strings only; no model text. Mobile: the same order in one column.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FrontPageLead from '../components/FrontPageLead.astro';
import SchoolAlertBanner from '../components/SchoolAlertBanner.astro';
import ResultsBanner from '../components/ResultsBanner.astro';
import { ELECTION_BY_TOWN } from '../config/election';
import SafetyNotices from '../components/SafetyNotices.astro';
import TopEventCard from '../components/TopEventCard.astro';
import { selectTopEvent } from '../lib/top-event';
import OrientationHeader from '../components/OrientationHeader.astro';
import RailLayout from '../components/RailLayout.astro';
import RailModules from '../components/rail/RailModules.astro';
import SectionBlock from '../components/ui/SectionBlock.astro';
import { railMeetings } from '../lib/rail';
import {
  getUpcomingStories, getActiveAlerts, getSeasonGames, getActiveSchoolAlerts, getUpcomingArtsEvents, getRecentProjectUpdates,
  PROJECT_PENDING_OUTCOME_LABEL, getFacilities, getRegionalSports, getActiveTrafficIncidents, type RegionalGame, type TrafficIncident,
} from '../lib/db';
import { selectFrontPage, type FrontPageBigEvent, type FrontPageItem } from '../lib/front-page';
import { FRONT_PAGE_BY_TOWN } from '../config/front-page';
import { frontPageAlerts } from '../lib/front-page-alerts';
import { frontPageHolidays } from '../lib/front-page-holidays';
import { loadEveningForFrontPage } from '../lib/front-page-load';
import { localDayNumber } from '../lib/local-day';
import { todayUtcMidnight, buildEventFeed, dayIndex, weekendAnchorOffset, itemLink } from '../lib/events';
import { buildTownEventsView } from '../lib/events-town-view';
import { homeBlocks, type DayRow } from '../lib/event-day-view';
import { loadUpcomingMeetings } from '../lib/meetings-data';
import { siteConfig } from '../lib/site-config';
import { isSectionBuilt, linksToBuiltSection } from '../lib/sections';
import { isWordCut, metaDescription } from '../lib/meta-description';
import { placeAbbr, countryProfile } from '../lib/country-profile';
import { resolveThisWeekImage } from '../lib/db';
import { weekInfoForInstant } from '../lib/this-week';
import { seasonForMonth } from '../lib/this-week-images';
import { thisWeekImagesFor } from '../config/this-week-images';
import { holidayBandImage, cityImageSlot, responsiveSrc, CITY_PHOTO_SIZES } from '../lib/city-face';
import { holidayPageDef } from '../config/holiday-pages/calendar';
import { townHasHolidayPages } from '../config/holiday-pages/registry';
import { answerPagesFor } from '../config/city-answers';
import { resolveImage, type ImageCategory } from '../lib/images';
import { categoryImagesFor } from '../config/category-images';
import { getTicketmasterEventsForTown, IN_TOWN_THRESHOLD_MILES } from '../lib/ticketmaster';
import { rankTicketmasterEvents, collapseMarqueeRuns, ticketmasterResolvableImage, ticketmasterHref } from '../lib/whats-on';
import { homeSectionsFor, type HomeBlockId } from '../config/home-sections';
import { pickFromPools, dateBox, distinctBy, sportsItems, cityHallItems, gettingAroundItems, type BlockItem, type BlockImage } from '../lib/home-blocks';
import type { RailModuleKind } from '../config/home-rail';
import { ymd } from '../lib/sports-season';

const tz = siteConfig.timezone;
const profile = countryProfile(siteConfig.country);
const locale = profile.locale as 'en-US' | 'en-GB';
const sections = homeSectionsFor(siteConfig.townId);
const wants = new Set<HomeBlockId>([...sections.upper, ...sections.beside, ...sections.lower]);
const sportsBuilt = isSectionBuilt('jackrabbits', siteConfig) || isSectionBuilt('sports', siteConfig);

const [alerts, schoolAlerts, seasonGames, facilities, quickLinkEvents, quickLinkArtsEvents, regional, traffic] = await Promise.all([
  getActiveAlerts(),
  getActiveSchoolAlerts(),
  isSectionBuilt('jackrabbits', siteConfig) ? getSeasonGames() : Promise.resolve([]),
  getFacilities(),
  // The same fetch shape as /events/, so a count here and a count there agree.
  getUpcomingStories(['event'], 120),
  getUpcomingArtsEvents(40),
  isSectionBuilt('sports', siteConfig) ? getRegionalSports() : Promise.resolve([] as RegionalGame[]),
  wants.has('getting_around') && isSectionBuilt('traffic', siteConfig) ? getActiveTrafficIncidents() : Promise.resolve([] as TrafficIncident[]),
]);

// FRONT_PAGE_NOW (an ISO instant) is only for checking the layout on a chosen day in a local build; CI never sets it.
const now = process.env.FRONT_PAGE_NOW ? new Date(process.env.FRONT_PAGE_NOW) : new Date();
const todayYmd = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
const quickLinkDate = todayUtcMidnight(tz);
const frontPageEvents = buildEventFeed(quickLinkEvents, quickLinkArtsEvents, tz).items;
const meetingsData = await loadUpcomingMeetings();

// Ticketmaster near the town (the What's On marquee rank). The front page promises "here": 25 miles.
const HOMEPAGE_MARQUEE_RADIUS_MILES = 25;
const nearbyWhatsOnItems = (siteConfig.hasWhatsOn ? await getTicketmasterEventsForTown(siteConfig) : [])
  .filter((item) => { const miles = item.ticketmasterEvent.venueDistanceMiles; return miles == null || miles <= HOMEPAGE_MARQUEE_RADIUS_MILES; });
const whatsOnEntries = collapseMarqueeRuns(rankTicketmasterEvents(nearbyWhatsOnItems, siteConfig.townId));
const pools = categoryImagesFor(siteConfig.townId);
const imageOpts = { town: siteConfig.townId, cityName: siteConfig.cityName, facilities, categoryImages: pools };

// Big in-town events for the lead rule (lib/front-page.ts): a configured top event (Hobo Day) and in-town marquee shows.
const topEvent = siteConfig.topEvents ? selectTopEvent(await getUpcomingStories(['event'], 200), siteConfig.topEvents, now, tz) : null;
const bigEvents: FrontPageBigEvent[] = [
  ...(topEvent?.occurs_at ? [{ title: topEvent.title.split(': ').pop()!, startsAt: new Date(topEvent.occurs_at).toISOString(), url: itemLink({ sourceKind: 'story', occurs_at: topEvent.occurs_at, story: topEvent }) ?? '/events/', venue: null }] : []),
  // Only the marquee itself (the top-ranked show near the town), and only when it is in town: not every in-town show is big.
  ...whatsOnEntries.slice(0, 1).filter((e) => e.primary.occurs_at && e.primary.ticketmasterEvent.venueDistanceMiles != null && e.primary.ticketmasterEvent.venueDistanceMiles < IN_TOWN_THRESHOLD_MILES)
    .map((e) => ({ title: e.primary.ticketmasterEvent.title, startsAt: e.primary.occurs_at!, url: ticketmasterHref(e.primary.ticketmasterEvent) ?? '/whats-on/', venue: e.primary.ticketmasterEvent.venueName })),
];

const frontPage = selectFrontPage({
  cityName: siteConfig.cityName,
  timezone: tz,
  locale,
  config: FRONT_PAGE_BY_TOWN[siteConfig.townId],
  alerts: frontPageAlerts(alerts),
  holidays: frontPageHolidays(siteConfig.townId, new Date(localDayNumber(now, tz) * 86_400_000).getUTCFullYear()),
  evening: await loadEveningForFrontPage(frontPageEvents, facilities, now),
  // Home games of the town's own program; the config decides which sport is "big" (Brookings: football).
  games: seasonGames.filter((g) => g.starts_at && g.home_away === 'home' && (g.phase === 'upcoming' || g.phase === 'inProgress')).map((g) => ({
    team: 'Jackrabbits', opponent: g.opponent, startsAt: g.starts_at!, home: true, url: '/jackrabbits/', sport: g.sport,
  })),
  meetings: meetingsData?.meetings ?? [],
  bigEvents,
}, now);

// The town's photo of the week (Fas 1a): the lead's surface; on an alert day the first secondary's thumbnail or nowhere (cityImageSlot).
const photoWeek = weekInfoForInstant(now, tz);
const photoPool = thisWeekImagesFor(siteConfig.townId);
const cityImage = siteConfig.noindexSite && photoPool.length === 0
  ? null
  : await resolveThisWeekImage(photoWeek.slug, seasonForMonth(photoWeek.monday.m), photoPool, photoWeek.monday, photoWeek.sunday);
const photoSlot = cityImage ? cityImageSlot(frontPage) : null;
const leadPhoto = photoSlot === 'lead' && cityImage ? responsiveSrc(cityImage.path) : null;
const todayParts = new Date(localDayNumber(now, tz) * 86_400_000);
const todayDate = { y: todayParts.getUTCFullYear(), m: todayParts.getUTCMonth() + 1, d: todayParts.getUTCDate() };

// Images already on the page: a later pick avoids them (no two identical images visible at once).
const used = new Set<string>(cityImage ? [cityImage.path] : []);
const asBlock = (img: { path: string; alt: string; width: number; height: number } | null): BlockImage | null =>
  img ? { path: img.path, alt: img.alt, width: img.width, height: img.height } : null;
// The category's own pool first, then the town's season photos (town and nature, fit any subject), then its other category pools; null
// rather than a repeat.
const FALLBACK_ORDER: ImageCategory[] = ['events', 'city_hall', 'university', 'sports', 'weather_alert', 'traffic', 'jobs', 'home_sales', 'workplace_watch', 'school_alerts'];
const seasonPool = photoPool.map((p) => ({ path: p.path, alt: p.alt, width: p.width, height: p.height }));
const categoryImage = (cat: ImageCategory, seed: string): BlockImage | null =>
  asBlock(pickFromPools([pools[cat], seasonPool, ...FALLBACK_ORDER.filter((c) => c !== cat).map((c) => pools[c])], `${seed}-${photoWeek.slug}`, used));

// Secondary thumbnails: the holiday page's own band photo; the week's photo on an alert day; else a category photo.
const SECONDARY_CATEGORY: Record<FrontPageItem['type'], ImageCategory> = {
  alert: 'weather_alert', holiday: 'city_hall', game_day: 'sports', big_event: 'events', tonight: 'events', weekend: 'events', meeting: 'city_hall', guide: 'city_hall',
};
const guideCategory = (url: string): ImageCategory => (url.startsWith('/traffic') ? 'traffic' : url.startsWith('/events') ? 'events' : 'city_hall');
const thumbs: (BlockImage | null)[] = frontPage.secondaries.map((s, idx) => {
  if (photoSlot === 'secondary' && idx === 0 && cityImage) return asBlock(cityImage);
  if (s.type === 'holiday' && s.pageSlug) {
    const def = holidayPageDef(s.pageSlug);
    const band = def ? holidayBandImage(siteConfig.townId, def.holidayId, todayDate, photoWeek.slug, cityImage?.id ?? null) : null;
    if (band && !used.has(band.path)) { used.add(band.path); return asBlock(band); }
  }
  return categoryImage(s.type === 'guide' ? guideCategory(s.url) : SECONDARY_CATEGORY[s.type], `secondary-${s.url}`);
});

const featuredMeetingIds = new Set([frontPage.lead, ...frontPage.secondaries].flatMap((it) => (/^\/city-hall\/#meeting-(.+)$/.exec(it.url)?.[1] ?? [])));
const featuredHolidaySlugs = new Set([frontPage.lead, ...frontPage.secondaries].flatMap((it) => (it.type === 'holiday' && it.pageSlug ? [it.pageSlug] : [])));

// ---- Tonight & this weekend (cards): today's events and the coming weekend's, own events and Ticketmaster shows near the town.
const townEvents = buildTownEventsView(quickLinkEvents, quickLinkArtsEvents, facilities);
const weekendAnchor = weekendAnchorOffset(quickLinkDate);
const evBlocks = homeBlocks(townEvents.view, weekendAnchor);
const inWindow = (iso: string) => { const d = dayIndex(iso, quickLinkDate, tz); return d === 0 || (d !== null && d >= weekendAnchor && d <= weekendAnchor + 2); };
const notOver = (iso: string) => new Date(iso).getTime() > now.getTime() - 60 * 60_000;
type Cand = { start: string; title: string; build: () => BlockItem };
const fmtWhen = (iso: string) => `${new Date(iso).toLocaleDateString(locale, { weekday: 'short', timeZone: tz })} · ${new Date(iso).toLocaleTimeString(locale, { hour: 'numeric', minute: '2-digit', timeZone: tz })}`;
const rowCands: Cand[] = [...evBlocks.today, ...evBlocks.weekend].flatMap((d) => d.rows).filter((r: DayRow) => notOver(r.end ?? r.start)).map((r: DayRow) => ({
  start: r.start, title: r.title,
  build: () => {
    const found = r.item.sourceKind === 'story' ? resolveImage(r.item.story, { ...imageOpts, usedImagePaths: used }) : null;
    const own = found && !used.has(found.path) ? found : null; // never a photo already on the page
    if (own) used.add(own.path);
    return { href: itemLink(r.item) ?? '/events/', title: r.title, kicker: r.allDay ? r.dateLabel : fmtWhen(r.start), meta: r.venue ?? undefined, image: asBlock(own) ?? categoryImage(r.item.sourceKind === 'arts' ? 'university' : 'events', r.title) };
  },
}));
const tmCands: Cand[] = whatsOnEntries.filter((e) => e.primary.occurs_at && inWindow(e.primary.occurs_at) && notOver(e.primary.occurs_at)).map((e) => ({
  start: e.primary.occurs_at!, title: e.primary.ticketmasterEvent.title,
  build: () => {
    const found = resolveImage(ticketmasterResolvableImage(e.primary), { ...imageOpts, usedImagePaths: used });
    const img = found && !used.has(found.path) ? found : null;
    if (img) used.add(img.path);
    return { href: ticketmasterHref(e.primary.ticketmasterEvent) ?? '/whats-on/', title: e.primary.ticketmasterEvent.title, kicker: fmtWhen(e.primary.occurs_at!), meta: e.primary.ticketmasterEvent.venueName ?? undefined, image: asBlock(img) ?? categoryImage('events', e.primary.ticketmasterEvent.title) };
  },
}));
// The lead's own event is not repeated as a card.
const leadTitle = frontPage.lead.headline.trim().toLowerCase();
const tonightItems: BlockItem[] = wants.has('tonight_weekend')
  ? distinctBy([...rowCands, ...tmCands].filter((c) => c.title.trim().toLowerCase() !== leadTitle).sort((a, b) => a.start.localeCompare(b.start)), (c) => c.title, 4).map((c) => c.build())
  : [];
const tonightSeeAll = siteConfig.nav.tabs.includes('tonight') ? '/tonight/' : '/events/';

// ---- Sports (list)
const sportsBlock: BlockItem[] = wants.has('sports') && sportsBuilt
  ? sportsItems({ games: seasonGames, regional, todayYmd, tz, locale, teamName: siteConfig.cityName, drawLetter: profile.spelling === 'british' ? 'D' : 'T' })
  : [];

// ---- City Hall (list): the next three meetings and the latest decision.
const recentProjectUpdates = wants.has('cityhall') ? await getRecentProjectUpdates(1) : [];
const rm = meetingsData ? railMeetings(meetingsData.meetings, meetingsData.todayYmd, featuredMeetingIds) : null;
const decision = recentProjectUpdates[0];
const cityHallBlock: BlockItem[] = wants.has('cityhall') && meetingsData
  ? cityHallItems({
      meetings: [...(rm?.next ? [rm.next] : []), ...(rm?.more ?? [])], todayYmd: meetingsData.todayYmd, locale,
      decision: decision ? {
        href: `/city-hall/projects/${decision.project_slug}/`, title: decision.project_title, ymd: ymd(decision.meeting_date as string | Date),
        meta: `${decision.body}: ${decision.outcome_override ?? (decision.outcome === 'pending' ? PROJECT_PENDING_OUTCOME_LABEL : decision.outcome.toLowerCase())}`,
      } : null,
    })
  : [];

// ---- Getting around (list): traffic incidents and road closures. School closures have their own banner at the top.
const gettingAroundBlock: BlockItem[] = wants.has('getting_around') ? gettingAroundItems({ traffic, schoolClosures: [], tz, locale }) : [];

// ---- Guides (cards): the town's evergreen pages that are built.
const answerSlugs = new Set(answerPagesFor(siteConfig.townId).map((p) => `/${p.slug}/`));
const guideBuilt = (href: string) => (href === '/holidays/' ? townHasHolidayPages(siteConfig.townId) : answerSlugs.has(href) || linksToBuiltSection(href, siteConfig));
const guidesBlock: BlockItem[] = wants.has('guides')
  ? sections.guides.filter((g) => guideBuilt(g.href)).map((g) => ({ href: g.href, title: g.title, meta: g.meta, image: categoryImage(g.image, `guide-${g.href}`) }))
  : [];

// ---- Places (cards): facilities with an approved photo of their own.
const placesBlock: BlockItem[] = wants.has('places')
  ? facilities.filter((f) => f.image_path && !f.image_needs_review).map((f) => ({ href: `/facilities/${f.slug}/`, title: f.name, meta: f.address ?? undefined, image: { path: f.image_path!, alt: f.image_alt ?? f.name, width: 1200, height: 800 } }))
  : [];

const BLOCKS: Record<HomeBlockId, { kicker?: string; title: string; seeAllHref?: string; seeAllLabel?: string; variant: 'cards' | 'list'; items: BlockItem[] }> = {
  tonight_weekend: { kicker: 'Out and about', title: 'Tonight & this weekend', seeAllHref: tonightSeeAll, variant: 'cards', items: tonightItems },
  sports: { kicker: 'Sports', title: 'Next games and results', seeAllHref: isSectionBuilt('jackrabbits', siteConfig) ? '/jackrabbits/' : '/sports/', variant: 'list', items: sportsBlock },
  cityhall: { kicker: 'City Hall', title: 'Meetings and decisions', seeAllHref: '/city-hall/', seeAllLabel: 'All meetings', variant: 'list', items: cityHallBlock },
  guides: { kicker: 'Guides', title: `Living in ${siteConfig.cityName}`, variant: 'cards', items: guidesBlock },
  places: { kicker: 'Places', title: 'Places to go', seeAllHref: '/facilities/', variant: 'cards', items: placesBlock },
  getting_around: { kicker: 'Getting around', title: 'Traffic and road closures', seeAllHref: '/traffic/', variant: 'list', items: gettingAroundBlock },
};
// A block is shown with 3+ cards, or 1+ list rows (SectionBlock `min`); the rail leaves out what a shown block already covers.
const shown = (id: HomeBlockId) => BLOCKS[id].items.length >= (BLOCKS[id].variant === 'cards' ? 3 : 1);
const railOmit: RailModuleKind[] = [
  ...(shown('cityhall') ? (['meeting', 'meetings_more'] as const) : []),
  ...(shown('sports') ? (['sport'] as const) : []),
  ...(shown('getting_around') ? (['traffic'] as const) : []),
];

// ---- Status line: an active alert, the next game, the next meeting (the weather is the band right above it, site-wide).
const nextGame = seasonGames.find((g) => g.starts_at && (g.phase === 'upcoming' || g.phase === 'inProgress'));
const regionalDay = (g: RegionalGame) => (g.game_date ? ymd(g.game_date as string | Date) : '');
const nextRegional = regional.filter((g) => g.relevance_tier === 'primary' && g.status !== 'final' && regionalDay(g) >= todayYmd)
  .sort((a, b) => regionalDay(a).localeCompare(regionalDay(b)))[0];
const nextMeeting = meetingsData ? railMeetings(meetingsData.meetings, meetingsData.todayYmd).next : null;
const regionalWhen = (g: RegionalGame) => { const b = dateBox(`${regionalDay(g)}T12:00:00Z`, 'UTC', locale); return `${b.top} ${b.day}`; };
const statusItems: { label: string; text: string; href: string }[] = [
  ...(alerts[0] ? [{ label: 'Alert', text: alerts[0].title, href: '/weather/' }] : []),
  ...(nextGame ? [{ label: 'Next game', text: `${nextGame.home_away === 'away' ? 'at' : 'vs'} ${nextGame.opponent}, ${fmtWhen(nextGame.starts_at!)}`, href: '/jackrabbits/' }]
    : nextRegional ? [{ label: 'Next game', text: `${nextRegional.team_name} ${nextRegional.home_away === 'home' ? 'vs' : 'at'} ${nextRegional.opponent_name}, ${regionalWhen(nextRegional)}`, href: '/sports/' }] : []),
  ...(nextMeeting ? [{ label: 'Next meeting', text: `${nextMeeting.bodyLabel}, ${nextMeeting.dateLabel}${nextMeeting.time ? ` ${nextMeeting.time}` : ''}`, href: `/city-hall/#meeting-${nextMeeting.id}` }] : []),
];
---

<BaseLayout title={`${siteConfig.siteName} — what's happening in ${placeAbbr(siteConfig)}`} wide description={isWordCut(frontPage.meta_description) ? metaDescription('home', siteConfig) : frontPage.meta_description}>
  {leadPhoto && (
    <link slot="head" rel="preload" as="image" href={leadPhoto.src} imagesrcset={leadPhoto.srcset} imagesizes={leadPhoto.srcset ? CITY_PHOTO_SIZES.lead : undefined} fetchpriority="high" />
  )}
  <OrientationHeader now={now} />
  {statusItems.length > 0 && (
    <ul class="statusline" aria-label="At a glance">
      {statusItems.map((s) => <li><span class="statusline__label">{s.label}</span> <a href={s.href}>{s.text}</a></li>)}
    </ul>
  )}
  {ELECTION_BY_TOWN[siteConfig.townId] && <ResultsBanner />}
  {siteConfig.safetyNotices && <SafetyNotices townId={siteConfig.townId} timezone={tz} variant="compact" onlyWhenActive />}
  <SchoolAlertBanner alerts={schoolAlerts} />

  <FrontPageLead page={frontPage} cityImage={cityImage} thumbs={thumbs} />

  {topEvent && frontPage.lead.type !== 'big_event' && <TopEventCard story={topEvent} timezone={tz} />}

  {sections.upper.map((id) => <SectionBlock id={id} {...BLOCKS[id]} />)}

  <RailLayout>
    {sections.beside.map((id) => <SectionBlock id={id} {...BLOCKS[id]} />)}
    <RailModules slot="rail" now={now} withStatus omit={railOmit} excludeMeetingIds={featuredMeetingIds} excludeHolidaySlugs={featuredHolidaySlugs} frontImageId={cityImage?.id ?? null} meetingsData={meetingsData} />
  </RailLayout>

  {sections.lower.map((id) => <SectionBlock id={id} {...BLOCKS[id]} />)}

  {/* SEO Fas 4 -- WebSite, homepage-only (NewsMediaOrganization already renders site-wide via BaseLayout.astro). No SearchAction: the site
      has no internal search. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  })} />
</BaseLayout>

<style>
.statusline {
  list-style: none; margin: 0 0 1rem; padding: 0.5rem 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem;
  border-bottom: 1px solid var(--rule); font-family: var(--font-ui); font-size: 0.8125rem; font-variant-numeric: tabular-nums;
}
.statusline li { min-height: 24px; display: inline-flex; align-items: baseline; gap: 0.375rem; }
.statusline__label { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
.statusline a { color: var(--ink); }
</style>

---
/**
 * Förstasidan, byggd som en tidningsförstasida.
 *
 * Strukturen är TID, inte ämne: I dag -> Den här veckan -> Framöver. Frågan
 * sajten svarar på ("what's happening in Brookings?") handlar om när, inte om
 * vad -- de flesta lokalsajter sorterar efter kategori och blir svårare att
 * skanna för det.
 *
 * Hierarkin är avsiktlig: en etta som dominerar, ett högerfält med siffror
 * (väder, nästa match, råvarupriser -- tidningens väderruta och börstabell),
 * och därunder en spaltström avdelad med hårfina linjer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import FrontPageLead from '../components/FrontPageLead.astro';
import GameCard from '../components/GameCard.astro';
import RegionalGameCard from '../components/RegionalGameCard.astro';
import SdsuEventCard from '../components/SdsuEventCard.astro';
import JackrabbitWidget from '../components/JackrabbitWidget.astro';
import JackrabbitGameDayLine from '../components/JackrabbitGameDayLine.astro';
import WorkplaceWatchWidget from '../components/WorkplaceWatchWidget.astro';
import BurroBonanzaWidget from '../components/BurroBonanzaWidget.astro';
import SchoolAlertBanner from '../components/SchoolAlertBanner.astro';
import TrafficWidget from '../components/TrafficWidget.astro';
import Tile from '../components/Tile.astro';
import CityStatus from '../components/CityStatus.astro';
import ResultsBanner from '../components/ResultsBanner.astro';
import { ELECTION_BY_TOWN } from '../config/election';
import SafetyNotices from '../components/SafetyNotices.astro';
import MarqueeCard from '../components/MarqueeCard.astro';
import TopEventCard from '../components/TopEventCard.astro';
import { selectTopEvent } from '../lib/top-event';
import OrientationHeader from '../components/OrientationHeader.astro';
import QuickLinks from '../components/QuickLinks.astro';
import {
  getUpcomingStories, getActiveAlerts, getUpcomingGames, getNextRegionalGame,
  getNextSdsuMarqueeEvent, getActiveSchoolAlerts, getActiveTrafficIncidents,
  getAgPrices,
  getEmployerJobStats, getUpcomingArtsEvents, getRecentJobs, getNextMeeting,
  getRecentProjectUpdates, PROJECT_PENDING_OUTCOME_LABEL, formatDate,
  getFacilities,
} from '../lib/db';
import { selectFrontPage } from '../lib/front-page';
import { FRONT_PAGE_BY_TOWN } from '../config/front-page';
import { frontPageAlerts } from '../lib/front-page-alerts';
import { frontPageHolidays } from '../lib/front-page-holidays';
import { loadEveningForFrontPage } from '../lib/front-page-load';
import { localDayNumber } from '../lib/local-day';
import {
  todayUtcMidnight, buildEventFeed, isToday, isThisWeekend, isFreeEvent, isLibraryEvent, isKidsEvent, dayIndex,
  weekendAnchorOffset, itemLink,
} from '../lib/events';
import SectionHeader from '../components/ui/SectionHeader.astro';
import EventsGlance from '../components/events/EventsGlance.astro';
import PopEventList from '../components/pop/PopEventList.astro';
import { groupRowsByDay } from '../lib/pop-days';
import MeetingLine from '../components/meetings/MeetingLine.astro';
import { buildTownEventsView } from '../lib/events-town-view';
import { homeBlocks, takeRows } from '../lib/event-day-view';
import { loadUpcomingMeetings } from '../lib/meetings-data';
import { selectWorthKnowingMeetings } from '../lib/meetings-view';
import { resolveQuickLinks, type QuickLinkContext } from '../lib/quick-links';
import { siteConfig } from '../lib/site-config';
import { isSectionBuilt } from '../lib/sections';
import { isWordCut, metaDescription } from '../lib/meta-description';
import { placeAbbr, forCountry } from '../lib/country-profile';
import { resolveImage } from '../lib/images';
import { categoryImagesFor } from '../config/category-images';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';
import { rankTicketmasterEvents, collapseMarqueeRuns, ticketmasterResolvableImage, type MarqueeEntry } from '../lib/whats-on';

const isBrookings = siteConfig.townId === 'brookings_sd';
const isMorenoValley = siteConfig.townId === 'moreno_valley_ca';

const [alerts, schoolAlerts, trafficIncidents, games, nextRegionalGame, nextSdsuEvent, prices, facilities, quickLinkEvents, quickLinkArtsEvents, quickLinkJobs, quickLinkNextMeeting] = await Promise.all([
  getActiveAlerts(),
  getActiveSchoolAlerts(),
  getActiveTrafficIncidents(),
  getUpcomingGames(3),
  getNextRegionalGame(),
  getNextSdsuMarqueeEvent(),
  getAgPrices(),
  getFacilities(),
  // Front-page orientation pass, Phase 2 ("Looking for something?" quick
  // links) -- deliberately its OWN fetch:
  // a 40-item cap across FOUR mixed source_types would
  // would give an inaccurate (likely false-negative) content check against
  // the real /events/today|this-weekend|free|kids|library facet pages.
  // Mirrors events.astro's own exact fetch shape so the quick-link check
  // agrees with what the linked-to page will actually show.
  getUpcomingStories(['event'], 120),
  getUpcomingArtsEvents(40),
  getRecentJobs(1),
  getNextMeeting(),
]);

// Front-page orientation pass, Phase 2: resolve "Looking for something?"
// against the SAME predicates the real facet pages use (see the fetch
// comment above for why this is its own fetch).
const quickLinkDate = todayUtcMidnight(siteConfig.timezone);
const { items: quickLinkFeed } = buildEventFeed(quickLinkEvents, quickLinkArtsEvents, siteConfig.timezone);
const quickLinkContext: QuickLinkContext = {
  hasToday: quickLinkFeed.some((i) => isToday(i, quickLinkDate, siteConfig.timezone)),
  hasWeekend: quickLinkFeed.some((i) => isThisWeekend(i, quickLinkDate, siteConfig.timezone)),
  hasFree: quickLinkFeed.some((i) => isFreeEvent(i, facilities))
    || facilities.some((f) => f.category === 'library' || f.category === 'park' || f.category === 'community_center'),
  hasKids: quickLinkFeed.some((i) => isKidsEvent(i)),
  hasLibrary: quickLinkFeed.some((i) => isLibraryEvent(i, facilities)),
  // "Has a real season/schedule to show" -- games already fetched above
  // for the rail's own game-card tile, reused here rather than re-queried.
  hasJackrabbits: games.length > 0 && isSectionBuilt('jackrabbits', siteConfig),
  hasMeetings: quickLinkNextMeeting !== null,
  // Evergreen reference pages (traffic, closures, facilities): gated on
  // the town actually having the underlying capability/data, not on a
  // live item count -- an empty /traffic page still correctly says "no
  // incidents right now," which is real content, not a broken page (see
  // the handoff's own "Evergreen reference pages ... pass the check if
  // the page exists and has current data").
  hasClosures: !!siteConfig.hasClosureWatch,
  hasJobs: quickLinkJobs.length > 0 && isSectionBuilt('jobs', siteConfig),
  hasTraffic: isSectionBuilt('traffic', siteConfig),
  hasWhatsOn: !!siteConfig.hasWhatsOn,
  hasFacilities: facilities.length > 0 && isSectionBuilt('facilities', siteConfig),
};
const { shown: quickLinks, omitted: omittedQuickLinks } = resolveQuickLinks(siteConfig.townId, quickLinkContext);


// The daily front page (lib/front-page.ts): one lead and 1-3 secondaries chosen by rule from alerts, holidays, the weekend, game day, meetings,
// tonight and the evergreen guides. Titles come from the stories' own titles (built by build_title) and the source fields; alert headlines come from the
// source's event title, never from stories.body. Text-only: no model text and no photo, so there is nothing to dedupe.
// FRONT_PAGE_NOW (an ISO instant) is only for checking the layout on a chosen day in a local build; CI never sets it.
const now = process.env.FRONT_PAGE_NOW ? new Date(process.env.FRONT_PAGE_NOW) : new Date();
const frontPageEvents = buildEventFeed(quickLinkEvents, quickLinkArtsEvents, siteConfig.timezone).items;
const meetingsData = await loadUpcomingMeetings();
const frontPage = selectFrontPage({
  cityName: siteConfig.cityName,
  timezone: siteConfig.timezone,
  locale: siteConfig.country === 'gb' ? 'en-GB' : 'en-US',
  config: FRONT_PAGE_BY_TOWN[siteConfig.townId],
  alerts: frontPageAlerts(alerts),
  holidays: frontPageHolidays(siteConfig.townId, new Date(localDayNumber(now, siteConfig.timezone) * 86_400_000).getUTCFullYear()),
  evening: await loadEveningForFrontPage(frontPageEvents, facilities, now),
  // Home games only: an away game does not change anyone's day here.
  games: games.filter((g) => g.starts_at && g.home_away === 'home').map((g) => ({
    team: 'Jackrabbits', opponent: g.opponent, startsAt: g.starts_at!, home: true, url: '/jackrabbits/',
  })),
  meetings: meetingsData?.meetings ?? [],
}, now);
// A meeting featured on the front page is not repeated as a Worth knowing row.
const featuredMeetingIds = new Set([frontPage.lead, ...frontPage.secondaries].flatMap((it) => (/^\/city-hall\/#meeting-(.+)$/.exec(it.url)?.[1] ?? [])));

// One pipeline for "what's on": the same one /events/ uses (lib/events-town-view.ts), so a count here and a count there agree. Each event is in
// exactly one block below (today / this weekend / this week / coming up). Meetings are not in these blocks; they are the "Worth knowing" rows.
const dayOffsetOf = (iso: string | null) => (iso === null ? null : dayIndex(iso, quickLinkDate, siteConfig.timezone));
const townEvents = buildTownEventsView(quickLinkEvents, quickLinkArtsEvents, facilities);
const blocks = homeBlocks(townEvents.view, weekendAnchorOffset(quickLinkDate));
const todayBlock = takeRows(blocks.today, 5);
const weekendBlock = takeRows(blocks.weekend, 6);
const weekBlock = takeRows(blocks.week, 6);
const comingUp = blocks.later.slice(0, 5);
const worthMeetings = meetingsData
  ? selectWorthKnowingMeetings(meetingsData.meetings.filter((m) => !featuredMeetingIds.has(String(m.id))), meetingsData.todayYmd)
  : [];

const nextGame = games[0] ?? null;

// City Hall project milestones (see NEEDS-HUMAN-REVIEW.md, "Week 3 -- City
// Hall Project Pages") -- real, sourced updates from the last 14 days,
// never a hand-picked/AI-selected slot. A separate block from Worth
// Knowing rather than folded into that Story-based pipeline: projects are
// a different entity (projects/project_updates, not stories), and this
// keeps that pipeline's selection rules untouched.
const recentProjectUpdates = await getRecentProjectUpdates(3);

// Homepage teaser into the Week 2 event landing pages (see
// NEEDS-HUMAN-REVIEW.md "Week 2 -- Event Landing Pages") -- picks whichever
// of Today/This-weekend is the more relevant search intent for the site's
// own local "today" (not the visitor's, not the build machine's), same
// timezone-correct primitive events.astro and the landing pages themselves
// use. Free/Kids stay evergreen regardless of the day.
const eventTeaserWeekday = todayUtcMidnight(siteConfig.timezone).getUTCDay(); // 0=Sun..6=Sat
const isEventTeaserWeekend = eventTeaserWeekday === 5 || eventTeaserWeekday === 6 || eventTeaserWeekday === 0;
const timelyEventTeaser = isEventTeaserWeekend
  ? { href: '/events/this-weekend/', label: 'This weekend' }
  : { href: '/events/today/', label: 'Today' };

// Cross-link a Jackrabbits HOME game happening today into the same "Today"
// river as events/meetings (see NEEDS-HUMAN-REVIEW.md "University Coverage
// Rebuild", A.1 -- a game day is exactly the kind of "what's happening
// today" fact this section exists for, and previously only surfaced in the
// separate rail widget, never in the main content stream). Home only --
// an away game doesn't affect anyone's day in Brookings the way a home game
// does (traffic, parking, foot draw), and the rail widget already covers
// "next game" regardless of home/away.
const todayHomeGame = isBrookings && nextGame && nextGame.home_away === 'home'
  && dayOffsetOf(nextGame.starts_at) === 0 ? nextGame : null;

// 2026-10-01: getLatestEmployerRatings() (rating-derived) is no longer
// fetched here at all -- the homepage card only ever needed it for the
// rating/ranking display that's now hidden, see WorkplaceWatchWidget.astro's
// own comment. employerJobStats (Adzuna-derived, unrelated source) is all
// this page still needs.
// Bara hämtat på towns med Workplace Watch enabled -- ingen anledning att
// fråga en tabell som alltid är tom annars.
const employerJobStats = siteConfig.hasWorkplaceWatch ? await getEmployerJobStats() : [];
// Samma resonemang: bara hämtat för Broomfield, tabellen är alltid tom för
// de andra två (town_id-scopad, se db/migrations/029_vail_news.sql).

// Sitewide presentation-layer pass -- the marquee module. Same
// rank/collapse pipeline lib/cityStatus.ts's buildWhatsOnStatus() already
// uses for the status-line mention, but that one only ever needs TEXT
// (title + distance); this needs an actual resolvable IMAGE, since the
// whole point of the marquee module is Ticketmaster being the one feed
// with licensed photography. Promotes the highest-ranked entry that
// actually resolves to a real image -- skipping (not just deprioritizing)
// any higher-ranked entry that doesn't, per the handoff's own "do not
// render a 16:9 placeholder" rule. Skipped/lower-ranked entries can still
// appear in the "also on" rail below, but ONLY if they too have a real
// image (the front-page module is exclusively for imaged items -- a
// text-only "also on" row belongs to /whats-on's own dense list, not
// here). Omitted entirely (both consts stay null/empty) when hasWhatsOn is
// off or nothing in the whole ranked list has an image -- no placeholder,
// no module.
// Item E5: the homepage marquee is presented as "what's happening" for THIS
// town -- a real, verified Sioux Falls venue ~53mi away reads as local there
// in a way it never would on /whats-on, whose own lede explicitly discloses
// the full town radius (75mi Brookings/35mi Moreno Valley/20mi Broomfield,
// see that page's own radiusMiles copy) before showing a single card. Capped
// here, not in getTicketmasterEventsForTown()/rankTicketmasterEvents()
// themselves -- /whats-on/index.astro calls those same functions and must
// keep showing the full town radius unchanged; only the homepage's own
// prominent placement needs the tighter promise. `venueDistanceMiles ==
// null` (Discovery API had no venue geo data at all) is kept rather than
// dropped -- an unknown distance is not a confirmed "too far," and this cap
// exists to stop a KNOWN-far venue from reading as local, not to penalize a
// missing field.
// Top-event marquee (configs/<town>.json features.top_events): a configured event
// such as Hobo Day gets its own card ahead of the Ticketmaster marquee, found in
// the event stories we already hold, and gone once the day has passed.
const topEvent = siteConfig.topEvents
  ? selectTopEvent(await getUpcomingStories(['event'], 200), siteConfig.topEvents, new Date(), siteConfig.timezone)
  : null;

const HOMEPAGE_MARQUEE_RADIUS_MILES = 25;
const nearbyWhatsOnItems = (siteConfig.hasWhatsOn ? await getTicketmasterEventsForTown(siteConfig) : [])
  .filter((item) => {
    const miles = item.ticketmasterEvent.venueDistanceMiles;
    return miles == null || miles <= HOMEPAGE_MARQUEE_RADIUS_MILES;
  });
const whatsOnEntries = collapseMarqueeRuns(rankTicketmasterEvents(nearbyWhatsOnItems, siteConfig.townId));
let marqueeHero: { entry: MarqueeEntry; image: NonNullable<ReturnType<typeof resolveImage>> } | null = null;
const marqueeAlsoOn: { entry: MarqueeEntry; image: NonNullable<ReturnType<typeof resolveImage>> }[] = [];
for (const entry of whatsOnEntries) {
  const image = resolveImage(ticketmasterResolvableImage(entry.primary), {
    town: siteConfig.townId,
    cityName: siteConfig.cityName,
    facilities,
    categoryImages: categoryImagesFor(siteConfig.townId),
  });
  if (!image) continue;
  if (!marqueeHero) {
    marqueeHero = { entry, image };
  } else if (marqueeAlsoOn.length < 2) {
    marqueeAlsoOn.push({ entry, image });
  } else {
    break;
  }
}
// 2026-10-01: the rating-derived topEmployer/biggestMover pair that used to
// live here (getLatestEmployerRatings()[0], and a reduce() over
// rating_delta_vs_last_month) was removed, along with the fetch itself
// (see above getEmployerJobStats), when the homepage widget's rating/
// ranking display was hidden -- see WorkplaceWatchWidget.astro's own
// comment. /workplace-watch's own full table still fetches ratings
// directly (getLatestEmployerRatings() is still used there, just no longer
// here on the homepage).

// Fas 4a: a reduce() over posting-count
// change. Falls back to "who has the most listings right now" when NO
// employer has month-over-month history yet (every town's first tracked
// month) -- a real, useful fact even before a delta is computable, rather
// than showing nothing at all for the widget's entire first month live.
// Either way, a "leader" tied at zero (every tracked employer has 0
// postings, true for Broomfield today) is not surfaced in the WIDGET --
// technically honest but misleading framing to call one of several zeros
// "the leader"; the full /workplace-watch table still shows every
// employer's real (possibly zero) count with proper context.
const hasHiringHistory = employerJobStats.some((s) => s.postings_change !== null);
const biggestHiringMoverRaw = hasHiringHistory
  ? employerJobStats.reduce<typeof employerJobStats[number] | null>((best, s) => {
      if (s.postings_change === null) return best;
      if (!best || Math.abs(s.postings_change) > Math.abs(best.postings_change!)) return s;
      return best;
    }, null)
  : employerJobStats.reduce<typeof employerJobStats[number] | null>((best, s) => {
      if (!s.postings_now) return best;
      if (!best || s.postings_now > (best.postings_now ?? 0)) return s;
      return best;
    }, null);
const biggestHiringMover =
  biggestHiringMoverRaw && (biggestHiringMoverRaw.postings_now || biggestHiringMoverRaw.postings_change)
    ? biggestHiringMoverRaw
    : null;

// Jackrabbits nästa match och SDSU:s nästa "marquee"-evenemang (Athletics/
// Music) konkurrerar om SAMMA rail-slot för Brookings -- "mutually
// exclusive" enligt spec, inte två samtidiga rutor. Whichever is
// chronologically sooner vinner slotten; det finns inget "rätt" svar när
// båda finns (en Jackrabbits-match ÄR ofta redan med i SDSU:s egen
// Athletics-kategori), så tidsordning är den enda regeln som inte kräver
// att gissa vilken källa som "äger" sanningen.
// A game card links the town's sports page, so it shows only where that page is built (lib/sections.ts, F18 2026-11-13).
const railGame = isSectionBuilt('jackrabbits', siteConfig) ? nextGame : null;
const railRegionalGame = isSectionBuilt('sports', siteConfig) ? nextRegionalGame : null;
const gameSlot: 'jackrabbits' | 'sdsu' | 'regional' | null =
  railGame && nextSdsuEvent
    ? (new Date(railGame.starts_at ?? 0) <= new Date(nextSdsuEvent.starts_at ?? 0) ? 'jackrabbits' : 'sdsu')
    : railGame ? 'jackrabbits'
    : nextSdsuEvent ? 'sdsu'
    : railRegionalGame ? 'regional'
    : null;
---

<BaseLayout title={`${siteConfig.siteName} — what's happening in ${placeAbbr(siteConfig)}`} wide description={isWordCut(frontPage.meta_description) ? metaDescription('home', siteConfig) : frontPage.meta_description}>

  {/* CityStatus: the front-page condensed status strip (lib/cityStatus.ts),
      mounted here at the top of the front page, above the Phase F original-
      content block below (that ordering is an AdSense remediation fix and
      must hold). Replaces the old TodayBlock mount that used to sit here --
      TodayBlock covered nearly identical ground (weather/alerts/closures/
      traffic/tonight) in a fuller, sectioned style; CityStatus is now the
      purpose-built condensed surface the handoff describes, and /today
      (pages/today.astro) keeps its own TodayBlock mount UNCHANGED as the
      expanded view. The two don't yet share one resolver layer (a real,
      deliberately deferred follow-up -- see cityStatus.ts's own module
      docstring), so `alerts`/`schoolAlerts` are still fetched independently
      above for the front-page selector/SchoolAlertBanner below, unrelated to
      CityStatus's own alerts module. */}
  <OrientationHeader />
  {ELECTION_BY_TOWN[siteConfig.townId] && <ResultsBanner />}
  <CityStatus />
  {siteConfig.safetyNotices && <SafetyNotices townId={siteConfig.townId} timezone={siteConfig.timezone} variant="compact" onlyWhenActive />}
  <QuickLinks links={quickLinks} omitted={omittedQuickLinks} />

  {/* The answer first: how many things are on today and the days as counts, straight after the status strip. The day lists are further down. */}
  {(townEvents.view.todayCount > 0 || townEvents.view.nextDay) && <section class="home-glance"><EventsGlance view={townEvents.view} base="/events/" /></section>}

  {/* Marquee module (sitewide presentation-layer pass): the single
      top-ranked What's On item with a real image, full-width, plus up to
      two "also on" rows -- see the const block above for the promotion
      logic. Sits between the status line and the page's original content,
      per the handoff's own page-order table. Omitted entirely (not a
      placeholder) when marqueeHero is null. */}
  {topEvent && <TopEventCard story={topEvent} timezone={siteConfig.timezone} />}

  {marqueeHero && (
    <section class="marquee-module" aria-label="What's On this week">
      <MarqueeCard
        item={marqueeHero.entry.primary}
        image={marqueeHero.image}
        cityName={siteConfig.cityName}
        timezone={siteConfig.timezone}
        variant="hero"
        priority
        runSize={marqueeHero.entry.members.length}
        lastOccursAt={marqueeHero.entry.members[marqueeHero.entry.members.length - 1].occurs_at}
      />
      {marqueeAlsoOn.length > 0 && (
        <div class="marquee-module__also-on">
          {marqueeAlsoOn.map(({ entry, image }) => (
            <MarqueeCard
              item={entry.primary}
              image={image}
              cityName={siteConfig.cityName}
              timezone={siteConfig.timezone}
              variant="row"
              runSize={entry.members.length}
              lastOccursAt={entry.members[entry.members.length - 1].occurs_at}
            />
          ))}
        </div>
      )}
      <a class="marquee-module__link" href="/whats-on/">See everything on this week &rarr;</a>
    </section>
  )}

  <SchoolAlertBanner alerts={schoolAlerts} />


  {/* AdSense "low value content" remediation, Phase 0: the "Today's read"
      feature slot and the "Latest from <site>" grid both only ever showed
      the generic AI content track (editorials/columns/reviews/recipes),
      which stopped generating -- both sections removed outright rather
      than left to render an empty/frozen state. The freed slot is now the
      Events weekend module (Phase 2, item 2b) -- omitted entirely (not a
      placeholder) when weekendSummary is null, same rule as every other
      conditional module above. */}
  <section class="home-events" aria-label="What's on">

    {(todayBlock.days.length > 0 || todayHomeGame) && (
      <div class="home-events__block">
        {todayHomeGame && <div class="river"><GameCard game={todayHomeGame} feature /></div>}
        <PopEventList days={todayBlock.days} idPrefix="home-today" />
      </div>
    )}
    {weekendBlock.days.length > 0 && (
      <div class="home-events__block">
        <SectionHeader title="This weekend" seeAllHref="/events/this-weekend/" seeAllLabel="All weekend events" />
        <PopEventList days={weekendBlock.days} idPrefix="home-weekend" />
      </div>
    )}
    {weekBlock.days.length > 0 && (
      <div class="home-events__block">
        <SectionHeader title="This week" seeAllHref="/events/" seeAllLabel="All events" />
        <PopEventList days={weekBlock.days} idPrefix="home-week" />
      </div>
    )}
  </section>

  <FrontPageLead page={frontPage} />

  <aside class="rail" aria-label="Conditions and numbers">
      {gameSlot === 'jackrabbits' && nextGame ? (
        <>
          <a class="rail__link rail__game" href="/jackrabbits/">
            <GameCard game={nextGame} />
          </a>
          {/* Bara vid en RIKTIG Jackrabbits-match, inte ett allmänt SDSU-
              marquee-event eller en Moreno Valley-match -- se gameSlot
              ovan. Egen <a>, inte nästlad i länken ovan (ogiltig HTML). */}
          <JackrabbitGameDayLine />
        </>
      ) : gameSlot === 'sdsu' && nextSdsuEvent ? (
        <a class="rail__link rail__game" href="/university/">
          <SdsuEventCard event={nextSdsuEvent} />
        </a>
      ) : gameSlot === 'regional' && nextRegionalGame && (
        <a class="rail__link rail__game" href="/sports/">
          <RegionalGameCard game={nextRegionalGame} />
        </a>
      )}
      {isBrookings && <JackrabbitWidget />}
      {isMorenoValley && <BurroBonanzaWidget />}
      {/* 2026-10-01: gated on biggestHiringMover (Adzuna-sourced), not
          topEmployer (rating-sourced) -- rating/ranking is hidden pending
          a Glassdoor/Indeed ToS review, see WorkplaceWatchWidget.astro's
          own comment. With no rating to show, there's nothing left to
          headline the card with when hiring data is absent, so the card
          simply doesn't render in that case rather than showing an empty
          shell. */}
      {siteConfig.hasWorkplaceWatch && biggestHiringMover && (
        <WorkplaceWatchWidget
          hiringName={biggestHiringMover.name}
          hiringCount={biggestHiringMover.postings_now}
          hiringDelta={biggestHiringMover.postings_change}
        />
      )}
      {trafficIncidents.length > 0 && isSectionBuilt('traffic', siteConfig) && (
        <a class="rail__link" href="/traffic/">
          <TrafficWidget incidents={trafficIncidents} />
        </a>
      )}
      {prices.length > 0 && (
        <a class="rail__link rail__prices" href="/farm-report/">
          <p class="rail__label">Markets</p>
          <table class="prices data">
            <tbody>
              {prices.map((p) => (
                <tr>
                  <th scope="row">{p.commodity}</th>
                  <td>{p.price !== null ? Number(p.price).toFixed(2) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </a>
      )}
      <p class="rail__hint">Tap a panel for the full picture &rarr;</p>
  </aside>

  {worthMeetings.length > 0 && (
    // Data rows from the meetings view (organ, kind, date and time, agenda items, agenda link), picked by rule: real meetings with an agenda in the
    // next three weeks. No prose; a meeting featured as the lead above is not repeated.
    <section aria-label="Worth knowing" class="worth-knowing">
      <SectionHeader title="Worth knowing" seeAllHref="/city-hall/" seeAllLabel="All meetings" />
      <ul class="plain-list">
        {worthMeetings.map((m) => <MeetingLine m={m} todayYmd={meetingsData!.todayYmd} />)}
      </ul>
    </section>
  )}

  {recentProjectUpdates.length > 0 && (
    <section aria-label="Project updates" class="project-updates">
      <SectionRule label="City hall project updates" href="/city-hall/projects/" />
      <ul class="project-updates__list">
        {recentProjectUpdates.map((u) => (
          <li>
            <a href={`/city-hall/projects/${u.project_slug}/`}>{u.project_title}</a>
            <span class="project-updates__meta">
              {' '}— {u.body}, {formatDate(u.meeting_date)}:
              {' '}{u.outcome_override ?? (u.outcome === 'pending' ? PROJECT_PENDING_OUTCOME_LABEL : u.outcome.toLowerCase())}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {comingUp.length > 0 && (
    <section aria-label="Coming up">
      <SectionHeader title="Coming up" seeAllHref="/events/" seeAllLabel="All events" />
      <PopEventList days={groupRowsByDay(comingUp)} idPrefix="coming" />
    </section>
  )}

  {/* AdSense "low value content" remediation, Phase 0: "More to read"
      existed only to surface the shared/town-agnostic content-track items
      (recipe, review, science column), which stopped generating -- removed
      outright along with "Today's read" and "Latest from" above. */}

  <section aria-label="Sections">
    <SectionRule label={`More from ${siteConfig.cityName}`} />
    <div class="panels">
      {isBrookings && (
        <a class="panel" href="/university/">
          <h3>University</h3>
          <p>Games, concerts, shows and campus events at South Dakota State.</p>
        </a>
      )}
      {isBrookings && (
        <a class="panel" href="/jackrabbits/">
          <h3>Jackrabbits</h3>
          <p>Full schedules and results for SDSU football, basketball and volleyball.</p>
        </a>
      )}
      <a class="panel" href="/city-hall/">
        <h3>City hall</h3>
        <p>What the {forCountry(siteConfig.country, 'council, county commission and committees', 'council and committees')} are deciding.</p>
      </a>
      {isBrookings && (
        <a class="panel" href="/farm-report/">
          <h3>Farm report</h3>
          <p>Corn, soybean and cattle prices from USDA.</p>
        </a>
      )}
    </div>
  </section>

  {/* SEO Fas 4 -- WebSite, homepage-only (NewsMediaOrganization already
      renders site-wide via BaseLayout.astro, a distinct @type from this).
      No potentialAction/SearchAction: the site has no internal search
      feature, and claiming one would be exactly the kind of unverified
      capability this project's structured data never asserts. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  })} />
</BaseLayout>

<style>


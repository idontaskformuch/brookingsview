---
/**
 * Förstasidan, byggd som en tidningsförstasida.
 *
 * Strukturen är TID, inte ämne: I dag -> Den här veckan -> Framöver. Frågan
 * sajten svarar på ("what's happening in Brookings?") handlar om när, inte om
 * vad -- de flesta lokalsajter sorterar efter kategori och blir svårare att
 * skanna för det.
 *
 * Hierarkin är avsiktlig: en etta som dominerar, ett högerfält med siffror
 * (väder, nästa match, råvarupriser -- tidningens väderruta och börstabell),
 * och därunder en spaltström avdelad med hårfina linjer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import LeadStory from '../components/LeadStory.astro';
import SecondaryStory from '../components/SecondaryStory.astro';
import WeeklyRoundup from '../components/WeeklyRoundup.astro';
import GameCard from '../components/GameCard.astro';
import RegionalGameCard from '../components/RegionalGameCard.astro';
import SdsuEventCard from '../components/SdsuEventCard.astro';
import JackrabbitWidget from '../components/JackrabbitWidget.astro';
import JackrabbitGameDayLine from '../components/JackrabbitGameDayLine.astro';
import WorkplaceWatchWidget from '../components/WorkplaceWatchWidget.astro';
import VailNewsWidget from '../components/VailNewsWidget.astro';
import BurroBonanzaWidget from '../components/BurroBonanzaWidget.astro';
import SchoolAlertBanner from '../components/SchoolAlertBanner.astro';
import TrafficWidget from '../components/TrafficWidget.astro';
import Tile from '../components/Tile.astro';
import CityStatus from '../components/CityStatus.astro';
import MarqueeCard from '../components/MarqueeCard.astro';
import OrientationHeader from '../components/OrientationHeader.astro';
import QuickLinks from '../components/QuickLinks.astro';
import {
  getUpcomingStories, getActiveAlerts, getUpcomingGames, getNextRegionalGame,
  getNextSdsuMarqueeEvent, getActiveSchoolAlerts, getActiveTrafficIncidents,
  getWeather, getAgPrices, getLatestWeekly,
  getEmployerJobStats, getUpcomingArtsEvents, getRecentJobs, getNextMeeting,
  getWorthKnowingCandidates, getRecentProjectUpdates, formatDate,
  getFacilities, getLatestVailNewsItem, getEventDeckDigests,
} from '../lib/db';
import { selectWorthKnowing, selectFrontPageRhythm } from '../lib/homepage-curation';
import {
  todayUtcMidnight, buildEventFeed, isToday, isThisWeekend, isFreeEvent, isLibraryEvent, isKidsEvent, dayIndex,
} from '../lib/events';
import { resolveQuickLinks, type QuickLinkContext } from '../lib/quick-links';
import { siteConfig } from '../lib/site-config';
import { resolveImage, dedupeConsecutiveImages } from '../lib/images';
import { categoryImagesFor } from '../config/category-images';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';
import { rankTicketmasterEvents, collapseMarqueeRuns, ticketmasterResolvableImage, marqueeDigestKey, type MarqueeEntry } from '../lib/whats-on';

const isBrookings = siteConfig.townId === 'brookings_sd';
const isMorenoValley = siteConfig.townId === 'moreno_valley_ca';
const isBroomfield = siteConfig.townId === 'broomfield_co';

const [alerts, schoolAlerts, trafficIncidents, upcoming, games, nextRegionalGame, nextSdsuEvent, periods, prices, weekly, worthKnowingCandidates, facilities, quickLinkEvents, quickLinkArtsEvents, quickLinkJobs, quickLinkNextMeeting] = await Promise.all([
  getActiveAlerts(),
  getActiveSchoolAlerts(),
  getActiveTrafficIncidents(),
  // 'announcement' (t.ex. spellanseringen) ska in i SAMMA Today/This week-
  // ström som event/meeting -- inte en egen sektion för en enstaka
  // handskriven post, se lib/db.ts:SourceType. 'new_in_town_digest'
  // (Handoff: Information Hub Tier 1, Feature B) tillagd här av samma skäl
  // -- utan detta skulle veckans New in Town-roundup vara osynlig på
  // förstasidan trots att den publiceras korrekt i stories, EXAKT samma
  // bugg som en gång hände med 'announcement' innan den lades till här.
  getUpcomingStories(['event', 'meeting', 'announcement', 'new_in_town_digest'], 40),
  getUpcomingGames(3),
  getNextRegionalGame(),
  getNextSdsuMarqueeEvent(),
  getWeather(),
  getAgPrices(),
  getLatestWeekly(),
  getWorthKnowingCandidates(),
  getFacilities(),
  // Front-page orientation pass, Phase 2 ("Looking for something?" quick
  // links) -- deliberately its OWN fetch, not a reuse of `upcoming` above:
  // `upcoming` is capped at 40 items across FOUR mixed source_types, which
  // would give an inaccurate (likely false-negative) content check against
  // the real /events/today|this-weekend|free|kids|library facet pages.
  // Mirrors events.astro's own exact fetch shape so the quick-link check
  // agrees with what the linked-to page will actually show.
  getUpcomingStories(['event'], 120),
  getUpcomingArtsEvents(40),
  getRecentJobs(1),
  getNextMeeting(),
]);

// Front-page orientation pass, Phase 2: resolve "Looking for something?"
// against the SAME predicates the real facet pages use (see the fetch
// comment above for why this is its own feed, not a reuse of `upcoming`).
const quickLinkDate = todayUtcMidnight(siteConfig.timezone);
const { items: quickLinkFeed } = buildEventFeed(quickLinkEvents, quickLinkArtsEvents, siteConfig.timezone);
const quickLinkContext: QuickLinkContext = {
  hasToday: quickLinkFeed.some((i) => isToday(i, quickLinkDate, siteConfig.timezone)),
  hasWeekend: quickLinkFeed.some((i) => isThisWeekend(i, quickLinkDate, siteConfig.timezone)),
  hasFree: quickLinkFeed.some((i) => isFreeEvent(i, facilities))
    || facilities.some((f) => f.category === 'library' || f.category === 'park' || f.category === 'community_center'),
  hasKids: quickLinkFeed.some((i) => isKidsEvent(i)),
  hasLibrary: quickLinkFeed.some((i) => isLibraryEvent(i, facilities)),
  // "Has a real season/schedule to show" -- games already fetched above
  // for the rail's own game-card tile, reused here rather than re-queried.
  hasJackrabbits: games.length > 0,
  hasMeetings: quickLinkNextMeeting !== null,
  // Evergreen reference pages (traffic, closures, facilities): gated on
  // the town actually having the underlying capability/data, not on a
  // live item count -- an empty /traffic page still correctly says "no
  // incidents right now," which is real content, not a broken page (see
  // the handoff's own "Evergreen reference pages ... pass the check if
  // the page exists and has current data").
  hasClosures: !!siteConfig.hasClosureWatch,
  hasJobs: quickLinkJobs.length > 0,
  hasTraffic: !!siteConfig.trafficSource,
  hasWhatsOn: !!siteConfig.hasWhatsOn,
  hasFacilities: facilities.length > 0,
};
const { shown: quickLinks, omitted: omittedQuickLinks } = resolveQuickLinks(siteConfig.townId, quickLinkContext);

// AdSense "low value content" remediation, Phase 0: the generic AI content
// track (editorials/columns/reviews/recipes) stopped generating and was
// pulled from the homepage entirely -- no "Today's read" feature slot, no
// "Latest from"/"More to read" sections. `feature` stays a literal `null`
// (not removed outright) so frontPageImageOrder just below and the
// now-dead JSX guards elsewhere on the page don't need their own
// follow-up edit. The slot is spec'd to come back in Phase 2 as the
// Events weekend module, not refilled with anything else meanwhile.
const feature = null;
const alertBannerSlugs = new Set(alerts.map((a) => a.slug));

const today = periods.find((p) => p.is_daytime) ?? periods[0] ?? null;

// Front-page rhythm (see NEEDS-HUMAN-REVIEW.md "Liveliness Spec" §1): a
// rule-based lead + secondary selection, not just "closest upcoming item"
// -- see lib/homepage-curation.ts's own docstring for the full fallback
// chain (active alert -> substantial meeting -> announcement -> newest
// imaged item -> newest, image or not). hasImage() reuses the SAME
// resolveImage() tier the actual <img> rendering uses, so the selection
// can never pick something LeadStory/SecondaryStory then fail to render an
// image for.
//
// 2026-10-02, item D5: computed BEFORE Worth Knowing now (it used to run
// after), specifically so usedSlugs exists in time to be passed into
// selectWorthKnowing() below -- see that function's own comment for the
// real duplicate-card bug this ordering fixes.
const hasImage = (story: (typeof upcoming)[number]) => resolveImage(story, {
  town: siteConfig.townId,
  cityName: siteConfig.cityName,
  facilities,
  categoryImages: categoryImagesFor(siteConfig.townId),
}) !== null;

// No story-based widget today overlaps the front-page candidate pool (the
// rail's game/weather/traffic tiles all come from other tables, not
// `stories`) -- kept as a real Set, not hardcoded empty, so the rule stays
// enforced if that ever changes.
const widgetSlugs = new Set<string>();

const { fullWidthLead, secondary, usedSlugs } = selectFrontPageRhythm(upcoming, alerts, { hasImage, widgetSlugs });

// Phase 0 removed the "Latest from" content-track section this used to
// dedupe against -- the theme-collision check has nothing left to compare
// to, so this is now always [], not a second removed fetch.
const worthKnowingSelection = selectWorthKnowing(worthKnowingCandidates, alertBannerSlugs, [], usedSlugs);

// Real per-place/category photos (see NEEDS-HUMAN-REVIEW.md "Switch venue/
// category images to real photos") replaced the old, much larger
// Flux-generated set with ONE photo per category -- so two front-page
// cards sharing a category (e.g. two "events" items) would otherwise
// render the exact same photo twice, reading as a bug rather than a
// deliberate choice. dedupeConsecutiveImages() (added with the original
// image-identity feature but never actually called from any page until
// this) is applied here to the front page's image-bearing cards IN THEIR
// REAL VISUAL ORDER -- the "Today's read" feature (moved above the scraped
// lead/secondary hero, Phase F: surface what's actually unique), then the
// lead, then each secondary card -- so a repeat is suppressed (an honest
// "no image" gap, same as any other resolveImage() miss) rather than shown
// twice. Deliberately only consecutive-in-this-list repeats are
// suppressed, not any-earlier-in-the-list ones -- see that function's own
// docstring for why a repeat separated by other images isn't the same
// "reads as broken" problem.
//
// `weekly` is deliberately NOT in this list (This Week image rotation,
// 2026-10-03): WeeklyRoundup.astro now resolves its own image from a
// dedicated, town+season-scoped pool (config/this-week-images.ts) with its
// own real 60-day usage history, not the shared 'events' category pool --
// it can no longer collide with another card's photo at all, so it has
// nothing to participate in this same-page dedup pass for.
const frontPageImageOrder = [feature, fullWidthLead, ...secondary]
  .filter((s): s is NonNullable<typeof s> => s != null);

// Image-rotation follow-up, Part 2 ("within-page variety") -- see
// NEEDS-HUMAN-REVIEW.md's image-rotation report for the full pool-size
// numbers this is scoped against (every category pool is 2-3 images, so
// this reduces repeats, it doesn't eliminate them). Resolved in the SAME
// visual order as the page renders them, threading a running set of
// already-used category-pool paths into each resolveImage() call -- a
// later item in a small pool then avoids an earlier item's exact photo
// when an unused alternative exists, not just the immediately-preceding
// one (dedupeConsecutiveImages() below still runs afterward as a safety
// net for tiers 1-3's own, different, adjacent-repeat case -- see that
// function's and usedImagePaths' own doc comments for why those tiers are
// excluded from this pass).
const usedCategoryImagePaths = new Set<string>();

const frontPageImages = dedupeConsecutiveImages(
  frontPageImageOrder,
  (s) => {
    const image = resolveImage(s, {
      town: siteConfig.townId,
      cityName: siteConfig.cityName,
      facilities,
      categoryImages: categoryImagesFor(siteConfig.townId),
      usedImagePaths: usedCategoryImagePaths,
    });
    if (image) usedCategoryImagePaths.add(image.path);
    return image;
  },
);
const frontPageImageBySlug = new Map(frontPageImages.map(({ item, image }) => [item.slug, image]));

const rest = upcoming.filter((s) => !usedSlugs.has(s.slug));

// Events correctness Phase 1 (2026-10-07): this used to bucket via
// `new Date().setHours(0,0,0,0)`, which reads the BUILD MACHINE's local
// time (always UTC in CI/Cloudflare) instead of siteConfig.timezone -- an
// evening local event, once past its own town's sunset, is already
// tomorrow in UTC and silently fell into "This week" instead of "Today."
// dayOffsetOf() reuses the same timezone-correct day-bucketing primitive
// quickLinkDate above (and events.astro/the /events/[facet] pages) already
// use, so this river can't drift from what those pages consider "today"
// again.
const dayOffsetOf = (iso: string | null) => (iso === null ? null : dayIndex(iso, quickLinkDate, siteConfig.timezone));

const todayStories = rest.filter((s) => dayOffsetOf(s.occurs_at) === 0);
const weekStories = rest.filter((s) => {
  const offset = dayOffsetOf(s.occurs_at);
  return offset !== null && offset >= 1 && offset <= 7;
});
const laterStories = rest.filter((s) => {
  const offset = dayOffsetOf(s.occurs_at);
  return offset !== null && offset >= 8;
});

const nextGame = games[0] ?? null;

// City Hall project milestones (see NEEDS-HUMAN-REVIEW.md, "Week 3 -- City
// Hall Project Pages") -- real, sourced updates from the last 14 days,
// never a hand-picked/AI-selected slot. A separate block from Worth
// Knowing rather than folded into that Story-based pipeline: projects are
// a different entity (projects/project_updates, not stories), and this
// keeps that pipeline's selection rules untouched.
const recentProjectUpdates = await getRecentProjectUpdates(3);

// Homepage teaser into the Week 2 event landing pages (see
// NEEDS-HUMAN-REVIEW.md "Week 2 -- Event Landing Pages") -- picks whichever
// of Today/This-weekend is the more relevant search intent for the site's
// own local "today" (not the visitor's, not the build machine's), same
// timezone-correct primitive events.astro and the landing pages themselves
// use. Free/Kids stay evergreen regardless of the day.
const eventTeaserWeekday = todayUtcMidnight(siteConfig.timezone).getUTCDay(); // 0=Sun..6=Sat
const isEventTeaserWeekend = eventTeaserWeekday === 5 || eventTeaserWeekday === 6 || eventTeaserWeekday === 0;
const timelyEventTeaser = isEventTeaserWeekend
  ? { href: '/events/this-weekend/', label: 'This weekend' }
  : { href: '/events/today/', label: 'Today' };

// Cross-link a Jackrabbits HOME game happening today into the same "Today"
// river as events/meetings (see NEEDS-HUMAN-REVIEW.md "University Coverage
// Rebuild", A.1 -- a game day is exactly the kind of "what's happening
// today" fact this section exists for, and previously only surfaced in the
// separate rail widget, never in the main content stream). Home only --
// an away game doesn't affect anyone's day in Brookings the way a home game
// does (traffic, parking, foot draw), and the rail widget already covers
// "next game" regardless of home/away.
const todayHomeGame = isBrookings && nextGame && nextGame.home_away === 'home'
  && dayOffsetOf(nextGame.starts_at) === 0 ? nextGame : null;

// 2026-10-01: getLatestEmployerRatings() (rating-derived) is no longer
// fetched here at all -- the homepage card only ever needed it for the
// rating/ranking display that's now hidden, see WorkplaceWatchWidget.astro's
// own comment. employerJobStats (Adzuna-derived, unrelated source) is all
// this page still needs.
// Bara hämtat på towns med Workplace Watch enabled -- ingen anledning att
// fråga en tabell som alltid är tom annars.
const employerJobStats = siteConfig.hasWorkplaceWatch ? await getEmployerJobStats() : [];
// Samma resonemang: bara hämtat för Broomfield, tabellen är alltid tom för
// de andra två (town_id-scopad, se db/migrations/029_vail_news.sql).
const latestVailNews = isBroomfield ? await getLatestVailNewsItem() : null;

// Sitewide presentation-layer pass -- the marquee module. Same
// rank/collapse pipeline lib/cityStatus.ts's buildWhatsOnStatus() already
// uses for the status-line mention, but that one only ever needs TEXT
// (title + distance); this needs an actual resolvable IMAGE, since the
// whole point of the marquee module is Ticketmaster being the one feed
// with licensed photography. Promotes the highest-ranked entry that
// actually resolves to a real image -- skipping (not just deprioritizing)
// any higher-ranked entry that doesn't, per the handoff's own "do not
// render a 16:9 placeholder" rule. Skipped/lower-ranked entries can still
// appear in the "also on" rail below, but ONLY if they too have a real
// image (the front-page module is exclusively for imaged items -- a
// text-only "also on" row belongs to /whats-on's own dense list, not
// here). Omitted entirely (both consts stay null/empty) when hasWhatsOn is
// off or nothing in the whole ranked list has an image -- no placeholder,
// no module.
// Item E5: the homepage marquee is presented as "what's happening" for THIS
// town -- a real, verified Sioux Falls venue ~53mi away reads as local there
// in a way it never would on /whats-on, whose own lede explicitly discloses
// the full town radius (75mi Brookings/35mi Moreno Valley/20mi Broomfield,
// see that page's own radiusMiles copy) before showing a single card. Capped
// here, not in getTicketmasterEventsForTown()/rankTicketmasterEvents()
// themselves -- /whats-on/index.astro calls those same functions and must
// keep showing the full town radius unchanged; only the homepage's own
// prominent placement needs the tighter promise. `venueDistanceMiles ==
// null` (Discovery API had no venue geo data at all) is kept rather than
// dropped -- an unknown distance is not a confirmed "too far," and this cap
// exists to stop a KNOWN-far venue from reading as local, not to penalize a
// missing field.
const HOMEPAGE_MARQUEE_RADIUS_MILES = 25;
const nearbyWhatsOnItems = (siteConfig.hasWhatsOn ? await getTicketmasterEventsForTown(siteConfig) : [])
  .filter((item) => {
    const miles = item.ticketmasterEvent.venueDistanceMiles;
    return miles == null || miles <= HOMEPAGE_MARQUEE_RADIUS_MILES;
  });
const whatsOnEntries = collapseMarqueeRuns(rankTicketmasterEvents(nearbyWhatsOnItems, siteConfig.townId));
let marqueeHero: { entry: MarqueeEntry; image: NonNullable<ReturnType<typeof resolveImage>> } | null = null;
const marqueeAlsoOn: { entry: MarqueeEntry; image: NonNullable<ReturnType<typeof resolveImage>> }[] = [];
for (const entry of whatsOnEntries) {
  const image = resolveImage(ticketmasterResolvableImage(entry.primary), {
    town: siteConfig.townId,
    cityName: siteConfig.cityName,
    facilities,
    categoryImages: categoryImagesFor(siteConfig.townId),
  });
  if (!image) continue;
  if (!marqueeHero) {
    marqueeHero = { entry, image };
  } else if (marqueeAlsoOn.length < 2) {
    marqueeAlsoOn.push({ entry, image });
  } else {
    break;
  }
}
// Marquee deck sentences follow-up: only the hero card ever shows a deck
// (see MarqueeCard.astro's own comment), so only its key needs a lookup --
// still a batch call (of one) for consistency with whats-on/index.astro's
// own multi-key lookup, and because getEventDeckDigests() already handles
// an empty array cheaply when hasWhatsOn is off or nothing resolved a hero.
// Looked up by marqueeDigestKey(), NOT the primary member's own event id --
// see that function's own doc comment for why (a real bug, caught live).
const marqueeDeck = marqueeHero
  ? (await getEventDeckDigests([marqueeDigestKey(marqueeHero.entry)])).get(marqueeDigestKey(marqueeHero.entry))
  : undefined;
// 2026-10-01: the rating-derived topEmployer/biggestMover pair that used to
// live here (getLatestEmployerRatings()[0], and a reduce() over
// rating_delta_vs_last_month) was removed, along with the fetch itself
// (see above getEmployerJobStats), when the homepage widget's rating/
// ranking display was hidden -- see WorkplaceWatchWidget.astro's own
// comment. /workplace-watch's own full table still fetches ratings
// directly (getLatestEmployerRatings() is still used there, just no longer
// here on the homepage).

// Fas 4a: a reduce() over posting-count
// change. Falls back to "who has the most listings right now" when NO
// employer has month-over-month history yet (every town's first tracked
// month) -- a real, useful fact even before a delta is computable, rather
// than showing nothing at all for the widget's entire first month live.
// Either way, a "leader" tied at zero (every tracked employer has 0
// postings, true for Broomfield today) is not surfaced in the WIDGET --
// technically honest but misleading framing to call one of several zeros
// "the leader"; the full /workplace-watch table still shows every
// employer's real (possibly zero) count with proper context.
const hasHiringHistory = employerJobStats.some((s) => s.postings_change !== null);
const biggestHiringMoverRaw = hasHiringHistory
  ? employerJobStats.reduce<typeof employerJobStats[number] | null>((best, s) => {
      if (s.postings_change === null) return best;
      if (!best || Math.abs(s.postings_change) > Math.abs(best.postings_change!)) return s;
      return best;
    }, null)
  : employerJobStats.reduce<typeof employerJobStats[number] | null>((best, s) => {
      if (!s.postings_now) return best;
      if (!best || s.postings_now > (best.postings_now ?? 0)) return s;
      return best;
    }, null);
const biggestHiringMover =
  biggestHiringMoverRaw && (biggestHiringMoverRaw.postings_now || biggestHiringMoverRaw.postings_change)
    ? biggestHiringMoverRaw
    : null;

// Jackrabbits nästa match och SDSU:s nästa "marquee"-evenemang (Athletics/
// Music) konkurrerar om SAMMA rail-slot för Brookings -- "mutually
// exclusive" enligt spec, inte två samtidiga rutor. Whichever is
// chronologically sooner vinner slotten; det finns inget "rätt" svar när
// båda finns (en Jackrabbits-match ÄR ofta redan med i SDSU:s egen
// Athletics-kategori), så tidsordning är den enda regeln som inte kräver
// att gissa vilken källa som "äger" sanningen.
const gameSlot: 'jackrabbits' | 'sdsu' | 'regional' | null =
  nextGame && nextSdsuEvent
    ? (new Date(nextGame.starts_at ?? 0) <= new Date(nextSdsuEvent.starts_at ?? 0) ? 'jackrabbits' : 'sdsu')
    : nextGame ? 'jackrabbits'
    : nextSdsuEvent ? 'sdsu'
    : nextRegionalGame ? 'regional'
    : null;
---

<BaseLayout title={`${siteConfig.siteName} — what's happening in ${siteConfig.cityName}, ${siteConfig.stateAbbr}`} wide>

  {/* CityStatus: the front-page condensed status strip (lib/cityStatus.ts),
      mounted here at the top of the front page, above the Phase F original-
      content block below (that ordering is an AdSense remediation fix and
      must hold). Replaces the old TodayBlock mount that used to sit here --
      TodayBlock covered nearly identical ground (weather/alerts/closures/
      traffic/tonight) in a fuller, sectioned style; CityStatus is now the
      purpose-built condensed surface the handoff describes, and /today
      (pages/today.astro) keeps its own TodayBlock mount UNCHANGED as the
      expanded view. The two don't yet share one resolver layer (a real,
      deliberately deferred follow-up -- see cityStatus.ts's own module
      docstring), so `alerts`/`schoolAlerts` are still fetched independently
      above for selectFrontPageRhythm/SchoolAlertBanner below, unrelated to
      CityStatus's own alerts module. */}
  <OrientationHeader />
  <CityStatus />
  <QuickLinks links={quickLinks} omitted={omittedQuickLinks} />

  {/* Marquee module (sitewide presentation-layer pass): the single
      top-ranked What's On item with a real image, full-width, plus up to
      two "also on" rows -- see the const block above for the promotion
      logic. Sits between the status line and the page's original content,
      per the handoff's own page-order table. Omitted entirely (not a
      placeholder) when marqueeHero is null. */}
  {marqueeHero && (
    <section class="marquee-module" aria-label="What's On this week">
      <MarqueeCard
        item={marqueeHero.entry.primary}
        image={marqueeHero.image}
        cityName={siteConfig.cityName}
        timezone={siteConfig.timezone}
        variant="hero"
        priority
        deck={marqueeDeck}
        runSize={marqueeHero.entry.members.length}
        lastOccursAt={marqueeHero.entry.members[marqueeHero.entry.members.length - 1].occurs_at}
      />
      {marqueeAlsoOn.length > 0 && (
        <div class="marquee-module__also-on">
          {marqueeAlsoOn.map(({ entry, image }) => (
            <MarqueeCard
              item={entry.primary}
              image={image}
              cityName={siteConfig.cityName}
              timezone={siteConfig.timezone}
              variant="row"
              runSize={entry.members.length}
              lastOccursAt={entry.members[entry.members.length - 1].occurs_at}
            />
          ))}
        </div>
      )}
      <a class="marquee-module__link" href="/whats-on/">See everything on this week &rarr;</a>
    </section>
  )}

  <SchoolAlertBanner alerts={schoolAlerts} />

  {weekly && <WeeklyRoundup story={weekly} />}

  {/* AdSense "low value content" remediation, Phase 0: the "Today's read"
      feature slot and the "Latest from <site>" grid both only ever showed
      the generic AI content track (editorials/columns/reviews/recipes),
      which stopped generating -- both sections removed outright rather
      than left to render an empty/frozen state. The freed slot is spec'd
      to become the Events weekend module in Phase 2; until then it's
      simply gone, not backfilled with something else. */}

  {/* Front-page orientation pass, Phase 3: "Today" and "This week" moved
      up from well below the fold (they used to sit after Worth Knowing/
      City hall project updates) to right after Phase F's own original-
      content block -- as early as the page's hierarchy allows WITHOUT
      violating Phase F's own "original content leads, ahead of the
      scraped feed" rule (see that block's comment above): Today/This week
      are themselves scraped-feed sections, so they can't go any higher
      than immediately below Phase F without undoing that earlier,
      deliberate fix. "Today" gets the same strong heading treatment as
      "Right Now" (CityStatus) -- see SectionRule's own `strong` prop. */}
  {(todayStories.length > 0 || todayHomeGame) && (
    <section aria-label="Today">
      <SectionRule label="Today" href="/events/" strong />
      {todayHomeGame && (
        <div class="river">
          <GameCard game={todayHomeGame} feature />
        </div>
      )}
      {todayStories.length > 0 && (
        // Capped at 5 (see NEEDS-HUMAN-REVIEW.md "Homepage Curation") --
        // previously unbounded, which is exactly what let a 30+ item
        // events list dominate the homepage on a busy day. SectionRule's
        // "All →" (added above) is the real complete view now, same
        // pattern "This week"/"Coming up" already used.
        <div class="river">
          {todayStories.slice(0, 5).map((story) => <StoryCard story={story} facilities={facilities} />)}
        </div>
      )}
    </section>
  )}

  <section aria-label="This week">
    <SectionRule label="This week" href="/events/" />
    <p class="event-teasers">
      <a href={timelyEventTeaser.href}>{timelyEventTeaser.label}</a> ·
      <a href="/events/free/">Free</a> ·
      <a href="/events/kids/">Kids &amp; family</a>
    </p>
    {weekStories.length > 0 ? (
      // Homepage/vertical redundancy (NEEDS-HUMAN-REVIEW.md "4.4"): a short
      // teaser here, /events is the canonical complete view -- SectionRule's
      // "All →" link (above) is where the rest lives, not a second copy of
      // the full list on this page too.
      <div class="river">
        {weekStories.slice(0, 5).map((story) => <StoryCard story={story} facilities={facilities} />)}
      </div>
    ) : (
      <p class="empty">Nothing scheduled in the next week yet.</p>
    )}
  </section>

  <div class="front">
    {fullWidthLead ? (
      <LeadStory story={fullWidthLead} facilities={facilities} image={frontPageImageBySlug.get(fullWidthLead.slug)} />
    ) : secondary.length === 0 && (
      <p class="empty">Nothing scheduled right now. This page rebuilds every 6 hours.</p>
    )}

    {secondary.length > 0 && (
      <div class="front__secondary">
        {secondary.map((story) => <SecondaryStory story={story} facilities={facilities} image={frontPageImageBySlug.get(story.slug)} />)}
      </div>
    )}
  </div>

  <aside class="rail" aria-label="Conditions and numbers">
      {today && (
        <a class="rail__link" href="/weather/">
          <Tile
            label="Weather"
            value={today.temp !== null
              ? `${today.is_daytime ? 'High' : 'Low'} ${Math.round(today.temp)}°${today.unit}`
              : '—'}
            note={`${today.short} · 5-day forecast`}
          />
        </a>
      )}
      {gameSlot === 'jackrabbits' && nextGame ? (
        <>
          <a class="rail__link rail__game" href="/jackrabbits/">
            <GameCard game={nextGame} />
          </a>
          {/* Bara vid en RIKTIG Jackrabbits-match, inte ett allmänt SDSU-
              marquee-event eller en Moreno Valley-match -- se gameSlot
              ovan. Egen <a>, inte nästlad i länken ovan (ogiltig HTML). */}
          <JackrabbitGameDayLine />
        </>
      ) : gameSlot === 'sdsu' && nextSdsuEvent ? (
        <a class="rail__link rail__game" href="/university/">
          <SdsuEventCard event={nextSdsuEvent} />
        </a>
      ) : gameSlot === 'regional' && nextRegionalGame && (
        <a class="rail__link rail__game" href="/sports/">
          <RegionalGameCard game={nextRegionalGame} />
        </a>
      )}
      {isBrookings && <JackrabbitWidget />}
      {isMorenoValley && <BurroBonanzaWidget />}
      {/* 2026-10-01: gated on biggestHiringMover (Adzuna-sourced), not
          topEmployer (rating-sourced) -- rating/ranking is hidden pending
          a Glassdoor/Indeed ToS review, see WorkplaceWatchWidget.astro's
          own comment. With no rating to show, there's nothing left to
          headline the card with when hiring data is absent, so the card
          simply doesn't render in that case rather than showing an empty
          shell. */}
      {siteConfig.hasWorkplaceWatch && biggestHiringMover && (
        <WorkplaceWatchWidget
          hiringName={biggestHiringMover.name}
          hiringCount={biggestHiringMover.postings_now}
          hiringDelta={biggestHiringMover.postings_change}
        />
      )}
      {isBroomfield && latestVailNews && <VailNewsWidget item={latestVailNews} />}
      {trafficIncidents.length > 0 && (
        <a class="rail__link" href="/traffic/">
          <TrafficWidget incidents={trafficIncidents} />
        </a>
      )}
      {prices.length > 0 && (
        <a class="rail__link rail__prices" href="/farm-report/">
          <p class="rail__label">Markets</p>
          <table class="prices data">
            <tbody>
              {prices.map((p) => (
                <tr>
                  <th scope="row">{p.commodity}</th>
                  <td>{p.price !== null ? Number(p.price).toFixed(2) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </a>
      )}
      <p class="rail__hint">Tap a panel for the full picture &rarr;</p>
  </aside>

  {worthKnowingSelection.length > 0 && (
    // Significance, not recency -- the slot that surfaces a civic decision
    // (or hand-flagged item) that would otherwise be buried past the event
    // list's cap below. See lib/homepage-curation.ts:selectWorthKnowing()
    // for the rule-based selection (never AI-picked) and
    // NEEDS-HUMAN-REVIEW.md "Homepage Curation".
    <section aria-label="Worth knowing" class="worth-knowing">
      <SectionRule label="Worth knowing" />
      <div class="river">
        {worthKnowingSelection.map((story) => <StoryCard story={story} facilities={facilities} />)}
      </div>
    </section>
  )}

  {recentProjectUpdates.length > 0 && (
    <section aria-label="Project updates" class="project-updates">
      <SectionRule label="City hall project updates" href="/city-hall/projects/" />
      <ul class="project-updates__list">
        {recentProjectUpdates.map((u) => (
          <li>
            <a href={`/city-hall/projects/${u.project_slug}/`}>{u.project_title}</a>
            <span class="project-updates__meta">
              {' '}— {u.body}, {formatDate(u.meeting_date)}:
              {' '}{u.outcome === 'pending' ? 'reviewed, outcome not yet available' : u.outcome.toLowerCase()}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {laterStories.length > 0 && (
    <section aria-label="Coming up">
      <SectionRule label="Coming up" href="/events/" />
      <div class="river">
        {laterStories.slice(0, 5).map((story) => <StoryCard story={story} compact facilities={facilities} />)}
      </div>
    </section>
  )}

  {/* AdSense "low value content" remediation, Phase 0: "More to read"
      existed only to surface the shared/town-agnostic content-track items
      (recipe, review, science column), which stopped generating -- removed
      outright along with "Today's read" and "Latest from" above. */}

  <section aria-label="Sections">
    <SectionRule label={`More from ${siteConfig.cityName}`} />
    <div class="panels">
      {isBrookings && (
        <a class="panel" href="/university/">
          <h3>University</h3>
          <p>Games, concerts, shows and campus events at South Dakota State.</p>
        </a>
      )}
      {isBrookings && (
        <a class="panel" href="/jackrabbits/">
          <h3>Jackrabbits</h3>
          <p>Full schedules and results for SDSU football, basketball and volleyball.</p>
        </a>
      )}
      <a class="panel" href="/city-hall/">
        <h3>City hall</h3>
        <p>What the council, county commission and committees are deciding.</p>
      </a>
      {isBrookings && (
        <a class="panel" href="/farm-report/">
          <h3>Farm report</h3>
          <p>Corn, soybean and cattle prices from USDA.</p>
        </a>
      )}
    </div>
  </section>

  {/* SEO Fas 4 -- WebSite, homepage-only (NewsMediaOrganization already
      renders site-wide via BaseLayout.astro, a distinct @type from this).
      No potentialAction/SearchAction: the site has no internal search
      feature, and claiming one would be exactly the kind of unverified
      capability this project's structured data never asserts. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  })} />
</BaseLayout>

<style>

/* Marquee module (sitewide presentation-layer pass). */
.marquee-module { margin-bottom: 1.75rem; }
.marquee-module__also-on { margin-bottom: 0.75rem; }
.marquee-module__link {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
}

/* Front-page rhythm (Liveliness Spec §1): lead -> secondary -> widget row
   -> dense rivers, all stacked full-width, not a lead-beside-rail grid. */
.front { margin-bottom: 1.75rem; }
.front__secondary {
  display: grid;
  gap: 1.5rem;
  margin-top: 1.75rem;
}
@media (min-width: 40rem) {
  .front__secondary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Widget row -- a horizontal band of tiles below lead+secondary, not a
   sidebar column beside them. Each tile wraps at its own natural width. */
.rail {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: stretch;
  margin-bottom: 1.75rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--rule);
}
.rail__link { flex: 1 1 14rem; }
.rail__prices { flex-basis: 16rem; }
.rail__hint { flex-basis: 100%; }
.rail__link {
  display: block;
  color: inherit;
  text-decoration: none;
  border-radius: 3px;
  transition: background-color 0.12s ease;
}
.rail__link:hover { background: var(--navy-tint); }
.rail__hint {
  margin: 0.25rem 0 0;
  font-size: 0.75rem;
  color: var(--ink-soft);
  font-style: italic;
}
.rail__game { border-top: 1px solid var(--rule); padding-top: 0.25rem; }
.rail__prices { border-top: 1px solid var(--rule); padding-top: 0.75rem; }
.rail__label {
  margin: 0 0 0.375rem;
  font-family: var(--font-ui);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.prices { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.prices th {
  text-align: left; font-weight: 400; text-transform: capitalize;
  padding: 0.1875rem 0; color: var(--ink-soft);
}
.prices td { text-align: right; padding: 0.1875rem 0; font-variant-numeric: tabular-nums; }

/* Spaltström: hårfina vertikala linjer mellan spalterna, som i en tidning. */
.river { display: grid; gap: 0 1.5rem; }
@media (min-width: 40rem) {
  .river { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .river > :global(*) { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
  .river > :global(*:nth-child(2n + 1)) { border-left: 0; padding-left: 0; }
}
@media (min-width: 62rem) {
  .river { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .river > :global(*:nth-child(2n + 1)) { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
  .river > :global(*:nth-child(3n + 1)) { border-left: 0; padding-left: 0; }
}

.empty { color: var(--ink-soft); margin: 0; padding: 1rem 0; }

.event-teasers {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--navy);
  margin: -0.25rem 0 0.75rem;
}
.event-teasers a { color: inherit; }

.project-updates__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.project-updates__list li { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
.project-updates__list a { font-weight: 600; }
.project-updates__meta { color: var(--ink-soft); font-size: 0.9375rem; }

.panels { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
.panel {
  display: block;
  border-top: 1px solid var(--rule);
  padding: 0.875rem 0 1rem;
  text-decoration: none;
  color: inherit;
}
.panel h3 { margin: 0 0 0.25rem; color: var(--navy); }
.panel:hover h3 { text-decoration: underline; }
.panel p { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.45; }

/* Worth knowing: same StoryCard as the event rivers, with a left-border
   accent so a reader can tell these were curated, not just next in line. */
.worth-knowing { border-left: 3px solid var(--navy); padding-left: 1.125rem; }

/* .latest-from__*/.more-to-read__* rules removed, AdSense "low value
   content" remediation Phase 0 -- both sections only ever rendered the
   generic AI content track, which stopped generating (see the two removed
   sections' own comment further up this file). */
</style>

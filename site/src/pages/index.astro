---
/**
 * Förstasidan, byggd som en tidningsförstasida.
 *
 * Strukturen är TID, inte ämne: I dag -> Den här veckan -> Framöver. Frågan
 * sajten svarar på ("what's happening in Brookings?") handlar om när, inte om
 * vad -- de flesta lokalsajter sorterar efter kategori och blir svårare att
 * skanna för det.
 *
 * Hierarkin är avsiktlig: en etta som dominerar, ett högerfält med siffror
 * (väder, nästa match, råvarupriser -- tidningens väderruta och börstabell),
 * och därunder en spaltström avdelad med hårfina linjer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import LeadStory from '../components/LeadStory.astro';
import SecondaryStory from '../components/SecondaryStory.astro';
import WeeklyRoundup from '../components/WeeklyRoundup.astro';
import GameCard from '../components/GameCard.astro';
import RegionalGameCard from '../components/RegionalGameCard.astro';
import SdsuEventCard from '../components/SdsuEventCard.astro';
import JackrabbitWidget from '../components/JackrabbitWidget.astro';
import JackrabbitGameDayLine from '../components/JackrabbitGameDayLine.astro';
import WorkplaceWatchWidget from '../components/WorkplaceWatchWidget.astro';
import BurroBonanzaWidget from '../components/BurroBonanzaWidget.astro';
import SchoolAlertBanner from '../components/SchoolAlertBanner.astro';
import TrafficWidget from '../components/TrafficWidget.astro';
import Tile from '../components/Tile.astro';
import {
  getUpcomingStories, getActiveAlerts, getUpcomingGames, getNextRegionalGame,
  getNextSdsuMarqueeEvent, getActiveSchoolAlerts, getActiveTrafficIncidents,
  getWeather, getAgPrices, getLatestWeekly, getTodaysFeature, getLatestEmployerRatings,
  getWorthKnowingCandidates, getLatestFromCandidates, getRecentProjectUpdates, formatDate,
  CATEGORY_HREFS, CATEGORY_LABELS, getFacilities,
} from '../lib/db';
import { selectWorthKnowing, selectLatestFrom, firstSentence, selectFrontPageRhythm } from '../lib/homepage-curation';
import { todayUtcMidnight } from '../lib/events';
import { siteConfig } from '../lib/site-config';
import { resolveImage } from '../lib/images';
import { CATEGORY_IMAGES } from '../config/category-images';

const isBrookings = siteConfig.townId === 'brookings_sd';
const isMorenoValley = siteConfig.townId === 'moreno_valley_ca';

const [alerts, schoolAlerts, trafficIncidents, upcoming, games, nextRegionalGame, nextSdsuEvent, periods, prices, weekly, feature, worthKnowingCandidates, latestFromCandidates, facilities] = await Promise.all([
  getActiveAlerts(),
  getActiveSchoolAlerts(),
  getActiveTrafficIncidents(),
  // 'announcement' (t.ex. spellanseringen) ska in i SAMMA Today/This week-
  // ström som event/meeting -- inte en egen sektion för en enstaka
  // handskriven post, se lib/db.ts:SourceType.
  getUpcomingStories(['event', 'meeting', 'announcement'], 40),
  getUpcomingGames(3),
  getNextRegionalGame(),
  getNextSdsuMarqueeEvent(),
  getWeather(),
  getAgPrices(),
  getLatestWeekly(),
  getTodaysFeature(),
  getWorthKnowingCandidates(),
  getLatestFromCandidates(),
  getFacilities(),
]);

// Homepage curation (see NEEDS-HUMAN-REVIEW.md "Homepage Curation"): Latest
// From is computed FIRST because Worth Knowing's theme-collision check
// needs to know what Latest From already selected, not the other way
// around -- see selectWorthKnowing()'s own comment.
const latestFromSelection = selectLatestFrom(latestFromCandidates);
const alertBannerSlugs = new Set(alerts.map((a) => a.slug));
const worthKnowingSelection = selectWorthKnowing(worthKnowingCandidates, alertBannerSlugs, latestFromSelection);

const today = periods.find((p) => p.is_daytime) ?? periods[0] ?? null;

// Front-page rhythm (see NEEDS-HUMAN-REVIEW.md "Liveliness Spec" §1): a
// rule-based lead + secondary selection, not just "closest upcoming item"
// -- see lib/homepage-curation.ts's own docstring for the full fallback
// chain (active alert -> substantial meeting -> announcement -> newest
// imaged item -> newest, image or not). hasImage() reuses the SAME
// resolveImage() tier the actual <img> rendering uses, so the selection
// can never pick something LeadStory/SecondaryStory then fail to render an
// image for.
const hasImage = (story: (typeof upcoming)[number]) => resolveImage(story, {
  town: siteConfig.townId as 'brookings_sd' | 'moreno_valley_ca',
  cityName: siteConfig.cityName,
  facilities,
  categoryImages: CATEGORY_IMAGES[siteConfig.townId as 'brookings_sd' | 'moreno_valley_ca'],
}) !== null;

// No story-based widget today overlaps the front-page candidate pool (the
// rail's game/weather/traffic tiles all come from other tables, not
// `stories`) -- kept as a real Set, not hardcoded empty, so the rule stays
// enforced if that ever changes.
const widgetSlugs = new Set<string>();

const { fullWidthLead, secondary, usedSlugs } = selectFrontPageRhythm(upcoming, alerts, { hasImage, widgetSlugs });

const rest = upcoming.filter((s) => !usedSlugs.has(s.slug));

const startOfDay = new Date(); startOfDay.setHours(0, 0, 0, 0);
const endOfDay = new Date(startOfDay); endOfDay.setDate(endOfDay.getDate() + 1);
const weekEnd = new Date(startOfDay); weekEnd.setDate(weekEnd.getDate() + 8);

const within = (iso: string | null, from: Date, to: Date) =>
  !!iso && new Date(iso) >= from && new Date(iso) < to;

const todayStories = rest.filter((s) => within(s.occurs_at, startOfDay, endOfDay));
const weekStories = rest.filter((s) => within(s.occurs_at, endOfDay, weekEnd));
const laterStories = rest.filter((s) => s.occurs_at && new Date(s.occurs_at) >= weekEnd);

const nextGame = games[0] ?? null;

// City Hall project milestones (see NEEDS-HUMAN-REVIEW.md, "Week 3 -- City
// Hall Project Pages") -- real, sourced updates from the last 14 days,
// never a hand-picked/AI-selected slot. A separate block from Worth
// Knowing rather than folded into that Story-based pipeline: projects are
// a different entity (projects/project_updates, not stories), and this
// keeps that pipeline's selection rules untouched.
const recentProjectUpdates = await getRecentProjectUpdates(3);

// Homepage teaser into the Week 2 event landing pages (see
// NEEDS-HUMAN-REVIEW.md "Week 2 -- Event Landing Pages") -- picks whichever
// of Today/This-weekend is the more relevant search intent for the site's
// own local "today" (not the visitor's, not the build machine's), same
// timezone-correct primitive events.astro and the landing pages themselves
// use. Free/Kids stay evergreen regardless of the day.
const eventTeaserWeekday = todayUtcMidnight(siteConfig.timezone).getUTCDay(); // 0=Sun..6=Sat
const isEventTeaserWeekend = eventTeaserWeekday === 5 || eventTeaserWeekday === 6 || eventTeaserWeekday === 0;
const timelyEventTeaser = isEventTeaserWeekend
  ? { href: '/events/this-weekend/', label: 'This weekend' }
  : { href: '/events/today/', label: 'Today' };

// Cross-link a Jackrabbits HOME game happening today into the same "Today"
// river as events/meetings (see NEEDS-HUMAN-REVIEW.md "University Coverage
// Rebuild", A.1 -- a game day is exactly the kind of "what's happening
// today" fact this section exists for, and previously only surfaced in the
// separate rail widget, never in the main content stream). Home only --
// an away game doesn't affect anyone's day in Brookings the way a home game
// does (traffic, parking, foot draw), and the rail widget already covers
// "next game" regardless of home/away.
const todayHomeGame = isBrookings && nextGame && nextGame.home_away === 'home'
  && within(nextGame.starts_at, startOfDay, endOfDay) ? nextGame : null;

// Bara hämtat på Moreno Valley-builds -- ingen anledning att fråga en tabell
// som alltid är tom på Brookings.
const employerRatings = isMorenoValley ? await getLatestEmployerRatings() : [];
const topEmployer = employerRatings[0] ?? null;
const biggestMover = employerRatings.reduce<typeof employerRatings[number] | null>((best, e) => {
  if (e.rating_delta_vs_last_month === null) return best;
  if (!best || Math.abs(e.rating_delta_vs_last_month) > Math.abs(best.rating_delta_vs_last_month!)) return e;
  return best;
}, null);

// Jackrabbits nästa match och SDSU:s nästa "marquee"-evenemang (Athletics/
// Music) konkurrerar om SAMMA rail-slot för Brookings -- "mutually
// exclusive" enligt spec, inte två samtidiga rutor. Whichever is
// chronologically sooner vinner slotten; det finns inget "rätt" svar när
// båda finns (en Jackrabbits-match ÄR ofta redan med i SDSU:s egen
// Athletics-kategori), så tidsordning är den enda regeln som inte kräver
// att gissa vilken källa som "äger" sanningen.
const gameSlot: 'jackrabbits' | 'sdsu' | 'regional' | null =
  nextGame && nextSdsuEvent
    ? (new Date(nextGame.starts_at ?? 0) <= new Date(nextSdsuEvent.starts_at ?? 0) ? 'jackrabbits' : 'sdsu')
    : nextGame ? 'jackrabbits'
    : nextSdsuEvent ? 'sdsu'
    : nextRegionalGame ? 'regional'
    : null;
---

<BaseLayout title={`${siteConfig.siteName} — what's happening in ${siteConfig.cityName}, ${siteConfig.stateAbbr}`} wide>

  {alerts.length > 0 && (
    <section aria-label="Active alerts" class="alerts">
      {alerts.map((story) => <StoryCard story={story} />)}
    </section>
  )}

  <SchoolAlertBanner alerts={schoolAlerts} />

  {weekly && <WeeklyRoundup story={weekly} facilities={facilities} />}

  <div class="front">
    {fullWidthLead ? (
      <LeadStory story={fullWidthLead} facilities={facilities} />
    ) : secondary.length === 0 && (
      <p class="empty">Nothing scheduled right now. This page rebuilds every hour.</p>
    )}

    {secondary.length > 0 && (
      <div class="front__secondary">
        {secondary.map((story) => <SecondaryStory story={story} facilities={facilities} />)}
      </div>
    )}
  </div>

  <aside class="rail" aria-label="Conditions and numbers">
      {today && (
        <a class="rail__link" href="/weather/">
          <Tile
            label="Weather"
            value={`${today.temp !== null ? Math.round(today.temp) : '—'}°${today.unit}`}
            note={`${today.short} · 5-day forecast`}
          />
        </a>
      )}
      {gameSlot === 'jackrabbits' && nextGame ? (
        <>
          <a class="rail__link rail__game" href="/jackrabbits/">
            <GameCard game={nextGame} />
          </a>
          {/* Bara vid en RIKTIG Jackrabbits-match, inte ett allmänt SDSU-
              marquee-event eller en Moreno Valley-match -- se gameSlot
              ovan. Egen <a>, inte nästlad i länken ovan (ogiltig HTML). */}
          <JackrabbitGameDayLine />
        </>
      ) : gameSlot === 'sdsu' && nextSdsuEvent ? (
        <a class="rail__link rail__game" href="/university/">
          <SdsuEventCard event={nextSdsuEvent} />
        </a>
      ) : gameSlot === 'regional' && nextRegionalGame && (
        <a class="rail__link rail__game" href="/sports/">
          <RegionalGameCard game={nextRegionalGame} />
        </a>
      )}
      {isBrookings && <JackrabbitWidget />}
      {isMorenoValley && <BurroBonanzaWidget />}
      {isMorenoValley && topEmployer && (
        <WorkplaceWatchWidget
          topName={topEmployer.name}
          topRating={topEmployer.overall_rating}
          moverName={biggestMover?.name ?? null}
          moverDelta={biggestMover?.rating_delta_vs_last_month ?? null}
        />
      )}
      {trafficIncidents.length > 0 && (
        <a class="rail__link" href="/traffic/">
          <TrafficWidget incidents={trafficIncidents} />
        </a>
      )}
      {prices.length > 0 && (
        <a class="rail__link rail__prices" href="/farm-report/">
          <p class="rail__label">Markets</p>
          <table class="prices data">
            <tbody>
              {prices.map((p) => (
                <tr>
                  <th scope="row">{p.commodity}</th>
                  <td>{p.price !== null ? Number(p.price).toFixed(2) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </a>
      )}
      <p class="rail__hint">Tap a panel for the full picture &rarr;</p>
  </aside>

  {feature && (
    <section aria-label="Today's read">
      <SectionRule label="Today's read" href={CATEGORY_HREFS[feature.source_type]} />
      <LeadStory story={feature} facilities={facilities} />
    </section>
  )}

  {worthKnowingSelection.length > 0 && (
    // Significance, not recency -- the slot that surfaces a civic decision
    // (or hand-flagged item) that would otherwise be buried past the event
    // list's cap below. See lib/homepage-curation.ts:selectWorthKnowing()
    // for the rule-based selection (never AI-picked) and
    // NEEDS-HUMAN-REVIEW.md "Homepage Curation".
    <section aria-label="Worth knowing" class="worth-knowing">
      <SectionRule label="Worth knowing" />
      <div class="river">
        {worthKnowingSelection.map((story) => <StoryCard story={story} />)}
      </div>
    </section>
  )}

  {recentProjectUpdates.length > 0 && (
    <section aria-label="Project updates" class="project-updates">
      <SectionRule label="City hall project updates" href="/city-hall/projects/" />
      <ul class="project-updates__list">
        {recentProjectUpdates.map((u) => (
          <li>
            <a href={`/city-hall/projects/${u.project_slug}/`}>{u.project_title}</a>
            <span class="project-updates__meta">
              {' '}— {u.body}, {formatDate(u.meeting_date)}:
              {' '}{u.outcome === 'pending' ? 'reviewed, outcome not yet available' : u.outcome.toLowerCase()}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(todayStories.length > 0 || todayHomeGame) && (
    <section aria-label="Today">
      <SectionRule label="Today" href="/events/" />
      {todayHomeGame && (
        <div class="river">
          <GameCard game={todayHomeGame} feature />
        </div>
      )}
      {todayStories.length > 0 && (
        // Capped at 5 (see NEEDS-HUMAN-REVIEW.md "Homepage Curation") --
        // previously unbounded, which is exactly what let a 30+ item
        // events list dominate the homepage on a busy day. SectionRule's
        // "All →" (added above) is the real complete view now, same
        // pattern "This week"/"Coming up" already used.
        <div class="river">
          {todayStories.slice(0, 5).map((story) => <StoryCard story={story} />)}
        </div>
      )}
    </section>
  )}

  <section aria-label="This week">
    <SectionRule label="This week" href="/events/" />
    <p class="event-teasers">
      <a href={timelyEventTeaser.href}>{timelyEventTeaser.label}</a> ·
      <a href="/events/free/">Free</a> ·
      <a href="/events/kids/">Kids &amp; family</a>
    </p>
    {weekStories.length > 0 ? (
      // Homepage/vertical redundancy (NEEDS-HUMAN-REVIEW.md "4.4"): a short
      // teaser here, /events is the canonical complete view -- SectionRule's
      // "All →" link (above) is where the rest lives, not a second copy of
      // the full list on this page too.
      <div class="river">
        {weekStories.slice(0, 5).map((story) => <StoryCard story={story} />)}
      </div>
    ) : (
      <p class="empty">Nothing scheduled in the next week yet.</p>
    )}
  </section>

  {laterStories.length > 0 && (
    <section aria-label="Coming up">
      <SectionRule label="Coming up" href="/events/" />
      <div class="river">
        {laterStories.slice(0, 5).map((story) => <StoryCard story={story} compact />)}
      </div>
    </section>
  )}

  {latestFromSelection.length > 0 && (
    // The site's editorial verticals (Editorials/Columns/Reviews/Recipes)
    // -- previously invisible from the homepage entirely, buried below a
    // 30+ item events list. See lib/homepage-curation.ts:selectLatestFrom()
    // and NEEDS-HUMAN-REVIEW.md "Homepage Curation".
    <section aria-label="Latest from" class="latest-from">
      <SectionRule label={`Latest from ${siteConfig.siteName}`} />
      <div class="latest-from__grid">
        {latestFromSelection.map((story) => (
          <a class="latest-from__card" href={`/s/${story.slug}/`}>
            <p class="latest-from__kicker">{CATEGORY_LABELS[story.source_type] ?? 'Feature'}</p>
            <h3 class="latest-from__title">{story.title}</h3>
            <p class="latest-from__excerpt">{firstSentence(story.body)}</p>
            <span class="latest-from__read">Read &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section aria-label="Sections">
    <SectionRule label={`More from ${siteConfig.cityName}`} />
    <div class="panels">
      {isBrookings && (
        <a class="panel" href="/university/">
          <h3>University</h3>
          <p>Games, concerts, shows and campus events at South Dakota State.</p>
        </a>
      )}
      {isBrookings && (
        <a class="panel" href="/jackrabbits/">
          <h3>Jackrabbits</h3>
          <p>Full schedules and results for SDSU football, basketball and volleyball.</p>
        </a>
      )}
      <a class="panel" href="/city-hall/">
        <h3>City hall</h3>
        <p>What the council, county commission and committees are deciding.</p>
      </a>
      {isBrookings && (
        <a class="panel" href="/farm-report/">
          <h3>Farm report</h3>
          <p>Corn, soybean and cattle prices from USDA.</p>
        </a>
      )}
      <a class="panel" href="/reviews/">
        <h3>Reviews</h3>
        <p>What's playing right now, reviewed and clearly labeled as AI-written.</p>
      </a>
      <a class="panel" href="/recipes/">
        <h3>Recipes</h3>
        <p>Simple weeknight dinners built around what's in season.</p>
      </a>
      <a class="panel" href="/editorials/">
        <h3>Editorials</h3>
        <p>Opinion pieces on issues facing {siteConfig.cityName}.</p>
      </a>
      <a class="panel" href="/columns/">
        <h3>Columns</h3>
        <p>Culture, science and light essays -- a change of pace from the news.</p>
      </a>
    </div>
  </section>

  {/* SEO Fas 4 -- WebSite, homepage-only (NewsMediaOrganization already
      renders site-wide via BaseLayout.astro, a distinct @type from this).
      No potentialAction/SearchAction: the site has no internal search
      feature, and claiming one would be exactly the kind of unverified
      capability this project's structured data never asserts. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  })} />
</BaseLayout>

<style>
.alerts { margin-bottom: 1.25rem; }

/* Front-page rhythm (Liveliness Spec §1): lead -> secondary -> widget row
   -> dense rivers, all stacked full-width, not a lead-beside-rail grid. */
.front { margin-bottom: 1.75rem; }
.front__secondary {
  display: grid;
  gap: 1.5rem;
  margin-top: 1.75rem;
}
@media (min-width: 40rem) {
  .front__secondary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Widget row -- a horizontal band of tiles below lead+secondary, not a
   sidebar column beside them. Each tile wraps at its own natural width. */
.rail {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: stretch;
  margin-bottom: 1.75rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--rule);
}
.rail__link { flex: 1 1 14rem; }
.rail__prices { flex-basis: 16rem; }
.rail__hint { flex-basis: 100%; }
.rail__link {
  display: block;
  color: inherit;
  text-decoration: none;
  border-radius: 3px;
  transition: background-color 0.12s ease;
}
.rail__link:hover { background: var(--navy-tint); }
.rail__hint {
  margin: 0.25rem 0 0;
  font-size: 0.75rem;
  color: var(--ink-soft);
  font-style: italic;
}
.rail__game { border-top: 1px solid var(--rule); padding-top: 0.25rem; }
.rail__prices { border-top: 1px solid var(--rule); padding-top: 0.75rem; }
.rail__label {
  margin: 0 0 0.375rem;
  font-family: var(--font-ui);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.prices { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.prices th {
  text-align: left; font-weight: 400; text-transform: capitalize;
  padding: 0.1875rem 0; color: var(--ink-soft);
}
.prices td { text-align: right; padding: 0.1875rem 0; font-variant-numeric: tabular-nums; }

/* Spaltström: hårfina vertikala linjer mellan spalterna, som i en tidning. */
.river { display: grid; gap: 0 1.5rem; }
@media (min-width: 40rem) {
  .river { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .river > :global(*) { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
  .river > :global(*:nth-child(2n + 1)) { border-left: 0; padding-left: 0; }
}
@media (min-width: 62rem) {
  .river { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .river > :global(*:nth-child(2n + 1)) { border-left: 1px solid var(--rule); padding-left: 1.5rem; }
  .river > :global(*:nth-child(3n + 1)) { border-left: 0; padding-left: 0; }
}

.empty { color: var(--ink-soft); margin: 0; padding: 1rem 0; }

.event-teasers {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--navy);
  margin: -0.25rem 0 0.75rem;
}
.event-teasers a { color: inherit; }

.project-updates__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.project-updates__list li { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
.project-updates__list a { font-weight: 600; }
.project-updates__meta { color: var(--ink-soft); font-size: 0.9375rem; }

.panels { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
.panel {
  display: block;
  border-top: 1px solid var(--rule);
  padding: 0.875rem 0 1rem;
  text-decoration: none;
  color: inherit;
}
.panel h3 { margin: 0 0 0.25rem; color: var(--navy); }
.panel:hover h3 { text-decoration: underline; }
.panel p { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.45; }

/* Worth knowing: same StoryCard as the event rivers, with a left-border
   accent so a reader can tell these were curated, not just next in line. */
.worth-knowing { border-left: 3px solid var(--navy); padding-left: 1.125rem; }

.latest-from__grid { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
.latest-from__card {
  display: block;
  border-top: 1px solid var(--rule);
  padding: 0.875rem 0 1rem;
  text-decoration: none;
  color: inherit;
}
.latest-from__kicker {
  margin: 0 0 0.25rem;
  font-family: var(--font-ui);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.latest-from__title { margin: 0 0 0.3125rem; font-size: 1.0625rem; line-height: 1.2; color: var(--navy); }
.latest-from__card:hover .latest-from__title { text-decoration: underline; }
.latest-from__excerpt { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.45; }
.latest-from__read { display: inline-block; margin-top: 0.5rem; font-size: 0.8125rem; color: var(--navy); }
</style>

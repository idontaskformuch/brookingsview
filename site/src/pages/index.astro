  .river > :global(*:nth-child(3n + 1)) { border-left: 0; padding-left: 0; }
}

.empty { color: var(--ink-soft); margin: 0; padding: 1rem 0; }

.event-teasers {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--navy);
  margin: -0.25rem 0 0.75rem;
}
.event-teasers a { color: inherit; }

.project-updates__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.project-updates__list li { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
.project-updates__list a { font-weight: 600; }
.project-updates__meta { color: var(--ink-soft); font-size: 0.9375rem; }

.panels { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
.panel {
  display: block;
  border-top: 1px solid var(--rule);
  padding: 0.875rem 0 1rem;
  text-decoration: none;
  color: inherit;
}
.panel h3 { margin: 0 0 0.25rem; color: var(--navy); }
.panel:hover h3 { text-decoration: underline; }
.panel p { margin: 0; font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.45; }

/* Worth knowing: same StoryCard as the event rivers, with a left-border
   accent so a reader can tell these were curated, not just next in line. */
.worth-knowing { margin-top: var(--ui-5); }
.plain-list { list-style: none; margin: 0; padding: 0; }
.home-glance { margin: var(--ui-4) 0; }

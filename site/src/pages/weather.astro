---
/**
 * Weather: the standard "forecast" layout (.claude/standards.md). Question it answers: what is it like now, what is it doing today and what
 * should I plan for this week?
 *
 * Order: active warning (the only thing allowed above the answer) -> H1 + source/updated line -> hero (the forecast for the current hour,
 * labelled as a forecast) with its insight lines -> next 24 hours -> week ahead (one row per day, details behind a tap) -> About this page.
 * All numbers and sentences come from lib/weather-model.ts (pure, tested); the answer block is markup from lib/weather-html.ts, which the
 * browser reruns with a newer forecast (lib/live-weather.ts), so a page refreshed in the browser reads exactly like the built one.
 * Units, coordinates, authority and the official-warnings link come from config (site config + country profile), never from this file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WarningBanner from '../components/ui/WarningBanner.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import MetOfficeWarnings from '../components/MetOfficeWarnings.astro';
import { getWeatherSnapshot, getActiveAlerts } from '../lib/db';
import { siteConfig, isSectionDisabled } from '../lib/site-config';
import { metaDescription } from '../lib/meta-description';
if (isSectionDisabled('weather')) return Astro.redirect('/', 302);
import { countryProfile } from '../lib/country-profile';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubBacklink } from '../lib/clusters';
import { ownPageHref } from '../lib/ai-text';
import { localYMD } from '../lib/weather-format';
import { yesterdayHighFrom } from '../lib/weather-model';
import { viewFor, weatherRegionHtml, type WeatherConfig } from '../lib/weather-html';

const pageMeta = resolvePageMeta('weather', siteConfig);
const hubBacklink = resolveHubBacklink('weather', siteConfig);
const profile = countryProfile(siteConfig.country);

const [snapshot, alerts] = await Promise.all([getWeatherSnapshot(), getActiveAlerts()]);

const buildNow = new Date();
const tz = siteConfig.timezone;
const today = localYMD(buildNow, tz);
const yesterdayHigh = yesterdayHighFrom(snapshot.earlierPeriods, tz, buildNow);
const config: WeatherConfig = {
  unit: profile.temperatureUnit, lat: siteConfig.townCenter.lat, lon: siteConfig.townCenter.lon, tz, country: siteConfig.country,
  yesterday: yesterdayHigh === null ? null : { for: `${today.y}-${String(today.m).padStart(2, '0')}-${String(today.d).padStart(2, '0')}`, value: yesterdayHigh },
};
const view = viewFor({ periods: snapshot.periods, hourly: snapshot.hourly, fetchedAt: snapshot.fetchedAt }, config, buildNow);
const region = weatherRegionHtml(view);
const authority = profile.weather.authority;
const official = profile.weather.officialLink;
---
<BaseLayout title={pageMeta.title} ogSlug="section-weather" description={metaDescription('weather', siteConfig)}>
  {siteConfig.hasMetOfficeWarnings && <MetOfficeWarnings timezone={tz} variant="full" />}
  {alerts.length > 0 && (
    <div class="wx-warnings">
      {alerts.map((alert) => <WarningBanner href={ownPageHref(alert) ?? undefined} linkLabel="Details">{alert.title}</WarningBanner>)}
    </div>
  )}

  <header class="wx-head">
    <h1>{siteConfig.cityName} weather</h1>
    <p class="wx-meta"><a href={authority.url} rel="noopener">{authority.name}</a><span data-wx-updated-wrap hidden={view.updated ? undefined : true}> · Updated <span data-wx-updated>{view.updated ?? ''}</span></span></p>
  </header>

  <div data-weather-region data-fetched-at={view.fetchedAt ?? ''}>
    {region ? <Fragment set:html={region} /> : <EmptyState href={authority.url} linkLabel={`${authority.name} forecast`}>The forecast is not available right now.</EmptyState>}
  </div>
  <script type="application/json" data-weather-config set:html={JSON.stringify(config)}></script>

  {siteConfig.hasHeatAdvisory && alerts.some((a) => /heat/i.test(a.title)) && (
    <p class="wx-note">Active heat alert: see <a href="/workplace-watch/">Worker Pulse</a> for outdoor and loading-dock work risk guidance.</p>
  )}

  {alerts.length === 0 && (
    <p class="wx-note">{siteConfig.hasMetOfficeWarnings ? '' : `No active weather alerts for ${siteConfig.cityName} as of the last site update. `}{official.note}: <a href={official.url} rel="noopener">{official.label}</a>.</p>
  )}

  <AboutThisPage sources={[{ name: `${authority.name} forecast`, href: authority.url }]}>
    <p>The forecast for {siteConfig.cityName}: hour by hour for the next day and day by day for the week{siteConfig.hasMetOfficeWarnings ? ', with any Met Office weather warning in force shown first' : ', plus any active weather alerts'}.</p>
    <p>Use the hourly view to time a commute or an outdoor plan, and open an alert for what it means and how long it lasts. Forecasts change: the {authority.name} page is the authority.</p>
    <p>The large temperature is the forecast for the current hour, not a measurement. Sunrise and sunset are calculated from the location. Chance of precipitation, feels-like and gusts appear when the forecast gives them.</p>
    {hubBacklink && <p>Looking for a specific address instead? See <a href={hubBacklink.hubHref}>{hubBacklink.clusterLabel}</a>.</p>}
  </AboutThisPage>
</BaseLayout>

<style>
  .wx-warnings { display: grid; gap: var(--ui-2); margin: var(--ui-3) 0; }
  .wx-head { margin: var(--ui-4) 0 var(--ui-3); }
  .wx-head h1 { margin: 0; }
  .wx-meta { margin: var(--ui-1) 0 0; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .wx-note { margin: var(--ui-4) 0 0; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); }
  [data-weather-region] :global(.wx-insights) { display: grid; gap: var(--ui-2); margin: var(--ui-3) 0 0; }
  [data-weather-region] :global(.ui-hero) { margin-top: var(--ui-3); }
</style>


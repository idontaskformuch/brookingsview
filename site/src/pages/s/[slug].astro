---
/** Enskild story. Varje sida länkar tillbaka till sin primärkälla -- det är både
 *  hederligt mot läsaren och det som gör E-E-A-T-anspråket på metodsidan sant. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RelatedStories from '../../components/RelatedStories.astro';
import Byline from '../../components/Byline.astro';
import WorkerPulseComments from '../../components/WorkerPulseComments.astro';
import {
  getAllStories, getRelatedStories, formatOccursAt, formatDate, CATEGORY_LABELS,
  getWorkerPulseComments, getFacilities,
} from '../../lib/db';
import type { Story, Facility } from '../../lib/db';
import { buildEventJsonLd } from '../../lib/event-jsonld';
import { buildArticleJsonLd, buildDatasetJsonLd, buildRecipeJsonLd } from '../../lib/article-jsonld';
import { siteConfig } from '../../lib/site-config';

export async function getStaticPaths() {
  // Fetched once for the whole build, not per-page -- the facilities set is
  // small (a handful of rows) and doesn't vary per story.
  const [stories, facilities] = await Promise.all([getAllStories(), getFacilities()]);
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story, facilities } }));
}

const { story, facilities } = Astro.props as { story: Story; facilities: Facility[] };
const isAlert = story.source_type === 'alert';
const isMeeting = story.source_type === 'meeting' || story.source_type === 'meeting_followup';
const kind = isAlert ? 'Alert' : isMeeting ? 'Meeting' : 'Event';
// Genererat innehåll (krönikor m.fl.) har alltid byline satt -- scraped nyheter
// har byline = NULL. Byline.astro ersätter story__kind-raden när den finns, i
// stället för att visa båda (kind skulle ändå bara säga "Event" fel för dessa).
const hasByline = Boolean(story.byline);
const category = CATEGORY_LABELS[story.source_type] ?? story.source_type;
// Home sales digests keep a byline (AI-genererad) like other generated
// content, so the generic `when` slot below is normally empty for them --
// reuse it for an explicit "Covering <Month Year>" label instead, since
// occurs_at already stores the digest's covered month (see
// ai_pipeline/home_sales_digest.py) and was previously only surfaced on the
// /home-sales listing card, never on the digest's own page.
const isHomeSalesDigest = story.source_type === 'home_sales_digest';
const coveringMonth = isHomeSalesDigest && story.occurs_at
  ? new Date(story.occurs_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
const when = hasByline
  ? (coveringMonth ? `Covering ${coveringMonth}` : null)
  : (formatOccursAt(story) || null);
// "not yet released" placeholders are real, but thin and temporary --
// noindex until a later reconcile fills them in (generated_by flips away
// from 'data_pending' automatically once real sales data lands, see
// ai_pipeline/home_sales_digest.py's main()). "zero_sales" is genuinely
// substantive (a confirmed reporting fact), so it stays indexable.
const isNoindex = story.generated_by === 'data_pending';
// City-hall development items often name a ZIP directly ("...in the 92553
// area...") -- cross-link to the home-sales table pre-filtered to it, per
// NEEDS-HUMAN-REVIEW.md "3.2 City hall". Deliberately scoped to Moreno
// Valley's actual ZIP codes (a fixed, known list, see home-sales.astro's own
// zip-filter options) rather than a bare \d{5} match, which would also catch
// case/file numbers already common in meeting text.
const MOVAL_ZIPS = ['92551', '92552', '92553', '92555', '92557'];
const mentionedZips = isMeeting
  ? [...new Set(MOVAL_ZIPS.filter((z) => story.body.includes(z)))]
  : [];
const canonicalUrl = new URL(`/s/${story.slug}/`, Astro.site ?? siteConfig.siteUrl).href;
const related = await getRelatedStories(story, 3);
// Steg 3.5: en tecknad illustration matchad till artikeln, om en sådan finns.
// Har inte samma mått som OG-korten (1200x630) -- inga hårdkodade width/height
// för den, bara CSS-skalning. Saknas image_path (scraped content, eller om
// bildgenereringen misslyckades den dagen) faller sidan tillbaka på OG-kortet.
const heroSrc = story.image_path ?? `/og/${story.slug}.png`;
const heroUrl = new URL(heroSrc, Astro.site ?? siteConfig.siteUrl).href;

// Kommentarer bara på Worker Pulse-digester (se WorkerPulseComments.astro-
// docstringen) -- source_type existerar bara för Moreno Valley-storys, så
// det här blir aldrig sant på en Brookings-build.
const isWorkerPulseDigest = story.source_type === 'workplace_watch_digest';
const comments = isWorkerPulseDigest ? await getWorkerPulseComments(story.slug) : [];

// Event JSON-LD -- full decision tree lives in lib/event-jsonld.ts (unit-
// tested there, see event-jsonld.test.ts) so it's testable independent of
// Astro's build pipeline. See NEEDS-HUMAN-REVIEW.md, "Event JSON-LD venue
// resolution & emission rules" for the reasoning.
const eventJsonLdObject = buildEventJsonLd(
  story, facilities,
  { cityName: siteConfig.cityName, stateAbbr: siteConfig.stateAbbr,
    siteName: siteConfig.siteName, timezone: siteConfig.timezone },
  canonicalUrl, heroUrl,
);
---

<BaseLayout title={`${story.title} — ${siteConfig.siteName}`} description={story.body.slice(0, 155)} ogSlug={story.slug} noindex={isNoindex}>
  <article class="story">
    {!hasByline && <p class="story__kind data">{kind}</p>}
    <h1>{story.title}</h1>
    {hasByline && (
      <Byline category={category} byline={story.byline!} date={formatDate(story.published_at)} />
    )}
    {when && <p class="story__when data">{when}</p>}

    <img
      class="story__hero"
      src={heroSrc}
      alt={`Illustration for “${story.title}”`}
      loading="eager"
    />

    <div class="story__body">
      {story.body.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
    </div>

    {mentionedZips.length > 0 && (
      <p class="story__zip-links data">
        See recent home sales in {mentionedZips.map((zip, i) => (
          <>
            {i > 0 && ', '}
            <a href={`/home-sales/?zip=${zip}`}>{zip}</a>
          </>
        ))}
      </p>
    )}

    {story.ingredients && story.ingredients.length > 0 && (
      <>
        <h2 class="story__section-label">Ingredients</h2>
        <ul class="story__ingredients">
          {story.ingredients.map((ingredient) => <li>{ingredient}</li>)}
        </ul>
      </>
    )}

    {story.instructions && story.instructions.length > 0 && (
      <>
        <h2 class="story__section-label">Instructions</h2>
        <ol class="story__instructions">
          {story.instructions.map((step) => <li>{step}</li>)}
        </ol>
      </>
    )}

    {story.source_type === 'media_recension' && siteConfig.localTheaters && siteConfig.localTheaters.length > 0 && (
      /* The local anchor a review needs to justify running on a local site
         at all -- see NEEDS-HUMAN-REVIEW.md "3.3 Reviews". Names/links only,
         never showtimes: no permitted showtimes feed exists for these
         chains (same category as MaxPreps/HomeCampus -- proprietary,
         ticketing-partner-gated, not open data), so this points the reader
         to the theater's own site rather than asserting what's playing when. */
      <div class="story__theaters">
        <h2 class="story__section-label">Showing locally</h2>
        <p>Check current showtimes at theaters in {siteConfig.cityName}:</p>
        <ul>
          {siteConfig.localTheaters.map((t) => (
            <li><a href={t.url} rel="noopener">{t.name}</a></li>
          ))}
        </ul>
      </div>
    )}

    <ShareButtons url={canonicalUrl} title={story.title} />

    <footer class="story__source">
      {story.source_url ? (
        <p>
          Source: <a href={story.source_url} rel="noopener">the original agenda or listing</a>.
          Read it if you need the full detail — this summary is deliberately short.
        </p>
      ) : (
        <p>{siteConfig.sourceBlurb}</p>
      )}
      <p class="data">
        Published {formatDate(story.published_at)} ·
        <a href="/how-we-gather-this">How we gather this</a>
      </p>
    </footer>
  </article>

  <RelatedStories stories={related} />

  {isWorkerPulseDigest && <WorkerPulseComments pageSlug={story.slug} comments={comments} />}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildArticleJsonLd(story, heroUrl, siteConfig.siteName)
  )} />

  {(() => {
    const recipeJsonLd = buildRecipeJsonLd(story, heroUrl, siteConfig.siteName);
    return recipeJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(recipeJsonLd)} />
    );
  })()}

  {(() => {
    const datasetJsonLd = story.source_type === 'home_sales_digest'
      ? buildDatasetJsonLd(story, canonicalUrl, siteConfig.cityName, siteConfig.siteName)
      : null;
    return datasetJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetJsonLd)} />
    );
  })()}

  {eventJsonLdObject && (
    /* Resolved against the curated facilities registry -- see
       lib/event-jsonld.ts and ai_pipeline/venue_registry.py. Never ships a
       Place without a real resolved PostalAddress (the previous version of
       this block always claimed town-level location regardless of whether
       a real venue was known, which is exactly the kind of unverified
       claim Google's rich-result terms treat as spam). Unresolved-venue
       and recurring-series events render as plain HTML with no Event
       markup at all. */
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLdObject)} />
  )}
</BaseLayout>

<style>
.story { max-width: 38rem; }
.story__kind {
  margin: 0 0 0.5rem;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--navy);
}
.story__when { margin: 0.75rem 0 0; color: var(--ink-soft); font-size: 0.875rem; }
.story__hero {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 1.25rem;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 1.25rem;
}
.story__section-label {
  margin: 2rem 0 0.75rem;
  font-size: 1.25rem;
}
.story__ingredients {
  margin: 0;
  padding: 1rem 1.25rem;
  background: var(--paper-tint, rgba(0, 0, 0, 0.03));
  border: 1px solid var(--rule);
  border-radius: 0.375rem;
  font-size: 1.0625rem;
  line-height: 1.5;
}
.story__ingredients li { margin: 0.25rem 0; }
.story__instructions {
  margin: 0;
  padding-left: 1.5rem;
  font-size: 1.0625rem;
  line-height: 1.6;
}
.story__instructions li { margin: 0 0 0.75rem; padding-left: 0.25rem; }
.story__body { margin-top: 1.75rem; font-size: 1.125rem; }
.story__body p { margin: 0 0 1rem; }
.story__zip-links { color: var(--ink-soft); font-size: 0.875rem; margin: -0.5rem 0 1.25rem; }
.story__theaters { margin: 1.75rem 0; }
.story__theaters p { color: var(--ink-soft); margin: 0.5rem 0; }
.story__theaters ul { margin: 0.5rem 0 0; padding-left: 1.25rem; }
.story__theaters li { margin: 0.25rem 0; }
.story__source {
  margin-top: 2.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--rule);
  font-size: 0.9375rem;
  color: var(--ink-soft);
}
.story__source p { margin: 0 0 0.5rem; }
.story__source .data { font-size: 0.8125rem; }
</style>

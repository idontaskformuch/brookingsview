---
/** Enskild story. Varje sida länkar tillbaka till sin primärkälla -- det är både
 *  hederligt mot läsaren och det som gör E-E-A-T-anspråket på metodsidan sant. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import RelatedStories from '../../components/RelatedStories.astro';
import Byline from '../../components/Byline.astro';
import WorkerPulseComments from '../../components/WorkerPulseComments.astro';
import {
  getAllStories, getRelatedStories, formatOccursAt, formatDate, CATEGORY_LABELS,
  getWorkerPulseComments, getFacilities, buildVenueIndex, resolveVenue,
  hasResolvedAddress, isVirtualVenue, toZonedISOString,
} from '../../lib/db';
import type { Story, Facility } from '../../lib/db';
import { siteConfig } from '../../lib/site-config';

export async function getStaticPaths() {
  // Fetched once for the whole build, not per-page -- the facilities set is
  // small (a handful of rows) and doesn't vary per story.
  const [stories, facilities] = await Promise.all([getAllStories(), getFacilities()]);
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story, facilities } }));
}

const { story, facilities } = Astro.props as { story: Story; facilities: Facility[] };
const isAlert = story.source_type === 'alert';
const kind = isAlert ? 'Alert' : story.source_type === 'meeting' ? 'Meeting' : 'Event';
// Genererat innehåll (krönikor m.fl.) har alltid byline satt -- scraped nyheter
// har byline = NULL. Byline.astro ersätter story__kind-raden när den finns, i
// stället för att visa båda (kind skulle ändå bara säga "Event" fel för dessa).
const hasByline = Boolean(story.byline);
const category = CATEGORY_LABELS[story.source_type] ?? story.source_type;
// Home sales digests keep a byline (AI-genererad) like other generated
// content, so the generic `when` slot below is normally empty for them --
// reuse it for an explicit "Covering <Month Year>" label instead, since
// occurs_at already stores the digest's covered month (see
// ai_pipeline/home_sales_digest.py) and was previously only surfaced on the
// /home-sales listing card, never on the digest's own page.
const isHomeSalesDigest = story.source_type === 'home_sales_digest';
const coveringMonth = isHomeSalesDigest && story.occurs_at
  ? new Date(story.occurs_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
const when = hasByline
  ? (coveringMonth ? `Covering ${coveringMonth}` : null)
  : (formatOccursAt(story) || null);
// "not yet released" placeholders are real, but thin and temporary --
// noindex until a later reconcile fills them in (generated_by flips away
// from 'data_pending' automatically once real sales data lands, see
// ai_pipeline/home_sales_digest.py's main()). "zero_sales" is genuinely
// substantive (a confirmed reporting fact), so it stays indexable.
const isNoindex = story.generated_by === 'data_pending';
const canonicalUrl = new URL(`/s/${story.slug}/`, Astro.site ?? siteConfig.siteUrl).href;
const related = await getRelatedStories(story, 3);
// Steg 3.5: en tecknad illustration matchad till artikeln, om en sådan finns.
// Har inte samma mått som OG-korten (1200x630) -- inga hårdkodade width/height
// för den, bara CSS-skalning. Saknas image_path (scraped content, eller om
// bildgenereringen misslyckades den dagen) faller sidan tillbaka på OG-kortet.
const heroSrc = story.image_path ?? `/og/${story.slug}.png`;
const heroUrl = new URL(heroSrc, Astro.site ?? siteConfig.siteUrl).href;

// Kommentarer bara på Worker Pulse-digester (se WorkerPulseComments.astro-
// docstringen) -- source_type existerar bara för Moreno Valley-storys, så
// det här blir aldrig sant på en Brookings-build.
const isWorkerPulseDigest = story.source_type === 'workplace_watch_digest';
const comments = isWorkerPulseDigest ? await getWorkerPulseComments(story.slug) : [];

// Event JSON-LD emission decision tree -- see NEEDS-HUMAN-REVIEW.md, "Event
// JSON-LD venue resolution & emission rules". Every event resolves into
// exactly one branch; a Place with no real resolved PostalAddress must never
// ship (Google requires one for rich-result eligibility, and a placeholder
// reads as spam/an error, not a courtesy).
const isEvent = story.source_type === 'event' && story.occurs_at;
const venueIndex = isEvent ? buildVenueIndex(facilities) : null;
const resolvedVenue = venueIndex ? resolveVenue(venueIndex, story.venue_raw) : null;
const venueResolved = hasResolvedAddress(resolvedVenue);
const eventIsVirtual = isEvent && isVirtualVenue(story.venue_raw, story.body);
// A "series" story (ai_pipeline.publish.group_recurring_events) is ONE URL
// standing in for MANY real-world occurrences -- Google's one-event-one-URL
// rule means it can't honestly carry a single Event object, and this
// codebase deliberately has no per-occurrence URL to hang one on instead
// (that's the whole point of collapsing a recurring program into one page --
// see publish.py's moduldocstring on "scaled content"). Rather than emit an
// eventSchedule/Schedule object built from loosely-formatted display strings
// (series_dates is already human-formatted text, not structured data),
// series pages skip Event JSON-LD entirely and render as plain HTML.
const emitEventJsonLd = Boolean(isEvent) && !story.is_recurring_series && (venueResolved || eventIsVirtual);

function eventJsonLd() {
  const startDate = toZonedISOString(story.occurs_at!, siteConfig.timezone);
  const endDate = story.ends_at ? toZonedISOString(story.ends_at, siteConfig.timezone) : undefined;

  const physicalLocation = venueResolved ? {
    '@type': 'Place',
    name: resolvedVenue!.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: resolvedVenue!.street_address,
      addressLocality: siteConfig.cityName,
      addressRegion: siteConfig.stateAbbr,
      postalCode: resolvedVenue!.postal_code,
      addressCountry: 'US',
    },
    ...(resolvedVenue!.lat != null && resolvedVenue!.lon != null
      ? { geo: { '@type': 'GeoCoordinates', latitude: resolvedVenue!.lat, longitude: resolvedVenue!.lon } }
      : {}),
  } : null;
  const virtualLocation = eventIsVirtual ? { '@type': 'VirtualLocation', url: canonicalUrl } : null;

  const location = physicalLocation && virtualLocation
    ? [physicalLocation, virtualLocation]
    : (physicalLocation ?? virtualLocation);
  const eventAttendanceMode = physicalLocation && virtualLocation
    ? 'https://schema.org/MixedEventAttendanceMode'
    : virtualLocation
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode';

  return {
    '@context': 'https://schema.org',
    '@type': 'Event',
    '@id': canonicalUrl,
    url: canonicalUrl,
    name: story.title,
    startDate,
    ...(endDate ? { endDate } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode,
    location,
    description: story.body.slice(0, 300),
    image: [heroUrl],
    // The resolved venue is the most defensible organizer we can state
    // without inventing a fact (a library/park/city-hall event is
    // reasonably organized by the place hosting it); a virtual-only event
    // with no resolved physical venue falls back to the site itself rather
    // than guess.
    organizer: { '@type': 'Organization', name: resolvedVenue?.name ?? siteConfig.siteName },
  };
}
---

<BaseLayout title={`${story.title} — ${siteConfig.siteName}`} description={story.body.slice(0, 155)} ogSlug={story.slug} noindex={isNoindex}>
  <article class="story">
    {!hasByline && <p class="story__kind data">{kind}</p>}
    <h1>{story.title}</h1>
    {hasByline && (
      <Byline category={category} byline={story.byline!} date={formatDate(story.published_at)} />
    )}
    {when && <p class="story__when data">{when}</p>}

    <img
      class="story__hero"
      src={heroSrc}
      alt={`Illustration for “${story.title}”`}
      loading="eager"
    />

    <div class="story__body">
      {story.body.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
    </div>

    {story.ingredients && story.ingredients.length > 0 && (
      <>
        <h2 class="story__section-label">Ingredients</h2>
        <ul class="story__ingredients">
          {story.ingredients.map((ingredient) => <li>{ingredient}</li>)}
        </ul>
      </>
    )}

    {story.instructions && story.instructions.length > 0 && (
      <>
        <h2 class="story__section-label">Instructions</h2>
        <ol class="story__instructions">
          {story.instructions.map((step) => <li>{step}</li>)}
        </ol>
      </>
    )}

    <ShareButtons url={canonicalUrl} title={story.title} />

    <footer class="story__source">
      {story.source_url ? (
        <p>
          Source: <a href={story.source_url} rel="noopener">the original agenda or listing</a>.
          Read it if you need the full detail — this summary is deliberately short.
        </p>
      ) : (
        <p>{siteConfig.sourceBlurb}</p>
      )}
      <p class="data">
        Published {formatDate(story.published_at)} ·
        <a href="/how-we-gather-this">How we gather this</a>
      </p>
    </footer>
  </article>

  <RelatedStories stories={related} />

  {isWorkerPulseDigest && <WorkerPulseComments pageSlug={story.slug} comments={comments} />}

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: story.title,
    datePublished: story.published_at,
    dateModified: story.published_at,
    articleBody: story.body,
    image: [heroUrl],
    // story.byline är alltid den bokstavliga strängen "AI-genererad" (se
    // content/_base.py:to_metadata) -- en transparensmarkering, inte ett
    // riktigt namn. Att sätta '@type':'Person', name:'AI-genererad' skulle
    // hävda att en person med det namnet skrev texten, exakt den sortens
    // påhittade uppgift projektets egna regler annars aldrig tillåter.
    // Ingen story har en riktig mänsklig författare i nuläget, så
    // Organization gäller för alla.
    author: { '@type': 'Organization', name: siteConfig.siteName },
    publisher: { '@type': 'Organization', name: siteConfig.siteName },
  })} />

  {emitEventJsonLd && (
    /* Resolved against the curated facilities registry -- see
       ai_pipeline/venue_registry.py and the emitEventJsonLd/eventJsonLd()
       logic above. Never ships a Place without a real resolved
       PostalAddress (the previous version of this block always claimed
       town-level location regardless of whether a real venue was known,
       which is exactly the kind of unverified claim Google's rich-result
       terms treat as spam). Unresolved-venue and recurring-series events
       render as plain HTML with no Event markup at all. */
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd())} />
  )}
</BaseLayout>

<style>
.story { max-width: 38rem; }
.story__kind {
  margin: 0 0 0.5rem;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--navy);
}
.story__when { margin: 0.75rem 0 0; color: var(--ink-soft); font-size: 0.875rem; }
.story__hero {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 1.25rem;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 1.25rem;
}
.story__section-label {
  margin: 2rem 0 0.75rem;
  font-size: 1.25rem;
}
.story__ingredients {
  margin: 0;
  padding: 1rem 1.25rem;
  background: var(--paper-tint, rgba(0, 0, 0, 0.03));
  border: 1px solid var(--rule);
  border-radius: 0.375rem;
  font-size: 1.0625rem;
  line-height: 1.5;
}
.story__ingredients li { margin: 0.25rem 0; }
.story__instructions {
  margin: 0;
  padding-left: 1.5rem;
  font-size: 1.0625rem;
  line-height: 1.6;
}
.story__instructions li { margin: 0 0 0.75rem; padding-left: 0.25rem; }
.story__body { margin-top: 1.75rem; font-size: 1.125rem; }
.story__body p { margin: 0 0 1rem; }
.story__source {
  margin-top: 2.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--rule);
  font-size: 0.9375rem;
  color: var(--ink-soft);
}
.story__source p { margin: 0 0 0.5rem; }
.story__source .data { font-size: 0.8125rem; }
</style>

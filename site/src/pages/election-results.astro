---
/** /election-results -- unofficial results for the 3 Nov 2026 election (election 2026, phase 2).
 *  Spec: .claude/specs/election-2026.md. No AI text. The build renders the latest VALID snapshot (the same payload
 *  /api/election-results serves) into the HTML; only a build from before the end of election night also polls that
 *  endpoint in the browser. From the morning after, the page is the build's frozen numbers (owner B4, 2026-11-11),
 *  indexable until 1 December (isPastResultsIndexWindow). The official link is always in the HTML. */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../lib/site-config';
import { fitDescription } from '../lib/meta-description';
import { ELECTION_BY_TOWN } from '../config/election';
import { resolvePageMeta } from '../lib/page-meta';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { assertElectionValid, todayIn, isPastResultsIndexWindow, isVoteOver, formatYmd } from '../lib/election';
import { endpointFor, staticMetaLine, staticView } from '../lib/election-results';
import { getElectionResults } from '../lib/db';

const election = ELECTION_BY_TOWN[siteConfig.townId];
if (!election || !election.enabled || !election.results) {
  return Astro.redirect('/', 302);
}
assertElectionValid(siteConfig.townId, election);
const results = election.results;

const today = todayIn(siteConfig.timezone);
const pageMeta = resolvePageMeta('election-results', siteConfig);
const canonicalUrl = new URL('/election-results/', Astro.site ?? siteConfig.siteUrl).href;
// /vote/ is noindex once Election Day is over, so nothing here links to it after that (owner B4, 2026-11-11).
const voteOver = isVoteOver(today, election.election_date);
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  ...(voteOver ? [] : [{ label: 'How to vote', href: '/vote/' }]),
  { label: 'Election results', href: canonicalUrl },
];
const noindex = isPastResultsIndexWindow(today, election.election_date);
const payload = results.live ? await getElectionResults() : null;
const view = staticView(payload, results.source_name, siteConfig.siteName);
const shown = view.showNumbers && payload ? payload : null;
const hostOf = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const electionLabel = formatYmd(election.election_date, true);
---
<BaseLayout
  title={pageMeta.title}
  description={fitDescription(`Unofficial results for the ${electionLabel} election in ${siteConfig.cityName}, from the official source, with the time the source last updated.`)}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="er-hero">
    <h1>{pageMeta.h1}</h1>
    <p class="er-unofficial"><strong>Unofficial results.</strong> Final results are the ones the election authority certifies.</p>
  </header>

  <section class="er-live" aria-labelledby="er-heading" data-live={view.poll ? 'true' : 'false'} data-town={siteConfig.townId}
           data-endpoint={endpointFor()} data-source={results.source_name} data-tz={siteConfig.timezone}>
    <h2 id="er-heading">Results</h2>
    <p class="er-status" id="er-status" role={view.poll ? 'status' : undefined}>{view.text}</p>
    <p class="er-meta" id="er-meta" hidden={!shown}>{shown ? staticMetaLine(shown, siteConfig.timezone) : ''}</p>
    <p class="er-progress" id="er-progress" hidden></p>
    <div id="er-contests">
      {shown?.contests?.map((c) => (
        <article class="er-card">
          <h3 class="er-contest">{c.name}</h3>
          <ul class="er-choices">
            {c.choices.map((ch) => (
              <li class="er-choice">
                <div class="er-choice-head"><span class="er-name">{ch.name}</span><span class="er-votes">{ch.votes.toLocaleString('en-US')} · {ch.pct.toFixed(1)}%</span></div>
                <div class="er-bar"><div class="er-fill" style={`width:${Math.min(100, Math.max(0, ch.pct))}%`}></div></div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    {view.poll && <noscript><p class="er-status">Newer numbers need JavaScript. The official numbers from {results.source_name} are under Official source below.</p></noscript>}
  </section>

  <section class="er-official" aria-labelledby="er-official-h">
    <h2 id="er-official-h">Official source</h2>
    <ul>
      <li><a href={results.link.url} rel="noopener">{results.link.label}</a> <span class="er-host">({hostOf(results.link.url)})</span></li>
      {results.local_link && <li><a href={results.local_link.url} rel="noopener">{results.local_link.label}</a> <span class="er-host">({hostOf(results.local_link.url)})</span></li>}
    </ul>
    {results.local_link && <p class="er-note">Local Broomfield contests and ballot questions are not in the state's results feed, so they are linked, not copied.</p>}
    {!voteOver && <p class="er-note">How to vote, key dates and drop-off locations: <a href="/vote/">{siteConfig.cityName} voter guide</a>.</p>}
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl))} />
  <AboutThisPage slot="about">
    {results.notice && <p>{results.notice.text}</p>}
    <p>{results.live
      ? `The numbers are copied from ${results.source_name}. Percentages are worked out from the votes, choices are listed in the source's order, and nobody is called a winner here.`
      : `This page links to ${results.source_name} for the ${electionLabel} election results and does not copy the numbers.`}
      {' '}{siteConfig.siteName} is not an election authority; the election is run by {election.authority.name}.</p>
  </AboutThisPage>
</BaseLayout>

<script>
  import { metaLine, nextPollDelay, progressRow, viewState, type ResultsPayload } from '../lib/election-results';

  const root = document.querySelector<HTMLElement>('.er-live');
  if (root && root.dataset.live === 'true') {
    const el = (id: string) => document.getElementById(id)!;
    const status = el('er-status'), meta = el('er-meta'), progress = el('er-progress'), list = el('er-contests');
    const mk = (tag: string, cls?: string, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text; // textContent only: source strings are never parsed as HTML
      return n;
    };
    const render = (p: ResultsPayload | null) => {
      const v = viewState(p);
      if (v.kind !== 'results' || !p) { status.textContent = v.kind === 'results' ? '' : v.text; return; }
      status.textContent = '';
      meta.hidden = false;
      meta.textContent = metaLine(p, root.dataset.source ?? '', root.dataset.tz ?? 'UTC');
      const pl = progressRow(p);
      progress.hidden = !pl; progress.textContent = pl;
      list.replaceChildren(...(p.contests ?? []).map((c) => {
        const card = mk('article', 'er-card');
        card.appendChild(mk('h3', 'er-contest', c.name));
        const ol = mk('ul', 'er-choices');
        for (const ch of c.choices) { // source order, never re-sorted
          const li = mk('li', 'er-choice');
          const head = mk('div', 'er-choice-head');
          head.append(mk('span', 'er-name', ch.name), mk('span', 'er-votes', `${ch.votes.toLocaleString('en-US')} · ${ch.pct.toFixed(1)}%`));
          const bar = mk('div', 'er-bar'); const fill = mk('div', 'er-fill'); fill.style.width = `${Math.min(100, Math.max(0, ch.pct))}%`;
          bar.appendChild(fill); li.append(head, bar); ol.appendChild(li);
        }
        card.appendChild(ol);
        return card;
      }));
    };
    // Every 3 minutes while results are live (the Worker fetches every 10); every minute before that and
    // after an error so the page notices the moment results start; stops once automatic updates end.
    const load = async () => {
      let next = 60_000;
      try {
        const r = await fetch(root.dataset.endpoint!, { headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        const payload = (await r.json()) as ResultsPayload;
        render(payload);
        next = nextPollDelay(payload.phase) ?? 0;
      } catch { render(null); }
      if (next > 0) setTimeout(load, next);
    };
    void load();
  }
</script>

<style>
.er-hero { max-width: 46rem; margin: 0 auto 1.5rem; border-bottom: 3px solid var(--rule-strong); padding-bottom: 1.125rem; }
.er-unofficial { font-size: 1.125rem; margin: 0.5rem 0; }
.er-notice { color: var(--ink-soft); margin: 0; }
section { max-width: 46rem; margin: 0 auto 2rem; }
section h2 { margin: 0 0 0.75rem; }
.er-status { margin: 0 0 0.75rem; }
.er-meta { font-weight: 600; margin: 0 0 0.25rem; }
.er-progress { color: var(--ink-soft); margin: 0 0 1rem; }
.er-card { border-top: 1px solid var(--rule); padding: 0.875rem 0; }
.er-contest { margin: 0 0 0.625rem; font-size: 1.0625rem; }
.er-choices { list-style: none; margin: 0; padding: 0; }
.er-choice { margin-bottom: 0.625rem; }
.er-choice-head { display: flex; justify-content: space-between; gap: 1rem; }
.er-votes { font-variant-numeric: tabular-nums; color: var(--ink-soft); white-space: nowrap; }
.er-bar { height: 0.5rem; background: var(--paper-tint, var(--surface)); margin-top: 0.25rem; }
.er-fill { height: 100%; background: var(--ink-soft); }
.er-host, .er-note { color: var(--ink-soft); font-size: 0.9375rem; }
</style>

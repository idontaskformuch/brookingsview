---
/** /tonight -- "What can we do tonight?" (evening layer, steg 3; spec .claude/specs/weekend-layer.md T2).
 *  Rows come from lib/evening-items.ts (own events, SDSU, Ticketmaster); layout from lib/evening-page.ts. No AI text.
 *  Built for tonight and tomorrow night; the browser hides what has ended and flips the headings (script below + hide-ended sweep).
 *  Indexing: ALWAYS noindex and out of the sitemap until step 7 wires the threshold verdict (lib/evening-threshold.ts) to both,
 *  so the tag and the sitemap can never disagree. The verdict is only logged at build. Brookings (mode 'never') stays noindex for good. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageGuide from '../components/PageGuide.astro';
import ShareButton from '../components/ShareButton.astro';
import { getWeather, getActiveAlerts, getUpcomingStories, getUpcomingArtsEvents, getFacilities, getOsmSnapshot } from '../lib/db';
import { buildEventFeed, isFreeEvent } from '../lib/events';
import { siteConfig } from '../lib/site-config';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';
import { buildEveningEntries, toThresholdItems, driveLabel } from '../lib/evening-items';
import { evaluateEveningThreshold } from '../lib/evening-threshold';
import { buildEveningSections } from '../lib/evening-page';
import { placesFromSnapshot, openLateRows } from '../lib/osm-open-late';
import { gettingHomeFor } from '../lib/getting-home';
import { showTimeGb } from '../lib/whats-on-dates';
import { forecastLine } from '../lib/weather-format';
import { resolvePageMeta } from '../lib/page-meta';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';

const layer = siteConfig.eveningLayer;
if (!layer) {
  return Astro.redirect('/', 302);
}

const now = new Date();
const tz = siteConfig.timezone;
const [periods, alerts, stories, arts, facilities] = await Promise.all([
  getWeather(), getActiveAlerts(), getUpcomingStories(['event'], 200), getUpcomingArtsEvents(60), getFacilities(),
]);
const { items } = buildEventFeed(stories, arts, tz);
const tm = siteConfig.hasWhatsOn ? await getTicketmasterEventsForTown(siteConfig, { includeSports: layer.includeTicketmasterSports }) : [];
const checked = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
const entries = buildEveningEntries({
  feed: items, ticketmaster: tm, now, timezone: tz, checked, cityName: siteConfig.cityName,
  isFree: (i) => isFreeEvent(i, facilities),
  ticketmasterMaxMiles: layer.maxMiles,
  includeTicketmasterSports: layer.includeTicketmasterSports,
});
const verdict = evaluateEveningThreshold({ items: toThresholdItems(entries), now, timezone: tz, mode: layer.mode });
console.log(`[evening] ${siteConfig.townId}: indexable=${verdict.indexable} (${verdict.reason}) median items ${verdict.medianItems}, groups ${verdict.medianGroups}`);

const sections = buildEveningSections(entries, now, tz);
const osmSnapshot = layer.openLate ? await getOsmSnapshot() : null;
const osm = placesFromSnapshot(osmSnapshot, now) ?? [];
const osmChecked = osmSnapshot ? osmSnapshot.fetchedAt.slice(0, 10) : checked;
const lateBySection = new Map(sections.map((s) => [s.day, openLateRows(osm, s.day, tz)]));
const anyLate = [...lateBySection.values()].some((r) => r.length > 0);
const anyRows = sections.some((s) => s.count > 0) || anyLate;
const home = gettingHomeFor(siteConfig.townId, now);
const outside = entries.some((e) => e.driveMinutes !== null);
const forecast = forecastLine(periods, tz, now);
const alertCount = alerts.length;
const label = { 'Free': 'Free', '18+': '18+', 'All ages': 'All ages' } as const;
const dateOf = (iso: string) => new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(iso));
const dayLabelOf = (day: number) => new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(day * 86_400_000));

const pageMeta = resolvePageMeta('tonight', siteConfig);
const canonicalUrl = new URL('/tonight/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [{ label: 'Home', href: '/' }, { label: 'Tonight', href: canonicalUrl }];
const sourceNames = siteConfig.hasWhatsOn ? 'Local event calendars and Ticketmaster listings' : 'Local event calendars';
---
<BaseLayout title={pageMeta.title} canonicalUrl={canonicalUrl} noindex={true}
  description={`Things to do tonight and tomorrow night in ${siteConfig.cityName}: live music, comedy, quiz nights and more, with times, venues and what is free.`}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="tn-head">
    <h1>{pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  <PageGuide
    shows={`Events in ${siteConfig.cityName} that start this evening or tomorrow evening, grouped by what they are, with the start time, the venue and what is free.`}
    use={`Pick the group that fits the night, then open the listing for the source's own details before you go. Times can change, so check the source for anything you plan around.${layer.maxMiles > 15 ? ' Rows outside town show an estimated drive time.' : ''}`}
  >
    {sourceNames}, read {checked}. <a href="/how-we-gather-this/">How we gather this</a>.
  </PageGuide>

  {(forecast || alertCount > 0) && (
    <p class="tn-weather">
      {forecast && <span>{forecast} </span>}
      {alertCount > 0
        ? <a href="/weather/">{alertCount} active weather {alertCount === 1 ? 'alert' : 'alerts'}: check before you head out</a>
        : <a href="/weather/">Full forecast</a>}
    </p>
  )}

  {sections.map((s) => (
    <section class="tn-day" data-evening-day={s.day} data-tz={tz} data-built-kind={s.kind} aria-labelledby={`tn-h-${s.kind}`} hidden={s.count === 0 && lateBySection.get(s.day)!.length === 0 && s.kind === 'tomorrow' ? true : undefined}>
      <h2 id={`tn-h-${s.kind}`}><span data-evening-heading>{s.kind === 'tonight' ? 'Tonight' : 'Tomorrow night'}</span> <span class="tn-date">{dayLabelOf(s.day)}</span></h2>
      {s.count === 0 && <p class="tn-empty">Nothing listed for this evening yet.</p>}
      {s.highlights.length > 0 && (
        <ul class="tn-highlights" data-hide-ended>
          {s.highlights.map((e) => (
            <li class="tn-card" data-start={e.start} data-end={e.end ?? undefined}>
              <p class="tn-time">{showTimeGb(e.start, tz)}{e.group && <span class="tn-group"> · {e.group}</span>}</p>
              <h3>{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h3>
              {e.venue && <p class="tn-venue">{e.venue}</p>}
              {e.driveMinutes !== null && <p class="tn-drive">{driveLabel(e.driveMinutes)}</p>}
              {e.labels.length > 0 && <p class="tn-labels">{e.labels.map((l) => <span class="tn-label">{label[l]}</span>)}</p>}
            </li>
          ))}
        </ul>
      )}
      {s.groups.map((g) => (
        <div class="tn-group-block">
          <h3 class="tn-group-name">{g.name}</h3>
          <ul class="tn-rows" data-hide-ended data-hide-when-empty>
            {g.entries.map((e) => (
              <li class="tn-row" data-start={e.start} data-end={e.end ?? undefined}>
                <span class="tn-time">{showTimeGb(e.start, tz)}</span>
                <span class="tn-title">{e.href ? <a href={e.href}>{e.title}</a> : e.title}</span>
                {e.venue && <span class="tn-venue"> at {e.venue}</span>}
                {e.driveMinutes !== null && <span class="tn-drive"> ({driveLabel(e.driveMinutes)})</span>}
                {e.labels.map((l) => <span class="tn-label">{label[l]}</span>)}
              </li>
            ))}
          </ul>
        </div>
      ))}
      {lateBySection.get(s.day)!.length > 0 && (
        <div class="tn-group-block">
          <h3 class="tn-group-name">Open late</h3>
          <ul class="tn-rows" data-hide-ended data-hide-when-empty>
            {lateBySection.get(s.day)!.map((p) => (
              <li class="tn-row" data-start={p.start} data-end={p.end}>
                <span class="tn-title">{p.website ? <a href={p.website} rel="noopener">{p.name}</a> : p.name}</span>
                <span class="tn-venue"> · {p.kind}, {p.closing}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  ))}

  {anyLate && (
    <p class="tn-note">Open late lists pubs, bars, nightclubs and restaurants whose opening hours keep them open past 11 pm, latest closing first. Hours come from <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, read {osmChecked}. People edit them by hand, so check with the place before you go.</p>
  )}

  {!anyRows && (
    <p class="tn-none">Nothing is listed for this evening or the next. The <a href="/events/">full events list</a>{siteConfig.hasWhatsOn && <span> and <a href="/whats-on/">bigger shows in the region</a></span>} show what is coming later.</p>
  )}

  {outside && (
    <p class="tn-note">Drive times are estimates from straight-line distance to the venue, not a route plan. Only shows within {layer.maxMiles} miles of {siteConfig.cityName} are listed.</p>
  )}

  {home && (
    <section class="tn-home" aria-labelledby="tn-home-h">
      <h2 id="tn-home-h">Getting home from {siteConfig.cityName}</h2>
      <p>The {home.subway.name} runs {home.subway.hours.monSat} Monday to Saturday and {home.subway.hours.sunday} on Sunday. Last trains:</p>
      <table class="tn-table">
        <thead><tr><th scope="col">Circle</th><th scope="col">From</th><th scope="col">Mon to Sat</th><th scope="col">Sunday</th></tr></thead>
        <tbody>
          {home.subway.lastTrains.map((r) => <tr><td>{r.circle}</td><td>{r.from}</td><td>{r.monSat}</td><td>{r.sunday}</td></tr>)}
        </tbody>
      </table>
      <p>Event nights and holidays can change these times. Check the source before you rely on a last train.</p>
      <p>{home.rail.name} publishes last trains route by route, so use the planner for your own journey: <a href={home.rail.plannerUrl} rel="noopener">{home.rail.sourceLabel}</a>.</p>
      <p class="tn-checked">Source: <a href={home.subway.sourceUrl} rel="noopener">{home.subway.sourceLabel}</a>. Checked {home.checked}.</p>
    </section>
  )}

  <p class="tn-more">More than tonight: the <a href="/events/">full events list</a>.</p>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl))} />
</BaseLayout>

<script>
  import { sectionState } from '../lib/evening-page';
  // The build can be hours old: hide an evening that is over, and turn "Tomorrow night" into "Tonight" after midnight.
  document.querySelectorAll<HTMLElement>('[data-evening-day]').forEach((sec) => {
    const state = sectionState(Number(sec.dataset.eveningDay), new Date(), sec.dataset.tz || 'UTC');
    if (state.hidden) { sec.hidden = true; return; }
    const heading = sec.querySelector<HTMLElement>('[data-evening-heading]');
    if (heading) heading.textContent = state.kind === 'tonight' ? 'Tonight' : 'Tomorrow night';
  });
</script>

<style>
  .tn-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .tn-weather { margin: 0 0 1.25rem; color: var(--ink-soft); }
  .tn-day { margin: 0 0 2rem; }
  .tn-date { font-size: 0.9rem; font-weight: 400; color: var(--ink-soft); }
  .tn-highlights { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); list-style: none; padding: 0; margin: 0 0 1.25rem; }
  .tn-card { border: 1px solid var(--rule, #c8c6bd); padding: 0.75rem 0.9rem; background: var(--surface, transparent); }
  .tn-card h3 { margin: 0.15rem 0 0.25rem; font-size: 1.05rem; }
  .tn-card p { margin: 0; }
  .tn-time { font-variant-numeric: tabular-nums; font-weight: 600; }
  .tn-group, .tn-venue, .tn-drive { color: var(--ink-soft); font-weight: 400; }
  .tn-group-name { margin: 1rem 0 0.35rem; font-size: 1rem; }
  .tn-rows { list-style: none; padding: 0; margin: 0; }
  .tn-row { padding: 0.3rem 0; border-bottom: 1px solid var(--rule, #e4e2da); }
  .tn-row .tn-time { display: inline-block; min-width: 4.2rem; }
  .tn-label { display: inline-block; margin-left: 0.4rem; padding: 0 0.4rem; border: 1px solid var(--rule, #c8c6bd); font-size: 0.8rem; }
  .tn-labels { margin-top: 0.35rem; }
  .tn-note, .tn-checked, .tn-empty, .tn-none { color: var(--ink-soft); font-size: 0.9375rem; }
  .tn-home { margin: 2rem 0; max-width: 44rem; }
  .tn-table { border-collapse: collapse; margin: 0.5rem 0 1rem; }
  .tn-table th, .tn-table td { text-align: left; padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
</style>

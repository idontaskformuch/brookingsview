---
/** /tonight -- "What can we do tonight?" (evening layer; spec .claude/specs/weekend-layer.md T2). Same components as /this-weekend
 *  (components/evening/). Rows come from lib/evening-items.ts (own events, SDSU, Ticketmaster, the curated venue register); layout from
 *  lib/evening-page.ts. No generated text: the summary line is counted from the data.
 *  Built for tonight and tomorrow night; the browser hides what has ended and flips the headings (script below + hide-ended sweep).
 *  Indexing (lib/evening-verdict.ts): indexable only when the threshold verdict (lib/evening-threshold.ts) AND the owner's yes
 *  (siteConfig.eveningLayer.indexApproved) both hold. The one answer feeds the robots tag here and the sitemap filter (astro.config.mjs, via
 *  .evening-verdict.json), so tag and sitemap cannot disagree. Brookings (mode 'never') stays noindex for good. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareButton from '../components/ShareButton.astro';
import SectionHero from '../components/SectionHero.astro';
import EveningDay from '../components/evening/EveningDay.astro';
import EveningSummary from '../components/evening/EveningSummary.astro';
import EveningAbout from '../components/evening/EveningAbout.astro';
import { getWeather, getActiveAlerts, getUpcomingStories, getUpcomingArtsEvents, getFacilities, getOsmSnapshot, getEveningRegister } from '../lib/db';
import { buildEventFeed, isFreeEvent, ownVenueCity } from '../lib/events';
import { siteConfig } from '../lib/site-config';
import { countryProfile } from '../lib/country-profile';
import { metaDescription } from '../lib/meta-description';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';
import { buildEveningEntries, toThresholdItems } from '../lib/evening-items';
import { indexingForTown } from '../lib/evening-verdict';
import { buildEveningSections, eveningEntries } from '../lib/evening-page';
import TonightCard from '../components/tonight/TonightCard.astro';
import TonightRows from '../components/tonight/TonightRows.astro';
import TonightStyles from '../components/tonight/TonightStyles.astro';
import { chipPlan, countByRegion, cityScope, dayView, heroFor, pairNights, regionOf, scopeLine, unmappedAreas, SOON_MAX_CARDS, type CardTown } from '../lib/tonight-cards';
import { OPEN_LATE_MAX_ROWS } from '../lib/osm-open-late';
import TonightChips from '../components/tonight/TonightChips.astro';
import HeroStat from '../components/ui/HeroStat.astro';
import InsightLine from '../components/ui/InsightLine.astro';
import { showTimeGb } from '../lib/whats-on-dates';
import { placesFromSnapshot, openLateRows, openLateCounts, decorateOpenLate } from '../lib/osm-open-late';
import { areasFor, withAreas } from '../lib/areas';
import { gettingHomeFor } from '../lib/getting-home';
import { buildSummary, openAfterOneCount, lastSubwayTime } from '../lib/evening-summary';
import { hasEnded, localDayNumber, localHourOf } from '../lib/local-day';
import { EVENING_LAST_START_HOUR } from '../lib/evening-threshold';
import { forecastLine } from '../lib/weather-format';
import { resolvePageMeta } from '../lib/page-meta';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';

const layer = siteConfig.eveningLayer;
if (!layer) {
  return Astro.redirect('/', 302);
}

const now = new Date();
const tz = siteConfig.timezone;
const [periods, alerts, stories, arts, facilities] = await Promise.all([
  getWeather(), getActiveAlerts(), getUpcomingStories(['event'], 200), getUpcomingArtsEvents(60), getFacilities(),
]);
const { items } = buildEventFeed(stories, arts, tz);
const tm = siteConfig.hasWhatsOn ? await getTicketmasterEventsForTown(siteConfig, { includeSports: layer.includeTicketmasterSports }) : [];
const register = layer.register ? await getEveningRegister() : [];
const checked = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
const areaData = areasFor(siteConfig.townId);
const entries = withAreas(buildEveningEntries({
  feed: items, ticketmaster: tm, register, now, timezone: tz, checked, cityName: siteConfig.cityName, townId: siteConfig.townId, venueMiles: areaData?.venueMiles,
  isFree: (i) => isFreeEvent(i, facilities),
  venueCity: (i) => ownVenueCity(i, facilities),
  ticketmasterMaxMiles: layer.maxMiles,
  includeTicketmasterSports: layer.includeTicketmasterSports,
}), areaData);

const osmSnapshot = layer.openLate ? await getOsmSnapshot() : null;
const osm = placesFromSnapshot(osmSnapshot, now) ?? [];
const osmChecked = osmSnapshot ? osmSnapshot.fetchedAt.slice(0, 10) : checked;
const indexing = await indexingForTown({ townId: siteConfig.townId, siteUrl: siteConfig.siteUrl, layer, entries, osm, now, tz });

const sections = buildEveningSections(entries, now, tz, layer.nearMiles);
const anyFree = sections.some((s) => [...s.highlights, ...s.groups.flatMap((g) => g.entries), ...s.farGroups.flatMap((g) => g.entries)].some((e) => e.labels.includes('Free')));
const lateBySection = new Map(sections.map((s) => [s.day, decorateOpenLate(openLateRows(osm, s.day, tz, Number.MAX_SAFE_INTEGER), siteConfig.townId, areaData)]));
const anyLate = [...lateBySection.values()].some((r) => r.length > 0);
const anyRows = sections.some((s) => s.count > 0) || anyLate;
const home = gettingHomeFor(siteConfig.townId, now);
const outside = entries.some((e) => e.driveMinutes !== null);
const anyArea = entries.some((e) => e.area);
const forecast = forecastLine(periods, tz, now);
const alertCount = alerts.length;

const tonight = sections[0];
const cards = layer.cards;
const eveningOf = new Map(sections.map((s) => [s.day, eveningEntries(entries, s.day, tz)]));
const tonightEvents = [...(eveningOf.get(tonight.day) ?? [])].sort((a, b) => a.start.localeCompare(b.start));
const upNext = tonightEvents.filter((e) => new Date(e.start).getTime() > now.getTime() - 3 * 3_600_000).slice(0, SOON_MAX_CARDS);
const regions = cards?.regions ?? {};
const town: CardTown = { country: siteConfig.country, homeCity: siteConfig.cityName, center: siteConfig.townCenter, hidePrice: !!cards?.hidePrice, cityLabels: !!cards?.cityLabels };
// "12 in Broomfield · 31 nearby": by the source's own venue city; events with no stated city are in neither count
const scopeCounts = { home: 0, near: 0, unknown: 0 };
if (town.cityLabels) for (const e of tonightEvents) scopeCounts[cityScope(e.venueCity, town.homeCity)]++;
// what is still to come tonight / tomorrow night at build time (the browser recounts as events pass): drives the header and which sections show
const liveEvents = (day: number) => (eveningOf.get(day) ?? []).filter((e) => !hasEnded({ start: e.start, end: e.end }, now, tz)).length;
const liveLate = (day: number) => (lateBySection.get(day) ?? []).filter((p) => !hasEnded({ start: p.start, end: p.end }, now, tz)).length;
const hero = heroFor({ events: liveEvents(tonight.day), late: liveLate(tonight.day), tomorrow: sections[1] ? (eveningOf.get(sections[1].day) ?? []).length : 0, word: 'tonight' });
const scopeText = town.cityLabels ? scopeLine(scopeCounts, town.homeCity) : null;
const regionOrder = Object.keys(regions);
const tonightLateCards = (lateBySection.get(tonight.day) ?? []).slice(0, OPEN_LATE_MAX_ROWS);
// what a chip tap shows tonight: events + Open late places in the region
const chipThings = countByRegion([...tonightEvents.map((e) => regionOf(e.area, regions)), ...tonightLateCards.map((p) => regionOf(p.area, regions))]);
const plan = chipPlan(chipThings, regionOrder, null);
if (cards && regionOrder.length > 0) {
  const missing = unmappedAreas([...[...eveningOf.values()].flat().map((e) => e.area), ...[...lateBySection.values()].flat().map((p) => p.area)], regions);
  if (missing.length > 0) console.warn(`[tonight] areas in no chip region (shown under All only): ${missing.join(', ')}`);
}
const pairs = cards ? pairNights(tonightEvents, lateBySection.get(tonight.day) ?? [], now, tz) : [];
const tonightLate = openLateRows(osm, tonight.day, tz, Number.MAX_SAFE_INTEGER);
const isSunday = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'short' }).format(now) === 'Sun';
const lastTrain = lastSubwayTime(home, isSunday);
const summary = buildSummary({
  count: tonight.count, period: 'tonight', openAfterOne: openAfterOneCount(tonightLate, tonight.day, tz),
  lastTrain, subwayName: home?.subway.name,
});
const train = home && lastTrain ? { monSat: lastSubwayTime(home, false) ?? lastTrain, sunday: lastSubwayTime(home, true) ?? lastTrain, name: home.subway.name } : null;

const dateLocale = countryProfile(siteConfig.country).locale;
const dayLabelOf = (day: number) => new Intl.DateTimeFormat(dateLocale, { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(day * 86_400_000));
const updatedLabel = new Intl.DateTimeFormat(dateLocale, { timeZone: tz, day: 'numeric', month: 'long', year: 'numeric' }).format(now);

const pageMeta = resolvePageMeta('tonight', siteConfig);
const canonicalUrl = new URL('/tonight/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [{ label: 'Home', href: '/' }, { label: 'Tonight', href: canonicalUrl }];
const sourceNames = (siteConfig.hasWhatsOn ? 'Local event calendars and Ticketmaster listings' : 'Local event calendars') + (register.length > 0 ? ' and venue websites' : '');
---
<BaseLayout title={pageMeta.title} canonicalUrl={canonicalUrl} noindex={!indexing.indexable}
  description={metaDescription('tonight', siteConfig)}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class:list={['ev-head', { 'ev-head--cards': !!cards }]}>
    <h1>{layer.h1 ?? pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>
  <p class="ev-updated">Updated {updatedLabel} · <a href="#about-this-page">How we gather this</a></p>

  {cards ? (
    <div class="tc" data-tc data-tz={tz}>
      <TonightStyles />
      <section class="tc-hero" aria-label="Tonight at a glance">
        <HeroStat value={hero.count ?? 0} unit={hero.label ?? 'things on tonight'}
          rootAttrs={{ 'data-tc-count-box': '', hidden: hero.kind === 'empty' ? true : undefined }} valueAttrs={{ 'data-tc-count': '' }} unitAttrs={{ 'data-tc-count-label': '' }} />
        <p class="tc-empty" data-tc-empty hidden={hero.kind === 'empty' ? undefined : true}><span data-tc-empty-text>{hero.text}</span><span data-tc-empty-sep hidden={hero.tomorrow ? undefined : true}> · </span><a href="#tn-tomorrow-h" data-tc-tomorrow hidden={hero.tomorrow ? undefined : true}>{hero.tomorrow}</a></p>
        {town.cityLabels && <InsightLine class="tc-scope" attrs={{ 'data-tc-scope': '', 'data-home': town.homeCity, hidden: scopeText ? undefined : true }}>{scopeText}</InsightLine>}
        <InsightLine class="tc-next" attrs={{ 'data-tc-next': '', hidden: true }} />
      </section>

      {upNext.length > 0 && (
        <section class="tc-soon" data-tc-soon-box aria-labelledby="tc-soon-h">
          <h2 id="tc-soon-h" data-tc-soon-h>Up next</h2>
          <ul class="tc-row tc-row--lg" data-tc-soon>
            {upNext.map((e) => <TonightCard town={town} e={e} tz={tz} lg region={regionOf(e.area, regions)} />)}
          </ul>
        </section>
      )}

      {(forecast || alertCount > 0) && (
        <p class="ev-weather">
          {forecast && <span>{forecast} </span>}
          {alertCount > 0
            ? <a href="/weather/">{alertCount} active weather {alertCount === 1 ? 'alert' : 'alerts'}: check before you head out</a>
            : <a href="/weather/">Full forecast</a>}
        </p>
      )}

      <TonightChips order={regionOrder} plan={plan} />

      <div data-ev-page>
        {sections.map((s) => (
          <section class="tc-day" aria-labelledby={`tn-${s.kind}-h`} data-evening-day={s.day} data-tz={tz} data-built-kind={s.kind} data-tc-view={dayView({ events: liveEvents(s.day), late: liveLate(s.day) })}
            hidden={s.count === 0 && lateBySection.get(s.day)!.length === 0 && s.kind === 'tomorrow' ? true : undefined}>
            <h2 id={`tn-${s.kind}-h`} class="tc-day-h"><span data-evening-heading>{s.kind === 'tonight' ? 'Tonight' : 'Tomorrow night'}</span> <span class="ev-date">{dayLabelOf(s.day)}</span></h2>
            {s.kind === 'tonight' && pairs.length > 0 && (
              <section class="tc-night" data-tc-pairs aria-labelledby="tc-night-h">
                <h3 id="tc-night-h">Make a night of it</h3>
                <ul class="tc-pairs">
                  {pairs.map((p) => (
                    <li class="tc-pair" data-pair data-start={p.event.start} data-end={p.event.end ?? undefined} data-area={regionOf(p.event.area, regions) ?? undefined}>
                      <span class="tc-pair-time">{showTimeGb(p.event.start, tz)}</span>
                      <span class="tc-pair-main">
                        <a class="tc-pair-event" href={p.event.href ?? undefined}>{p.event.title}</a>
                        <span class="tc-meta">{[p.event.venue, p.event.area].filter(Boolean).join(' · ')}</span>
                      </span>
                      <span class="tc-pair-arrow" aria-hidden="true">→</span>
                      <span class="tc-pair-main">
                        <span class="tc-pair-place">{p.place.name} <span class="tc-pair-until">{p.place.closing}</span></span>
                        <span class="tc-meta">{p.walk} min walk (approx)</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )}
            <TonightRows id={`tn-${s.kind}`} entries={eveningOf.get(s.day) ?? []} late={lateBySection.get(s.day)!} tz={tz} regions={regions} town={town} />
          </section>
        ))}
      </div>

      <button type="button" class="tc-surprise" data-tc-surprise hidden>Surprise me</button>
    </div>
  ) : (<>
  <SectionHero section="today" evening compact />

  <EveningSummary parts={summary} label="Tonight at a glance" train={train} />

  {(forecast || alertCount > 0) && (
    <p class="ev-weather">
      {forecast && <span>{forecast} </span>}
      {alertCount > 0
        ? <a href="/weather/">{alertCount} active weather {alertCount === 1 ? 'alert' : 'alerts'}: check before you head out</a>
        : <a href="/weather/">Full forecast</a>}
    </p>
  )}

  <div data-ev-page>
    {sections.map((s) => (
      <EveningDay
        id={`tn-${s.kind}`} heading={s.kind === 'tonight' ? 'Tonight' : 'Tomorrow night'} dateLabel={dayLabelOf(s.day)}
        highlights={s.highlights} groups={s.groups} farGroups={s.farGroups} count={s.count} late={lateBySection.get(s.day)!} tz={tz}
        hidden={s.count === 0 && lateBySection.get(s.day)!.length === 0 && s.kind === 'tomorrow'}
        attrs={{ 'data-evening-day': s.day, 'data-tz': tz, 'data-built-kind': s.kind }}
      />
    ))}
  </div>
  </>)}

  {!anyRows && (
    <p class="ev-empty">Nothing is listed for this evening or the next. The <a href="/events/">full events list</a>{siteConfig.hasWhatsOn && <span> and <a href="/whats-on/">bigger shows in the region</a></span>} show what is coming later.</p>
  )}

  {home && (
    <section class="ev-home" aria-labelledby="ev-home-h">
      <h2 id="ev-home-h">Getting home from {siteConfig.cityName}</h2>
      <p>The {home.subway.name} runs {home.subway.hours.monSat} Monday to Saturday and {home.subway.hours.sunday} on Sunday. Last trains:</p>
      <table class="ev-table">
        <thead><tr><th scope="col">Circle</th><th scope="col">From</th><th scope="col">Mon to Sat</th><th scope="col">Sunday</th></tr></thead>
        <tbody>
          {home.subway.lastTrains.map((r) => <tr><td>{r.circle}</td><td>{r.from}</td><td>{r.monSat}</td><td>{r.sunday}</td></tr>)}
        </tbody>
      </table>
      <p>Event nights and holidays can change these times. Check the source before you rely on a last train.</p>
      <p>{home.rail.name} publishes last trains route by route, so use the planner for your own journey: <a href={home.rail.plannerUrl} rel="noopener">{home.rail.sourceLabel}</a>.</p>
      <p class="ev-note">Source: <a href={home.subway.sourceUrl} rel="noopener">{home.subway.sourceLabel}</a>. Checked {home.checked}.</p>
    </section>
  )}

  <p class="ev-more-links">More than tonight: <a href="/this-weekend/">this weekend</a> · the <a href="/events/">full events list</a>.</p>

  <EveningAbout
    shows={`Events in ${siteConfig.cityName} that start this evening or tomorrow evening, grouped by what they are, with the start time and the venue${anyFree ? ', and what is free' : ''}.`}
    use={`Pick the group that fits the night, then open the listing for the source's own details before you go. Times can change, so check the source for anything you plan around.${layer.maxMiles > 15 ? ' Rows outside town show an estimated drive time.' : ''}`}
  >
    <Fragment slot="sources">{sourceNames}, read {checked}. <a href="/how-we-gather-this/">How we gather this</a>.</Fragment>
    {anyLate && (
      <p class="ev-note">Open late lists pubs, bars, nightclubs and restaurants whose opening hours keep them open past 11 pm, latest closing first. Hours come from <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, read {osmChecked}. People edit them by hand, so check with the place before you go.</p>
    )}
    {anyArea && areaData && <p class="ev-note">{areaData.attribution}. The area shown is the nearest mapped one to the venue, so treat it as a guide.</p>}
    {outside && (
      <p class="ev-note">Drive times are estimates from straight-line distance to the venue, not a route plan. Only shows within {layer.maxMiles} miles of {siteConfig.cityName} are listed.</p>
    )}
  </EveningAbout>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl))} />
</BaseLayout>

<script>
  import { initTonightCards } from '../lib/tonight-cards-client';
  initTonightCards(document);
</script>

<script>
  import { sectionState } from '../lib/evening-page';
  import { refreshSummary } from '../lib/evening-client';
  // The build can be hours old: hide an evening that is over, and turn "Tomorrow night" into "Tonight" after midnight.
  let pageTz = 'UTC';
  document.querySelectorAll<HTMLElement>('[data-evening-day]').forEach((sec) => {
    pageTz = sec.dataset.tz || pageTz;
    const state = sectionState(Number(sec.dataset.eveningDay), new Date(), pageTz);
    if (state.hidden) { sec.hidden = true; return; }
    const heading = sec.querySelector<HTMLElement>('[data-evening-heading]');
    if (heading) heading.textContent = state.kind === 'tonight' ? 'Tonight' : 'Tomorrow night';
  });
  // After the hide-ended sweep (BaseLayout) has run: re-count what is still on.
  window.addEventListener('load', () => setTimeout(() => refreshSummary(document, pageTz, new Date(), (doc) => {
    const first = doc.querySelector<HTMLElement>('.ev-day:not([hidden]) [data-evening-heading]');
    return (first?.textContent ?? 'tonight').toLowerCase();
  }, true), 0));
</script>

<style>
  .ev-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.25rem; }
  .ev-head--cards h1 { font-size: 1.625rem; line-height: 1.15; margin: 0.25rem 0 0; }
  .ev-head--cards + .ev-updated { font-size: 0.8125rem; margin-bottom: 0.25rem; }
  .ev-updated { margin: 0 0 1rem; color: var(--ink-soft); font-size: 0.9375rem; }
  .ev-weather { margin: 0 0 1.25rem; color: var(--ink-soft); }
  .ev-note, .ev-empty { color: var(--ink-soft); font-size: 0.9375rem; }
  .ev-home { margin: 2rem 0; max-width: 44rem; }
  .ev-table { border-collapse: collapse; margin: 0.5rem 0 1rem; }
  .ev-table th, .ev-table td { text-align: left; padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
  .ev-more-links { margin: 1.5rem 0 0; }
</style>

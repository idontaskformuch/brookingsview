---
/** Veterans Day page (Broomfield only), rendered from data (config/holiday-pages/veterans-day.ts) by the shared
 *  holiday template. Indexable Nov 1-12 2026 (lib/veterans-day.ts), noindex after. Other towns redirect home and
 *  stay out of the sitemap (astro.config.mjs). */
import HolidayPage from '../components/HolidayPage.astro';
import { siteConfig } from '../lib/site-config';
import { buildVeteransDayPage } from '../config/holiday-pages/veterans-day';
import { isOutsideVeteransDayWindow } from '../lib/veterans-day';

const page = buildVeteransDayPage(siteConfig.townId);
if (!page) {
  return Astro.redirect('/', 302);
}
---
<HolidayPage page={page} holidayLabel="Veterans Day" noindex={isOutsideVeteransDayWindow(Date.now())} hasClosures={!!siteConfig.hasClosureWatch} />

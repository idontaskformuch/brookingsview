---
/** Phase 8 ("Month in <Town>") -- build-time, no-AI monthly recap across
 *  six structured-data modules (decisions, projects, home sales, events,
 *  traffic, jobs). See lib/month-in-review.ts's own module doc for the
 *  per-module coverage rule and .claude/phase8-research.md for the full
 *  data audit this is built from.
 *
 *  Not a `stories` row / `/s/[slug]/` page on purpose (research section
 *  3): this is build-time SQL aggregation, not AI-generated content, so
 *  it doesn't belong in the editorial pipeline -- same "structured data,
 *  its own page, never a story" reasoning as /traffic or /home-sales.
 *
 *  getStaticPaths naturally returns [] for any town with no
 *  MONTH_IN_REVIEW_START entry (today: every town except moreno_valley_ca)
 *  -- owner condition 6, same "gracefully empty elsewhere, no redirect
 *  needed" pattern as home-sales/[slug].astro's own getStaticPaths.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getContentByType } from '../../lib/db';
import { storyHref } from '../../lib/content-slugs';
import {
  listEligibleMonths, monthBoundsUTC, monthLabel, monthSlug,
  buildDecisionsModule, buildProjectsModule, buildSalesModule, buildEventsModule,
  buildTrafficModule, buildJobsModule,
  decisionsSentence, projectsSentence, salesSentence, eventsSentence, trafficSentence, jobsSentence,
  clearedModuleCount, MIN_MODULES_FOR_INDEX,
} from '../../lib/month-in-review';
import { siteConfig } from '../../lib/site-config';
import { placeAbbr } from '../../lib/country-profile';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { buildClusterBreadcrumbTrail } from '../../lib/clusters';

export async function getStaticPaths() {
  const months = listEligibleMonths(siteConfig.townId, siteConfig.timezone);
  return months.map(({ year, month }) => ({
    params: { slug: monthSlug(year, month) },
    props: { year, month },
  }));
}

const { year, month } = Astro.props as { year: number; month: number };
const { start, end } = monthBoundsUTC(year, month);
const label = monthLabel(year, month);
const slug = monthSlug(year, month);

const [decisions, projects, sales, events, traffic, jobs, digests] = await Promise.all([
  buildDecisionsModule(start, end),
  buildProjectsModule(start, end),
  buildSalesModule(start, end),
  buildEventsModule(year, month, siteConfig.timezone, siteConfig.townId, siteConfig.cityName, siteConfig.townCenter),
  buildTrafficModule(start, end, siteConfig.townId, siteConfig.trafficCorridors, siteConfig.trafficCorridorMaxMiles),
  buildJobsModule(start, end, siteConfig.cityName),
  // Bidirectional link with the existing AI home-sales digest (research
  // section 2: "link, don't replace" -- the digest is the only real
  // editorial content for this topic, Phase 8 itself is numbers-only).
  getContentByType(['home_sales_digest'], 999),
]);

const cleared = clearedModuleCount([decisions, projects, sales, events, traffic, jobs]);
// Owner condition 7: noindex until >=4 of 6 modules have real data for
// this town+month.
const isNoindex = cleared < MIN_MODULES_FOR_INDEX;

const digestSlug = `home-sales-digest-${year}-${String(month).padStart(2, '0')}`;
// generated_by === 'data_pending' is the same "county hasn't released this
// month yet" placeholder s/[slug].astro and astro.config.mjs's own
// noindexStoryUrls already treat specially -- its body literally says
// "Sales data for ... has not yet been released," so linking to it here
// as "what sold" would be misleading. Only link when a REAL digest exists,
// which in practice tracks `sales.status === 'full'` anyway, but checking
// generated_by directly is the one source of truth, not a re-derived proxy.
const digestExists = digests.some((d) => d.slug === digestSlug && d.generated_by !== 'data_pending');

interface ModuleRow { key: string; label: string; text: string | null; href: string }
const trafficSourceName = siteConfig.trafficSource?.name ?? 'our traffic coverage';
const rows = ([
  { key: 'decisions', label: 'City hall', text: decisionsSentence(decisions, label, siteConfig.cityName, siteConfig.siteName), href: '/city-hall/' },
  { key: 'projects', label: 'Active projects', text: projectsSentence(projects, label, siteConfig.cityName, siteConfig.siteName), href: '/city-hall/projects/' },
  { key: 'sales', label: 'Home sales', text: salesSentence(sales, label, siteConfig.cityName), href: '/home-sales/' },
  { key: 'events', label: 'Events', text: eventsSentence(events, label, siteConfig.cityName, siteConfig.siteName), href: '/events/' },
  { key: 'traffic', label: 'Traffic', text: trafficSentence(traffic, label, siteConfig.cityName, trafficSourceName), href: '/traffic/' },
  { key: 'jobs', label: 'Jobs', text: jobsSentence(jobs, label, siteConfig.cityName), href: '/jobs/' },
] satisfies ModuleRow[]).filter((r): r is ModuleRow & { text: string } => r.text !== null);

const title = `${siteConfig.cityName} in ${label} — ${siteConfig.siteName}`;
const h1 = `${siteConfig.cityName} in ${label}`;
const canonicalUrl = new URL(`/month/${slug}/`, Astro.site ?? siteConfig.siteUrl).href;
const description = `A month-in-review recap of ${placeAbbr(siteConfig)} for ${label}: city hall decisions, development projects, home sales, events, traffic and jobs, compiled from public data sources.`;

const breadcrumbTrail: BreadcrumbEntry[] = [
  ...buildClusterBreadcrumbTrail('month', siteConfig, { label: 'Month in review', href: '/month/' }),
  { label, href: canonicalUrl },
];
---
<BaseLayout title={title} ogSlug="section-city-hall" description={description} noindex={isNoindex}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <article class="month-review">
    <header class="lede">
      <h1>{h1}</h1>
      <p>A numbers-only recap of {placeAbbr(siteConfig)} for {label},
      compiled from public data sources. <a href="/month/">See all months</a>.</p>
      <ShareButton title={title} url={canonicalUrl} />
    </header>

    {rows.length > 0 ? (
      <ul class="modules">
        {rows.map((r) => (
          <li class="module">
            <p class="module__text">{r.text}</p>
            <p class="module__link"><a href={r.href}>See {r.label} →</a></p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No structured data cleared for display yet for {label}.</p>
    )}

    {digestExists && (
      <p class="digest-link">
        Read the full write-up: <a href={storyHref(digestSlug)}>{siteConfig.cityName} home sales: what sold in {label} →</a>
      </p>
    )}

    <p class="back"><a href="/month/">← All months</a></p>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede { max-width: 42rem; border-bottom: 3px solid var(--rule-strong); padding-bottom: 1.125rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.modules { list-style: none; margin: 1.5rem 0 0; padding: 0; max-width: 42rem; display: grid; gap: 0.75rem; }
.module { border: 1px solid var(--rule); padding: 0.875rem 1rem; }
.module__text { margin: 0; }
.module__link { margin: 0.375rem 0 0; font-size: 0.875rem; }
.empty { color: var(--ink-soft); }
.digest-link { margin-top: 1.25rem; font-size: 0.9375rem; }
.back { margin-top: 2rem; font-size: 0.9375rem; }
</style>

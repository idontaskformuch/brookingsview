---
/** Trafikincidenter som TABELL, ingen AI -- se lib/db.ts (getActiveTrafficIncidents)
 *  och scrapers/parsers/traffic_v1.py.
 *
 *  Till skillnad från /sports eller /home-sales är den här sidan INTE
 *  ort-gated med en redirect -- traffic är konceptuellt en funktion som kan
 *  gälla vilken ort som helst, det är bara KÄLLAN som (ännu) saknas för
 *  Brookings (se traffic._notes i configs/brookings_sd.json). En redirect
 *  hade felaktigt sagt "den här funktionen finns inte för din ort" när det
 *  rätta är "ingen data ännu" -- samma princip som /facilities//weather,
 *  som också bara renderar vad som finns i DB:n utan att gissa bort orter. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import { getActiveTrafficIncidents, formatTimeWithZone, plainLanguageTraffic } from '../lib/db';
import { siteConfig } from '../lib/site-config';
import SectionHero from '../components/SectionHero.astro';
import { EMPTY_STATES } from '../lib/empty-states';
import { SECTION_THEME } from '../lib/section-theme';

const incidents = await getActiveTrafficIncidents();

const typeLabel = (t: string) => (t === 'lane_closure' ? 'Lane closure / construction' : 'Incident');

const SEVERITY_LABELS: Record<string, string> = {
  closure: 'Closure', injury: 'Injury reported', incident: 'Incident', planned: 'Planned closure',
};
---
<BaseLayout title={`Traffic in ${siteConfig.cityName} — ${siteConfig.siteName}`} wide ogSlug="section-traffic"
  description={`Current road incidents and lane closures affecting ${siteConfig.cityName}, ${siteConfig.stateAbbr}.`}
  accentColor={SECTION_THEME.traffic.accent}>
  <SectionHero category="traffic" />
  <header class="lede">
    <h1>Traffic</h1>
    <p>Current road incidents, closures and construction near {siteConfig.cityName} —
    straight from the state's own public traffic feed.</p>
    <ShareButton title={`Traffic in ${siteConfig.cityName} — ${siteConfig.siteName}`} />
  </header>

  <SectionRule label={incidents.length > 0 ? `${incidents.length} active` : 'Current incidents'} />

  {incidents.length > 0 && (
    <div class="controls">
      <label>
        Severity
        <select id="severity-filter">
          <option value="">All</option>
          {[...new Set(incidents.map((i) => i.severity ?? 'incident'))].map((s) => (
            <option value={s}>{SEVERITY_LABELS[s] ?? s}</option>
          ))}
        </select>
      </label>
    </div>
  )}

  {incidents.length > 0 ? (
    <table class="incidents" id="incidents-table">
      <thead>
        <tr><th scope="col">Severity</th><th scope="col">Road</th><th scope="col">Details</th><th scope="col">Last updated</th></tr>
      </thead>
      <tbody>
        {incidents.map((incident) => (
          <tr data-severity={incident.severity ?? 'incident'}>
            <td class={`sev sev--${incident.severity ?? 'incident'}`}>
              {SEVERITY_LABELS[incident.severity ?? 'incident']}
            </td>
            <td>{incident.road ?? '—'}</td>
            <td>
              <p class="plain">{plainLanguageTraffic(incident.title)}</p>
              {incident.description && <p class="plain desc">{plainLanguageTraffic(incident.description)}</p>}
              <details class="raw">
                <summary>View source detail</summary>
                <p class="type">{typeLabel(incident.incident_type)}</p>
                <p>{incident.title}</p>
                {incident.description && <p>{incident.description}</p>}
              </details>
            </td>
            <td class="data">{formatTimeWithZone(incident.last_seen_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : siteConfig.trafficSource ? (
    <p class="empty">{EMPTY_STATES.traffic}</p>
  ) : (
    // Never render "No active incidents" when there's no actual source
    // behind it -- that reads as "roads are clear," not the true state
    // ("we don't have a live feed for this area yet"). See
    // NEEDS-HUMAN-REVIEW.md "Traffic wrong-state source fix".
    <p class="empty no-source">
      No public live traffic-incident feed has been found for {siteConfig.cityName} yet
      (checked SD511.org and South Dakota DOT's GIS server directly -- neither
      exposes an open incident API at this time). For winter road safety and
      closures, <a href="/weather/">check active weather alerts</a>, which does
      cover this area.
    </p>
  )}

  <p class="source">
    {siteConfig.trafficSource ? (
      <>Source: <a href={siteConfig.trafficSource.url} rel="noopener">{siteConfig.trafficSource.name}</a>, refreshed regularly. {siteConfig.trafficSource.scopeNote}</>
    ) : (
      <>No traffic data source configured for {siteConfig.cityName} yet.</>
    )}
  </p>

  <RelatedContent pageType="traffic" />
</BaseLayout>

<script>
  import { initDataTable } from '../lib/data-table';
  import { EMPTY_STATES } from '../lib/empty-states';

  function init() {
    initDataTable({
      tableId: 'incidents-table',
      filters: [{ selectId: 'severity-filter', attr: 'severity' }],
      emptyMessage: EMPTY_STATES.searchFilter,
    });
  }
  init();
</script>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.source a { color: var(--section-accent, var(--navy)); }
.controls { display: flex; gap: 1.25rem; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
.controls label { display: flex; align-items: center; gap: 0.4rem; color: var(--ink-soft); }
.controls select { font: inherit; padding: 0.2rem 0.4rem; }
.incidents { width: 100%; border-collapse: collapse; background: var(--surface); font-size: 0.9375rem; }
.incidents th {
  text-align: left;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  font-weight: 600;
  padding: 0.625rem 0.875rem;
  border-bottom: 1px solid var(--rule);
}
.incidents td { padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
.incidents tr:last-child td { border-bottom: 0; }
.type { color: var(--alert); font-weight: 600; white-space: nowrap; }
.sev { font-weight: 600; white-space: nowrap; }
.sev--closure { color: var(--alert); }
.sev--injury { color: var(--alert); }
.sev--incident { color: var(--ink); }
.sev--planned { color: var(--ink-soft); }
.plain { margin: 0; }
.desc { margin-top: 0.25rem; font-size: 0.9375rem; color: var(--ink-soft); }
.raw { margin-top: 0.375rem; font-size: 0.8125rem; }
.raw summary { cursor: pointer; color: var(--ink-soft); }
.raw p { margin: 0.25rem 0 0; color: var(--ink-soft); }
.empty { color: var(--ink-soft); }
.source { margin-top: 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
</style>

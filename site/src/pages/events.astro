---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import EventRow from '../components/events/EventRow.astro';
import HeroStat from '../components/ui/HeroStat.astro';
import DayStrip from '../components/ui/DayStrip.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import StoryCard from '../components/StoryCard.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getUpcomingStories, getPastStories, getUpcomingArtsEvents, getRegionalSports, getFacilities, calendarDateParts } from '../lib/db';
import {
  buildEventFeed, artsEventAsStory, localDateParts, utcMidnight, classifyEventLocality,
  TOWN_EVENT_KICKER,
  type FeedItem,
} from '../lib/events';
import { siteConfig, isQuietSection } from '../lib/site-config';
import { metaDescription } from '../lib/meta-description';
import { withoutEnded } from '../lib/local-day';
import { countryProfile, forCountry } from '../lib/country-profile';
import { EVENT_FACETS } from '../lib/event-facets';
import { EMPTY_STATES } from '../lib/empty-states';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { buildEventJsonLd } from '../lib/event-jsonld';
import { storyHref } from '../lib/content-slugs';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubNavItems } from '../lib/clusters';
import ClusterNav from '../components/ClusterNav.astro';
import HolidayContextCard from '../components/HolidayContextCard.astro';
import { buildEventsView, type DayRow } from '../lib/event-day-view';
import { makeRowFacts } from '../lib/event-row-facts';
import { areasFor } from '../lib/areas';
import { aboutSourcesFor } from '../lib/about-sources';

const pageMeta = resolvePageMeta('events', siteConfig);
const clusterNavItems = resolveHubNavItems('events', siteConfig);

// "Arts & Culture" (SDSU) / "Around Town" (library, city, chamber, ...) --
// bara Brookings har den här campus-vs-townwide-uppdelningen att göra (se
// scrapers/parsers/sdsu_events_v1.py:s "EDITORIAL-OMORGANISERING"). Andra
// orter (Moreno Valley) har inget SDSU-motstycke, så deras events lämnas
// utan override -- StoryCard.astro visar då ingen kicker alls längre för en
// vanlig 'event'-rad (sitewide presentation-layer pass, R4: sidans egen
// rubrik säger redan "Events", en upprepad generisk kicker var bara brus).
const isBrookings = siteConfig.townId === 'brookings_sd';
// gb: no override, so StoryCard shows the story's own category (meta.category) and falls back to "Around Town" itself.
const townwideKicker = siteConfig.country === 'gb' ? undefined : TOWN_EVENT_KICKER;

const [upcoming, past, artsEvents, facilities] = await Promise.all([
  getUpcomingStories(['event'], 120),
  getPastStories(['event'], 12),
  // Brookings-specifikt (SDSU) -- tom lista för andra orter, samma
  // ofarliga "town-scoped, naturally empty elsewhere"-mönster som
  // getNextRegionalGame/getUpcomingSdsuEvents. Musik/Special Events/
  // Theatre-Dance från SDSU:s kalender taggas "Arts & Culture" här i
  // stället för att visas på /university, se
  // scrapers/parsers/sdsu_events_v1.py:s "EDITORIAL-OMORGANISERING".
  getUpcomingArtsEvents(40),
  getFacilities(),
]);

// FAS 2: en primary-lags (66ers) HEMMAmatch idag hör hemma i "Today"-bucketen
// -- den fanns tidigare bara på /sports, aldrig cross-linkad härifrån.
// moreno_valley_ca-specifikt (getRegionalSports() ger bara raderna för
// aktuell town_id ändå, samma "naturligt tom på andra orter"-mönster som
// getUpcomingArtsEvents). game_date är ett rent kalenderdatum (samma
// meeting_date-landmina som formatCalendarDate skyddar mot) -- jämförs här
// via calendarDateParts, ALDRIG genom en tidszonskonvertering.
const regionalGames = siteConfig.townId === 'moreno_valley_ca' ? await getRegionalSports() : [];

/**
 * Cross-source merge + dedup + timezone-correct date bucketing all live in
 * lib/events.ts now (see NEEDS-HUMAN-REVIEW.md, "Week 2 -- Event Landing
 * Pages") so this page and the new /events/[facet]/ landing pages compute
 * IDENTICAL results from IDENTICAL logic -- never two independently
 * maintained copies of timezone-sensitive date math (see that file's
 * module docstring for the real off-by-one-day bug this guards against).
 * This page's own "Today / This weekend / Coming up / Further out"
 * sequential bucket loop below is unchanged and stays page-local.
 */
const { items, alsoListedBy } = buildEventFeed(withoutEnded(upcoming, new Date(), siteConfig.timezone), artsEvents, siteConfig.timezone);

/**
 * Phase 2, item 2a: "In <Town>" vs "Nearby" -- see lib/town-boundary.ts's
 * module doc for the boundary/distance mechanics. `inTownItems` feeds every
 * section below that already existed (This weekend / Today / Coming up /
 * Further out); `nearbyItems` is a new, separate section (own real place,
 * just outside town, surfaced rather than silently dropped). An `unknown`
 * zone (resolved coordinates further than NEARBY_RADIUS_MILES, or a bare
 * fallback-text match that named neither town) is excluded from both --
 * in practice this almost never fires, since every source here is already
 * a town-scoped or adjacent calendar.
 */
const localized = items.map((item) => ({
  item,
  ...classifyEventLocality(item, facilities, siteConfig.townId, siteConfig.cityName, siteConfig.townCenter),
}));
const inTownItems: FeedItem[] = localized.filter((l) => l.zone === 'in_town').map((l) => l.item);
const nearbyItems = localized.filter((l) => l.zone === 'nearby');
// Owner fix, 2026-10-08: an "unknown"-locality item (classifyEventLocality()
// couldn't confirm in-town OR nearby) used to just be excluded here --
// neither in `inTownItems` nor `nearbyItems`, so it silently vanished from
// the whole page. See buildEventSections()'s own doc comment (lib/
// events.ts) for how these are now folded into Today/Coming up/Further
// out instead, unlabeled, never the weekend hero.
const unknownItems: FeedItem[] = localized.filter((l) => l.zone === 'unknown').map((l) => l.item);

// Owner request, 2026-10-08 (post-2a verification): visibility into how
// much of this page's locality split rests on a real resolved coordinate
// versus the weaker text fallback, per town, per build -- same plain
// console.log convention as lib/noindex.ts's own `[build]` tally.
// `'text'`-method results are never `nearby` any more (see
// classifyLocalityByText()'s own doc comment), so a high `text` count here
// is a prompt to go seed that venue into `places` with real coordinates,
// not a sign anything is currently wrong.
const localityMethodCounts = { coords: 0, text: 0, default: 0 };
for (const l of localized) localityMethodCounts[l.method]++;
console.log(
  `[locality] ${siteConfig.cityName}: ${localized.length} event(s) -- ` +
  `${localityMethodCounts.coords} via coords, ${localityMethodCounts.text} via text fallback, ` +
  `${localityMethodCounts.default} default (arts/virtual/no-venue) -- ` +
  `${inTownItems.length} in_town, ${nearbyItems.length} nearby, ` +
  `${localized.length - inTownItems.length - nearbyItems.length} excluded (unknown)`
);


/**
 * The answer first (standards.md, Events): "N things on today", the seven local days with their counts, then one compact row per event
 * grouped by LOCAL day. Every date and clock below is the town's (lib/event-day-view.ts); the stored story text is never printed here,
 * because for an evening event it can name the UTC day (born from the owner's report 2026-11-05, qa/checks.json).
 */
const rowFacts = makeRowFacts({ cityName: siteConfig.cityName, facilities, areas: areasFor(siteConfig.townId) });
const viewOpts = { now: new Date(), timezone: siteConfig.timezone, gb: siteConfig.country === 'gb', facts: rowFacts };
const view = buildEventsView([...inTownItems, ...unknownItems], viewOpts);
const nearbyView = buildEventsView(nearbyItems.map((l) => l.item), viewOpts);
const distanceOf = new Map(nearbyItems.map((l) => [l.item, l.distanceMiles]));
const nearbyRows: DayRow[] = [...nearbyView.days.flatMap((d) => d.rows), ...nearbyView.furtherOut];

const today = utcMidnight(localDateParts(new Date(), siteConfig.timezone));
const todaysHomeGame = regionalGames.find((g) => {
  if (g.relevance_tier !== 'primary' || g.home_away !== 'home') return false;
  if (g.status !== 'scheduled' && g.status !== 'live') return false;
  const parts = calendarDateParts(g.game_date);
  if (!parts) return false;
  return parts.y === today.getUTCFullYear() && parts.m === today.getUTCMonth() && parts.d === today.getUTCDate();
}) ?? null;

function hrefOf(item: FeedItem): string {
  return item.sourceKind === 'arts' ? item.event.event_url : storyHref(item.story.slug);
}
const FOLD = 7;
const busyDays = view.days.filter((d) => d.count > 0);
const heroSub = [
  view.tonightCount > 0 && view.tonightCount < view.todayCount ? `${view.tonightCount} tonight` : null,
  view.freeToday > 0 ? `${view.freeToday} free` : null,
].filter(Boolean).join(' · ');

const canonicalUrl = new URL('/events/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: canonicalUrl },
];

/** ItemList + dateModified for /events/: the displayed order (days, then further out, then nearby), so `position` means what it says. */
const allDisplayedItems: FeedItem[] = [
  ...view.days.flatMap((d) => d.rows.map((r) => r.item)),
  ...view.furtherOut.map((r) => r.item),
  ...nearbyRows.map((r) => r.item),
];

function asStoryShape(item: FeedItem) {
  return item.sourceKind === 'arts' ? artsEventAsStory(item.event) : item.story;
}
function displayItemUrl(item: FeedItem): string {
  return item.sourceKind === 'arts' ? item.event.event_url : new URL(storyHref(item.story.slug), Astro.site ?? siteConfig.siteUrl).href;
}

const itemListJsonLd = allDisplayedItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageMeta.title,
  itemListElement: allDisplayedItems.map((item, i) => {
    const asStory = asStoryShape(item);
    const itemUrl = displayItemUrl(item);
    const heroUrl = new URL(asStory.image_path ?? `/og/${asStory.slug}.png`, Astro.site ?? siteConfig.siteUrl).href;
    const eventJsonLd = buildEventJsonLd(
      asStory, facilities,
      { cityName: siteConfig.cityName, stateAbbr: siteConfig.stateAbbr, region: siteConfig.region, addressCountry: countryProfile(siteConfig.country).addressCountry, siteName: siteConfig.siteName, timezone: siteConfig.timezone },
      itemUrl, heroUrl,
    );
    return {
      '@type': 'ListItem',
      position: i + 1,
      url: itemUrl,
      name: asStory.title,
      ...(eventJsonLd ? { item: eventJsonLd } : {}),
    };
  }),
} : null;

// Real, not guessed: the most recent REAL `published_at` among everything
// shown -- the same field article-jsonld.ts's own per-story dateModified
// already uses (see that file), just taken as a max across this page's
// whole displayed set rather than one story. Story-kind items only --
// arts-kind items' artsEventAsStory() sets `published_at: event.starts_at
// ?? new Date().toISOString()` (see lib/events.ts), reusing that field to
// satisfy the Story shape StoryCard/JSON-LD need, NOT a real "last
// modified" signal -- it's the event's own FUTURE occurrence time. Caught
// on a real build before shipping: a page with an SDSU event further out
// than any real story produced a dateModified weeks in the future, which
// is backwards. Falls back to null (omit the WebPage block) on the one
// edge case where every displayed item is arts-kind -- no real signal
// exists then, never guessed.
const realPublishedDates = allDisplayedItems
  .filter((item): item is Extract<FeedItem, { sourceKind: 'story' }> => item.sourceKind === 'story')
  .map((item) => item.story.published_at);
const dateModified = realPublishedDates.length > 0
  ? realPublishedDates.reduce((max, p) => (p > max ? p : max))
  : null;

const webPageJsonLd = dateModified ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageMeta.title,
  url: canonicalUrl,
  dateModified,
} : null;
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-events" noindex={isQuietSection('events')}
  description={metaDescription('events', siteConfig)}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="ev-head">
    <h1>{pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  <section class="ev-answer" aria-label="Events at a glance">
    {view.todayCount > 0 ? (
      <HeroStat value={view.todayCount} unit={view.todayCount === 1 ? 'thing on today' : 'things on today'} sub={heroSub || undefined} />
    ) : view.nextDay ? (
      <EmptyState href={`#day-${view.nextDay.dayKey}`} linkLabel={`${view.nextDay.label}: ${view.nextDay.count} ${view.nextDay.count === 1 ? 'thing' : 'things'}`}>Nothing else listed for today.</EmptyState>
    ) : (
      <EmptyState>{EMPTY_STATES.eventsAll}</EmptyState>
    )}
    {todaysHomeGame && (
      <p class="game-note">
        🏟️ {todaysHomeGame.team_name} play {todaysHomeGame.opponent_name} at home today{todaysHomeGame.venue && ` at ${todaysHomeGame.venue}`}.
        <a href="/sports/">See the schedule</a>
      </p>
    )}
    {view.showDayStrip && (
      <DayStrip label="Events per day" days={view.days.map((d) => ({
        label: d.offset < 2 ? d.label.slice(0, 3) : d.label,
        value: String(d.count), sub: d.dateLabel, today: d.offset === 0, href: d.count > 0 ? `#day-${d.dayKey}` : undefined,
      }))} />
    )}
  </section>

  <HolidayContextCard />

  <nav class="facet-nav" aria-label="Event filters">
    {EVENT_FACETS.filter((f) => !f.brookingsOnly || isBrookings).map((f) => (
      <a href={`/events/${f.slug}/`}>{f.navLabel}</a>
    ))}
  </nav>

  {busyDays.map((d) => (
    <section class="ev-day" id={`day-${d.dayKey}`} aria-labelledby={`h-${d.dayKey}`}>
      <h2 class="ev-day__h" id={`h-${d.dayKey}`}>{d.label} <span class="ev-day__date">{d.dateLabel}</span></h2>
      <ul class="ev-list" data-hide-ended data-hide-section data-tz={siteConfig.timezone}>
        {d.rows.map((r) => <EventRow row={r} href={hrefOf(r.item)} />)}
      </ul>
    </section>
  ))}

  {view.furtherOut.length > 0 && (
    <section class="ev-day" aria-labelledby="h-later">
      <h2 class="ev-day__h" id="h-later">Further out</h2>
      <ul class="ev-list" data-hide-ended data-tz={siteConfig.timezone}>
        {view.furtherOut.slice(0, FOLD).map((r) => <EventRow row={r} href={hrefOf(r.item)} showDate />)}
      </ul>
      {view.furtherOut.length > FOLD && (
        <details class="ev-more">
          <summary>{view.furtherOut.length - FOLD} more</summary>
          <ul class="ev-list" data-hide-ended data-tz={siteConfig.timezone}>
            {view.furtherOut.slice(FOLD).map((r) => <EventRow row={r} href={hrefOf(r.item)} showDate />)}
          </ul>
        </details>
      )}
    </section>
  )}

  {nearbyRows.length > 0 && (
    <section class="ev-day" aria-labelledby="h-nearby">
      <h2 class="ev-day__h" id="h-nearby">Nearby</h2>
      <ul class="ev-list" data-hide-ended data-tz={siteConfig.timezone}>
        {nearbyRows.map((r) => {
          const miles = distanceOf.get(r.item);
          return <EventRow row={r} href={hrefOf(r.item)} showDate note={miles != null ? `${Math.round(miles)} mi away` : null} />;
        })}
      </ul>
    </section>
  )}

  {past.length > 0 && (
    <>
      <SectionRule label="Recently" href="/events/past/" />
      <div class="grid">{past.map((story) => <StoryCard story={story} compact kicker={townwideKicker} facilities={facilities} />)}</div>
    </>
  )}

  <ClusterNav clusterLabel="What's happening" items={clusterNavItems} />

  <RelatedContent pageType="events" />

  {itemListJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  )}

  {webPageJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageJsonLd)} />
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />

  <AboutThisPage sources={aboutSourcesFor(siteConfig.townId).map((s) => ({ name: s.name, href: s.url }))}>
    <p>Upcoming events in and around {siteConfig.cityName}, soonest first, with the date, time and venue as the {forCountry(siteConfig.country, 'organizer', 'organiser')} published them. Times and registration details come straight from the source, never guessed or rewritten.</p>
    <p>Scan by day, use the filters for a kind of event, and follow a listing to the {forCountry(siteConfig.country, 'organizer', 'organiser')} for tickets, registration or changes. Times can change: check with them before you go. Updated daily. <a href="/how-we-gather-this/">How we gather this</a>.</p>
    {siteConfig.hasWhatsOn && <p>Concerts and shows in the region: <a href="/whats-on/">What's On</a>. For a shorter list, see <a href="/today/">today</a> or <a href="/this-week/">the week ahead</a>.</p>}
  </AboutThisPage>
</BaseLayout>

<style>
.ev-head { display: flex; align-items: center; justify-content: space-between; gap: var(--ui-3); margin: var(--ui-3) 0; }
.ev-head h1 { margin: 0; }
.ev-answer { display: grid; gap: var(--ui-3); margin-bottom: var(--ui-3); }
.game-note { margin: 0; padding: var(--ui-2) var(--ui-3); background: var(--ui-surface-2); border-radius: var(--ui-radius); font-family: var(--font-ui); font-size: var(--ui-meta); }
.game-note a { margin-left: var(--ui-1); }
.facet-nav { display: flex; flex-wrap: wrap; gap: var(--ui-2); margin: var(--ui-3) 0 var(--ui-4); }
.facet-nav a { font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: 600; color: var(--navy); background: var(--navy-tint); border-radius: 999px; padding: 0.35rem 0.8rem; }
.facet-nav a:hover, .facet-nav a:focus-visible { background: var(--navy); color: var(--surface); }
.ev-day { margin-bottom: var(--ui-5); scroll-margin-top: var(--ui-5); }
.ev-day__h { position: sticky; top: 0; z-index: 1; margin: 0; padding: var(--ui-2) 0; background: var(--surface); font-family: var(--font-head); font-size: 1.375rem; border-bottom: var(--ui-hairline); }
.ev-day__date { font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: 400; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
.ev-list { list-style: none; margin: 0; padding: 0; }
.ev-more { margin-top: var(--ui-2); font-family: var(--font-ui); }
.ev-more summary { cursor: pointer; padding: var(--ui-2) 0; font-size: var(--ui-meta); font-weight: 600; color: var(--navy); min-height: 44px; display: flex; align-items: center; }
.grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
</style>

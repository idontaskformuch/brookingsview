---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getUpcomingStories, getPastStories, getUpcomingArtsEvents, getRegionalSports, getFacilities, calendarDateParts } from '../lib/db';
import {
  buildEventFeed, artsEventAsStory, withAttribution, localDateParts, utcMidnight, classifyEventLocality,
  weekendAnchorOffset,
  type FeedItem,
} from '../lib/events';
import { siteConfig } from '../lib/site-config';
import { EVENT_FACETS } from '../lib/event-facets';
import SectionHero from '../components/SectionHero.astro';
import { EMPTY_STATES } from '../lib/empty-states';
import { SECTION_THEME } from '../lib/section-theme';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubNavItems } from '../lib/clusters';
import ClusterNav from '../components/ClusterNav.astro';

const pageMeta = resolvePageMeta('events', siteConfig);
const clusterNavItems = resolveHubNavItems('events', siteConfig);

// "Arts & Culture" (SDSU) / "Around Town" (library, city, chamber, ...) --
// bara Brookings har den här campus-vs-townwide-uppdelningen att göra (se
// scrapers/parsers/sdsu_events_v1.py:s "EDITORIAL-OMORGANISERING"). Andra
// orter (Moreno Valley) har inget SDSU-motstycke, så deras events lämnas
// utan override -- StoryCard.astro visar då ingen kicker alls längre för en
// vanlig 'event'-rad (sitewide presentation-layer pass, R4: sidans egen
// rubrik säger redan "Events", en upprepad generisk kicker var bara brus).
const isBrookings = siteConfig.townId === 'brookings_sd';
const townwideKicker = isBrookings ? 'Around Town' : undefined;

const [upcoming, past, artsEvents, facilities] = await Promise.all([
  getUpcomingStories(['event'], 120),
  getPastStories(['event'], 12),
  // Brookings-specifikt (SDSU) -- tom lista för andra orter, samma
  // ofarliga "town-scoped, naturally empty elsewhere"-mönster som
  // getNextRegionalGame/getUpcomingSdsuEvents. Musik/Special Events/
  // Theatre-Dance från SDSU:s kalender taggas "Arts & Culture" här i
  // stället för att visas på /university, se
  // scrapers/parsers/sdsu_events_v1.py:s "EDITORIAL-OMORGANISERING".
  getUpcomingArtsEvents(40),
  getFacilities(),
]);

// FAS 2: en primary-lags (66ers) HEMMAmatch idag hör hemma i "Today"-bucketen
// -- den fanns tidigare bara på /sports, aldrig cross-linkad härifrån.
// moreno_valley_ca-specifikt (getRegionalSports() ger bara raderna för
// aktuell town_id ändå, samma "naturligt tom på andra orter"-mönster som
// getUpcomingArtsEvents). game_date är ett rent kalenderdatum (samma
// meeting_date-landmina som formatCalendarDate skyddar mot) -- jämförs här
// via calendarDateParts, ALDRIG genom en tidszonskonvertering.
const regionalGames = siteConfig.townId === 'moreno_valley_ca' ? await getRegionalSports() : [];

/**
 * Cross-source merge + dedup + timezone-correct date bucketing all live in
 * lib/events.ts now (see NEEDS-HUMAN-REVIEW.md, "Week 2 -- Event Landing
 * Pages") so this page and the new /events/[facet]/ landing pages compute
 * IDENTICAL results from IDENTICAL logic -- never two independently
 * maintained copies of timezone-sensitive date math (see that file's
 * module docstring for the real off-by-one-day bug this guards against).
 * This page's own "Today / This weekend / Coming up / Further out"
 * sequential bucket loop below is unchanged and stays page-local.
 */
const { items, alsoListedBy } = buildEventFeed(upcoming, artsEvents, siteConfig.timezone);

/**
 * Phase 2, item 2a: "In <Town>" vs "Nearby" -- see lib/town-boundary.ts's
 * module doc for the boundary/distance mechanics. `inTownItems` feeds every
 * section below that already existed (This weekend / Today / Coming up /
 * Further out); `nearbyItems` is a new, separate section (own real place,
 * just outside town, surfaced rather than silently dropped). An `unknown`
 * zone (resolved coordinates further than NEARBY_RADIUS_MILES, or a bare
 * fallback-text match that named neither town) is excluded from both --
 * in practice this almost never fires, since every source here is already
 * a town-scoped or adjacent calendar.
 */
const localized = items.map((item) => ({
  item,
  ...classifyEventLocality(item, facilities, siteConfig.townId, siteConfig.cityName, siteConfig.townCenter),
}));
const inTownItems: FeedItem[] = localized.filter((l) => l.zone === 'in_town').map((l) => l.item);
const nearbyItems = localized.filter((l) => l.zone === 'nearby');

/**
 * Bucket upcoming events by time horizon rather than showing one flat list.
 * "This weekend" is the bucket the whole feature exists for (see
 * news-aggregator return-visit reasoning) -- Fri/Sat/Sun relative to the
 * site's own local "today", not the visitor's, so the grouping matches the
 * dateline the site already prints on every story. localDateParts/
 * utcMidnight (imported from lib/events.ts) are the same primitives the
 * /events/[facet]/ landing pages use -- see that file's module docstring
 * for the real off-by-one-day timezone bug they guard against. This page's
 * OWN sequential "Today / Weekend / Coming up / Further out" bucketing
 * below is deliberately mutually-exclusive (unlike the standalone landing
 * pages' inclusive isToday()/isThisWeekend() predicates) since this is one
 * flat list being partitioned into non-overlapping sections.
 */
function dayIndex(occursAt: string, today: Date): number {
  const eventDay = utcMidnight(localDateParts(new Date(occursAt), siteConfig.timezone));
  return Math.round((eventDay.getTime() - today.getTime()) / 86_400_000);
}

const today = utcMidnight(localDateParts(new Date(), siteConfig.timezone));

const todaysHomeGame = regionalGames.find((g) => {
  if (g.relevance_tier !== 'primary' || g.home_away !== 'home') return false;
  if (g.status !== 'scheduled' && g.status !== 'live') return false;
  const parts = calendarDateParts(g.game_date);
  if (!parts) return false;
  return parts.y === today.getUTCFullYear() && parts.m === today.getUTCMonth() && parts.d === today.getUTCDate();
}) ?? null;

// Events correctness Phase 2, item 2a verification (2026-10-08): was a
// local `(5 - weekdayOfToday + 7) % 7` -- wrong on a real Saturday/Sunday
// (jumped a full week ahead instead of recognizing the weekend already in
// progress). Now the one shared primitive lib/events.ts's isThisWeekend()
// also uses -- see that function's own doc comment for the full case
// breakdown this fixes.
const daysToFriday = weekendAnchorOffset(today);

const buckets = { today: [] as FeedItem[], weekend: [] as FeedItem[], nextWeek: [] as FeedItem[], later: [] as FeedItem[] };
for (const item of inTownItems) {
  if (!item.occurs_at) { buckets.later.push(item); continue; }
  const offset = dayIndex(item.occurs_at, today);
  if (offset <= 0) buckets.today.push(item);
  else if (offset >= daysToFriday && offset <= daysToFriday + 2) buckets.weekend.push(item);
  else if (offset < 14) buckets.nextWeek.push(item);
  else buckets.later.push(item);
}

/**
 * Phase 2, item 2a: "This weekend in <Town>" split Fri/Sat/Sun with counts
 * -- replaces the old flat "This weekend" bucket (still computed above as
 * `buckets.weekend`, just no longer rendered as its own single-label
 * section) with a richer per-day breakdown, per the phase2 spec. `offset`
 * values reuse daysToFriday from above -- Friday/Saturday/Sunday are
 * exactly daysToFriday/+1/+2 regardless of which weekday "today" is.
 */
const weekendDays = ([
  ['Friday', daysToFriday],
  ['Saturday', daysToFriday + 1],
  ['Sunday', daysToFriday + 2],
] as [string, number][]).map(([label, offset]) => ({
  label,
  items: buckets.weekend.filter((item) => item.occurs_at && dayIndex(item.occurs_at, today) === offset),
}));
const weekendTotal = buckets.weekend.length;

const sections = (
  [
    ['Today', buckets.today],
    ['Coming up', buckets.nextWeek],
    ['Further out', buckets.later],
  ] as [string, FeedItem[]][]
// "Today" stays even with zero library/city events when there's still a
// home game to surface (see todaysHomeGame below) -- every other bucket
// keeps the original "hide if empty" rule.
).filter(([label, list]) => list.length > 0 || (label === 'Today' && todaysHomeGame));

const canonicalUrl = new URL('/events/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: canonicalUrl },
];
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-events"
  description={`What's on this weekend in ${siteConfig.cityName}, ${siteConfig.stateName} — library programs, city events and community happenings.`}
  accentColor={SECTION_THEME.events.accent}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <SectionHero category="events" />
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
    <p>Community events in {siteConfig.cityName}, {siteConfig.stateName} —
    library programs, city events and more, gathered from each organiser's own
    calendar. Times and registration details come straight from the source,
    never guessed or rewritten. For a shorter list, see what's happening
    <a href="/today/">today</a> or over <a href="/this-week/">the week ahead</a>.
    Check back — this updates daily.</p>
    {siteConfig.hasWhatsOn && (
      // Front-page orientation pass, Phase 4: "a first-time reader can't
      // tell Events and What's On apart" -- only one goes in primary nav
      // per town, this line points to whichever one doesn't.
      <p class="cross-link">Concerts and shows in the region: <a href="/whats-on/">What's On</a></p>
    )}
    <ShareButton title={pageMeta.title} />
  </header>

  <nav class="facet-nav" aria-label="Event filters">
    {EVENT_FACETS.filter((f) => !f.brookingsOnly || isBrookings).map((f) => (
      <a href={`/events/${f.slug}/`}>{f.navLabel}</a>
    ))}
  </nav>

  {/* Phase 2, item 2a: "This weekend in <Town>" split Fri/Sat/Sun with
      counts -- the hero this whole restructure exists for (see
      news-aggregator return-visit reasoning in this file's own history).
      In-town events only; a weekend event at a nearby-but-out-of-town venue
      shows in the Nearby section below instead, tagged with its distance. */}
  {weekendTotal > 0 && (
    <section class="weekend-hero">
      <SectionRule label={`This weekend in ${siteConfig.cityName}`} />
      <p class="weekend-counts">
        {weekendDays.map(({ label, items: dayItems }, i) => (
          <>
            {i > 0 && <span class="sep"> · </span>}
            <span class="weekend-count"><strong>{dayItems.length}</strong> {label.slice(0, 3)}</span>
          </>
        ))}
      </p>
      {weekendDays.filter((d) => d.items.length > 0).map((day) => (
        <div class="weekend-day">
          <h3 class="weekend-day__label">{day.label}</h3>
          <div class="grid">
            {day.items.map((item) => item.sourceKind === 'story'
              ? <StoryCard story={{ ...item.story, body: withAttribution(item.story.body, item, alsoListedBy) }} kicker={townwideKicker} facilities={facilities} />
              : <StoryCard story={{ ...artsEventAsStory(item.event), body: withAttribution(artsEventAsStory(item.event).body, item, alsoListedBy) }} href={item.event.event_url} kicker="Arts & Culture" facilities={facilities} />
            )}
          </div>
        </div>
      ))}
    </section>
  )}

  {/* Phase 2, item 2a: "Nearby" -- real events at a real place just outside
      town (within lib/town-boundary.ts's NEARBY_RADIUS_MILES), surfaced
      rather than silently dropped. Distance is straight-line miles, never a
      drive-time estimate -- see town-boundary.ts's own doc comment for why
      (an owner decision, 2026-10-08, matching the site's existing
      /whats-on/ precedent). Not day-bucketed like the in-town sections
      above -- one flat, date-sorted list is enough at today's volume. */}
  {nearbyItems.length > 0 && (
    <section class="nearby">
      <SectionRule label="Nearby" />
      <div class="grid">
        {nearbyItems.map(({ item, distanceMiles }) => (
          <div class="event-cell">
            {item.sourceKind === 'story'
              ? <StoryCard story={{ ...item.story, body: withAttribution(item.story.body, item, alsoListedBy) }} kicker={townwideKicker} facilities={facilities} />
              : <StoryCard story={{ ...artsEventAsStory(item.event), body: withAttribution(artsEventAsStory(item.event).body, item, alsoListedBy) }} href={item.event.event_url} kicker="Arts & Culture" facilities={facilities} />}
            {distanceMiles != null && <p class="distance">{Math.round(distanceMiles)} mi away</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  {(sections.length > 0 || weekendTotal > 0 || nearbyItems.length > 0 || todaysHomeGame) ? sections.map(([label, list]) => (
    <>
      <SectionRule label={label} />
      {label === 'Today' && todaysHomeGame && (
        <p class="game-note">
          🏟️ {todaysHomeGame.team_name} play {todaysHomeGame.opponent_name} at home today
          {todaysHomeGame.venue && ` at ${todaysHomeGame.venue}`}.
          <a href="/sports/">See the schedule</a>
        </p>
      )}
      {list.length > 0 && (
        <div class="grid">
          {list.map((item) => item.sourceKind === 'story'
            ? <StoryCard story={{ ...item.story, body: withAttribution(item.story.body, item, alsoListedBy) }} kicker={townwideKicker} facilities={facilities} />
            : <StoryCard story={{ ...artsEventAsStory(item.event), body: withAttribution(artsEventAsStory(item.event).body, item, alsoListedBy) }} href={item.event.event_url} kicker="Arts & Culture" facilities={facilities} />
          )}
        </div>
      )}
    </>
  )) : (
    <p class="empty">{EMPTY_STATES.eventsAll}</p>
  )}

  {past.length > 0 && (
    <>
      <SectionRule label="Recently" href="/events/past/" />
      <div class="grid">{past.map((story) => <StoryCard story={story} compact kicker={townwideKicker} facilities={facilities} />)}</div>
    </>
  )}

  <ClusterNav clusterLabel="What's happening" items={clusterNavItems} />

  <RelatedContent pageType="events" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.cross-link { font-size: 0.875rem; }
.cross-link a { color: var(--navy); }
.facet-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 1.5rem; }
.facet-nav a {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--navy);
  background: var(--navy-tint);
  border-radius: 999px;
  padding: 0.35rem 0.8rem;
}
.facet-nav a:hover, .facet-nav a:focus-visible { background: var(--navy); color: var(--surface); }
.grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
.game-note {
  margin: 0 0 0.75rem;
  padding: 0.625rem 0.875rem;
  background: var(--navy-tint);
  border-left: 4px solid var(--navy);
  font-size: 0.9375rem;
}
.game-note a { margin-left: 0.375rem; }
.empty { color: var(--ink-soft); }
.weekend-counts {
  font-family: var(--font-ui);
  font-size: 0.9375rem;
  color: var(--ink-soft);
  margin: 0 0 1rem;
}
.weekend-count strong { color: var(--ink); font-size: 1.0625rem; }
.sep { opacity: 0.5; }
.weekend-day { margin-top: 1rem; }
.weekend-day:first-of-type { margin-top: 0; }
.weekend-day__label {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 0 0 0.5rem;
}
.event-cell { display: flex; flex-direction: column; gap: 0.375rem; }
.distance { margin: 0; font-size: 0.8125rem; color: var(--ink-soft); }
</style>

---
/** What's On -- Phase 5. Gated on siteConfig.hasWhatsOn (false everywhere,
 *  see site-config.ts) -- same redirect pattern as closures.astro/
 *  workplace-watch/index.astro. Indexable (not noindex): this is the one
 *  new page in the feature meant to attract search traffic, per the
 *  original What's On spec's intent -- detail pages stay noindex (see
 *  [slug].astro).
 *
 *  Marquee (larger cards, real images via lib/images.ts's Ticketmaster
 *  tier) vs. Also-on-this-day (dense, no image) -- see lib/whats-on.ts's
 *  rankTicketmasterEvents()/splitMarquee() for the ranking + provisional
 *  cutoff. Venue tiers for the real regional venues in this feed are
 *  curated (see lib/venue-tiers.ts) -- Marquee entries are also collapsed
 *  per real production/venue (see splitMarquee()'s own MarqueeEntry
 *  return shape) so a multi-date tour run occupies one slot, not one per
 *  date, per the "Tour-Run Collapsing" follow-up.
 *
 *  Every card shows a distance label for any venue outside town proper --
 *  the anti-doorway-pattern transparency the original spec named
 *  explicitly (see lib/ticketmaster.ts's distanceLabel()).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutThisPage from '../../components/ui/AboutThisPage.astro';
import SectionRule from '../../components/SectionRule.astro';
import WhatsOnCard from '../../components/WhatsOnCard.astro';
import MarqueeCard from '../../components/MarqueeCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButton from '../../components/ShareButton.astro';
import { siteConfig } from '../../lib/site-config';
import { placeLabel } from '../../lib/country-profile';
import { getTicketmasterEventsForTown } from '../../lib/ticketmaster';
import { rankTicketmasterEvents, splitMarquee, ticketmasterResolvableImage, dropEnded, collapseSeriesRows } from '../../lib/whats-on';
import { getFacilities } from '../../lib/db';
import { EMPTY_STATES } from '../../lib/empty-states';
import { SECTION_THEME } from '../../lib/section-theme';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { buildClusterBreadcrumbTrail } from '../../lib/clusters';
import { resolveImage } from '../../lib/images';
import { categoryImagesFor } from '../../config/category-images';
import { resolvePageMeta } from '../../lib/page-meta';

if (!siteConfig.hasWhatsOn) {
  return Astro.redirect('/', 302);
}

// Marquee deck sentences follow-up: hasWhatsOn=true has always implied a
// real `ticketmaster` config exists (this page's own Ticketmaster fetch
// below would be meaningless otherwise) -- made an explicit, loud check
// here now that marqueeSize is a REQUIRED field on that config (see
// site-config.ts's own comment): a town with hasWhatsOn on but no
// ticketmaster block would previously have just silently fetched zero
// events; now it fails the build immediately with a clear reason, rather
// than defaulting marqueeSize to some guessed number for a config shape
// that was never valid to begin with.
if (!siteConfig.ticketmaster) {
  throw new Error(`whats-on: hasWhatsOn is true for ${siteConfig.townId} but no ticketmaster config is set`);
}

const [items, facilities] = await Promise.all([
  getTicketmasterEventsForTown(siteConfig),
  getFacilities(),
]);
// Listings that already happened are dropped (a run's first date can be months old); see lib/whats-on.ts dropEnded().
const buildNow = new Date();
const ranked = rankTicketmasterEvents(dropEnded(items, buildNow), siteConfig.townId);
const { marquee, alsoOn } = splitMarquee(ranked, siteConfig.ticketmaster.marqueeSize);

// Sitewide presentation-layer pass: Marquee cards now need a real resolved
// image (MarqueeCard.astro never renders a placeholder) -- an entry
// splitMarquee() ranked into the Marquee tier but that has no resolvable
// image (rare: most Ticketmaster items do resolve one, per
// ticketmasterResolvableImage()'s own comment, but not all) is demoted into
// Also-on rather than shown imageless in what's meant to be the imagery
// tier. Same "skip, don't merely deprioritize" rule the front page's own
// marquee module uses.
const marqueeWithImages: { entry: (typeof marquee)[number]; image: NonNullable<ReturnType<typeof resolveImage>> }[] = [];
const demotedToAlsoOn: typeof alsoOn = [];
for (const entry of marquee) {
  const image = resolveImage(ticketmasterResolvableImage(entry.primary), {
    town: siteConfig.townId,
    cityName: siteConfig.cityName,
    facilities,
    categoryImages: categoryImagesFor(siteConfig.townId),
  });
  if (image) {
    marqueeWithImages.push({ entry, image });
  } else {
    demotedToAlsoOn.push(entry.primary);
  }
}
// Daily and repeated rows (same title, same venue, 3+ dates) become one row with the date range and the next date.
// Only the next 60 days are listed: a show a year away crowds out this week (Q3 2026-10-28: 100+ rows to October 2027).
// Glasgow lists 30 days (owner 2026-10-28: the 60-day list was still ~100 rows); the US towns keep 60.
const ALSO_ON_DAYS = siteConfig.country === 'gb' ? 30 : 60;
const ALSO_ON_HORIZON_MS = ALSO_ON_DAYS * 86_400_000;
// Marquee cards keep the venue-rank order; "Also on" is by date (owner 2026-10-28), so the dates never restart halfway down.
const allAlsoOnRows = collapseSeriesRows([...demotedToAlsoOn, ...alsoOn]).sort((x, y) =>
  (x.primary.occurs_at ? new Date(x.primary.occurs_at).getTime() : Infinity) - (y.primary.occurs_at ? new Date(y.primary.occurs_at).getTime() : Infinity)
  || x.primary.ticketmasterEvent.title.localeCompare(y.primary.ticketmasterEvent.title));
const alsoOnRows = allAlsoOnRows.filter((r) => !r.primary.occurs_at || new Date(r.primary.occurs_at).getTime() <= buildNow.getTime() + ALSO_ON_HORIZON_MS);
const laterCount = allAlsoOnRows.length - alsoOnRows.length;

// The weekly AI intro block (What's On Phase 6b) is not printed: model-written text is withheld everywhere (lib/ai-text.ts, owner 2026-11-06).
const introText: string | null = null;

const canonicalUrl = new URL('/whats-on/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('whats-on', siteConfig, { label: "What's On", href: canonicalUrl });
const radiusMiles = siteConfig.ticketmaster?.radiusMiles;
const pageMeta = resolvePageMeta('whats-on', siteConfig);
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-whats-on"
  description={`Concerts, theater and touring shows within ${radiusMiles ?? 75} miles of ${placeLabel(siteConfig)} — with real distance shown, never a hidden away-game.`}
  accentColor={SECTION_THEME.events.accent}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  {introText && (
    <div class="whats-on-intro">
      <p class="whats-on-intro__text">{introText}</p>
      <p class="whats-on-intro__disclosure">AI-generated from this week's listed events, checked against the source data before publishing.</p>
    </div>
  )}

  {ranked.length === 0 ? (
    <p class="empty">{EMPTY_STATES.whatsOn}</p>
  ) : (
    <>
      {marqueeWithImages.length > 0 && (
        <>
          <SectionRule label="Marquee" />
          {/* LCP fix: this grid renders several variant="hero" cards side
              by side (unlike index.astro's single hero + row thumbnails --
              see MarqueeCard.astro's own `priority` prop comment). Only
              the first, top-left card (plain CSS grid, no `order`
              override, so DOM order === paint order) is the real LCP
              candidate -- fetchpriority="high" on every card in the grid
              would dilute the signal instead of fixing it. */}
          <div class="marquee-grid">
            {marqueeWithImages.map(({ entry, image }, i) => (
              <MarqueeCard
                item={entry.primary}
                image={image}
                cityName={siteConfig.cityName}
                timezone={siteConfig.timezone}
                variant="hero"
                priority={i === 0}
                runSize={entry.members.length}
                lastOccursAt={entry.members[entry.members.length - 1].occurs_at}
              />
            ))}
          </div>
        </>
      )}
      {alsoOnRows.length > 0 && (
        <>
          <SectionRule label="Also on" />
          <div class="also-on-list">
            {alsoOnRows.map((row) => <WhatsOnCard item={row.primary} runSize={row.members.length} lastOccursAt={row.members[row.members.length - 1].occurs_at} />)}
          </div>
          {laterCount > 0 && (
            <p class="also-on-later">Showing the next {ALSO_ON_DAYS} days.{' '}
              {siteConfig.country === 'gb'
                ? <a href={`https://www.ticketmaster.co.uk/discover/${siteConfig.cityName.toLowerCase()}`} rel="noopener">{laterCount} more listing{laterCount === 1 ? '' : 's'} further ahead on Ticketmaster</a>
                : <>{laterCount} more listing{laterCount === 1 ? '' : 's'} further ahead are on Ticketmaster.</>}
            </p>
          )}
        </>
      )}
    </>
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  <AboutThisPage slot="about">
    {siteConfig.country === 'gb' ? (
      // Q3 live 2026-10-28: "every listing shows how far" contradicted the rows that just say "In Glasgow".
      <p>Concerts, theatre and touring shows within {radiusMiles ?? 75} miles of {siteConfig.cityName}. {/* gb-spelling */}
      Shows outside the city say how far away they are, so a regional show never reads as a local one;
      the rest say "In {siteConfig.cityName}". Powered by Ticketmaster.</p>
    ) : (
      <p>Concerts, theater and touring shows within {radiusMiles ?? 75} miles of {siteConfig.cityName},
      {siteConfig.stateName} — including nearby regional venues. Every listing shows how far it actually is,
      so a regional show never reads as a downtown event. Powered by Ticketmaster.</p>
    )}
    {/* Front-page orientation pass, Phase 4: "a first-time reader can't
        tell Events and What's On apart" -- only one goes in primary nav
        per town, this line points to whichever one doesn't. */}
    <p>Local library, city and community events: <a href="/events/">Events</a></p>
  </AboutThisPage>
</BaseLayout>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.cross-link { font-size: 0.875rem; }
.cross-link a { color: var(--navy); }
.whats-on-intro {
  max-width: 46rem;
  margin: 0 0 1.5rem;
  border: 1px solid var(--rule);
  border-left: 4px solid var(--section-accent, var(--rule-strong));
  border-radius: 8px;
  padding: 1rem 1.25rem;
}
.whats-on-intro__text { line-height: 1.6; margin: 0 0 0.5rem; }
.whats-on-intro__disclosure { font-size: 0.75rem; color: var(--ink-soft); margin: 0; }
.marquee-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); margin-bottom: 1.5rem; }
.also-on-list { display: block; }
.also-on-later { margin: 0.75rem 0 0; color: var(--ink-soft); font-size: 0.9375rem; }
.empty { color: var(--ink-soft); }
</style>

---
/** Traffic incidents as a TABLE, no AI -- see lib/db.ts (getActiveTrafficIncidents) and scrapers/parsers/traffic_v1.py.
 *
 *  Built only for a town with a traffic source (owner 2026-11-07): without one the page does not exist at all, so it is not built, not in the
 *  nav and not in the sitemap (the host answers a real 404, like the holiday pages). With a source but no current incidents the page is
 *  noindex and out of the sitemap, and says in one line that nothing is reported as of the latest read (AdSense plan F4, 2026-11-11;
 *  lib/traffic-verdict.ts). */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import SectionRule from '../components/SectionRule.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getTrafficIncidentsFromLatestRead, getTrafficLastRun, formatTimeWithZone, plainLanguageTraffic } from '../lib/db';
import { TRAFFIC_READ_MAX_AGE_HOURS, trafficPageState, writeTrafficVerdict } from '../lib/traffic-verdict';
import { siteConfig, isQuietSection } from '../lib/site-config';

export function getStaticPaths() {
  return siteConfig.trafficSource ? [{ params: { traffic: 'traffic' } }] : [];
}
import { metaDescription } from '../lib/meta-description';
import { placeAbbr } from '../lib/country-profile';
import { SECTION_THEME } from '../lib/section-theme';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubNavItems } from '../lib/clusters';
import ClusterNav from '../components/ClusterNav.astro';
import { classifyTrafficIncident } from '../lib/traffic';
import { listEligibleMonths, monthLabel, monthSlug } from '../lib/month-in-review';

// Phase 8 teaser link (research section 3) -- plain link, not a cluster
// membership. Naturally absent for any town with no eligible month yet.
const latestMonth = listEligibleMonths(siteConfig.townId, siteConfig.timezone)[0];
const pageMeta = resolvePageMeta('traffic', siteConfig);
const clusterNavItems = resolveHubNavItems('traffic', siteConfig);
const rawIncidents = await getTrafficIncidentsFromLatestRead();
// Traffic Phase 5 (2026-10-09): the scraper's own bounding box is looser
// than "this town" -- see lib/traffic.ts's own module doc for the real
// stored-data audit that found it storing other towns'/other cities'
// highways too. Every incident is re-classified here against the real
// town boundary + a named corridor list before it's allowed on the page;
// anything that's neither in town nor on a configured corridor within
// range is dropped, never shown as if it were town-relevant.
const incidents = rawIncidents
  .map((incident) => {
    const c = classifyTrafficIncident(incident, siteConfig.townId, siteConfig.trafficCorridors, siteConfig.trafficCorridorMaxMiles);
    return c ? { ...incident, zone: c.zone, distanceMiles: c.distanceMiles } : null;
  })
  .filter((i): i is NonNullable<typeof i> => i !== null);
const lastRun = siteConfig.trafficSource ? await getTrafficLastRun() : null;
const lastRunLabel = lastRun
  ? new Date(lastRun).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: siteConfig.timezone, timeZoneName: 'short' })
  : null;
const readIsStale = lastRun != null && Date.now() - new Date(lastRun).getTime() > TRAFFIC_READ_MAX_AGE_HOURS * 3_600_000;
const pageState = trafficPageState(incidents.length, siteConfig.cityName, lastRunLabel, isQuietSection('traffic'), readIsStale);
writeTrafficVerdict(siteConfig.townId, !pageState.noindex);
const canonicalUrl = new URL('/traffic/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Traffic', href: canonicalUrl },
];

const typeLabel = (t: string) => (t === 'lane_closure' ? 'Lane closure / construction' : 'Incident');

const SEVERITY_LABELS: Record<string, string> = {
  closure: 'Closure', injury: 'Injury reported', incident: 'Incident', planned: 'Planned closure',
};
const whereLabel = (i: { zone: 'in_town' | 'approach'; distanceMiles: number | null }) =>
  i.zone === 'in_town' ? `In ${siteConfig.cityName}` : `Approach roads · ${Math.round(i.distanceMiles ?? 0)} mi out`;
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-traffic" noindex={pageState.noindex}
  description={metaDescription('traffic', siteConfig)}
  accentColor={SECTION_THEME.traffic.accent}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  {pageState.statusLine && siteConfig.trafficSource && (
    <p class="traffic-status">
      {pageState.statusLine} <a href={siteConfig.trafficSource.url} rel="noopener">Check live road conditions on {siteConfig.trafficSource.name}</a>.
    </p>
  )}

  {incidents.length > 0 && <SectionRule label={`${incidents.length} reported${lastRunLabel ? ` as of ${lastRunLabel}` : ''}`} />}

  {incidents.length > 0 && (
    <div class="controls">
      <label>
        Severity
        <select id="severity-filter">
          <option value="">All</option>
          {[...new Set(incidents.map((i) => i.severity ?? 'incident'))].map((s) => (
            <option value={s}>{SEVERITY_LABELS[s] ?? s}</option>
          ))}
        </select>
      </label>
      <label>
        Where
        <select id="zone-filter">
          <option value="">All</option>
          {[...new Set(incidents.map((i) => i.zone))].map((z) => (
            <option value={z}>{z === 'in_town' ? `In ${siteConfig.cityName}` : 'Approach roads'}</option>
          ))}
        </select>
      </label>
    </div>
  )}

  {incidents.length > 0 ? (
    <table class="incidents" id="incidents-table">
      <thead>
        <tr><th scope="col">Severity</th><th scope="col">Where</th><th scope="col">Road</th><th scope="col">Details</th><th scope="col">Last updated</th></tr>
      </thead>
      <tbody>
        {incidents.map((incident) => (
          <tr data-severity={incident.severity ?? 'incident'} data-zone={incident.zone}>
            <td class={`sev sev--${incident.severity ?? 'incident'}`}>
              {SEVERITY_LABELS[incident.severity ?? 'incident']}
            </td>
            <td class="data">{whereLabel(incident)}</td>
            <td>{incident.road ?? '—'}</td>
            <td>
              <p class="plain">{plainLanguageTraffic(incident.title)}</p>
              {incident.description && <p class="plain desc">{plainLanguageTraffic(incident.description)}</p>}
              <details class="raw">
                <summary>View source detail</summary>
                <p class="type">{typeLabel(incident.incident_type)}</p>
                <p>{incident.title}</p>
                {incident.description && <p>{incident.description}</p>}
              </details>
            </td>
            <td class="data">{formatTimeWithZone(incident.last_seen_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}

  {siteConfig.trafficSource && incidents.length > 0 && (
    <p class="source">
      Source: <a href={siteConfig.trafficSource.url} rel="noopener">{siteConfig.trafficSource.name}</a>, refreshed regularly. {siteConfig.trafficSource.scopeNote}
    </p>
  )}

  <ClusterNav clusterLabel="Getting around" items={clusterNavItems} />

  <RelatedContent pageType="traffic" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  <AboutThisPage slot="about">
    <p>Current road incidents, closures and construction near {siteConfig.cityName} —
    {siteConfig.trafficSource && (
    <> straight from <a href={siteConfig.trafficSource.url} rel="noopener">{siteConfig.trafficSource.name}</a>,
    the state's own public incident feed. {siteConfig.trafficSource.scopeNote} The feed is read on a schedule,
    not continuously, and the list shows what the latest read found, with no manual review in between.
    For conditions right now, use the state's own map.</>
    )}</p>
    {latestMonth && (
      <p>See the full <a href={`/month/${monthSlug(latestMonth.year, latestMonth.month)}/`}>month in review for {monthLabel(latestMonth.year, latestMonth.month)} →</a></p>
    )}
  </AboutThisPage>
</BaseLayout>

<script>
  import { initDataTable } from '../lib/data-table';
  import { EMPTY_STATES } from '../lib/empty-states';

  function init() {
    initDataTable({
      tableId: 'incidents-table',
      filters: [{ selectId: 'severity-filter', attr: 'severity' }, { selectId: 'zone-filter', attr: 'zone' }],
      emptyMessage: EMPTY_STATES.searchFilter,
    });
  }
  init();
</script>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.month-teaser { font-size: 0.875rem; }
.source a { color: var(--section-accent, var(--navy)); }
.controls { display: flex; gap: 1.25rem; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
.controls label { display: flex; align-items: center; gap: 0.4rem; color: var(--ink-soft); }
.controls select { font: inherit; padding: 0.2rem 0.4rem; }
.incidents { width: 100%; border-collapse: collapse; background: var(--surface); font-size: 0.9375rem; }
.incidents th {
  text-align: left;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  font-weight: 600;
  padding: 0.625rem 0.875rem;
  border-bottom: 1px solid var(--rule);
}
.incidents td { padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
.incidents tr:last-child td { border-bottom: 0; }
.type { color: var(--alert); font-weight: 600; white-space: nowrap; }
.sev { font-weight: 600; white-space: nowrap; }
.sev--closure { color: var(--alert); }
.sev--injury { color: var(--alert); }
.sev--incident { color: var(--ink); }
.sev--planned { color: var(--ink-soft); }
.plain { margin: 0; }
.desc { margin-top: 0.25rem; font-size: 0.9375rem; color: var(--ink-soft); }
.raw { margin-top: 0.375rem; font-size: 0.8125rem; }
.raw summary { cursor: pointer; color: var(--ink-soft); }
.raw p { margin: 0.25rem 0 0; color: var(--ink-soft); }
.traffic-status { margin: 1.25rem 0 0; font-size: 1rem; }
.traffic-status a { color: var(--section-accent, var(--navy)); }
.source { margin-top: 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
</style>

---
/** Traffic incidents as a TABLE, no AI -- see lib/db.ts (getActiveTrafficIncidents) and scrapers/parsers/traffic_v1.py.
 *
 *  Built only for a town with a traffic source (owner 2026-11-07): without one the page does not exist at all, so it is not built, not in the
 *  nav and not in the sitemap (the host answers a real 404, like the holiday pages). Indexing per town (owner 2026-11-15,
 *  lib/traffic-verdict.ts): always indexed where the source lists standing closures, otherwise with 72 h / 3-read inertia before noindex.
 *  Under the current list, "Earlier this week" (lib/traffic-earlier.ts): incidents of the last 7 days that are no longer active, each with
 *  its date, under its own heading. Without either the page shows no message and no explanation line, and it is noindex.
 *  Top block (audit Fas 6a, owner 2026-11-16, lib/traffic-hero.ts): hero + "most affected road" + "listed until"; duplicate rows are
 *  shown once (display only). */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import HeroStat from '../components/ui/HeroStat.astro';
import InsightLine from '../components/ui/InsightLine.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getTrafficIncidentsFromLatestRead, getTrafficIncidentsStartedSince, getTrafficLatestReadStart, getTrafficLastRun, formatTimeWithZone, plainLanguageTraffic } from '../lib/db';
import { TRAFFIC_EARLIER_DAYS, earlierTrafficIncidents } from '../lib/traffic-earlier';
import { TRAFFIC_READ_MAX_AGE_HOURS, trafficIndexingForTown } from '../lib/traffic-verdict';
import { siteConfig, isQuietSection } from '../lib/site-config';
import { isSectionBuilt } from '../lib/sections';

export function getStaticPaths() {
  return isSectionBuilt('traffic', siteConfig) ? [{ params: { traffic: 'traffic' } }] : [];
}
import { metaDescription } from '../lib/meta-description';
import { placeAbbr } from '../lib/country-profile';
import { SECTION_THEME } from '../lib/section-theme';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { resolvePageMeta } from '../lib/page-meta';
import { resolveHubNavItems } from '../lib/clusters';
import ClusterNav from '../components/ClusterNav.astro';
import { classifyTrafficIncident } from '../lib/traffic';
import { dedupeTrafficIncidents, listedUntil, mostAffectedRoad, sentenceCase, trafficCause, trafficHero, withoutCurrent } from '../lib/traffic-hero';
import { listEligibleMonths, monthLabel, monthSlug } from '../lib/month-in-review';

// Phase 8 teaser link (research section 3) -- plain link, not a cluster
// membership. Naturally absent for any town with no eligible month yet.
const latestMonth = listEligibleMonths(siteConfig.townId, siteConfig.timezone)[0];
const pageMeta = resolvePageMeta('traffic', siteConfig);
const clusterNavItems = resolveHubNavItems('traffic', siteConfig);
const rawIncidents = await getTrafficIncidentsFromLatestRead();
// Traffic Phase 5 (2026-10-09): the scraper's own bounding box is looser
// than "this town" -- see lib/traffic.ts's own module doc for the real
// stored-data audit that found it storing other towns'/other cities'
// highways too. Every incident is re-classified here against the real
// town boundary + a named corridor list before it's allowed on the page;
// anything that's neither in town nor on a configured corridor within
// range is dropped, never shown as if it were town-relevant.
const incidents = dedupeTrafficIncidents(rawIncidents
  .map((incident) => {
    const c = classifyTrafficIncident(incident, siteConfig.townId, siteConfig.trafficCorridors, siteConfig.trafficCorridorMaxMiles);
    return c ? { ...incident, zone: c.zone, distanceMiles: c.distanceMiles } : null;
  })
  .filter((i): i is NonNullable<typeof i> => i !== null));
const [lastRun, latestReadStart, startedThisWeek] = siteConfig.trafficSource
  ? await Promise.all([getTrafficLastRun(), getTrafficLatestReadStart(), getTrafficIncidentsStartedSince(TRAFFIC_EARLIER_DAYS)])
  : [null, null, []];
const now = new Date();
const earlier = withoutCurrent(dedupeTrafficIncidents(earlierTrafficIncidents(startedThisWeek, {
  latestReadStart: latestReadStart ? new Date(latestReadStart).toISOString() : null, now,
  townId: siteConfig.townId, corridors: siteConfig.trafficCorridors, corridorMaxMiles: siteConfig.trafficCorridorMaxMiles,
})), incidents);
const shown = incidents.length + earlier.length;
const readIsStale = lastRun != null && now.getTime() - new Date(lastRun).getTime() > TRAFFIC_READ_MAX_AGE_HOURS * 3_600_000;
const locale = siteConfig.country === 'gb' ? 'en-GB' : 'en-US';
const hero = siteConfig.trafficSource ? trafficHero({
  current: incidents, earlierCount: earlier.length, readAt: lastRun ? new Date(lastRun).toISOString() : null, readIsStale,
  now, tz: siteConfig.timezone, locale, scope: siteConfig.trafficSource.heroScope, cityName: siteConfig.cityName,
}) : null;
const roadLine = hero ? mostAffectedRoad([...incidents, ...earlier], siteConfig.trafficCorridors) : null;
const untilLine = hero ? listedUntil(incidents, now, siteConfig.timezone, locale) : null;
const causeOf = (description: string | null) => { const c = trafficCause(description); return c ? sentenceCase(c) : null; };
const indexing = await trafficIndexingForTown({
  townId: siteConfig.townId, siteUrl: siteConfig.siteUrl, rule: siteConfig.trafficSource?.indexing ?? 'inertia', quiet: isQuietSection('traffic'),
  incidentCount: shown, readAt: lastRun && !readIsStale ? new Date(lastRun).toISOString() : null,
});
const canonicalUrl = new URL('/traffic/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Traffic', href: canonicalUrl },
];

const typeLabel = (t: string) => (t === 'lane_closure' ? 'Lane closure / construction' : 'Incident');

const SEVERITY_LABELS: Record<string, string> = {
  closure: 'Closure', injury: 'Injury reported', incident: 'Incident', planned: 'Planned closure',
};
const earlierWhen = (at: string) => new Date(at).toLocaleString(siteConfig.country === 'gb' ? 'en-GB' : 'en-US', {
  weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: siteConfig.timezone, timeZoneName: 'short',
});
const whereLabel = (i: { zone: 'in_town' | 'approach'; distanceMiles: number | null }) =>
  i.zone === 'in_town' ? `In ${siteConfig.cityName}` : `Approach roads · ${Math.round(i.distanceMiles ?? 0)} mi out`;
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-traffic" noindex={!indexing.indexable}
  description={metaDescription('traffic', siteConfig)}
  accentColor={SECTION_THEME.traffic.accent}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  {hero && (
    <section class="answer" data-traffic-hero>
      <HeroStat value={hero.value} sub={hero.sub} meta={hero.meta} tone="accent" />
      {roadLine && <InsightLine attrs={{ 'data-traffic-insight': 'road' }}>{roadLine}</InsightLine>}
      {untilLine && <InsightLine attrs={{ 'data-traffic-insight': 'until' }}>{untilLine}</InsightLine>}
    </section>
  )}

  {incidents.length > 0 && (
    <div class="controls">
      <label>
        Severity
        <select id="severity-filter">
          <option value="">All</option>
          {[...new Set(incidents.map((i) => i.severity ?? 'incident'))].map((s) => (
            <option value={s}>{SEVERITY_LABELS[s] ?? s}</option>
          ))}
        </select>
      </label>
      <label>
        Where
        <select id="zone-filter">
          <option value="">All</option>
          {[...new Set(incidents.map((i) => i.zone))].map((z) => (
            <option value={z}>{z === 'in_town' ? `In ${siteConfig.cityName}` : 'Approach roads'}</option>
          ))}
        </select>
      </label>
    </div>
  )}

  {incidents.length > 0 ? (
    <table class="incidents" id="incidents-table">
      <thead>
        <tr><th scope="col">Severity</th><th scope="col">Where</th><th scope="col">Road</th><th scope="col">Details</th><th scope="col">Last updated</th></tr>
      </thead>
      <tbody>
        {incidents.map((incident) => (
          <tr data-severity={incident.severity ?? 'incident'} data-zone={incident.zone} data-traffic-row="current">
            <td class={`sev sev--${incident.severity ?? 'incident'}`} data-label="Severity">
              {SEVERITY_LABELS[incident.severity ?? 'incident']}
            </td>
            <td class="data" data-label="Where">{whereLabel(incident)}</td>
            <td data-label="Road">{incident.road ?? '—'}</td>
            <td class="details">
              <p class="plain">{plainLanguageTraffic(incident.title)}</p>
              {causeOf(incident.description) && <p class="cause">{causeOf(incident.description)}</p>}
              {incident.description && <p class="plain desc">{plainLanguageTraffic(incident.description)}</p>}
              <details class="raw">
                <summary>View source detail</summary>
                <p class="type">{typeLabel(incident.incident_type)}</p>
                <p>{incident.title}</p>
                {incident.description && <p>{incident.description}</p>}
              </details>
            </td>
            <td class="data" data-label="Last updated">{formatTimeWithZone(incident.last_seen_at)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : null}

  {siteConfig.trafficSource && earlier.length > 0 && (
    <section class="earlier" aria-labelledby="earlier-heading" data-traffic-earlier>
      <h2 id="earlier-heading">Earlier this week</h2>
      <table class="incidents incidents--earlier">
        <thead>
          <tr><th scope="col">When</th><th scope="col">Where</th><th scope="col">Type</th><th scope="col">Source</th></tr>
        </thead>
        <tbody>
          {earlier.map((incident) => (
            <tr data-traffic-row="earlier">
              <td class="data" data-label="When"><time datetime={incident.at}>{earlierWhen(incident.at)}</time></td>
              <td data-label="Where">{incident.road ?? '—'}<span class="where-zone">{whereLabel(incident)}</span></td>
              <td class="details">{plainLanguageTraffic(incident.title)}{causeOf(incident.description) && <span class="cause">{causeOf(incident.description)}</span>}</td>
              <td data-label="Source"><a href={siteConfig.trafficSource!.url} rel="noopener">{siteConfig.trafficSource!.name}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {siteConfig.trafficSource && shown > 0 && (
    <p class="source">
      Source: <a href={siteConfig.trafficSource.url} rel="noopener">{siteConfig.trafficSource.name}</a>, refreshed regularly. {siteConfig.trafficSource.scopeNote}
    </p>
  )}

  <ClusterNav clusterLabel="Getting around" items={clusterNavItems} />

  <RelatedContent pageType="traffic" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  <AboutThisPage slot="about">
    <p>Current road incidents, closures and construction near {siteConfig.cityName} —
    {siteConfig.trafficSource && (
    <> straight from <a href={siteConfig.trafficSource.url} rel="noopener">{siteConfig.trafficSource.name}</a>,
    the state's own public incident feed. {siteConfig.trafficSource.scopeNote} The feed is read on a schedule,
    not continuously, and the list shows what the latest read found, with no manual review in between.
    For conditions right now, use the state's own map.</>
    )}</p>
    {latestMonth && (
      <p>See the full <a href={`/month/${monthSlug(latestMonth.year, latestMonth.month)}/`}>month in review for {monthLabel(latestMonth.year, latestMonth.month)} →</a></p>
    )}
  </AboutThisPage>
</BaseLayout>

<script>
  import { initDataTable } from '../lib/data-table';
  import { EMPTY_STATES } from '../lib/empty-states';

  function init() {
    initDataTable({
      tableId: 'incidents-table',
      filters: [{ selectId: 'severity-filter', attr: 'severity' }, { selectId: 'zone-filter', attr: 'zone' }],
      emptyMessage: EMPTY_STATES.searchFilter,
    });
  }
  init();
</script>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.month-teaser { font-size: 0.875rem; }
.source a { color: var(--section-accent, var(--navy)); }
.controls { display: flex; gap: 1.25rem; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
.controls label { display: flex; align-items: center; gap: 0.4rem; color: var(--ink-soft); }
.controls select { font: inherit; padding: 0.2rem 0.4rem; }
.incidents { width: 100%; border-collapse: collapse; background: var(--surface); font-size: 0.9375rem; }
.incidents th {
  text-align: left;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  font-weight: 600;
  padding: 0.625rem 0.875rem;
  border-bottom: 1px solid var(--rule);
}
.incidents td { padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
.incidents tr:last-child td { border-bottom: 0; }
.type { color: var(--alert); font-weight: 600; white-space: nowrap; }
.sev { font-weight: 600; white-space: nowrap; }
.sev--closure { color: var(--alert); }
.sev--injury { color: var(--alert); }
.sev--incident { color: var(--ink); }
.sev--planned { color: var(--ink-soft); }
.plain { margin: 0; }
.desc { margin-top: 0.25rem; font-size: 0.9375rem; color: var(--ink-soft); }
.raw { margin-top: 0.375rem; font-size: 0.8125rem; }
.raw summary { cursor: pointer; color: var(--ink-soft); }
.raw p { margin: 0.25rem 0 0; color: var(--ink-soft); }
.earlier { margin-top: 2rem; }
.earlier h2 { font-size: 1.125rem; margin: 0 0 0.5rem; }
.where-zone { display: block; font-size: 0.8125rem; color: var(--ink-soft); }
.source { margin-top: 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
.answer { margin: 1.5rem 0 2rem; }
.cause { display: block; margin: 0.125rem 0 0; font-size: 0.875rem; font-weight: 600; color: var(--ink-soft); }
/* Phone: each incident is a short block (the details first, then labelled facts) instead of a table cut off at the screen edge. */
@media (max-width: 40rem) {
  .incidents thead { position: absolute; left: -9999px; }
  .incidents, .incidents tbody, .incidents tr, .incidents td { display: block; }
  .incidents tr { display: flex; flex-direction: column; padding: 0.625rem 0; border-bottom: 1px solid var(--rule); }
  .incidents tr:last-child { border-bottom: 0; }
  .incidents td { padding: 0.125rem 0.875rem; border: 0; }
  .incidents td.details { order: -1; padding-bottom: 0.25rem; }
  .incidents td[data-label]::before { content: attr(data-label) ": "; font-weight: 600; color: var(--ink-soft); }
  .controls { flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .where-zone { display: inline; margin-left: 0.35rem; }
}
</style>

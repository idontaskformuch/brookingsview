---
/** Thanksgiving page, one per US town. Rendered from data (config/holiday-pages/thanksgiving.ts) by the shared
 *  holiday template. Brookings' pickup moves are computed from the city's Thursday-holiday rule (lib/trash-schedule.ts).
 *  Indexable only around the holiday (lib/thanksgiving.ts); after the window it is noindex until the data is
 *  refreshed for the next year (owner 2026-11-04: showing last year's facts instead was left out, see state.md). */
import HolidayPage from '../components/HolidayPage.astro';
import { siteConfig } from '../lib/site-config';
import { buildThanksgivingPage, type BrookingsTrashMoves } from '../config/holiday-pages/thanksgiving';
import { THANKSGIVING_PAGE_YEAR, thanksgivingWeekMonday, isPastThanksgivingWindow } from '../lib/thanksgiving';
import { upcomingHolidayShifts } from '../lib/trash-schedule';

let moves: BrookingsTrashMoves | undefined;
if (siteConfig.townId === 'brookings_sd') {
  const movesFor = (side: 'south' | 'north') =>
    upcomingHolidayShifts(thanksgivingWeekMonday(THANKSGIVING_PAGE_YEAR), 6, side).find((h) => h.name === 'Thanksgiving Day')?.moves ?? [];
  moves = { south: movesFor('south'), north: movesFor('north') };
}
const page = siteConfig.country === 'us' ? buildThanksgivingPage(siteConfig.townId, moves) : null;
if (!page) {
  return Astro.redirect('/', 302);
}
---
<HolidayPage page={page} holidayLabel="Thanksgiving" noindex={isPastThanksgivingWindow(Date.now())} hasClosures={!!siteConfig.hasClosureWatch} />

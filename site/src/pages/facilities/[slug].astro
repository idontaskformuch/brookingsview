---
/** En enskild anläggning (bibliotek, park, city hall, ...) -- adress, telefon,
 *  öppettider, en kort beskrivning, och länk till den officiella källan.
 *
 *  Det här är MEDVETET en egen sida per rad, till skillnad från property_sales
 *  (se lib/db.ts, getFacilities-kommentaren, för resonemanget om varför det
 *  inte är samma "scaled content"-problem). Byggs för alla städer -- ingen
 *  townId-gate, eftersom facilities-tabellen redan är town_id-filtrerad via
 *  getFacilities()/getFacilityBySlug(). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ImageAttribution from '../../components/ImageAttribution.astro';
import { assertImageExists } from '../../lib/images';
import {
  getFacilities, getFacilityBySlug, FACILITY_CATEGORY_LABELS, FACILITY_SCHEMA_TYPE,
  formatCalendarDate, getUpcomingStories, buildVenueIndex, resolveVenue, formatOccursAt,
} from '../../lib/db';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { siteConfig } from '../../lib/site-config';
import { buildClusterBreadcrumbTrail } from '../../lib/clusters';
import { computeOpenStatus } from '../../lib/facility-hours';
import { buildFacilityLede } from '../../lib/facility-lede';
import { resolvePageMeta } from '../../lib/page-meta';

export async function getStaticPaths() {
  const facilities = await getFacilities();
  return facilities.map((f) => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const facility = await getFacilityBySlug(slug!);

if (!facility) {
  return Astro.redirect('/facilities/', 302);
}

const categoryLabel = FACILITY_CATEGORY_LABELS[facility.category] ?? facility.category;
const description = facility.description
  ? facility.description.slice(0, 155)
  : `Address, phone number and hours for ${facility.name} in ${siteConfig.cityName}, ${siteConfig.stateAbbr}.`;
// Sitewide title/H1/lede handoff, facility-detail rule: the lede must
// include the street address in prose form -- see buildFacilityLede's own
// comment for why this is synthesized at render time (varied connector
// phrasing) rather than a content rewrite of all 38 real facility
// descriptions. Distinct from `description` above (the <meta
// name="description"> value, which keeps its own 155-char truncation and
// doesn't need the address baked in).
const lede = buildFacilityLede(facility.description, facility.address, facility.slug);
const pageMeta = resolvePageMeta('facilities/detail', siteConfig, { FacilityName: facility.name });

// Cross-link upcoming events held at this facility -- the venue registry
// (ai_pipeline/venue_registry.py, site/src/lib/event-jsonld.ts) is the join
// key: an event's venue_raw resolves against the SAME facilities table this
// page renders, so no separate venue-to-facility mapping needs maintaining.
const allUpcoming = await getUpcomingStories(['event'], 200);
const venueIndex = buildVenueIndex(await getFacilities());
const upcomingHere = allUpcoming
  .filter((s) => resolveVenue(venueIndex, s.venue_raw)?.slug === facility.slug)
  .slice(0, 8);

const hasFullAddress = Boolean(facility.street_address && facility.postal_code);
// Recurring-traffic layer, Phase 2: "open now" computed from the
// structured hours (see lib/facility-hours.ts) -- known:false whenever
// hours_structured is null (no hours_text at all, or the parser flagged
// it for review), which the template below renders as no badge at all,
// never a guessed/false "closed".
const openStatus = computeOpenStatus(facility.hours_structured, new Date(), siteConfig.timezone);
const schemaType = FACILITY_SCHEMA_TYPE[facility.category] ?? 'CivicStructure';
// Sitewide presentation-layer pass: a verified real photo where one
// exists -- never a placeholder when it doesn't. image_needs_review means
// Task 1's Commons search couldn't confidently match this specific
// building (see db/migrations/028_facility_image_attribution.sql's own
// comment); rendering it anyway would present an unverified match as if it
// were confirmed, so this page stays text-only in that case, exactly the
// same "resolved or nothing" rule the JSON-LD address block below already
// follows.
const showFacilityImage = Boolean(facility.image_path) && !facility.image_needs_review;
// Same build-time safety net resolveImage()'s own venue tier already gives
// facility.image_path elsewhere -- a broken/missing file fails the build
// loudly instead of shipping a 404 <img src>.
if (showFacilityImage) assertImageExists(facility.image_path!, facility.slug);
const canonicalUrl = new URL(`/facilities/${facility.slug}/`, Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('facilities/detail', siteConfig, { label: facility.name, href: canonicalUrl });
---
<BaseLayout title={pageMeta.title} description={description} ogSlug={`facility-${facility.slug}`}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <article class="facility">
    <p class="kind data">{categoryLabel}</p>
    <h1>{pageMeta.h1}</h1>

    {showFacilityImage && (
      <>
        <img
          class="facility__image"
          src={facility.image_path}
          alt={facility.image_alt ?? facility.name}
          width="1200" height="800"
          loading="eager" decoding="async"
        />
        <ImageAttribution image={{
          attributionText: facility.image_attribution_text ?? undefined,
          attributionUrl: facility.image_attribution_url ?? undefined,
        }} />
      </>
    )}

    {/* Sitewide title/H1/lede handoff: moved above the facts <dl> --
        previously this paragraph rendered AFTER the address/phone/hours
        block, which meant the page's real editorial content structurally
        never qualified as a "lede" (the spec's own rule: must appear
        before any list, table, card grid, or widget) no matter how good
        the text itself was. `lede` (not `facility.description` directly)
        also carries the address in prose now -- see buildFacilityLede(). */}
    {lede && <p class="description">{lede}</p>}

    <dl class="facts">
      {facility.address && (
        <div class="fact"><dt>Address</dt><dd>{facility.address}</dd></div>
      )}
      {facility.phone && (
        <div class="fact"><dt>Phone</dt><dd><a href={`tel:${facility.phone.replace(/[^\d+]/g, '')}`}>{facility.phone}</a></dd></div>
      )}
      {facility.hours_text && (
        <div class="fact">
          <dt>Hours</dt>
          <dd>
            {openStatus.known && (
              <span class:list={['open-status', openStatus.isOpen ? 'open-status--open' : 'open-status--closed']}>
                {openStatus.isOpen ? `Open now — closes ${openStatus.closesAt}` : `Closed — opens ${openStatus.opensAt} ${openStatus.opensLabel}`}
              </span>
            )}
            <span class="hours-text">{facility.hours_text}</span>
          </dd>
        </div>
      )}
      {facility.website && (
        <div class="fact"><dt>Website</dt><dd><a href={facility.website} rel="noopener">{facility.website.replace(/^https?:\/\//, '')}</a></dd></div>
      )}
    </dl>

    {upcomingHere.length > 0 && (
      <>
        <h2 class="section-label">Upcoming events here</h2>
        <ul class="events">
          {upcomingHere.map((s) => (
            <li>
              <a href={`/s/${s.slug}/`}>{s.title}</a>
              <span class="when data">{formatOccursAt(s)}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    {facility.source_url && (
      <p class="source">
        Source: <a href={facility.source_url} rel="noopener">{siteConfig.cityName} official site</a>
        {facility.verified_date && <> — checked {formatCalendarDate(facility.verified_date)}</>}
      </p>
    )}

    <p class="back"><a href="/facilities/">← All local facilities</a></p>
  </article>

  <RelatedContent pageType="facilities" />

  {hasFullAddress && (
    /* Never claims a schema.org address for a facility that doesn't have a
       verified one -- same "resolved or nothing" rule as Event JSON-LD, see
       site/src/lib/event-jsonld.ts. */
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': schemaType,
      name: facility.name,
      address: {
        '@type': 'PostalAddress',
        streetAddress: facility.street_address,
        addressLocality: siteConfig.cityName,
        addressRegion: siteConfig.stateAbbr,
        postalCode: facility.postal_code,
        addressCountry: 'US',
      },
      ...(facility.lat != null && facility.lon != null
        ? { geo: { '@type': 'GeoCoordinates', latitude: facility.lat, longitude: facility.lon } }
        : {}),
      ...(facility.phone ? { telephone: facility.phone } : {}),
      ...(facility.website ? { url: facility.website } : {}),
    })} />
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.facility { max-width: 38rem; }
.kind { color: var(--ink-soft); margin: 0 0 0.25rem; }
.facility__image { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; margin-top: 1rem; }
.facts { margin: 1rem 0; display: grid; gap: 0.5rem; }
.fact { display: grid; grid-template-columns: 6rem 1fr; gap: 0.75rem; padding: 0.375rem 0; border-bottom: 1px solid var(--rule); }
.fact dt { font-family: var(--font-ui); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
.fact dd { margin: 0; }
.open-status { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.15rem; }
.open-status--open { color: var(--status-good); }
.open-status--closed { color: var(--ink-soft); }
.hours-text { display: block; color: var(--ink-soft); font-size: 0.9rem; }
.description { margin: 1.25rem 0; line-height: 1.6; }
.section-label { margin: 1.75rem 0 0.75rem; font-size: 1.0625rem; }
.events { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.events li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
.events a { font-weight: 600; }
.events .when { color: var(--ink-soft); white-space: nowrap; font-size: 0.8125rem; }
.source { font-size: 0.875rem; color: var(--ink-soft); margin-top: 1.5rem; }
.back { margin-top: 1rem; }
</style>

---
/** Katalogsida: alla lokala anläggningar (bibliotek, parker, city hall, ...)
 *  för den aktuella orten, grupperade per category. Länkar vidare till
 *  [slug].astro för respektive anläggnings egen sida.
 *
 *  Bakgrund: Search Console visade att sökningar som "moreno valley library"
 *  och "lasselle sports park" stod för nästan alla exponeringar sajten fick,
 *  men gav noll klick -- ingen sida besvarade frågan direkt. Se
 *  lib/db.ts (getFacilities) för det fullständiga resonemanget. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionRule from '../../components/SectionRule.astro';
import ShareButton from '../../components/ShareButton.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getFacilities, FACILITY_CATEGORY_LABELS } from '../../lib/db';
import { siteConfig, isSectionDisabled } from '../../lib/site-config';
if (isSectionDisabled('facilities')) return Astro.redirect('/', 302);
import { placeAbbr } from '../../lib/country-profile';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { resolvePageMeta } from '../../lib/page-meta';
import { resolveHubNavItems } from '../../lib/clusters';
import ClusterNav from '../../components/ClusterNav.astro';

const pageMeta = resolvePageMeta('facilities', siteConfig);
const clusterNavItems = resolveHubNavItems('facilities', siteConfig);
const facilities = await getFacilities();

const byCategory = new Map<string, typeof facilities>();
for (const f of facilities) {
  if (!byCategory.has(f.category)) byCategory.set(f.category, []);
  byCategory.get(f.category)!.push(f);
}
// Broomfield facilities expansion: every category FACILITY_CATEGORY_LABELS
// (lib/db.ts) knows about, not just the 5 that happened to be in use when
// this list was first written -- `police`/`post_office` already existed in
// that label map with no facility ever using them yet, so this exact gap
// (an unlisted category silently sorting to the front via .indexOf()'s -1)
// was already live and simply hadn't been exercised. Fixed here for good,
// not just patched for the two new categories this pass adds.
const categoryOrder = [
  'library', 'park', 'city_hall', 'police', 'fire_station', 'post_office',
  'recycling', 'animal_shelter', 'medical', 'school_district', 'transit',
  'museum', 'leisure', 'community_center', 'other',
];
const categories = [...byCategory.keys()].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);

const canonicalUrl = new URL('/facilities/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Facilities', href: canonicalUrl },
];
---
<BaseLayout title={pageMeta.title} wide ogSlug="section-facilities"
  description={`Addresses, phone numbers and hours for libraries, parks, city hall and other public facilities in ${placeAbbr(siteConfig)}.`}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
    <p>Addresses, phone numbers and hours for libraries, parks, city hall and
    other public places in {siteConfig.cityName} — the basics, in one place.
    Every fact here is checked against the facility's own official page, and
    each one shows the date it was last confirmed, so you know how current
    it is before you rely on it.</p>
    <ShareButton title={pageMeta.title} />
  </header>

  {categories.length > 0 ? categories.map((cat) => (
    <>
      <SectionRule label={FACILITY_CATEGORY_LABELS[cat] ?? cat} />
      {/* Open/Closed badge client-side move (2026-10-15): no more
          computeOpenStatus() call here -- a static hub page rebuilt every
          6h (scrape.yml) baking "now" in at build time is exactly the
          staleness bug facilities/[slug].astro's own script comment
          describes. data-tz on the <ul> (once per category list, not
          per-item) + data-hours per <li> that actually has structured
          hours; the badge <span> is absent entirely for a facility with
          none, and stays hidden (no badge, just the name/address already
          shown) until the <script> below fills it in client-side. */}
      <ul class="list" data-open-status-tz={siteConfig.timezone}>
        {byCategory.get(cat)!.map((f) => (
          <li>
            <a href={`/facilities/${f.slug}/`}>{f.name}</a>
            {f.address && <span class="addr"> — {f.address}</span>}
            {f.hours_structured && (
              <span class="badge" data-open-status-badge data-hours={JSON.stringify(f.hours_structured)} hidden></span>
            )}
          </li>
        ))}
      </ul>
    </>
  )) : (
    <p class="empty">No facility information available yet.</p>
  )}

  <ClusterNav clusterLabel="Places" items={clusterNavItems} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  <script>
    // Same client-side computation move as facilities/[slug].astro's own
    // script -- see that file's comment. computeOpenStatus() here is the
    // OLDER hours_structured-based function (lib/facility-hours.ts), not
    // computePlaceOpenStatus() -- this hub list still reads the same data
    // source it always has; only WHERE the decision runs changed.
    import { computeOpenStatus } from '../../lib/facility-hours';
    import type { StructuredHours } from '../../lib/db';

    document.querySelectorAll<HTMLElement>('[data-open-status-badge]').forEach((badge) => {
      const tz = badge.closest<HTMLElement>('[data-open-status-tz]')?.dataset.openStatusTz;
      const raw = badge.dataset.hours;
      if (!tz || !raw) return;
      const hours = JSON.parse(raw) as StructuredHours;
      const status = computeOpenStatus(hours, new Date(), tz);
      if (!status.known) return;
      badge.hidden = false;
      badge.className = `badge ${status.isOpen ? 'badge--open' : 'badge--closed'}`;
      badge.textContent = status.isOpen ? 'Open now' : `Closed — opens ${status.opensAt} ${status.opensLabel}`;
    });
  </script>
</BaseLayout>

<style>
.lede { max-width: 42rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.list { list-style: none; margin: 0 0 0.5rem; padding: 0; display: grid; gap: 0.5rem; max-width: 44rem; }
.list li { padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
.list a { font-weight: 600; }
.addr { color: var(--ink-soft); font-size: 0.9375rem; }
.empty { color: var(--ink-soft); }
.badge {
  display: inline-block; margin-left: 0.5rem; font-family: var(--font-ui);
  font-size: 0.75rem; font-weight: 600;
}
.badge--open { color: var(--ink); }
.badge--open::before { content: ''; display: inline-block; width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--status-ok); margin-right: 0.4em; vertical-align: baseline; }
.badge--closed { color: var(--ink-soft); }
</style>

---
/** Katalogsida: alla lokala anläggningar (bibliotek, parker, city hall, ...)
 *  för den aktuella orten, grupperade per category. Länkar vidare till
 *  [slug].astro för respektive anläggnings egen sida.
 *
 *  Bakgrund: Search Console visade att sökningar som "moreno valley library"
 *  och "lasselle sports park" stod för nästan alla exponeringar sajten fick,
 *  men gav noll klick -- ingen sida besvarade frågan direkt. Se
 *  lib/db.ts (getFacilities) för det fullständiga resonemanget.
 *
 *  Designsystem Fas 4 (2026-11-25): the page grid (no `wide`); each row shows its weekly hours and an open/closed pill where the
 *  place has structured hours; the H1 promises hours only when most places have them (lib/facilities-hub.ts); parks are a compact
 *  2-3 column grid with the amenities the place's own services list states (config/park-amenities.ts); the town, state and ZIP
 *  are not repeated on every row. Rules and tests: lib/facilities-hub.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutThisPage from '../../components/ui/AboutThisPage.astro';
import Pill from '../../components/ui/Pill.astro';
import SectionRule from '../../components/SectionRule.astro';
import ShareButton from '../../components/ShareButton.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getFacilities, getAllPlaceHoursForTown, isPublicPlace, FACILITY_CATEGORY_LABELS, type PlaceHoursRow } from '../../lib/db';
import { siteConfig } from '../../lib/site-config';
import { isSectionBuilt } from '../../lib/sections';
import { metaDescription } from '../../lib/meta-description';
if (!isSectionBuilt('facilities', siteConfig)) return Astro.redirect('/', 302);
import { forCountry } from '../../lib/country-profile';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../../lib/article-jsonld';
import { resolvePageMeta } from '../../lib/page-meta';
import { resolveHubNavItems } from '../../lib/clusters';
import { hubPromisesHours, parkAmenities, shortAddress, weeklyHoursLine } from '../../lib/facilities-hub';
import { effectiveHours, seasonRangeLabel } from '../../lib/hours-spec';
import { PARK_HOURS, PARK_HOURS_LABEL } from '../../config/park-hours';
import { EVENT_VENUES } from '../../config/hours-scope';
import { todayDate } from '../../lib/today-page';
import ClusterNav from '../../components/ClusterNav.astro';
import { otherTownOf } from '../../lib/place-locality';

const pageMeta = resolvePageMeta('facilities', siteConfig);
const clusterNavItems = resolveHubNavItems('facilities', siteConfig);
// Venue categories (bars, music venues, shopping) are place rows for event matching, not public facilities (lib/db.ts).
const facilities = (await getFacilities()).filter(isPublicPlace);
// Effective hours (lib/hours-spec.ts): place_hours rows, else hours_structured with the season in force on the town's date.
const rowsByPlace = new Map<number, PlaceHoursRow[]>();
for (const r of await getAllPlaceHoursForTown()) {
  if (!rowsByPlace.has(r.place_id)) rowsByPlace.set(r.place_id, []);
  rowsByPlace.get(r.place_id)!.push(r);
}
const buildDay = todayDate(new Date(), siteConfig.timezone).iso;
const parkRule = PARK_HOURS[siteConfig.townId] ?? null;
const hoursById = new Map(facilities.map((f) => [f.id, effectiveHours(f, rowsByPlace.get(f.id) ?? [], buildDay, parkRule)]));
const h1 = hubPromisesHours(facilities.map((f) => ({ hasHours: hoursById.get(f.id) != null, slug: f.slug })), EVENT_VENUES[siteConfig.townId] ?? [])
  ? pageMeta.h1 : (pageMeta.h1WithoutHours ?? pageMeta.h1);

const byCategory = new Map<string, typeof facilities>();
// A place whose own address names another town (Farm House Collective, Riverside) is listed last under "Nearby", never among this
// town's places (owner 2026-11-26, lib/place-locality.ts).
const NEARBY_GROUP = '__nearby';
const nearbyPlaces = facilities.filter((f) => otherTownOf(f, siteConfig.cityName));
for (const f of facilities) {
  if (otherTownOf(f, siteConfig.cityName)) continue;
  if (!byCategory.has(f.category)) byCategory.set(f.category, []);
  byCategory.get(f.category)!.push(f);
}
// Every category FACILITY_CATEGORY_LABELS (lib/db.ts) knows about; an unlisted category would sort to the front via indexOf's -1.
const categoryOrder = [
  'library', 'park', 'city_hall', 'police', 'fire_station', 'post_office',
  'recycling', 'animal_shelter', 'medical', 'school_district', 'transit',
  'museum', 'leisure', 'community_center', 'other',
];
const townCategories = [...byCategory.keys()].sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);
if (nearbyPlaces.length > 0) byCategory.set(NEARBY_GROUP, nearbyPlaces);
const categories = nearbyPlaces.length > 0 ? [...townCategories, NEARBY_GROUP] : townCategories;
const groupLabel = (cat: string) => (cat === NEARBY_GROUP ? 'Nearby' : FACILITY_CATEGORY_LABELS[cat] ?? cat);
// Parks are many and short: a compact grid instead of a long list (Fas 4).
const GRID_CATEGORIES = new Set(['park']);
const rowsFor = (cat: string) => byCategory.get(cat)!.map((f) => {
  const eff = hoursById.get(f.id) ?? null;
  const line = eff ? weeklyHoursLine(eff.rows) : null;
  return {
    slug: f.slug,
    name: f.name,
    address: shortAddress(f.address, siteConfig.cityName),
    // A seasonal week says which part of the year it is for: "Mon–Sat 10am–5pm, Sun 1pm–5pm (Apr 1–Dec 31)".
    hours: line && eff?.season ? `${line} (${seasonRangeLabel(eff.season)})` : line && eff?.dated ? `${line} (next 7 days)` : line,
    hoursJson: eff ? JSON.stringify(eff.pillRows) : null,
    // The town's rule, not the park's own posted hours: said discreetly after the line (order D 2).
    hoursSource: eff?.source === 'city-park-rule' ? PARK_HOURS_LABEL : null,
    amenities: GRID_CATEGORIES.has(cat) ? parkAmenities(f.services) : [],
    // A place whose hours we do not phrase ourselves links to its own page instead (lib/hours-link-only.ts).
    hoursLink: f.hours_link,
  };
});
// Only the kinds this town actually lists (Glasgow has no parks or city hall here; the old fixed sentence promised them).
const kindLabels = townCategories.map((c) => (FACILITY_CATEGORY_LABELS[c] ?? c).toLowerCase());
const placeKinds = kindLabels.length > 1 ? `${kindLabels.slice(0, -1).join(', ')} and ${kindLabels[kindLabels.length - 1]}` : kindLabels[0] ?? '';

const canonicalUrl = new URL('/facilities/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = [
  { label: 'Home', href: '/' },
  { label: 'Facilities', href: canonicalUrl },
];
// Open/closed pill: computed in the browser only (standards.md, time-dependent words). data-open-status-tz once per list,
// data-hours per row that has structured hours; the pill stays hidden until the script below fills it, and a row without
// structured hours has no pill at all.
---
<BaseLayout title={pageMeta.title} ogSlug="section-facilities"
  description={metaDescription('facilities', siteConfig)}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>{h1}</h1>
    <ShareButton title={pageMeta.title} />
  </header>

  {categories.map((cat) => (
    <section class="fac-group">
      <SectionRule label={groupLabel(cat)} />
      <ul class:list={['fac-list', GRID_CATEGORIES.has(cat) && 'fac-list--grid']}
        data-open-status-tz={siteConfig.timezone} data-gb={forCountry(siteConfig.country, '', '1')} data-sun={JSON.stringify(siteConfig.townCenter)}>
        {rowsFor(cat).map((r) => (
          <li class="fac">
            <a class="fac__name" href={`/facilities/${r.slug}/`}>{r.name}</a>
            {r.hoursJson && (
              <span class="fac__status" data-open-status-badge data-hours={r.hoursJson} hidden><Pill tone="neutral"></Pill></span>
            )}
            {r.address && <span class="fac__meta">{r.address}</span>}
            {r.hours && <span class="fac__meta fac__hours">{r.hours}{r.hoursSource && <span class="fac__source"> · {r.hoursSource}</span>}</span>}
            {r.hoursLink && <span class="fac__meta fac__hours"><a href={r.hoursLink.url} rel="noopener">{r.hoursLink.label}</a></span>}
            {r.amenities.length > 0 && (
              <span class="fac__amenities">{r.amenities.map((a) => <Pill>{a}</Pill>)}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <ClusterNav clusterLabel="Places" items={clusterNavItems} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
  <script>
    // Same client-side computation as facilities/[slug].astro's own script: "now" is never baked in at build.
    import { computePlaceOpenStatus } from '../../lib/place-hours';
    import type { PlaceHoursRow } from '../../lib/db';

    document.querySelectorAll<HTMLElement>('[data-open-status-badge]').forEach((badge) => {
      const list = badge.closest<HTMLElement>('[data-open-status-tz]');
      const tz = list?.dataset.openStatusTz;
      const raw = badge.dataset.hours;
      const pill = badge.querySelector<HTMLElement>('.ui-pill');
      if (!tz || !raw || !pill) return;
      const coords = list?.dataset.sun ? JSON.parse(list.dataset.sun) as { lat: number; lon: number } : null;
      const status = computePlaceOpenStatus(JSON.parse(raw) as PlaceHoursRow[], [], new Date(), tz, list?.dataset.gb === '1', coords);
      if (!status.known) return;
      pill.classList.remove('ui-pill--neutral', 'ui-pill--ok');
      pill.classList.add(status.isOpen ? 'ui-pill--ok' : 'ui-pill--neutral');
      pill.textContent = status.isOpen ? 'Open now' : status.opensAt ? `Closed · opens ${status.opensAt} ${status.opensLabel}` : 'Closed';
      badge.hidden = false;
    });
  </script>
  <AboutThisPage slot="about">
    <p>Public places in {siteConfig.cityName}{placeKinds ? ` (${placeKinds})` : ''}, with the address, the weekly hours where
    the place publishes them, and whether it is open right now. Open a place for its phone number, full hours and how to get
    there. Every fact is checked against the facility's own official page, and each place page shows the date it was last
    confirmed, so you know how current it is.</p>
  </AboutThisPage>
</BaseLayout>

<style>
.fac-group { margin-bottom: 1.5rem; }
.fac-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
.fac { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.6rem; padding: 0.6rem 0; border-bottom: 1px solid var(--rule); }
.fac__name { font-weight: 600; }
.fac__source { color: var(--ink-faint); }
.fac__meta { flex-basis: 100%; color: var(--ink-soft); font-family: var(--font-ui); font-size: max(13px, 0.875rem); font-variant-numeric: tabular-nums; }
.fac__amenities { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.15rem; }
.fac-list--grid { column-gap: 1.5rem; }
@media (min-width: 36rem) { .fac-list--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 62rem) { .fac-list--grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.fac-list--grid .fac { align-content: start; }
</style>

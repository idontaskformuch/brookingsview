---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site-config';
import CookiesGb from '../components/legal/gb/CookiesBody.astro';
---
<BaseLayout title={`Cookies — ${siteConfig.siteName}`} description={`${siteConfig.siteName}'s current cookie use.`}>
  {siteConfig.country === 'gb' ? <CookiesGb /> : (
  <article class="prose">
    <h1>Cookies</h1>
    <p><em>Last updated October 2026.</em></p>

    <p>Cloudflare, our hosting provider, may use a small number of strictly
    necessary cookies to keep the site secure and running smoothly; these
    aren't used to track you across other sites.</p>

    <p>This site may show advertising served by Google AdSense. If it does,
    Google and its advertising partners use cookies to serve ads based on a
    visitor's prior visits to this site or others, and to measure ad
    performance. Ads only load after you accept cookies through the banner
    on this site — declining means no advertising cookies are set, though
    you may see fewer or non-personalized ads as a result. You can control
    or opt out of personalized advertising directly through
    <a href="https://adssettings.google.com/" rel="noopener">Google's Ad
    Settings</a> or <a href="https://www.aboutads.info/choices/" rel="noopener">aboutads.info</a>,
    independent of the banner here.</p>

    <p>This site may also use Google Analytics to measure how many people
    visit and which pages they read. Unlike the advertising above, it runs
    by default from your first page view, before the banner is answered —
    declining there turns it off for the rest of your visit, though the
    page view that was already loading when you decline may still be
    counted. This is separate from the strictly-necessary Cloudflare
    cookies mentioned above, which aren't affected by this choice either
    way.</p>

    <p>Your choice is remembered in your browser only (via local storage),
    not sent to us or stored on our servers. <button type="button" id="cookie-reset" class="linklike">Change cookie settings</button></p>

    <p>Questions? <a href="/contact/">Contact us</a>. See also our
    <a href="/privacy/">privacy policy</a>.</p>
  </article>
)}
</BaseLayout>

<script>
  // Forget the stored choice and reload: with no choice stored the cookie banner asks again (CookieBanner.astro).
  document.getElementById('cookie-reset')?.addEventListener('click', () => {
    try { localStorage.removeItem('bv_cookie_consent'); } catch { /* storage blocked: the banner asks anyway */ }
    location.reload();
  });
</script>

<style>
.linklike { background: none; border: 0; padding: 0; font: inherit; color: var(--navy); text-decoration: underline; cursor: pointer; }
.prose { max-width: 36rem; }
.prose p { margin: 0 0 1rem; }
</style>

---
/** Closure Watch -- gated on siteConfig.hasClosureWatch (same pattern as
 *  workplace-watch/index.astro). Answers "is school closed today/tomorrow?"
 *  by SURFACING official information, never by forecasting -- see Handoff:
 *  Information Hub Tier 1, Feature A for the full spec. Three states, one
 *  renders:
 *
 *    Confirmed -- a real school_alerts closure notice exists (district's
 *                 own wording, rendered verbatim, NewsArticle JSON-LD).
 *    Watch     -- a relevant weather alert is active, no notice yet. The
 *                 "no closure has been announced" line below is HARDCODED,
 *                 outside any AI path. No model-written paragraph is shown
 *                 (owner 2026-11-06). See lib/db.ts:getClosureWatchStatus().
 *    Clear     -- neither. Short, static, reassuring.
 *
 *  ABSOLUTE RULE: nothing on this page may assert or imply that school WILL
 *  close. If that ever reads uncertain, treat it as a bug, not a style note.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RailModules from '../components/rail/RailModules.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getClosureWatchStatus } from '../lib/db';
import { closureStatusLine } from '../lib/closure-watch';
import { siteConfig } from '../lib/site-config';
import { metaDescription } from '../lib/meta-description';
import { resolvePageMeta } from '../lib/page-meta';
import { SECTION_THEME } from '../lib/section-theme';
import { buildFaqJsonLd, buildSchoolClosureNewsArticleJsonLd, buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { buildClusterBreadcrumbTrail, resolveHubBacklink } from '../lib/clusters';

if (!siteConfig.hasClosureWatch || !siteConfig.closureWatch) {
  return Astro.redirect('/', 302);
}

const feat = siteConfig.closureWatch;
const status = await getClosureWatchStatus();
const statusLine = closureStatusLine(status);
const canonicalUrl = new URL('/closures/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('closures', siteConfig, { label: 'Closure Watch', href: canonicalUrl });

const now = new Date();
const lastChecked = now.toLocaleString('en-US', {
  hour: 'numeric', minute: '2-digit', hour12: true,
  timeZone: siteConfig.timezone,
});
const lastCheckedDate = now.toLocaleDateString('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
  timeZone: siteConfig.timezone,
});

// Sitewide title/H1/lede handoff: the CONFIRMED-closure title is
// deliberately kept as its own dynamic, date-stamped string rather than
// resolvePageMeta()'s static pattern -- "{Date}: School closures |
// {Town}" is a genuinely more specific, more useful title during an
// actual active closure than the generic pattern could be (it directly
// answers "is school closed today"), so the pattern only applies to the
// default (no active closure) state.
const pageMeta = resolvePageMeta('closures', siteConfig);
const hubBacklink = resolveHubBacklink('closures', siteConfig);
const pageTitle = status.state === 'confirmed'
  ? `${lastCheckedDate.split(',')[0]}: School Closures | ${siteConfig.siteName}`
  : pageMeta.title;

const faqJsonLd = buildFaqJsonLd([
  {
    question: `Is school closed today in ${siteConfig.cityName}?`,
    answer: status.state === 'confirmed' && status.closures.length > 0
      ? status.closures.map((c) => c.message).join(' ')
      : `No closure has been announced as of ${lastChecked} on ${lastCheckedDate}. Check ${feat.districtName}'s own notification channel for the official word.`,
  },
  {
    question: `How are school closures announced in ${siteConfig.cityName}?`,
    answer: `${feat.districtName} announces closures, delays and cancellations directly through its own notification channel (${feat.districtUrl}). This page reflects that source, not a prediction.`,
  },
]);

const newsArticleJsonLd = status.state === 'confirmed'
  ? status.closures.map((c) =>
      buildSchoolClosureNewsArticleJsonLd(
        { title: c.title, message: c.message, postedAt: c.posted_at },
        canonicalUrl,
        siteConfig.siteName,
      ))
  : [];
// ---- Notes on the template below (moved here 2026-11-25: a JS comment inside an Astro template can drop all CSS from a
// build; scripts/verify_astro_template_comments.mjs). Each note names the markup it is about.
// [at: <header class="cw-hero">]
//   Fas 4 (owner spec 2026-11-20): the status in one line right under the H1, then when it was checked. The detail of an active
//         notice or alert follows; how the page works is one collapsed block at the very end (the old second "About this page" is gone).
// [at: <p class="cw-no-announcement">]
//   Hardcoded, non-negotiable, outside any AI path -- see module docstring.
// [at: <details class="cw-methodology" slot="about">]
//   The one block about the page, last and collapsed (owner spec Fas 4: "How this page works" last and collapsed, no second About).
---
<BaseLayout
  title={pageTitle}
  description={metaDescription('closures', siteConfig)}
  ogSlug="section-closure-watch"
  accentColor={SECTION_THEME.closure_watch.accent}
>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="cw-hero">
    <h1>{pageMeta.h1}</h1>
    <h2 class={`cw-status cw-status--${statusLine.tone}`} id="cw-state-heading" data-closure-status>{statusLine.line}</h2>
    <p class="cw-checked">Last checked {lastChecked}, {lastCheckedDate}</p>
    <ShareButton title={pageTitle} />
  </header>

  {status.state === 'confirmed' && status.closures.length > 0 && (
    <section class="cw-panel cw-panel--confirmed" aria-labelledby="cw-state-heading">
      {status.closures.map((closure) => (
        <div class="cw-closure">
          {status.closures.length > 1 && <h3 class="cw-closure__title">{closure.title || closure.district}</h3>}
          <p class="cw-message">{closure.message}</p>
          <p class="cw-source">
            Source: {closure.district}, posted {new Date(closure.posted_at).toLocaleString('en-US', {
              month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: siteConfig.timezone,
            })}.
            {closure.url && <a href={closure.url} rel="noopener">Read the district's own notice &rarr;</a>}
          </p>
        </div>
      ))}
    </section>
  )}

  {status.state === 'watch' && status.alert && (
    <section class="cw-panel cw-panel--watch" aria-labelledby="cw-state-heading">
      {status.alert.areaDesc && <p class="cw-area">Affected area: {status.alert.areaDesc}</p>}
      {status.alert.headline && <p class="cw-message">{status.alert.headline}</p>}

      {status.historicalCount > 0 && (
        <p class="cw-history">
          A {status.alert.event} alert has preceded a confirmed closure here {status.historicalCount} time(s) on record.
          That's history, not a forecast for today.
        </p>
      )}

      <p class="cw-no-announcement">
        <strong>No closure has been announced.</strong> Check {feat.districtName}'s{' '}
        <a href={feat.districtUrl} rel="noopener">own notification channel</a> for official notice.
      </p>
    </section>
  )}

  {feat.otherDistrictsNote && (
    <p class="cw-coverage-note">
      This page tracks {feat.districtName}. Parts of {siteConfig.cityName} are served by{' '}
      {feat.otherDistrictsNote.districtName}; check{' '}
      <a href={feat.otherDistrictsNote.url} rel="noopener">their site</a> for closures.
    </p>
  )}

  <RelatedContent pageType="closure_watch" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  {newsArticleJsonLd.map((ld) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  ))}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />

  <RailModules slot="rail" page="closures" now={now} />

  <details class="cw-methodology" slot="about">
    <summary>How this page works</summary>
    <p>
      Official school-closure status for {siteConfig.cityName}: what has actually been announced, not a guess at what might happen.
      Closures are always announced through {feat.districtName}'s{' '}
      <a href={feat.districtUrl} rel="noopener">own notification channel</a>, not predicted here.
    </p>
    <p>
      This page reads two sources directly: {feat.districtName}'s own closure notices, and active National Weather Service alerts
      ({feat.relevantAlertEvents.join(', ')}) for this area. It never predicts a closure: the Watch state only means a relevant alert
      is active and nothing has been announced yet. No AI-written text is shown.
    </p>
    {hubBacklink && <p>Checking road conditions too? See <a href={hubBacklink.hubHref}>{hubBacklink.clusterLabel}</a>.</p>}
  </details>
</BaseLayout>

<style>
.cw-hero {
  margin: 0 0 1.5rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.cw-hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
/* The status sentence in heading size (standards.md principle 1); one line. */
.cw-status { margin: 0.75rem 0 0.25rem; font-size: 1.375rem; }
.cw-status--alert { color: var(--status-bad); }
.cw-checked { font-size: 0.8125rem; color: var(--ink-soft); margin: 0.5rem 0; }

.cw-panel {
  margin: 0 0 1.5rem;
  border: 1px solid var(--rule); border-left: 4px solid var(--section-accent, var(--rule-strong));
  border-radius: 8px; padding: 1.25rem 1.5rem;
}
.cw-panel--confirmed { border-left-color: var(--status-bad); }
.cw-panel--watch { border-left-color: var(--status-caution); }
.cw-message { line-height: 1.6; margin: 0 0 0.75rem; }
.cw-area { font-size: 0.9375rem; color: var(--ink-soft); margin: 0 0 0.5rem; }
.cw-history { font-size: 0.875rem; color: var(--ink-soft); margin: 0 0 0.75rem; }
.cw-source { font-size: 0.875rem; color: var(--ink-soft); margin: 0; }
.cw-closure + .cw-closure { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
.cw-closure__title { margin: 0 0 0.5rem; font-size: 1.0625rem; }
.cw-coverage-note {
  margin: 0 0 1.5rem; font-size: 0.8125rem; color: var(--ink-soft); line-height: 1.6;
}
.cw-no-announcement {
  margin: 1rem 0 0; padding: 0.875rem 1rem;
  background: var(--panel, rgba(127, 127, 127, 0.06)); border-radius: 6px;
  font-size: 0.9375rem; line-height: 1.5;
}

.cw-methodology {
  margin: var(--ui-6) 0 var(--ui-4); padding-top: var(--ui-3); border-top: var(--ui-hairline);
  font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft);
}
.cw-methodology a { color: inherit; }
.cw-methodology summary { cursor: pointer; font-weight: 600; }
.cw-methodology p { line-height: 1.6; margin-top: 0.5rem; }
</style>

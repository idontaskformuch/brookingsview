---
/** Vail Resorts corporate newsroom feed -- Broomfield only. See Handoff:
 *  "Vail Resorts news section (/vail-resorts) — Broomfield only".
 *
 *  NOT hyperlocal content, and framed that way on purpose: Vail Resorts
 *  (NYSE: MTN) is headquartered here, so this mirrors the company's OWN
 *  newsroom listing (news.vailresorts.com/news-and-stories) -- company-wide
 *  releases, not Broomfield-specific reporting. Same "feed, not a content
 *  generator" contract as the copyright guardrail in
 *  scrapers/parsers/vail_news_v1.py: listing-page teaser verbatim, no full
 *  release body, no AI rewrite, images hotlinked from Vail's own CDN, never
 *  re-hosted. is_translation=false is already filtered in getVailNews()
 *  itself (see lib/db.ts), not re-filtered here.
 *
 *  No SectionHero here (unlike /traffic, /university, /workplace-watch):
 *  Broomfield has no seeded category-image pool yet, and this feature's own
 *  images ARE the hotlinked article thumbnails -- reusing the OG social
 *  card as an inline hero is explicitly banned by the handoff, so the page
 *  simply has no top illustration rather than reaching for that.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ShareButton from '../components/ShareButton.astro';
import { getVailNews } from '../lib/db';
import { siteConfig } from '../lib/site-config';
import { SECTION_THEME } from '../lib/section-theme';

if (siteConfig.townId !== 'broomfield_co') {
  return Astro.redirect('/', 302);
}

const items = await getVailNews(30);
---
<BaseLayout title={`Vail Resorts Newsroom — ${siteConfig.siteName}`} wide
  ogSlug="section-vail-news"
  description="Vail Resorts' own newsroom feed, collected here for Broomfield residents who work there, invest there, or just want to keep up."
  accentColor={SECTION_THEME.vail_news.accent}>
  <header class="lede">
    <h1>Vail Resorts Newsroom</h1>
    <p>
      Vail Resorts is headquartered here in Broomfield. Below is the company's own
      newsroom feed — announcements, leadership changes, and resort news from across
      its mountains — collected here for the many Broomfield residents who work there,
      invest there, or just want to keep up. All items link to the original release.
    </p>
    <ShareButton title={`Vail Resorts Newsroom — ${siteConfig.siteName}`} />
  </header>

  <SectionRule label={items.length > 0 ? `${items.length} recent releases` : 'Recent releases'} />

  {items.length > 0 ? (
    <div class="grid">
      {items.map((item) => (
        <article class="card">
          {item.image_url && (
            <a class="card__image-link" href={item.external_url} rel="noopener" target="_blank">
              <img class="card__image" src={item.image_url} alt="" loading="lazy" />
            </a>
          )}
          <div class="card__body">
            {item.categories.length > 0 && (
              <p class="card__tags">
                {item.categories.map((c) => <span class="card__tag">{c}</span>)}
              </p>
            )}
            <h2 class="card__title">{item.title}</h2>
            <p class="card__date data">{item.published_label}</p>
            {item.teaser && <p class="card__teaser">{item.teaser}</p>}
            <a class="card__link" href={item.external_url} rel="noopener" target="_blank">
              Read at Vail Resorts Newsroom →
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="empty">No Vail Resorts news collected yet — check back soon.</p>
  )}

  <p class="source">
    Source: <a href="https://news.vailresorts.com/news-and-stories" rel="noopener">Vail Resorts Newsroom</a>,
    refreshed every 48 hours. Headlines, dates, categories and teasers are the company's
    own; every item links back to the original release.
  </p>

  <RelatedContent pageType="vail_news" />
</BaseLayout>

<style>
.lede {
  max-width: 42rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; line-height: 1.6; }

.grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
.card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--rule);
  border-radius: 6px;
  overflow: hidden;
}
.card__image-link { display: block; line-height: 0; }
.card__image { display: block; width: 100%; height: 11rem; object-fit: cover; }
.card__body { padding: 0.875rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.375rem; }
.card__tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0; }
.card__tag {
  font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.03em;
  color: var(--section-accent, var(--ink-soft));
  border: 1px solid var(--section-accent, var(--rule));
  border-radius: 999px; padding: 0.0625rem 0.5rem;
}
.card__title {
  margin: 0.125rem 0 0;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.0625rem;
  letter-spacing: -0.01em;
  line-height: 1.3;
}
.card__date { margin: 0; font-size: 0.75rem; color: var(--ink-soft); }
.card__teaser { margin: 0.125rem 0 0; font-size: 0.875rem; line-height: 1.5; color: var(--ink); }
.card__link {
  margin-top: 0.375rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--section-accent, var(--navy));
}

.empty { color: var(--ink-soft); }
.source { margin-top: 1.5rem; font-size: 0.875rem; color: var(--ink-soft); }
</style>

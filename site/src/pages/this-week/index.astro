---
/** Rolling "this week" URL: the current ISO week's page, rendered here as well (F18, owner 2026-11-13: menu, footer, /events/
 *  and the "This week" card link /this-week/, so it is a built page, not a redirect stub). Its canonical is the dated
 *  /this-week/<iso-week>/ page, which is what Google indexes; its robots meta is that page's (components/ThisWeekView.astro). */
import ThisWeekView from '../../components/ThisWeekView.astro';
import { getCurrentThisWeekPage } from '../../lib/this-week-pages';

const props = await getCurrentThisWeekPage();
---
<ThisWeekView {...props} />

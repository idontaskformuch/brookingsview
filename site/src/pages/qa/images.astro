---
/** Glasgow image candidates for the owner's phone review (owner-ordered 2026-10-24). noindex, Glasgow only.
 *
 *  Nothing on this page is live content: it lists Wikimedia Commons candidates collected by
 *  scripts/source_glasgow_commons_images.py (data/glasgow_image_candidates.json) with the license, the photographer
 *  and the Commons page for each, so the owner can approve ids before anything is downloaded or activated. Tap "Keep"
 *  on the ones to approve; "Copy approved ids" copies the list to paste into the chat. The marks are saved only in
 *  this browser (localStorage). Rules: CC0, public domain, CC BY, CC BY-SA only; no murals or other 2D artworks, and no
 *  identifiable people, as the main subject. The script drops what it can by keyword; the reviewer decides the rest. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../lib/site-config';

if (siteConfig.townId !== 'glasgow') {
  return Astro.redirect('/', 302);
}

interface Candidate {
  id: string; pageid: number; buckets: string[]; title: string; page_url: string; thumb_url: string | null;
  thumb_w: number | null; thumb_h: number | null; width: number; height: number; artist: string | null;
  source?: string; license: string; license_url: string | null; description: string; categories: string[]; taken: string | null; flags: string[];
}
const data = (await import('../../../../data/glasgow_image_candidates.json')).default as unknown as {
  generated: string; rejected_by_reason: Record<string, number>; candidates: Candidate[];
};

const BUCKET_ORDER = [
  'season:autumn', 'season:winter',
  'holiday:halloween', 'holiday:bonfire_night', 'holiday:st_andrews_day', 'holiday:christmas', 'holiday:hogmanay',
  'category:city_hall', 'category:events', 'category:sports', 'category:traffic', 'category:weather_alert', 'category:university',
];
const LABELS: Record<string, string> = {
  'season:autumn': 'Season: autumn', 'season:winter': 'Season: winter',
  'holiday:halloween': 'Holiday: Halloween', 'holiday:bonfire_night': 'Holiday: Bonfire Night (5 Nov)',
  'holiday:st_andrews_day': "Holiday: St Andrew's Day (30 Nov)", 'holiday:christmas': 'Holiday: Christmas',
  'holiday:hogmanay': 'Holiday: Hogmanay',
  'category:city_hall': 'Section: Council / City Chambers', 'category:events': 'Section: Events and venues',
  'category:sports': 'Section: Sports', 'category:traffic': 'Section: Travel and transport',
  'category:weather_alert': 'Section: Weather', 'category:university': 'Section: University',
};
// Each candidate is shown once, under its first bucket in the order above; its other buckets are listed on the card.
const placed = new Set<number>();
const sections = BUCKET_ORDER.map((b) => ({
  bucket: b,
  label: LABELS[b] ?? b,
  items: data.candidates.filter((c) => {
    if (placed.has(c.pageid)) return false;
    const first = BUCKET_ORDER.find((x) => c.buckets.includes(x));
    if (first !== b) return false;
    placed.add(c.pageid);
    return true;
  }),
}));
const total = data.candidates.length;
const credit = (c: Candidate) =>
  `Photo: ${c.artist ?? 'unknown author'}, ${c.license}, via ${c.source === 'pexels' ? 'Pexels' : 'Wikimedia Commons'}`;
---
<BaseLayout title="Glasgow image candidates (review)" noindex>
  <header class="qa-head">
    <h1>Glasgow image candidates</h1>
    <p>{total} candidates from Wikimedia Commons, collected {data.generated}. <strong>Nothing here is live.</strong>
    Tap <strong>Keep</strong> on the pictures you approve, then <strong>Copy approved ids</strong> and paste the list into the chat.</p>
    <p class="qa-rules">Allowed licenses: CC0, public domain, CC BY, CC BY-SA (Wikimedia Commons), plus Pexels for generic Bonfire Night fireworks and bonfires only (owner-approved exception). Dropped automatically: murals and other 2D artworks,
    portraits and crowds, other places called Glasgow, anything without a named author when the license needs one. Check what is left:
    <strong>no mural or 2D artwork, and no identifiable person, as the main subject.</strong></p>
    <nav class="qa-jump" aria-label="Jump to a group">
      {sections.filter((s) => s.items.length > 0).map((s) => <a href={`#${s.bucket.replace(':', '-')}`}>{s.label} ({s.items.length})</a>)}
    </nav>
    <p class="qa-gaps">Groups with no candidates: {sections.filter((s) => s.items.length === 0).map((s) => s.label).join(', ') || 'none'}.</p>
    <label class="qa-filter"><input type="checkbox" id="qa-hide-flagged" /> Hide pictures with a flag (people? / sign or shop?)</label>
  </header>

  <div class="qa-bar" role="region" aria-label="Approved selection">
    <span id="qa-count">0 approved</span>
    <button type="button" id="qa-copy">Copy approved ids</button>
    <button type="button" id="qa-clear">Clear</button>
    <span id="qa-msg" aria-live="polite"></span>
  </div>

  {sections.filter((s) => s.items.length > 0).map((s) => (
    <section class="qa-section" id={s.bucket.replace(':', '-')}>
      <h2>{s.label} <span class="qa-n">({s.items.length})</span></h2>
      <ul class="qa-grid">
        {s.items.map((c) => (
          <li class="qa-card" data-id={c.id} data-flagged={c.flags.length > 0 ? '1' : '0'}>
            {c.thumb_url && <img src={c.thumb_url} width={c.thumb_w ?? 480} height={c.thumb_h ?? 320} loading="lazy" decoding="async" alt={c.description || c.title} />}
            <div class="qa-meta">
              <p class="qa-id"><strong>{c.id}</strong> <button type="button" class="qa-keep" aria-pressed="false">Keep</button></p>
              <p class="qa-title">{c.title}</p>
              <p>{credit(c)} · {c.license_url ? <a href={c.license_url} rel="noopener">license</a> : 'license'} · <a href={c.page_url} rel="noopener">{c.source === 'pexels' ? 'Pexels page' : 'Commons page'}</a></p>
              <p class="qa-small">{c.width}×{c.height}{c.taken ? ` · ${c.taken}` : ''}{c.buckets.length > 1 ? ` · also: ${c.buckets.filter((b) => b !== s.bucket).map((b) => LABELS[b] ?? b).join('; ')}` : ''}</p>
              {c.flags.length > 0 && <p class="qa-flag">Check: {c.flags.join(', ')}</p>}
              {c.description && <p class="qa-small">{c.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script>
  const KEY = 'glasgow_image_review_keep';
  let keep = new Set<string>();
  try { keep = new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]')); } catch { /* storage unavailable: marks last until reload */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify([...keep])); } catch { /* ignore */ } };
  const count = document.getElementById('qa-count');
  const msg = document.getElementById('qa-msg');
  const paint = () => {
    document.querySelectorAll<HTMLElement>('.qa-card').forEach((card) => {
      const on = keep.has(card.dataset.id ?? '');
      card.classList.toggle('qa-on', on);
      const b = card.querySelector<HTMLButtonElement>('.qa-keep');
      if (b) { b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.textContent = on ? 'Kept' : 'Keep'; }
    });
    if (count) count.textContent = `${keep.size} approved`;
  };
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const btn = t.closest('.qa-keep');
    if (btn) {
      const id = (btn.closest('.qa-card') as HTMLElement | null)?.dataset.id;
      if (id) { keep.has(id) ? keep.delete(id) : keep.add(id); save(); paint(); }
    }
  });
  document.getElementById('qa-copy')?.addEventListener('click', async () => {
    const list = [...keep].sort().join(', ');
    try { await navigator.clipboard.writeText(list); if (msg) msg.textContent = 'Copied.'; }
    catch { if (msg) msg.textContent = list || 'Nothing approved yet.'; }
  });
  document.getElementById('qa-clear')?.addEventListener('click', () => { keep = new Set(); save(); paint(); if (msg) msg.textContent = ''; });
  document.getElementById('qa-hide-flagged')?.addEventListener('change', (e) => {
    const hide = (e.target as HTMLInputElement).checked;
    document.querySelectorAll<HTMLElement>('.qa-card').forEach((c) => { c.hidden = hide && c.dataset.flagged === '1'; });
  });
  paint();
</script>

<style>
  .qa-head { max-width: 46rem; }
  .qa-rules, .qa-gaps { font-size: 0.9rem; }
  .qa-jump { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; font-size: 0.9rem; margin: 0.75rem 0; }
  .qa-filter { display: block; margin: 0.5rem 0 1rem; font-size: 0.95rem; }
  .qa-bar { position: sticky; top: 0; z-index: 5; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; padding: 0.5rem 0.75rem; background: var(--paper, #fff); border-bottom: 2px solid var(--rule-strong, #999); }
  .qa-bar button, .qa-keep { font: inherit; padding: 0.35rem 0.8rem; min-height: 2.5rem; cursor: pointer; }
  .qa-section h2 { margin-top: 2rem; }
  .qa-n { font-weight: 400; font-size: 0.9rem; }
  .qa-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr)); }
  .qa-card { border: 1px solid var(--rule, #ddd); padding: 0.5rem; min-width: 0; overflow-wrap: anywhere; }
  .qa-card[hidden] { display: none; }
  .qa-card img { display: block; width: 100%; height: auto; }
  .qa-card.qa-on { outline: 3px solid var(--accent, #2f7d32); }
  .qa-meta p { margin: 0.3rem 0; font-size: 0.9rem; max-width: none; }
  .qa-id { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: 1.05rem !important; }
  .qa-title { word-break: break-word; }
  .qa-small { color: var(--ink-soft); font-size: 0.8rem !important; }
  .qa-flag { color: var(--alert, #b3261e); font-weight: 600; }
  .qa-keep[aria-pressed='true'] { background: var(--accent, #2f7d32); color: #fff; }
</style>

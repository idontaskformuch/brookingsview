---
/** Sport som TABELL, aldrig som 109 enskilda sidor -- se lib/db.ts om varför.
 *
 * SDSU-specifikt, existerar bara meningsfullt för Brookings. Andra städer
 * redirectar till förstasidan i stället för att visa en tom/felaktig sida --
 * output:'static' kan inte hoppa över att emittera en statisk route helt,
 * så en redirect-stub är det närmaste. Nav-länken är redan isBrookings-gated
 * i BaseLayout, så den här sidan nås annars bara via en gammal länk/bokmärke. */
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutThisPage from '../components/ui/AboutThisPage.astro';
import SectionRule from '../components/SectionRule.astro';
import GameCard from '../components/GameCard.astro';
import GameTable from '../components/GameTable.astro';
import { getClubGames, getSportEvents } from '../lib/db';
import ClubGames from '../components/ClubGames.astro';
import { clubRows } from '../lib/club-games';
import { buildGroups, nextUp, recordText } from '../lib/jackrabbits-view';
import { sportTerms } from '../lib/sport-strings';
import { siteConfig } from '../lib/site-config';
import { isSectionBuilt } from '../lib/sections';
import { fitDescription } from '../lib/meta-description';
import { resolvePageMeta } from '../lib/page-meta';
import { SECTION_THEME } from '../lib/section-theme';
import { resolveHubNavItems } from '../lib/clusters';
import ClusterNav from '../components/ClusterNav.astro';

if (!isSectionBuilt('jackrabbits', siteConfig)) {
  return Astro.redirect('/', 302);
}

const pageMeta = resolvePageMeta('jackrabbits', siteConfig);
const clusterNavItems = resolveHubNavItems('jackrabbits', siteConfig);

// Local sports Phase 1: read from sport_events (lib/sport-events.ts decides upcoming / in progress / pending / history and what counts in
// a record). The page is built at deploy time, so "In progress" and "Result pending" are as of the build.
const PROGRAM = 'sdsu';
const now = new Date();
const terms = sportTerms(siteConfig.country);
const events = await getSportEvents(PROGRAM, now);
const groups = buildGroups(events, PROGRAM, now);
const featured = nextUp(groups);
// SDSU Club Hockey (Visit Brookings feed): its own section with a "Club" tag, never part of the Jackrabbits record or Next up.
const CLUB_PROGRAM = 'sdsu-club-hockey';
const club = await getClubGames(CLUB_PROGRAM, now);
const clubList = club ? clubRows(club.games, CLUB_PROGRAM, now) : [];
---
<BaseLayout title={pageMeta.title} wide
  description={fitDescription("Full SDSU Jackrabbits schedules and results for football, basketball and volleyball, with dates, opponents and scores for each game in Brookings.")}
  accentColor={SECTION_THEME.university.accent}>
  <header class="lede">
    <h1>{pageMeta.h1}</h1>
  </header>

  {featured && (
    <div data-next-up data-sport={featured.row.sport} data-start={featured.row.startAt.toISOString()} data-tz={featured.row.tz}
         data-status={featured.row.status} data-tba={featured.row.timeTba ? '1' : '0'} data-result="0">
      <SectionRule label="Next up" />
      <GameCard feature tagSlot sport={featured.group.label} opponent={featured.row.opponent} prefix={featured.row.prefix}
        startAt={featured.row.startAt.toISOString()} timeTba={featured.row.timeTba} venue={featured.row.venue}
        kicker={featured.row.neutralSite ? terms.neutral_site : undefined}
        tag={featured.row.exhibition ? terms.exhibition : featured.row.phase === 'inProgress' ? terms.in_progress : undefined} />
    </div>
  )}

  {groups.map((group) => {
    return (
      <section data-group>
        <SectionRule label={group.label} />
        {group.record && (
          <p class="record">{terms.record} <strong>{recordText(group.record)}</strong>{group.hasExhibition && <span class="note"> · {terms.exhibition_note}</span>}</p>
        )}
        {group.results.length > 0 && (
          <>
            <h3 class="sched-label">Results</h3>
            <div data-results><GameTable rows={group.results} terms={terms} section="results" label={group.label} /></div>
          </>
        )}
        {group.schedule.length > 0 && (
          <div data-schedule>
            <h3 class="sched-label">Schedule</h3>
            <GameTable rows={group.schedule} terms={terms} section="schedule" label={group.label} />
          </div>
        )}
      </section>
    );
  })}

  {club && <ClubGames name={club.name} rows={clubList} terms={terms} sourceUrl="https://visitbrookingssd.com/events/" />}

  <span data-sport-terms={JSON.stringify(terms)} hidden></span>
  <ClusterNav clusterLabel="Local life" items={clusterNavItems} />
  <AboutThisPage slot="about">
    <p>Schedules and results for SDSU football, basketball and volleyball, straight
    from the athletics department's own listings. Final scores are posted here
    once the athletics department publishes them — never estimated or reported
    ahead of the official result. Going to a football home game? Read the
    <a href="/game-day/">game day guide</a> for parking, tailgating and bag rules.</p>
  </AboutThisPage>
</BaseLayout>

<script>
  // Brings "In progress" / "Result pending" / history up to date when the page is opened; the build-time phase stays without JavaScript.
  import { refreshSportPhases } from '../lib/sport-phase-dom';
  refreshSportPhases(document);
</script>

<style>
.lede {
  max-width: 40rem;
  border-bottom: 3px solid var(--section-accent, var(--rule-strong));
  padding-bottom: 1.125rem;
}
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.sched-label {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 1.25rem 0 0.5rem;
}
.sched-label:first-of-type { margin-top: 0; }
.sched + .sched-label { margin-top: 1.75rem; }
.record { margin: 0 0 0.75rem; font-size: 0.9375rem; }
.record .note { color: var(--ink-soft); font-size: 0.8125rem; }
</style>

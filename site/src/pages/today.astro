---
/** /today -- Recurring-traffic layer handoff, Phase 1: the daily-return
 *  core product, answering "is anything happening here today?" in five
 *  seconds. Config-driven from the start (not Moreno-Valley-first): every
 *  section below is independently gated on real per-town data-source
 *  availability (siteConfig.hasClosureWatch, siteConfig.trafficSource),
 *  never on a hardcoded town check -- see TodayBlock.astro's own docstring
 *  for the full per-section gating rules.
 *
 *  This page fetches and composes; TodayBlock.astro renders (shared with
 *  index.astro's own mount of the same component -- one shared component,
 *  two mount points, per the handoff's own instruction).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareButton from '../components/ShareButton.astro';
import TodayBlock from '../components/TodayBlock.astro';
import SectionHero from '../components/SectionHero.astro';
import {
  getWeather, getActiveAlerts, getClosureWatchStatus, getActiveTrafficIncidents,
  getUpcomingStories, getUpcomingArtsEvents, getFacilities, getOsmSnapshot,
} from '../lib/db';
import { buildEventFeed, todayUtcMidnight, selectWeekCandidates } from '../lib/events';
import { siteConfig } from '../lib/site-config';
import { metaDescription } from '../lib/meta-description';
import { placeAbbr, forCountry } from '../lib/country-profile';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { buildClusterBreadcrumbTrail, resolveHubBacklink } from '../lib/clusters';
import { resolvePageMeta } from '../lib/page-meta';
import { getTicketmasterEventsForTown } from '../lib/ticketmaster';
import { selectTodayShows } from '../lib/today-shows';
import { forecastLine } from '../lib/weather-format';
import { enabledSections } from '../lib/nav-sections';
import OpenTonight from '../components/OpenTonight.astro';
import { placesFromSnapshot, decorateOpenLate } from '../lib/osm-open-late';
import { openTonightRows, openTonightSection, cafeRows, isHolidayDay, openLatePageIndexable } from '../lib/open-tonight';
import { localDayNumber } from '../lib/local-day';
import { areasFor } from '../lib/areas';

const [periods, alerts, upcomingEvents, artsEvents, trafficIncidents, closureStatus, facilities] = await Promise.all([
  getWeather(),
  getActiveAlerts(),
  getUpcomingStories(['event'], 200),
  getUpcomingArtsEvents(60),
  siteConfig.trafficSource ? getActiveTrafficIncidents() : Promise.resolve(null),
  siteConfig.hasClosureWatch ? getClosureWatchStatus() : Promise.resolve(null),
  getFacilities(),
]);
const cityHallFacility = facilities.find((f) => f.category === 'city_hall') ?? null;

const currentPeriod = periods.find((p) => p.is_daytime) ?? periods[0] ?? null;
const temperature = currentPeriod?.temp ?? null;

// FRONT_PAGE_NOW (an ISO instant) is only for checking the layout on a chosen day in a local build; CI never sets it.
const now = process.env.FRONT_PAGE_NOW ? new Date(process.env.FRONT_PAGE_NOW) : new Date();
const today = todayUtcMidnight(siteConfig.timezone);
const { items } = buildEventFeed(upcomingEvents, artsEvents, siteConfig.timezone);
// The week's non-recurring events: the browser buckets today / tonight / tomorrow from them and, when those are empty, lists the nearest as "Coming up".
const candidates = selectWeekCandidates(items, today, siteConfig.timezone);
// Glasgow: up to 3 Ticketmaster shows in the city itself join Tonight/Tomorrow (owner 2026-10-28).
const todayShows3 = siteConfig.country === 'gb' && siteConfig.hasWhatsOn
  ? selectTodayShows(await getTicketmasterEventsForTown(siteConfig), new Date(), siteConfig.timezone, siteConfig.townId, siteConfig.cityName)
  : [];

// Nothing in the next seven days (and no Ticketmaster show for Glasgow): the page has no events to offer, so it is not indexed (owner 2026-11-07).
// Open tonight / cafes open now: from the weekly OpenStreetMap snapshot (no snapshot or an old one = no section). Places, not events: they never change the noindex rule below.
const osmSnapshot = await getOsmSnapshot();
const osm = placesFromSnapshot(osmSnapshot, now) ?? [];
const osmDay = localDayNumber(now, siteConfig.timezone);
const osmOpts = { day: osmDay, tz: siteConfig.timezone, now, holiday: isHolidayDay(siteConfig.country, osmDay) };
const areaData = areasFor(siteConfig.townId);
const openTonight = openTonightSection(decorateOpenLate(openTonightRows(osm, osmOpts), siteConfig.townId, areaData), now, siteConfig.timezone);
const openCafes = openTonightSection(decorateOpenLate(cafeRows(osm, osmOpts), siteConfig.townId, areaData), now, siteConfig.timezone);
const osmChecked = osmSnapshot ? osmSnapshot.fetchedAt.slice(0, 10) : '';

const noEventsThisWeek = candidates.length === 0 && todayShows3.length === 0;
const canonicalUrl = new URL('/today/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('today', siteConfig, { label: 'Today', href: canonicalUrl });
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl);

const pageMeta = resolvePageMeta('today', siteConfig);
const pageTitle = pageMeta.title;
const hubBacklink = resolveHubBacklink('today', siteConfig);
import SafetyNotices from '../components/SafetyNotices.astro';
import ResultsBanner from '../components/ResultsBanner.astro';
import { ELECTION_BY_TOWN } from '../config/election';
// Facilities, council/city hall and traffic are not tabs (owner 2026-10-29); they are linked from here and from the footer.
const moreLinks = enabledSections(siteConfig).filter((s) => ['cityhall', 'facilities', 'traffic'].includes(s.id));
---

<BaseLayout title={pageTitle} ogSlug="section-today" noindex={noEventsThisWeek}
  description={metaDescription('today', siteConfig)}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <Breadcrumbs trail={breadcrumbTrail} />
  <div class="lede">
    {hubBacklink && <p class="lede__backlink">A quick daily snapshot — for the full week's picture, see <a href={hubBacklink.hubHref}>{hubBacklink.clusterLabel}</a>.</p>}
    <ShareButton title={pageTitle} />
  </div>

  <SectionHero section="today" compact />
  {ELECTION_BY_TOWN[siteConfig.townId] && <ResultsBanner />}

  <TodayBlock
    cityName={siteConfig.cityName}
    timezone={siteConfig.timezone}
    asOf={now}
    temperature={temperature}
    activeAlerts={alerts}
    closureStatus={closureStatus}
    traffic={trafficIncidents ? { incidents: trafficIncidents } : null}
    cityHallFacility={cityHallFacility}
    facilities={facilities}
    candidates={candidates}
    tmShows={todayShows3}
    forecastText={siteConfig.country === 'gb' ? forecastLine(periods, siteConfig.timezone, new Date()) : undefined}
    headingLevel="h1"
    headingText={pageMeta.h1}
  />
  <OpenTonight rows={openTonight} cafes={openCafes} osmChecked={osmChecked} cityName={siteConfig.cityName}
    lateHref={openLatePageIndexable(osm) ? '/open-late/' : null} />
  {siteConfig.safetyNotices && <SafetyNotices townId={siteConfig.townId} timezone={siteConfig.timezone} variant="compact" />}
  {siteConfig.eveningLayer && <p class="today-tonight">Planning the evening? <a href="/tonight/">Things to do tonight in {siteConfig.cityName}</a>.</p>}
  {siteConfig.country === 'gb' && siteConfig.townId === 'glasgow' && (
    <p class="today-official">Official warnings and safety information, from the services themselves: <a href="https://weather.metoffice.gov.uk/warnings-and-advice/uk-warnings" rel="noopener">Met Office weather warnings</a>, <a href="https://www.scotland.police.uk/" rel="noopener">Police Scotland</a> and <a href="https://www.firescotland.gov.uk/" rel="noopener">Scottish Fire and Rescue Service</a>. Links only: we do not copy their updates. In an emergency, call 999.</p>
  )}
  {moreLinks.length > 0 && (
    <p class="today-more">Also in {siteConfig.cityName}: {moreLinks.map((l, i) => <>{i > 0 && (i === moreLinks.length - 1 ? ' and ' : ', ')}<a href={l.href}>{l.label}</a></>)}.</p>
  )}
</BaseLayout>

<style>
  .today-more { margin: 0.5rem 0 0; }
  .lede { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .today-tonight { margin: 1rem 0 0; }
  .today-official { margin: 1rem 0 0; font-size: 0.9375rem; color: var(--ink-soft); max-width: 46rem; }
  .lede__backlink { margin: 0; color: var(--ink-soft); font-size: 0.9375rem; }
</style>

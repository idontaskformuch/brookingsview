---
/** Arkiv för editorial -- dagens ledartext flyttar hit dagen efter att den varit
 *  ettan på förstasidan (se index.astro / getTodaysFeature).
 *
 *  AdSense "low value content" remediation, Phase 0 (2026-10-07): editorial
 *  stopped generating and this page was unlinked from nav/footer/homepage --
 *  kept building (not 404ed) but noindexed, per the handoff spec's "keep data,
 *  stop rendering" rule. getTodaysFeature() itself is now dead code (nothing
 *  calls it from index.astro any more), kept only for the comment above. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/SectionRule.astro';
import StoryCard from '../components/StoryCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getContentByType } from '../lib/db';
import { siteConfig } from '../lib/site-config';
import { buildBreadcrumbJsonLd, type BreadcrumbEntry } from '../lib/article-jsonld';
import { buildClusterBreadcrumbTrail, resolveHubBacklink } from '../lib/clusters';

const stories = await getContentByType(['editorial'], 60);
const canonicalUrl = new URL('/editorials/', Astro.site ?? siteConfig.siteUrl).href;
const breadcrumbTrail: BreadcrumbEntry[] = buildClusterBreadcrumbTrail('editorials', siteConfig, { label: 'Editorials', href: canonicalUrl });
const hubBacklink = resolveHubBacklink('editorials', siteConfig);
---
<BaseLayout title={`Editorials — ${siteConfig.siteName}`} wide noindex
  description={`Opinion pieces on issues facing ${siteConfig.cityName}, AI-written and clearly labeled as such.`}>
  <Breadcrumbs trail={breadcrumbTrail} />
  <header class="lede">
    <h1>Editorials</h1>
    <p>Opinion pieces on issues facing {siteConfig.cityName}, written by AI and disclosed as
    such on every piece below.
    {hubBacklink && <> For more of what makes {siteConfig.cityName} feel local, see <a href={hubBacklink.hubHref}>{hubBacklink.clusterLabel}</a>.</>}</p>
  </header>

  <SectionRule label="Latest" />
  {stories.length > 0 ? (
    <div class="grid">{stories.map((story) => <StoryCard story={story} />)}</div>
  ) : (
    <p class="empty">Nothing published yet.</p>
  )}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(
    buildBreadcrumbJsonLd(breadcrumbTrail, canonicalUrl)
  )} />
</BaseLayout>

<style>
.lede { max-width: 40rem; }
.lede p { color: var(--ink-soft); margin: 0.75rem 0 0; }
.grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
.empty { color: var(--ink-soft); }
</style>

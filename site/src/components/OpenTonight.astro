---
/** Open tonight on /today (owner 2026-11-07): the same list as the Open tonight row on /tonight (lib/open-tonight.ts). Rendered only with
 *  rows: the caller has already applied the "at least 3 places" rule, so this component never prints an empty state. Cafes open now are
 *  the rail's module (components/rail/RailOpenNow.astro, owner 2026-11-20), not a list here. The list itself is components/OpenTonightList.astro
 *  (owner 2026-11-25), the same on /tonight. */
import type { OpenLateRow } from '../lib/osm-open-late';
import OpenTonightList from './OpenTonightList.astro';

interface Props { rows: OpenLateRow[]; osmChecked: string; /** Link to the evergreen Open late page, only when that page is indexable. */ lateHref?: string | null; tonightHref?: string | null; cityName: string }
const { rows, osmChecked, lateHref = null, tonightHref = null, cityName } = Astro.props;
---
{rows.length > 0 && (
  <section class="ot" data-otl-scope>
    <h2 id="ot-head">Open tonight in {cityName}</h2>
    <OpenTonightList rows={rows} idPrefix="ot" level={3} />
    <p class="ot-note">
      Hours © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, read {osmChecked}. Check with the place before you go.
      {tonightHref && <> <a href={tonightHref}>More for tonight</a>.</>}
      {lateHref && <> <a href={lateHref}>Open late in {cityName}</a>.</>}
    </p>
  </section>
)}

<style>
  .ot { margin: 1.5rem 0 0; }
  .ot[hidden] { display: none; }
  .ot h2 { margin: 0 0 var(--ui-2); font-size: 1.25rem; }
  .ot-note { margin: 0.5rem 0 0; color: var(--ink-soft); font-size: 0.8125rem; }
</style>

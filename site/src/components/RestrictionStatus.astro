---
/** "Can I have a fire / water my lawn right now?" -- the City's own fire and water restriction alerts (Fas 5 source 1, owner
 *  2026-11-19; lib/restrictions.ts). Per kind: every active alert in the City's category, its own title verbatim, newest first, at
 *  most 3, each with "Posted <date>" (the alert's publication date) and a link to that alert; then "Last checked" and the category page. A failed or 48 h old
 *  check reads "Status unknown, see the source", also in a page built while the data was fresh: the script below swaps in the
 *  pre-rendered unknown row at data-stale-at, no rebuild. Renders nothing for a town without siteConfig.restrictions. */
import SectionHeader from './ui/SectionHeader.astro';
import CompactRow from './ui/CompactRow.astro';
import { siteConfig } from '../lib/site-config';
import { loadRestrictionViews } from '../lib/restrictions-data';
import { SECTION_TITLE, UNKNOWN_TEXT, CHECK_FREQUENCY_TEXT, postedLine, checkedLine } from '../lib/restrictions';

const views = await loadRestrictionViews(siteConfig, new Date());
const tz = siteConfig.timezone;
---
{views.length > 0 && (
  <section id="restrictions" class="restrictions" aria-label={SECTION_TITLE} data-tz={tz}>
    <SectionHeader title={SECTION_TITLE} />
    {views.map((v) => (
      <div class="restrictions__kind" data-restriction={v.kind} data-state={v.state} data-stale-at={v.staleAt ?? undefined}
        data-checked-at={v.checkedAt ?? undefined}>
        <h3 class="restrictions__label">{v.label}</h3>
        {v.state === 'active' && v.alerts.map((a) => (
          <div data-r-known>
            <CompactRow href={a.url ?? v.sourceUrl}>
              <span class="restrictions__row">
                <span class="restrictions__text">{a.title}</span>
                {postedLine(a.sinceAt, tz) && <span class="restrictions__meta">{postedLine(a.sinceAt, tz)}</span>}
              </span>
            </CompactRow>
          </div>
        ))}
        {v.state === 'none' && (
          <div data-r-known><CompactRow href={v.sourceUrl}><span class="restrictions__text">{v.text}</span></CompactRow></div>
        )}
        <div data-r-unknown hidden={v.state !== 'unknown' ? true : undefined}>
          <CompactRow href={v.sourceUrl}><span class="restrictions__text">{UNKNOWN_TEXT}</span></CompactRow>
        </div>
        <p class="restrictions__meta">
          {v.more && <span data-r-known>{v.more} · </span>}<span data-r-checked>{checkedLine(v, tz)}</span> · <a href={v.sourceUrl} rel="noopener">The City's {v.label.toLowerCase()} page</a>
        </p>
      </div>
    ))}
    <p class="restrictions__note">From the City's own Alert Center, word for word; the City's pages are the ones to rely on. {CHECK_FREQUENCY_TEXT}</p>
  </section>
)}

<style>
  .restrictions { margin: 1.25rem 0; }
  .restrictions__kind { margin: 0.75rem 0; }
  .restrictions__label { margin: 0 0 0.25rem; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft);
    text-transform: uppercase; letter-spacing: 0.04em; }
  .restrictions__row { display: flex; flex-direction: column; gap: 0.15rem; }
  .restrictions__text { font-weight: var(--ui-primary-weight); }
  .restrictions__meta, .restrictions__note { font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); }
  p.restrictions__meta { margin: 0.25rem 0 0; }
  .restrictions__note { margin: 0.5rem 0 0; }
</style>

<script>
  import { formatChecked } from '../lib/restrictions';
  // Same 48 h rule as the build (lib/restrictions.ts restrictionView): past data-stale-at the kind shows only the unknown row.
  const root = document.querySelector<HTMLElement>('#restrictions');
  const tz = root?.dataset.tz || 'UTC';
  const flip = () => {
    let waiting = 0;
    root?.querySelectorAll<HTMLElement>('[data-stale-at]').forEach((kind) => {
      if (kind.dataset.state === 'unknown') return;
      const at = Date.parse(kind.dataset.staleAt || '');
      if (Number.isNaN(at)) return;
      if (Date.now() < at) { waiting++; return; }
      kind.dataset.state = 'unknown';
      kind.querySelectorAll<HTMLElement>('[data-r-known]').forEach((el) => { el.hidden = true; });
      const unknown = kind.querySelector<HTMLElement>('[data-r-unknown]');
      if (unknown) unknown.hidden = false;
      const checked = kind.querySelector('[data-r-checked]');
      if (checked && kind.dataset.checkedAt) checked.textContent = `Last successful check ${formatChecked(kind.dataset.checkedAt, tz)}`;
    });
    return waiting;
  };
  if (flip() > 0) { const h = setInterval(() => { if (flip() === 0) clearInterval(h); }, 60_000); }
</script>

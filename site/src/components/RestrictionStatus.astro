---
/** "Can I have a fire / water my lawn right now?" -- the City's own fire and water restriction alerts (Fas 5 source 1, owner
 *  2026-11-19; lib/restrictions.ts). Per kind: every active alert in the City's category, its own title verbatim, newest first, at
 *  most 3, each with "Posted <date>" (the alert's publication date) and a link to that alert; then "Last checked" and the category page.
 *  Tillägg C (owner 2026-11-20): a failed or 48 h old check is not shown at all -- no "Status unknown", no "see the source" text (the
 *  City's pages are in /safety/'s own sources). A page built while the data was fresh drops the kind in the browser at data-stale-at
 *  (the script below), and the whole section once no kind is left; no rebuild. Renders nothing for a town without
 *  siteConfig.restrictions, or when no kind is known. */
import SectionHeader from './ui/SectionHeader.astro';
import CompactRow from './ui/CompactRow.astro';
import { siteConfig } from '../lib/site-config';
import { loadRestrictionViews } from '../lib/restrictions-data';
import { SECTION_TITLE, CHECK_FREQUENCY_TEXT, postedLine, checkedLine } from '../lib/restrictions';

const views = (await loadRestrictionViews(siteConfig, new Date())).filter((v) => v.state !== 'unknown');
const tz = siteConfig.timezone;
---
{views.length > 0 && (
  <section id="restrictions" class="restrictions" aria-label={SECTION_TITLE}>
    <SectionHeader title={SECTION_TITLE} />
    {views.map((v) => (
      <div class="restrictions__kind" data-restriction={v.kind} data-state={v.state} data-stale-at={v.staleAt ?? undefined}>
        <h3 class="restrictions__label">{v.label}</h3>
        {v.state === 'active' && v.alerts.map((a) => (
          <div>
            <CompactRow href={a.url ?? v.sourceUrl}>
              <span class="restrictions__row">
                <span class="restrictions__text">{a.title}</span>
                {postedLine(a.sinceAt, tz) && <span class="restrictions__meta">{postedLine(a.sinceAt, tz)}</span>}
              </span>
            </CompactRow>
          </div>
        ))}
        {v.state === 'none' && (
          <div><CompactRow href={v.sourceUrl}><span class="restrictions__text">{v.text}</span></CompactRow></div>
        )}
        <p class="restrictions__meta">
          {v.more && <span>{v.more} · </span>}<span>{checkedLine(v, tz)}</span> · <a href={v.sourceUrl} rel="noopener">The City's {v.label.toLowerCase()} page</a>
        </p>
      </div>
    ))}
    <p class="restrictions__note">From the City's own Alert Center, word for word; the City's pages are the ones to rely on. {CHECK_FREQUENCY_TEXT}</p>
  </section>
)}

<style>
  .restrictions { margin: 1.25rem 0; }
  .restrictions__kind { margin: 0.75rem 0; }
  .restrictions__label { margin: 0 0 0.25rem; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft);
    text-transform: uppercase; letter-spacing: 0.04em; }
  .restrictions__row { display: flex; flex-direction: column; gap: 0.15rem; }
  .restrictions__text { font-weight: var(--ui-primary-weight); }
  .restrictions__meta, .restrictions__note { font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); }
  p.restrictions__meta { margin: 0.25rem 0 0; }
  .restrictions__note { margin: 0.5rem 0 0; }
</style>

<script>
  // Same 48 h rule as the build (lib/restrictions.ts restrictionView): past data-stale-at the kind is unknown and is removed;
  // with no kind left the section goes too (Tillägg C).
  const root = document.querySelector<HTMLElement>('#restrictions');
  const drop = () => {
    let waiting = 0;
    root?.querySelectorAll<HTMLElement>('[data-stale-at]').forEach((kind) => {
      const at = Date.parse(kind.dataset.staleAt || '');
      if (Number.isNaN(at)) return;
      if (Date.now() < at) { waiting++; return; }
      kind.remove();
    });
    if (root && !root.querySelector('[data-restriction]')) root.hidden = true;
    return waiting;
  };
  if (drop() > 0) { const h = setInterval(() => { if (drop() === 0) clearInterval(h); }, 60_000); }
</script>

---
/**
 * Met Office weather-warning banner (Glasgow). Answers "is there a weather warning where I live, and
 * what should I do?". Hidden until the browser has fetched /api/weather-warnings (same host, read from
 * the database at request time, so a new or cancelled warning needs no rebuild). Each warning is hidden
 * again in the browser once its valid-to time passes, even if the page stays open.
 * All text is set with textContent. Attribution: "Source: Met Office" with a link (Met Office terms).
 */
interface Props { timezone: string }
const { timezone } = Astro.props;
---
<section id="met-warnings" class="met-warnings" aria-label="Weather warnings" data-tz={timezone} hidden>
  <div class="shell met-warnings__inner" id="met-warnings-list"></div>
</section>

<style is:global>
  .met-warnings { margin: 0; padding: 0; }
  .met-warnings__inner { display: grid; gap: 0.75rem; padding-block: 0.75rem; }
  .mw { background: var(--status-warn-bg); color: var(--status-warn-text); border-left: 6px solid var(--status-warn); padding: 0.75rem 1rem; }
  .mw--amber { border-left-width: 10px; }
  .mw--red { background: var(--status-alert-bg); color: var(--status-alert-text); border-left: 10px solid var(--status-alert); }
  .mw__title { margin: 0; font-size: 1.05rem; font-weight: 700; }
  .mw__headline, .mw__valid, .mw__do, .mw__src { margin: 0.35rem 0 0; }
  .mw__valid { font-weight: 600; }
  .mw__sub { margin: 0.5rem 0 0; font-weight: 700; }
  .mw ul { margin: 0.25rem 0 0; padding-left: 1.25rem; }
  .mw__src { font-size: 0.875rem; }
  .mw a { color: inherit; text-decoration: underline; }
</style>

<script>
  import { isInForce, sortWarnings, levelLabel, weatherTypeText, formatValidity, type PublicWarning } from '../lib/met-warnings';

  const root = document.getElementById('met-warnings');
  const list = document.getElementById('met-warnings-list');
  if (root && list) {
    const tz = root.dataset.tz || 'Europe/London';
    let warnings: PublicWarning[] = [];

    const el = (tag: string, cls: string | null, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };

    const render = () => {
      const live = sortWarnings(warnings.filter((w) => isInForce(w, new Date())));
      list.replaceChildren();
      for (const w of live) {
        const a = el('article', `mw mw--${w.level}`);
        a.appendChild(el('h2', 'mw__title', `${levelLabel(w.level)} weather warning: ${weatherTypeText(w.weatherTypes)}`));
        if (w.headline) a.appendChild(el('p', 'mw__headline', w.headline));
        a.appendChild(el('p', 'mw__valid', formatValidity(w.validFrom, w.validTo, tz)));
        if (w.whatToExpect.length) {
          a.appendChild(el('p', 'mw__sub', 'What to expect'));
          const ul = el('ul', null);
          for (const t of w.whatToExpect) ul.appendChild(el('li', null, t));
          a.appendChild(ul);
        }
        if (w.whatShouldIDo) {
          a.appendChild(el('p', 'mw__sub', 'What should I do?'));
          a.appendChild(el('p', 'mw__do', w.whatShouldIDo));
        }
        const src = el('p', 'mw__src');
        src.append('Source: ');
        const link = el('a', null, w.sourceName) as HTMLAnchorElement;
        link.href = w.sourceUrl;
        link.rel = 'noopener';
        src.appendChild(link);
        a.appendChild(src);
        list.appendChild(a);
      }
      root.hidden = live.length === 0;
    };

    const load = async () => {
      try {
        const r = await fetch('/api/weather-warnings', { headers: { Accept: 'application/json' } });
        if (!r.ok) return;
        const data = (await r.json()) as { warnings?: PublicWarning[] };
        warnings = Array.isArray(data.warnings) ? data.warnings : [];
        render();
      } catch {
        /* offline or API down: keep what is shown; the expiry check below still applies */
      }
    };

    load();
    setInterval(load, 5 * 60_000);
    setInterval(render, 30_000);
  }
</script>

---
/**
 * Met Office weather warnings (Glasgow). Two variants of the same data (GET /api/weather-warnings, read from the database at
 * request time, so a new or cancelled warning needs no rebuild; each warning is hidden in the browser once its valid-to passes):
 *
 *   compact  ONE line under the header on every page: highest warning (level + type, validity, first "what to expect" point),
 *            "+1 yellow warning" for the rest, "Details" -> /weather/#weather-warnings. No "What should I do?" outside /weather/.
 *            Owner 2026-10-23: the full text on every page pushed the whole page down a screen.
 *   full     the complete text on /weather/: what to expect, and what to do split into short paragraphs.
 *
 * All text is set with textContent. Attribution: "Source: Met Office" with a link (Met Office terms).
 */
interface Props { timezone: string; variant?: 'compact' | 'full' }
const { timezone, variant = 'compact' } = Astro.props;
const id = variant === 'full' ? 'weather-warnings' : 'met-warnings';
---
<section id={id} class={`met-warnings met-warnings--${variant}`} aria-label="Weather warnings" data-met-warnings={variant} data-tz={timezone} hidden>
  {variant === 'full' && <h2 class="met-warnings__heading">Weather warnings</h2>}
  <div class="shell met-warnings__inner"></div>
  {variant === 'full' && <p class="met-warnings__none" hidden>No Met Office weather warnings are in force for Glasgow right now.</p>}
</section>

<style is:global>
  .met-warnings { margin: 0; padding: 0; }
  .met-warnings--full { margin: 1.25rem 0; }
  .met-warnings__heading { margin: 0 0 0.5rem; font-size: 1.125rem; }
  .met-warnings__none { margin: 0; color: var(--ink-soft); }
  .met-warnings__inner { display: grid; gap: 0.625rem; padding-block: 0.625rem; }
  .met-warnings--full .met-warnings__inner { padding-inline: 0; }
  .mw { background: var(--status-warn-bg); color: var(--status-warn-text); border-left: 6px solid var(--status-warn); padding: 0.625rem 0.875rem; }
  .mw--amber { border-left-width: 10px; }
  .mw--red { background: var(--status-alert-bg); color: var(--status-alert-text); border-left: 10px solid var(--status-alert); }
  .mw--compact { padding: 0.5rem 0.875rem; }
  .mw__line { margin: 0; font-size: 0.9375rem; line-height: 1.4; }
  .mw__title { margin: 0; font-size: 1rem; font-weight: 700; }
  .mw__headline, .mw__valid, .mw__do, .mw__src, .mw__more { margin: 0.3rem 0 0; }
  .mw__headline { font-size: 0.9375rem; }
  .mw__valid { font-weight: 600; font-size: 0.9375rem; }
  .mw__sub { margin: 0.6rem 0 0; font-weight: 700; }
  .mw ul { margin: 0.25rem 0 0; padding-left: 1.25rem; }
  .mw__src { font-size: 0.875rem; }
  .mw__more { font-weight: 700; }
  .mw a { color: inherit; text-decoration: underline; }
</style>

<script>
  import { isInForce, sortWarnings, formatValidity, splitParagraphs, warningName, firstExpectation, moreWarningsText, type PublicWarning } from '../lib/met-warnings';
  import { fetchWarnings } from '../lib/met-warnings-client';

  const roots = [...document.querySelectorAll<HTMLElement>('[data-met-warnings]')];
  if (roots.length) {
    let warnings: PublicWarning[] = [];

    const el = (tag: string, cls: string | null, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    const link = (text: string, href: string) => {
      const a = el('a', null, text) as HTMLAnchorElement;
      a.href = href;
      return a;
    };

    const renderOne = (w: PublicWarning, tz: string, variant: string) => {
      const a = el('article', `mw mw--${w.level}`);
      a.appendChild(el('h3', 'mw__title', warningName(w)));
      if (w.headline) a.appendChild(el('p', 'mw__headline', w.headline));
      a.appendChild(el('p', 'mw__valid', formatValidity(w.validFrom, w.validTo, tz)));
      if (w.whatToExpect.length) {
        a.appendChild(el('p', 'mw__sub', 'What to expect'));
        const ul = el('ul', null);
        for (const t of w.whatToExpect) ul.appendChild(el('li', null, t));
        a.appendChild(ul);
      }
      if (w.whatShouldIDo) {
        a.appendChild(el('p', 'mw__sub', 'What should I do?'));
        for (const para of splitParagraphs(w.whatShouldIDo)) a.appendChild(el('p', 'mw__do', para));
      }
      const src = el('p', 'mw__src');
      src.append('Source: ');
      const l = link(w.sourceName, w.sourceUrl);
      l.rel = 'noopener';
      src.appendChild(l);
      a.appendChild(src);
      return a;
    };

    // One short box: the highest warning (level + type, validity, first "what to expect" point), the rest as "+1 yellow warning",
    // and "Details" -> /weather/#weather-warnings where the whole text sits. No "What should I do?" here (owner 2026-10-24).
    const renderCompact = (live: PublicWarning[], tz: string) => {
      const [top, ...rest] = live;
      const a = el('article', `mw mw--${top.level} mw--compact`);
      const line = el('p', 'mw__line');
      line.appendChild(el('strong', 'mw__title', warningName(top)));
      line.append(` · ${formatValidity(top.validFrom, top.validTo, tz).replace(/^Valid /, '')}`);
      const first = firstExpectation(top);
      if (first) line.append(` · ${first}`);
      line.append(' · ');
      line.appendChild(link('Details', '/weather/#weather-warnings'));
      if (rest.length) {
        line.append(' · ');
        line.appendChild(link(moreWarningsText(rest), '/weather/#weather-warnings'));
      }
      line.append(' · Source: ');
      const src = link(top.sourceName, top.sourceUrl);
      src.rel = 'noopener';
      line.appendChild(src);
      a.appendChild(line);
      return a;
    };

    const render = () => {
      const live = sortWarnings(warnings.filter((w) => isInForce(w, new Date())));
      for (const root of roots) {
        const variant = root.dataset.metWarnings || 'compact';
        const tz = root.dataset.tz || 'Europe/London';
        const inner = root.querySelector('.met-warnings__inner');
        if (!inner) continue;
        if (variant === 'compact') inner.replaceChildren(...(live.length ? [renderCompact(live, tz)] : []));
        else inner.replaceChildren(...live.map((w) => renderOne(w, tz, variant)));
        const none = root.querySelector<HTMLElement>('.met-warnings__none');
        if (none) none.hidden = live.length > 0;
        // compact: only when there is something to show; full (/weather/): always, with an explicit "none in force" line
        root.hidden = variant === 'compact' ? live.length === 0 : false;
      }
    };

    const load = async () => {
      const got = await fetchWarnings();
      if (got === null) return; // API down: keep what is shown; expiry below still applies
      warnings = got;
      render();
    };

    load();
    setInterval(load, 5 * 60_000);
    setInterval(render, 30_000);
  }
</script>

---
/** Small required credit line for a licensed real photo (Wikimedia Commons,
 *  Pexels, Unsplash) -- see lib/images.ts's ImageRef.attributionText/Url and
 *  NEEDS-HUMAN-REVIEW.md "Switch venue/category images to real photos".
 *  Renders nothing for a Flux-generated image (no attributionText set) --
 *  this is the ONE place that decides how a credit line looks, so every
 *  resolveImage() consumer stays visually consistent and no one has to
 *  remember the rule twice. Deliberately its own element, not baked into
 *  the image's wrapping <a> -- that anchor already points at the story/
 *  section, not the photo credit's target. */
import type { ImageRef } from '../lib/images';

interface Props {
  image: Pick<ImageRef, 'attributionText' | 'attributionUrl' | 'attributionHtml'>;
}
const { image } = Astro.props;
---
{image.attributionHtml ? (
  <p class="image-attribution" set:html={image.attributionHtml} />
) : image.attributionText && (
  <p class="image-attribution">
    {image.attributionUrl ? (
      <a href={image.attributionUrl} rel="noopener nofollow" target="_blank">{image.attributionText}</a>
    ) : (
      image.attributionText
    )}
  </p>
)}

<style>
.image-attribution {
  margin: 0.25rem 0 0;
  font-size: 0.6875rem;
  line-height: 1.3;
  color: var(--ink-soft);
  text-align: right;
}
.image-attribution a {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: var(--rule);
}
.image-attribution a:hover { color: var(--accent); }
</style>

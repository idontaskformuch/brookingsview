---
/** "You might also like" -- most visitors land on a single page from a
 *  shared link and never see the rest of the site otherwise. Distinct from
 *  RelatedStories.astro (which finds nearby-dated stories of the SAME
 *  content type for a single article, already wired into /s/[slug]): this
 *  is for section landing pages (/traffic, /events, /university,
 *  /workplace-watch), where "related" means a small curated set of other
 *  sections and the town's own game, not another database story. See
 *  lib/db.ts:getRelatedContent() for the (rule-based, no AI) selection
 *  logic per page type. */
import { getRelatedContent, type RelatedPageType } from '../lib/db';

interface Props {
  pageType: RelatedPageType;
}
const { pageType } = Astro.props;
const items = await getRelatedContent(pageType);
---
{items.length > 0 && (
  <nav class="related-content" aria-label="You might also like">
    <h2 class="related-content__head">You might also like</h2>
    <div class="related-content__grid">
      {items.map((item) => (
        <a class="related-content__card" href={item.href}>
          <span class="related-content__kicker">{item.kicker}</span>
          <span class="related-content__title">{item.title}</span>
          {item.description && <span class="related-content__desc">{item.description}</span>}
        </a>
      ))}
    </div>
  </nav>
)}

<style>
.related-content { margin-top: 2.5rem; border-top: 3px solid var(--rule-strong); padding-top: 1rem; }
.related-content__head {
  font-family: var(--font-ui);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin: 0 0 0.75rem;
}
.related-content__grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
}
.related-content__card {
  display: block;
  border: 1px solid var(--rule);
  padding: 0.75rem 0.875rem;
  color: inherit;
  text-decoration: none;
}
.related-content__kicker {
  display: block;
  font-family: var(--font-ui);
  font-size: 0.6875rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin-bottom: 0.25rem;
}
.related-content__title {
  display: block;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.0625rem;
  line-height: 1.25;
  color: var(--ink);
}
.related-content__card:hover .related-content__title { text-decoration: underline; }
.related-content__desc {
  display: block;
  margin-top: 0.375rem;
  font-size: 0.8125rem;
  color: var(--ink-soft);
  line-height: 1.4;
}
</style>

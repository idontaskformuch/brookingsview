---
/** One compact row of /tonight and /this-weekend: start time in its own column (so a title that wraps stays aligned), then the title
 *  (a link, underlined only on hover/focus), then "venue · neighbourhood · drive time", then the source's labels. */
import type { EveningEntry } from '../../lib/evening-items';
import { driveLabel, distanceText } from '../../lib/evening-items';
import { siteConfig } from '../../lib/site-config';
import { showTimeGb } from '../../lib/whats-on-dates';

interface Props { e: EveningEntry; tz: string }
const { e, tz } = Astro.props;
const times = [e.start, ...(e.laterStarts ?? [])].map((t) => showTimeGb(t, tz));
const meta = [e.venue, e.area, distanceText(e.distanceMiles, siteConfig.country), driveLabel(e.driveMinutes)].filter(Boolean).join(' · ');
const external = !!e.href && /^https?:/i.test(e.href);
---
<li class="ev-row" data-start={e.start} data-end={e.end ?? undefined}>
  <span class="ev-time">{times.map((t) => <span>{t}</span>)}</span>
  <span class="ev-main">
    {e.href ? <a class="ev-title" href={e.href} rel={external ? 'noopener' : undefined}>{e.title}</a> : <span class="ev-title">{e.title}</span>}
    {meta && <span class="ev-meta">{meta}</span>}
  </span>
  {e.labels.length > 0 && <span class="ev-labels">{e.labels.map((l) => <span class="ev-label">{l}</span>)}</span>}
</li>
<style is:global>
  .ev-rows { list-style: none; padding: 0; margin: 0; }
  .ev-row { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr) auto; column-gap: 0.75rem; align-items: baseline; padding: 0.6rem 0; border-bottom: 1px solid var(--rule, #e4e2da); }
  /* Open late rows put a phrase in the time column ("until midnight", "open 24 hours"): let it wrap instead of running into the name */
  .ev-row[data-late] .ev-time { white-space: normal; }
  .ev-time { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
  .ev-main { display: flex; flex-direction: column; min-width: 0; }
  .ev-title { color: inherit; text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
  a.ev-title:hover, a.ev-title:focus-visible { text-decoration: underline; text-underline-offset: 0.15em; }
  .ev-meta { color: var(--ink-soft); font-size: 0.9rem; }
  .ev-labels { display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: flex-end; }
  .ev-label { padding: 0 0.4rem; border: 1px solid var(--rule, #c8c6bd); font-size: 0.8rem; white-space: nowrap; }
  @media (max-width: 30rem) {
    .ev-row { grid-template-columns: 4.1rem minmax(0, 1fr); }
    .ev-labels { grid-column: 2; justify-content: flex-start; margin-top: 0.25rem; }
  }
</style>

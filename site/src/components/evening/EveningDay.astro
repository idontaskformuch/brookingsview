---
/** One evening or day of /tonight and /this-weekend: the highlights, then a list per group, then the Open late block. Every event row is a row of the
 *  date-tile list (components/pop/PopEventList.astro) with the start time in the tile slot; there are no pictures. The Open late places keep their own
 *  rows (a closing phrase in the time column, not an event).
 *  `attrs` carries the page's own data attributes (the browser scripts find the section through them). */
import PopEventList from '../pop/PopEventList.astro';
import { groupLabel } from '../../lib/evening-items';
import { eveningPopDays } from '../../lib/pop-days';
import { siteConfig } from '../../lib/site-config';
import type { EveningEntry } from '../../lib/evening-items';
import { groupOpenLateByArea, type OpenLateRow } from '../../lib/osm-open-late';

interface Group { name: string; entries: EveningEntry[]; more?: number }
interface Props {
  id: string;
  heading: string;
  dateLabel: string;
  highlights: EveningEntry[];
  groups: Group[];
  /** Rows beyond the town's near radius, shown under `farHeading` after the near groups and the Open late block. */
  farGroups?: Group[];
  farHeading?: string;
  count: number;
  late?: OpenLateRow[];
  tz: string;
  attrs?: Record<string, string | number | undefined>;
  hidden?: boolean;
  moreHref?: string;
  moreLabel?: string;
}
const { id, heading, dateLabel, highlights, groups, farGroups = [], farHeading = 'Nearby', count, late = [], tz, attrs = {}, hidden = false, moreHref, moreLabel } = Astro.props;
const lateGroups = groupOpenLateByArea(late);
const listAttrs = { 'data-hide-ended': '', 'data-hide-when-empty': '' };
const groupAttr = (name: string) => (e: EveningEntry) => ({ 'data-group': groupLabel(e.group ?? name, siteConfig.country) });
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const popDays = (list: EveningEntry[], name: string) => eveningPopDays(list, tz, siteConfig.country, groupAttr(name));
const groupedLate = lateGroups.some((g) => g.area);
// A day with nothing in town and nothing nearby renders nothing (owner 2026-11-07: no "Nothing listed" message); the town heading shows only
// when something in town is listed, so a regional show never sits under an "in town" heading.
const hasLocal = highlights.length > 0 || groups.length > 0 || late.length > 0;
---
{(hasLocal || farGroups.length > 0) && (
<section class="ev-day" aria-labelledby={hasLocal ? `${id}-h` : undefined} aria-label={hasLocal ? undefined : farHeading} hidden={hidden || undefined} {...attrs}>
  {hasLocal && <h2 id={`${id}-h`}><span data-evening-heading>{heading}</span> <span class="ev-date">{dateLabel}</span></h2>}
  {highlights.length > 0 && <PopEventList days={popDays(highlights, '')} tile="time" idPrefix={`${id}-hl`} listAttrs={{ 'data-hide-ended': '' }} />}
  {groups.map((g) => (
    <div class="ev-group">
      <h3 class="ev-group-name">{groupLabel(g.name, siteConfig.country)}</h3>
      <PopEventList days={popDays(g.entries, g.name)} tile="time" idPrefix={`${id}-${slug(g.name)}`} listAttrs={listAttrs} />
      {g.more ? <p class="ev-more">{g.more} more {moreHref ? <a href={moreHref}>{moreLabel ?? 'on the full list'}</a> : 'on the full list'}</p> : null}
    </div>
  ))}
  {late.length > 0 && (
    <div class="ev-group">
      <h3 class="ev-group-name">Open late</h3>
      {lateGroups.map((g) => (
        <>
          {groupedLate && <h4 class="ev-area-name">{g.area ?? 'Elsewhere'}</h4>}
          <ul class="ev-rows" data-hide-ended data-hide-when-empty>
            {g.rows.map((p) => (
              <li class="ev-row" data-start={p.start} data-end={p.end} data-late>
                <span class="ev-time"><span>{p.closing}</span></span>
                <span class="ev-main">
                  {p.website ? <a class="ev-title" href={p.website} rel="noopener">{p.name}</a> : <span class="ev-title">{p.name}</span>}
                  <span class="ev-meta">{p.kind}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      ))}
    </div>
  )}
  {farGroups.length > 0 && (
    <div class="ev-far">
      <h3 class="ev-far-name">{farHeading}</h3>
      {farGroups.map((g) => (
        <div class="ev-group">
          <h4 class="ev-group-name">{g.name}</h4>
          <PopEventList days={popDays(g.entries, g.name)} tile="time" idPrefix={`${id}-far-${slug(g.name)}`} listAttrs={listAttrs} />
          {g.more ? <p class="ev-more">{g.more} more {moreHref ? <a href={moreHref}>{moreLabel ?? 'on the full list'}</a> : 'on the full list'}</p> : null}
        </div>
      ))}
    </div>
  )}
</section>
)}
<style is:global>
  .ev-rows { list-style: none; padding: 0; margin: 0; }
  .ev-row { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr) auto; column-gap: 0.75rem; align-items: baseline; padding: 0.6rem 0; border-bottom: 1px solid var(--rule, #e4e2da); }
  /* Open late rows put a phrase in the time column ("until midnight", "open 24 hours"): let it wrap instead of running into the name */
  .ev-row[data-late] .ev-time { white-space: normal; }
  .ev-time { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
  .ev-main { display: flex; flex-direction: column; min-width: 0; }
  .ev-title { color: inherit; text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
  a.ev-title:hover, a.ev-title:focus-visible { text-decoration: underline; text-underline-offset: 0.15em; }
  .ev-meta { color: var(--ink-soft); font-size: 0.9rem; }
  @media (max-width: 30rem) { .ev-row { grid-template-columns: 4.1rem minmax(0, 1fr); } }
  .ev-far { margin-top: 1.5rem; }
  .ev-far-name { margin: 0 0 0.25rem; font-size: 1.125rem; }
  .ev-area-name { margin: 0.9rem 0 0; font-size: 0.9375rem; font-weight: 600; color: var(--ink-soft); }
  .ev-day { margin: 0 0 2rem; }
  .ev-date { font-size: 0.9rem; font-weight: 400; color: var(--ink-soft); }
  .ev-group-name { margin: 1.25rem 0 0.25rem; font-size: 1rem; }
  .ev-empty, .ev-more { color: var(--ink-soft); font-size: 0.9375rem; }
  .ev-more { margin: 0.4rem 0 0; }
</style>

---
/** Holiday matrix (owner 2026-11-26): places down, key days across (24, 25, 26, 31 Dec, 1 Jan, plus any other day a place changes).
 *  A cell is "Closed" (or the place's own word, "No trains") marked with the icon, changed hours, or "Normal". A real <table>: on a
 *  phone the first column stays put and the days scroll sideways. Data: lib/holiday-festive.ts holidayMatrix. */
import Icon from '../ui/Icon.astro';
import type { MatrixView } from '../../lib/holiday-festive';

interface Props { matrix: MatrixView; heading?: string; lead?: boolean }
const { matrix, heading = 'Closed and open', lead = false } = Astro.props;
---
<section class:list={['hm', lead && 'hm--lead']} id="closures" aria-labelledby="hm-h" data-closure-grid>
  <h2 class="hol-h" id="hm-h">{heading}</h2>
  <div class="hm__scroll" tabindex="0" role="region" aria-labelledby="hm-h">
    <table class="hm__t">
      <thead>
        <tr>
          <th scope="col" class="hm__corner">Place</th>
          {matrix.days.map((d) => (
            <th scope="col" title={d.name ?? undefined}>
              <span class="hm__wd">{d.weekday}</span>
              <span class="hm__date">{d.label}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {matrix.rows.map((r) => (
          <tr data-grid-row>
            <th scope="row" class="hm__place">
              {r.href ? <a href={r.href} rel="noopener">{r.name}</a> : r.name}
              {r.note && <span class="hm__note">{r.note}</span>}
            </th>
            {r.cells.map((c) => (
              <td class={`hm__c hm__c--${c.kind}`} data-cell={c.kind}>
                {c.kind === 'closed' ? <span class="hm__closed"><Icon name="closed" size={14} />{c.text}</span> : c.text}
                {c.note && <a class="hm__ref" href={`#hm-note-${c.note}`} aria-label={`note ${c.note}`}><sup>{c.note}</sup></a>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {matrix.notes.length > 0 && (
    <ol class="hm__notes">
      {matrix.notes.map((n, i) => <li id={`hm-note-${i + 1}`}>{n}</li>)}
    </ol>
  )}
  <p class="hm__key">Normal = no change announced by the source.</p>
</section>

<style>
  .hm { margin: var(--ui-group-gap) 0 0; scroll-margin-top: var(--ui-5); }
  .hm--lead { margin-top: var(--ui-4); }
  .hm__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-top: 2px solid var(--hol-ink, var(--accent)); }
  .hm__scroll:focus-visible { outline: 2px solid var(--hol-ink, var(--accent)); outline-offset: 2px; }
  .hm__t { border-collapse: separate; border-spacing: 0; width: 100%; font-family: var(--font-ui); font-variant-numeric: tabular-nums; font-size: 0.9375rem; }
  .hm__t th, .hm__t td { padding: var(--ui-2) var(--ui-2); border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .hm__t td { min-width: 5.5rem; max-width: 8.5rem; }
  .hm__t thead th { white-space: nowrap; }
  .hm__t thead th { font-weight: 600; color: var(--ink-soft); font-size: var(--ui-meta); background: var(--paper); }
  .hm__wd { display: block; font-weight: 500; }
  .hm__date { display: block; color: var(--ink); font-size: 0.9375rem; }
  .hm__t .hm__corner, .hm__t .hm__place { position: sticky; left: 0; z-index: 1; background: var(--paper); min-width: 9rem; max-width: 14rem; white-space: normal; }
  .hm__place { font-weight: 600; color: var(--ink); box-shadow: 1px 0 0 var(--rule); }
  .hm__place a { color: inherit; }
  .hm__note { display: block; font-weight: 400; font-size: var(--ui-meta); color: var(--ink-soft); margin-top: 0.15rem; }
  .hm__c--normal { color: var(--ink-soft); }
  .hm__c--hours { color: var(--ink); font-weight: 600; }
  .hm__closed {
    white-space: nowrap; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.1rem 0.45rem; border-radius: 999px; font-weight: 600;
    color: var(--hol-warm, var(--accent)); background: color-mix(in srgb, var(--hol-warm, var(--accent)) 12%, var(--paper));
  }
  .hm__ref { margin-left: 0.15rem; color: var(--hol-ink, var(--accent)); font-weight: 700; text-decoration: none; }
  .hm__notes { margin: var(--ui-2) 0 0; padding-left: 1.4rem; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink); }
  .hm__notes li { margin: 0.15rem 0; scroll-margin-top: var(--ui-5); }
  .hm__key { margin: var(--ui-2) 0 0; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); }
  @media (max-width: 40rem) { .hm__t .hm__corner, .hm__t .hm__place { min-width: 7.5rem; max-width: 9.5rem; } }
</style>

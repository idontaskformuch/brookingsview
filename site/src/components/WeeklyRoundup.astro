---
/** Veckosammanfattningen på förstasidan. Får en egen, tydligt avvikande plats
 *  högst upp -- den är sajtens enda sammanhängande text och ska inte konkurrera
 *  med enskilda notiser i strömmen. */
import type { Story, Facility } from '../lib/db';
import { weekInfoForInstant } from '../lib/this-week';
import { siteConfig } from '../lib/site-config';
import { resolveImage, type ImageRef } from '../lib/images';
import { categoryImagesFor } from '../config/category-images';
import ImageAttribution from './ImageAttribution.astro';

// See LeadStory.astro's identical Props comment -- WeeklyRoundup always
// resolves via the 'events' category (see heroImage below), so it's the
// single most likely card to collide with another 'events' item on the
// front page -- exactly what index.astro's dedup pass is for.
interface Props { story: Story; facilities: Facility[]; image?: ImageRef | null; }
const { story, facilities } = Astro.props;
const imageOverride = 'image' in Astro.props ? Astro.props.image : undefined;

// Första stycket som ingress, resten bakom länken.
const paragraphs = story.body.split('\n').map((p) => p.trim()).filter(Boolean);
const standfirst = paragraphs[0] ?? '';
const words = story.body.split(/\s+/).length;

// Länkar till den nya /this-week/<iso-week>/-sidan (dag-för-dag-vyn), inte
// längre direkt till story-sidan -- se NEEDS-HUMAN-REVIEW.md "This Week".
// story.occurs_at = veckans måndag (satt av ai_pipeline/weekly.py:s main()).
const weekHref = story.occurs_at
  ? `/this-week/${weekInfoForInstant(new Date(story.occurs_at), siteConfig.timezone).slug}/`
  : `/s/${story.slug}/`;

// Was an unconditional /og/<slug>.png (the social card reused as an
// article image -- exactly the bug NEEDS-HUMAN-REVIEW.md "Venue &
// Category Image Identity" fixes). 'weekly' has no venue of its own, so
// this only ever resolves via the category tier (mapped to 'events', see
// lib/images.ts's CATEGORY_BY_SOURCE_TYPE) -- null renders no image at
// all rather than the social card.
const heroImage = imageOverride !== undefined ? imageOverride : resolveImage(story, {
  town: siteConfig.townId,
  cityName: siteConfig.cityName,
  facilities,
  categoryImages: categoryImagesFor(siteConfig.townId),
});
---
<article class="roundup">
  <p class="roundup__kicker"><span class="kicker">The week ahead</span></p>
  <h2 class="roundup__title"><a href={weekHref}>{story.title}</a></h2>
  {heroImage && (
    <a class="roundup__image-link" href={weekHref} tabindex="-1" aria-hidden="true">
      <img
        class="roundup__image"
        src={heroImage.path}
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        decoding="async"
      />
    </a>
  )}
  {heroImage && <ImageAttribution image={heroImage} />}
  <p class="roundup__standfirst">{standfirst}</p>
  <a class="roundup__more" href={weekHref}>
    Read this week in full &rarr; <span class="roundup__words data">{words} words</span>
  </a>
</article>

<style>
.roundup {
  border-top: 3px solid var(--rule-strong);
  border-bottom: 3px solid var(--rule-strong);
  padding: 1.125rem 0 1.25rem;
  margin-bottom: 1.5rem;
}
.roundup__kicker { margin: 0 0 0.4375rem; }
.roundup__kicker .kicker { color: var(--alert); }
.roundup__title {
  font-size: clamp(1.5rem, 3.4vw, 2.125rem);
  line-height: 1.08;
  margin: 0 0 0.5rem;
  max-width: 34rem;
}
.roundup__title a { color: inherit; text-decoration: none; }
.roundup__title a:hover { color: var(--navy); }
.roundup__image-link { display: block; }
.roundup__image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 0 1rem;
}
.roundup__standfirst {
  margin: 0;
  font-size: 1.0625rem;
  line-height: 1.55;
  max-width: 42rem;
  color: var(--ink);
}
.roundup__more {
  display: inline-block;
  margin-top: 0.625rem;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
}
.roundup__more { color: var(--accent); }
.roundup__more:hover { text-decoration: underline; }
.roundup__words { color: var(--ink-soft); letter-spacing: 0; text-transform: none; }
</style>

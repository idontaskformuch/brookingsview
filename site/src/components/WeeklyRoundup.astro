---
/** Veckosammanfattningen på förstasidan. Får en egen, tydligt avvikande plats
 *  högst upp -- den är sajtens enda sammanhängande text och ska inte konkurrera
 *  med enskilda notiser i strömmen. */
import type { Story } from '../lib/db';
import { resolveThisWeekImage } from '../lib/db';
import { weekInfoForInstant } from '../lib/this-week';
import { seasonForMonth } from '../lib/this-week-images';
import { thisWeekImagesFor } from '../config/this-week-images';
import { siteConfig } from '../lib/site-config';
import ImageAttribution from './ImageAttribution.astro';
import { storyHref } from '../lib/content-slugs';

// `facilities` is no longer a prop (This Week image rotation, 2026-10-03):
// the old resolveImage() call needed it for the venue-image tier; the new
// dedicated pool (config/this-week-images.ts) never resolves through a
// facility at all.
interface Props { story: Story }
const { story } = Astro.props;

// Första stycket som ingress, resten bakom länken.
const paragraphs = story.body.split('\n').map((p) => p.trim()).filter(Boolean);
const standfirst = paragraphs[0] ?? '';
const words = story.body.split(/\s+/).length;

// Länkar till den nya /this-week/<iso-week>/-sidan (dag-för-dag-vyn), inte
// längre direkt till story-sidan -- se NEEDS-HUMAN-REVIEW.md "This Week".
// story.occurs_at = veckans måndag (satt av ai_pipeline/weekly.py:s main()).
const weekInfo = story.occurs_at ? weekInfoForInstant(new Date(story.occurs_at), siteConfig.timezone) : null;
const weekHref = weekInfo ? `/this-week/${weekInfo.slug}/` : storyHref(story.slug);

// This Week image rotation (2026-10-03): a dedicated, town+season-scoped
// pool with real 60-day usage history (db/migrations/050), replacing the
// old shared 'events' category tier -- see config/this-week-images.ts's
// own module comment for why that pool read as "always the same picture."
// Was an unconditional /og/<slug>.png before the ORIGINAL venue/category
// image identity fix (the social card reused as an article image) -- still
// never that: resolveThisWeekImage() throws rather than returning null, so
// there's no "no image" case left to fall back from here.
const heroImage = weekInfo
  ? await resolveThisWeekImage(
      weekInfo.slug, seasonForMonth(weekInfo.monday.m), thisWeekImagesFor(siteConfig.townId),
      weekInfo.monday, weekInfo.sunday,
    )
  : null;
---
<article class="roundup">
  <p class="roundup__kicker"><span class="kicker">The week ahead</span></p>
  <h2 class="roundup__title"><a href={weekHref}>{story.title}</a></h2>
  {heroImage && (
    <a class="roundup__image-link" href={weekHref} tabindex="-1" aria-hidden="true">
      <img
        class="roundup__image"
        src={heroImage.path}
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        decoding="async"
      />
    </a>
  )}
  {heroImage && <ImageAttribution image={heroImage} />}
  <p class="roundup__standfirst">{standfirst}</p>
  <a class="roundup__more" href={weekHref}>
    Read this week in full &rarr; <span class="roundup__words data">{words} words</span>
  </a>
</article>

<style>
.roundup {
  border-top: 3px solid var(--rule-strong);
  border-bottom: 3px solid var(--rule-strong);
  padding: 1.125rem 0 1.25rem;
  margin-bottom: 1.5rem;
}
.roundup__kicker { margin: 0 0 0.4375rem; }
.roundup__kicker .kicker { color: var(--alert); }
.roundup__title {
  font-size: clamp(1.5rem, 3.4vw, 2.125rem);
  line-height: 1.08;
  margin: 0 0 0.5rem;
  max-width: 34rem;
}
.roundup__title a { color: inherit; text-decoration: none; }
.roundup__title a:hover { color: var(--navy); }
.roundup__image-link { display: block; }
.roundup__image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 0 1rem;
}
.roundup__standfirst {
  margin: 0;
  font-size: 1.0625rem;
  line-height: 1.55;
  max-width: 42rem;
  color: var(--ink);
}
.roundup__more {
  display: inline-block;
  margin-top: 0.625rem;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
}
.roundup__more { color: var(--accent); }
.roundup__more:hover { text-decoration: underline; }
.roundup__words { color: var(--ink-soft); letter-spacing: 0; text-transform: none; }
</style>

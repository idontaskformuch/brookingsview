---
/** Events grouped under ONE heading per day (never a date badge per row), in strict time order: no row is lifted above an earlier one. A row
 *  with a real photo (the story's own image or its venue's) shows it as a 64 px thumbnail; a row without one is the normal row with its small
 *  category icon. There is no large card and no full-size FallbackTile on events: a big coloured box that says nothing was the worst use of the
 *  first screen. The generic category pool is not used, so two days never show the same stock picture. Used by /events/ and the front page.
 *  ("Pick of the day" as a labelled block above the list is a proposal only; see .claude/state.md.) */
import EventRow from './EventRow.astro';
import { resolveImage } from '../../lib/images';
import type { DayGroup, DayRow } from '../../lib/event-day-view';
import { itemLink } from '../../lib/events';
import { siteConfig } from '../../lib/site-config';
import type { FeedItem } from '../../lib/events';
import type { Facility } from '../../lib/db';

interface Props { days: DayGroup[]; facilities: Facility[]; level?: 2 | 3; idPrefix?: string; tz?: string }
const { days, facilities, level = 2, idPrefix = 'day', tz = siteConfig.timezone } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const hrefOf = (item: FeedItem) => itemLink(item) ?? undefined;
const photoOf = (row: DayRow) =>
  row.item.sourceKind === 'story'
    ? resolveImage(row.item.story, { town: siteConfig.townId, cityName: siteConfig.cityName, facilities, categoryImages: {} })
    : null;
---
{days.map((d) => (
  <section class="evd" id={`${idPrefix}-${d.dayKey}`} aria-labelledby={`h-${idPrefix}-${d.dayKey}`}>
    <H class="evd__h" id={`h-${idPrefix}-${d.dayKey}`}>{d.label} <span class="evd__date">{d.dateLabel}</span></H>
    <ul class="evd__list" data-hide-ended data-hide-section data-tz={tz}>
      {d.rows.map((r) => <EventRow row={r} href={hrefOf(r.item)} photo={photoOf(r)} />)}
    </ul>
  </section>
))}
<style>
  .evd { margin-bottom: var(--ui-5); scroll-margin-top: var(--ui-5); }
  /* The heading sits straight on the page background; each event below is its own white card (EventRow). */
  .evd__h { margin: 0 0 var(--ui-2); font-family: var(--font-head); font-size: 1.5rem; }
  .evd__date { margin-left: var(--ui-2); font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: 400; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .evd__list { list-style: none; margin: 0; padding: 0; }
</style>

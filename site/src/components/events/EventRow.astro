---
/** One event: the time large in a fixed column with the category icon under it, serif title, `venue · area` on one line, pills from stated data
 *  (Free, Kids & families, Teens), ↻ for a weekly/monthly series. Category colour is the 3 px left edge; no category = quiet edge, and no
 *  label is printed for a generic "Around town" event. `showDate` puts the date above the time (rows beyond the day groups); `note` replaces
 *  the area (e.g. "4 mi away"). `photo` (a real image only) adds a 64 px thumbnail at the right; no photo = no tile, never a placeholder box. data-start/data-end let the ended-event sweep (data-hide-ended on the list) remove a row once it is over. */
import CompactRow from '../ui/CompactRow.astro';
import Pill from '../ui/Pill.astro';
import Icon from '../ui/Icon.astro';
import type { DayRow } from '../../lib/event-day-view';

interface Props { row: DayRow; href?: string | null; showDate?: boolean; note?: string | null; photo?: { path: string; alt: string } | null }
const { row, href, showDate = false, note = null, photo = null } = Astro.props;
const place = [row.venue, note ?? row.area].filter(Boolean).join(' · ');
const repeats = row.recurrence === 'weekly' ? 'Repeats weekly' : row.recurrence === 'monthly' ? 'Repeats monthly' : null;
const hasPills = row.free || row.kids || row.teens;
---
<li class={photo ? 'ev-li ev-li--photo' : 'ev-li'} data-start={row.start} data-end={row.end ?? undefined}>
  <CompactRow href={href ?? undefined} cat={row.cat ?? undefined}>
    <span class="ev-when" style={row.cat ? `--c: var(--cat-${row.cat})` : undefined}>
      {showDate && <span class="ev-when__date">{row.dateLabel}</span>}
      {row.timeLabel && <span class="ev-when__time">{row.timeLabel}</span>}
      {row.cat && <Icon name={row.cat} size={16} />}
    </span>
    <span class="ev-main">
      <span class="ev-title">{row.title}{repeats && <span class="ev-repeat" title={repeats} aria-label={repeats}> <Icon name="repeat" size={14} /></span>}</span>
      {place && <span class="ev-place">{place}</span>}
      {hasPills && (
        <span class="ev-pills">
          {row.free && <Pill tone="ok">Free</Pill>}
          {row.kids && <Pill>Kids &amp; families</Pill>}
          {row.teens && <Pill>Teens</Pill>}
        </span>
      )}
    </span>
    {photo && <img class="ev-thumb" src={photo.path} alt={photo.alt} width="64" height="64" loading="lazy" decoding="async" />}
  </CompactRow>
</li>
<style>
  .ev-li { list-style: none; border-bottom: var(--ui-hairline); }
  .ev-li :global(.ui-row__main) { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--ui-3); align-items: start; width: 100%; }
  .ev-li :global(.ui-row) { padding-block: var(--ui-3); }
  .ev-li--photo :global(.ui-row__main) { grid-template-columns: 5.5rem minmax(0, 1fr) 64px; }
  .ev-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: var(--ui-radius); display: block; }
  .ev-when { display: flex; flex-direction: column; gap: var(--ui-1); font-variant-numeric: tabular-nums; color: var(--c, var(--ink-soft)); }
  .ev-when__date { font-size: var(--ui-meta); color: var(--ink-soft); }
  .ev-when__time { font-size: 1.375rem; line-height: 1.1; font-weight: 700; color: var(--ink); white-space: nowrap; letter-spacing: -0.01em; }
  .ev-main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
  .ev-title { font-family: var(--font-head); font-size: 1.1875rem; line-height: 1.25; color: var(--ink); }
  .ev-repeat { color: var(--ink-soft); white-space: nowrap; }
  .ev-place { font-size: var(--ui-meta); color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ev-pills { display: flex; flex-wrap: wrap; gap: var(--ui-1); margin-top: var(--ui-1); }
</style>

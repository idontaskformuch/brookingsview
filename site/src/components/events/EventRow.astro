---
/** One event on /events/: time in a fixed column, serif title, `venue · area`, pills from stated data, ↻ for a weekly/monthly series.
 *  `showDate` puts the date above the time (rows beyond the day groups). `note` replaces the area (e.g. "4 mi away").
 *  data-start/data-end let the page's ended-event sweep (BaseLayout, data-hide-ended on the list) remove a row once it is over. */
import CompactRow from '../ui/CompactRow.astro';
import Pill from '../ui/Pill.astro';
import Icon from '../ui/Icon.astro';
import type { DayRow } from '../../lib/event-day-view';

interface Props { row: DayRow; href: string; showDate?: boolean; note?: string | null }
const { row, href, showDate = false, note = null } = Astro.props;
const place = [row.venue, note ?? row.area].filter(Boolean).join(' · ');
const repeats = row.recurrence === 'weekly' ? 'Repeats weekly' : row.recurrence === 'monthly' ? 'Repeats monthly' : null;
---
<li class="ev-li" data-start={row.start} data-end={row.end ?? undefined}>
  <CompactRow href={href}>
    <span class="ev-when">
      {showDate && <span class="ev-when__date">{row.dateLabel}</span>}
      <span class="ev-when__time">{row.timeLabel || '·'}</span>
    </span>
    <span class="ev-main">
      <span class="ev-title">{row.title}{repeats && <span class="ev-repeat" title={repeats} aria-label={repeats}> <Icon name="repeat" size={14} /></span>}</span>
      {place && <span class="ev-place">{place}</span>}
      {(row.free || row.kids) && (
        <span class="ev-pills">
          {row.free && <Pill tone="ok">Free</Pill>}
          {row.kids && <Pill>Kids &amp; families</Pill>}
        </span>
      )}
    </span>
  </CompactRow>
</li>
<style>
  .ev-li { list-style: none; border-bottom: var(--ui-hairline); }
  .ev-li :global(.ui-row__main) { display: grid; grid-template-columns: 4.25rem minmax(0, 1fr); gap: var(--ui-3); align-items: baseline; width: 100%; }
  .ev-when { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; }
  .ev-when__date { font-size: var(--ui-meta); color: var(--ink-soft); }
  .ev-when__time { font-size: var(--ui-primary); font-weight: var(--ui-primary-weight); white-space: nowrap; }
  .ev-main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
  .ev-title { font-family: var(--font-head); font-size: 1.1875rem; line-height: 1.25; color: var(--ink); }
  .ev-repeat { color: var(--ink-soft); white-space: nowrap; }
  .ev-place { font-size: var(--ui-meta); color: var(--ink-soft); }
  .ev-pills { display: flex; flex-wrap: wrap; gap: var(--ui-1); margin-top: var(--ui-1); }
</style>

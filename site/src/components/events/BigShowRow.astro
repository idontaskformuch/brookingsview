---
/** One big show: date and time in the left column, title, then "Venue · City · N mi". The whole row links to Ticketmaster. */
import CompactRow from '../ui/CompactRow.astro';
import Icon from '../ui/Icon.astro';
import { bigShowWhere, type BigShow } from '../../lib/big-shows';

interface Props { s: BigShow }
const { s } = Astro.props;
---
<li class="bs-li" data-start={s.start}>
  <CompactRow href={s.href} cat={s.cat ?? undefined}>
    <span class="bs-when" style={s.cat ? `--c: var(--cat-${s.cat})` : undefined}>
      <span class="bs-when__date">{s.dateLabel}</span>
      <span class="bs-when__time">{s.timeLabel}</span>
      {s.cat && <Icon name={s.cat} size={16} />}
    </span>
    <span class="bs-main">
      <span class="bs-title">{s.title}</span>
      <span class="bs-place">{bigShowWhere(s)}</span>
      {s.moreDates > 0 && <span class="bs-place">+ {s.moreDates} more {s.moreDates === 1 ? 'date' : 'dates'}</span>}
    </span>
  </CompactRow>
</li>
<style>
  .bs-li { list-style: none; background: var(--paper-raised); border: var(--ui-hairline); border-radius: var(--ui-radius); overflow: hidden; margin-bottom: var(--ui-2); }
  .bs-li :global(.ui-row__main) { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--ui-3); align-items: start; width: 100%; }
  .bs-li :global(.ui-row) { padding-block: var(--ui-3); }
  .bs-when { display: flex; flex-direction: column; gap: var(--ui-1); font-variant-numeric: tabular-nums; color: var(--c, var(--ink-soft)); }
  .bs-when__date { font-size: var(--ui-meta); color: var(--ink-soft); }
  .bs-when__time { font-size: 1.375rem; line-height: 1.1; font-weight: 700; color: var(--ink); white-space: nowrap; letter-spacing: -0.01em; }
  .bs-main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; }
  .bs-title { font-family: var(--font-head); font-size: 1.1875rem; line-height: 1.25; color: var(--ink); }
  .bs-place { font-size: var(--ui-meta); color: var(--ink-soft); overflow-wrap: anywhere; }
</style>

---
/** Event lists as day blocks (Designsystem Fas 4, owner 2026-11-21; design lift rollout a, owner 2026-11-26 (7)): one DayGroup per
 *  town day with its date as the heading and a digest line under it ("6 events · 2 music · 3 free"), then ONE featured event as a
 *  larger card (EventFeature), then compact EventRows (time, title, place; never a date or "Today" on a row), at most MAX_COMPACT
 *  before the rest folds behind "N more". Choice and words: lib/day-digest.ts. Used by /events/ and /this-week/ in every town.
 *  The group keeps id="<idPrefix>-YYYY-MM-DD", the anchor the week strip (EventsGlance) links to. In the browser
 *  (lib/event-pop-client.ts) rows that are over are removed, and a day whose rows are all over goes with its heading; without
 *  JavaScript every row stays. `keepOver`: an archive (a past week) keeps every row and loads no sweep script.
 *
 *  Resident question: what is on in town on each of the next days, and what is the one thing worth knowing about that day? */
import DayGroup from '../ui/DayGroup.astro';
import EventRow from '../ui/EventRow.astro';
import EventFeature from '../ui/EventFeature.astro';
import type { DayGroupData, EventRowData } from '../../lib/event-row';
import { eventDigest, splitDay, splitNearby } from '../../lib/day-digest';

interface Props {
  groups: DayGroupData<EventRowData>[]; tz: string; idPrefix?: string; level?: 2 | 3; showCategory?: boolean; keepOver?: boolean;
  /** The town's top events (siteConfig.topEvents): such a row is the day's featured card before any other. */
  isTop?: (r: EventRowData) => boolean;
  /** Where "More nearby shows →" goes (What's On); none = no link. */
  moreNearbyHref?: string | null;
}
const { groups, tz, idPrefix = 'day', level = 2, showCategory = false, keepOver = false, isTop, moreNearbyHref = null } = Astro.props;
const rowLevel = (level + 1) as 3 | 4;
// The town's rows decide the featured card and the digest; the day's rows in other towns are their own block, last (owner 2026-11-26 (9)).
const blocks = groups.map((g) => ({ g, digest: eventDigest(g.rows, g.nearby?.length ?? 0), ...splitDay(g.rows, isTop), near: splitNearby(g.nearby ?? []) }));
const attrs = (row: EventRowData, key: string) => (keepOver
  ? { 'data-day-key': key }
  : { 'data-pop-row': '', 'data-start': row.start ?? undefined, 'data-end': row.end ?? undefined, 'data-tz': tz, 'data-day-key': key });
---
<div class="ed" data-pop-list={keepOver ? undefined : ''} data-tz={tz}>
  {blocks.map(({ g, digest, featured, shown, more, near }) => (
    <div data-pop-group={keepOver ? undefined : ''}>
      <DayGroup label={g.label} datetime={g.key} id={`${idPrefix}-${g.key}`} level={level} digest={digest}>
        {featured && (
          <li class="ed__feature" {...attrs(featured, g.key)}>
            <EventFeature row={featured} showCategory={showCategory} level={rowLevel} />
          </li>
        )}
        {shown.map((row) => (
          <li {...attrs(row, g.key)}>
            <EventRow row={row} showCategory={showCategory} level={rowLevel} />
          </li>
        ))}
        <Fragment slot="after">
          {more.length > 0 && (
            <details class="ed__more">
              <summary>{more.length} more on {g.label}</summary>
              <ul class="day-group__rows">
                {more.map((row) => (
                  <li {...attrs(row, g.key)}>
                    <EventRow row={row} showCategory={showCategory} level={rowLevel} />
                  </li>
                ))}
              </ul>
            </details>
          )}
          {near.shown.length > 0 && (
            <div class="nearby-block" data-nearby-block>
              <p class="nearby-block__h">{near.heading}</p>
              <ul class="day-group__rows">
                {near.shown.map((row) => (
                  <li {...attrs(row, g.key)}>
                    <EventRow row={row} showCategory={showCategory} level={rowLevel} />
                  </li>
                ))}
              </ul>
              {near.moreOwn.length > 0 && (
                <details class="ed__more">
                  <summary>{near.moreOwn.length} more nearby</summary>
                  <ul class="day-group__rows">
                    {near.moreOwn.map((row) => (
                      <li {...attrs(row, g.key)}>
                        <EventRow row={row} showCategory={showCategory} level={rowLevel} />
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {near.moreTickets > 0 && moreNearbyHref && <p class="nearby-block__more"><a href={moreNearbyHref}>More nearby shows →</a></p>}
            </div>
          )}
        </Fragment>
      </DayGroup>
    </div>
  ))}
</div>
<script>
  // A keepOver list carries no data-pop-row, so this leaves it alone.
  import { applyEventPop } from '../../lib/event-pop-client';
  const root = document.querySelector<HTMLElement>('.ed[data-pop-list]');
  const tick = () => applyEventPop(document, new Date(), root?.dataset.tz || 'America/Chicago');
  tick();
  setInterval(tick, 60_000);
</script>
<style>
  .ed :global(.day-group) { scroll-margin-top: var(--ui-5); }
  .ed__feature { list-style: none; }
  .ed__feature + li :global(.ev-row) { border-top: 0; }
  /* A day with nothing in town: no empty list line above its Nearby block. */
  .ed :global(.day-group__rows:not(:has(li))) { display: none; }
  .ed__more summary { cursor: pointer; padding: var(--ui-2) 0; font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: 600; color: var(--navy); min-height: 44px; display: flex; align-items: center; }
  [data-pop-group][hidden] { display: none; }
</style>

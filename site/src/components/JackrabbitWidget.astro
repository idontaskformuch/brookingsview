---
// Front-page promo card for the Jackrabbit arcade game, see /play.
---

<a href="/play/" class="jackrabbit-widget" aria-label="Play the Jackrabbit arcade game">
  <div class="jr-icon" aria-hidden="true">🐇</div>
  <div class="jr-text">
    <div class="jr-title">Play Jackrabbit</div>
    <div class="jr-sub">Our free arcade game — can you beat 20?</div>
  </div>
</a>

<style>
  /* Consistency pass (2026-09-10): was a navy/gold gradient card, the same
     saturated-fill pattern independently invented three more times
     elsewhere (BurroBonanzaWidget, WorkplaceWatchWidget, VailNewsWidget)
     -- see NEEDS-HUMAN-REVIEW.md. Same restrained treatment as the rest of
     the site now: thin rule border, paper-raised background, no gradient.
     The emoji is the visual anchor instead of a colored border/arrow. */
  .jackrabbit-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .jackrabbit-widget:hover { border-color: var(--rule-strong); }
  .jr-icon { font-size: 1.5rem; flex-shrink: 0; }
  .jr-text { flex: 1; }
  .jr-title { font-weight: 700; font-size: 0.95rem; }
  .jr-sub { font-size: 0.78rem; color: var(--ink-soft); }
</style>

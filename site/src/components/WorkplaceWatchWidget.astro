---
// Front-page promo card for Worker Pulse / Workplace Watch, see /workplace-watch.
// Caller (index.astro) decides whether to render at all and passes the
// headline figures -- same convention as TrafficWidget.astro.
//
// 2026-10-01: per-employer RATING and the rating-based "top employer"/
// "biggest mover" ranking are temporarily removed from this card (and from
// the full /workplace-watch page) pending a review of Glassdoor's and
// Indeed's own Terms of Use on republishing their content -- both contain
// broad "personal, non-commercial use only" / "no reproduction or
// derivative works" language that a search-API-sourced, AI-paraphrased
// rating may not clear, independent of how carefully it's hedged. Adzuna
// hiring data has no such provenance question (a different, unrelated
// source), so it stays. See ai_pipeline/workplace_watch_digest.py's own
// extract_rating() for how a rating number is pulled (a bare regex over up
// to 20 concatenated Brave Search snippets, no verification the match is
// even about the right company) -- the accuracy question is separate from,
// and in addition to, the ToS question above.
interface Props {
  /** Fas 4a (hiring layer): the employer with the largest posting-count
   *  change vs last month, or the only employer with any postings at all
   *  when no town yet has month-over-month history. null when no employer
   *  has any employer_job_stats row yet (monthly digest hasn't run since
   *  this shipped) -- omitted entirely, never a fake "0 listings" line. */
  hiringName: string | null;
  hiringCount: number | null;
  hiringDelta: number | null;
}
const { hiringName, hiringCount, hiringDelta } = Astro.props;

const hiringSymbol = hiringDelta === null ? null : hiringDelta > 0 ? '▲' : hiringDelta < 0 ? '▼' : '▬';
---

<a href="/workplace-watch/" class="wpw-widget" aria-label="See Worker Pulse: local employer hiring activity">
  <div class="wpw-icon" aria-hidden="true">📊</div>
  <div class="wpw-text">
    <div class="wpw-title">Worker Pulse</div>
    <div class="wpw-sub">
      Hiring: {hiringName} — {hiringCount} listing{hiringCount === 1 ? '' : 's'}
      {hiringSymbol && (
        <>{' '}<span class:list={['wpw-symbol', { up: hiringDelta! > 0, down: hiringDelta! < 0 }]}>{hiringSymbol}</span></>
      )}
    </div>
    <div class="wpw-source">Source: Adzuna job postings, last 30 days</div>
  </div>
</a>

<style>
  /* Consistency pass (2026-09-10) -- see JackrabbitWidget.astro's
     identical comment for the full reasoning. The teal interactiveAccent
     (SECTION_THEME.workplace_watch) belongs to Worker Pulse's actual
     interactive controls (ShiftPollWidget's button, WorkerPulseComments'
     submit) -- deliberately NOT used here, this is a plain link like the
     other three promo cards, not a control. */
  .wpw-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .wpw-widget:hover { border-color: var(--rule-strong); }
  .wpw-icon { font-size: 1.5rem; flex-shrink: 0; }
  .wpw-text { flex: 1; min-width: 0; }
  .wpw-title { font-weight: 700; font-size: 0.95rem; }
  .wpw-sub { font-size: 0.78rem; color: var(--ink-soft); }
  .wpw-source { font-size: 0.68rem; color: var(--ink-soft); margin-top: 0.2rem; opacity: 0.8; }
  .wpw-symbol.up { color: var(--status-good); }
  .wpw-symbol.down { color: var(--status-bad); }
</style>

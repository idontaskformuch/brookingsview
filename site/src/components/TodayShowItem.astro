---
/** One Ticketmaster show in /today's Tonight/Tomorrow list (gb; lib/today-shows.ts). A component of its own because Astro mis-compiles plain
 *  HTML elements with expressions inside the <template> in TodayBlock.astro (only components work there). */
import type { TodayShow } from '../lib/today-shows';
interface Props { show: TodayShow; cityName: string }
const { show, cityName } = Astro.props;
---
<article class="today-show">
  <p class="today-show__meta">{show.venue}{show.clock && ` · ${show.clock}`} · In {cityName}</p>
  <h3 class="today-show__title"><a href={show.href}>{show.title}</a></h3>
  <p class="today-show__all"><a href="/whats-on/">More shows on What's On</a></p>
</article>

<style>
.today-show { padding-block: 0.5rem; border-bottom: 0.5px solid var(--rule); }
.today-show__meta { margin: 0; font-size: 0.8125rem; color: var(--ink-soft); }
.today-show__title { margin: 0.125rem 0; font-size: 1rem; font-family: var(--font-head); }
.today-show__title a { color: var(--ink); text-decoration: none; }
.today-show__all { margin: 0; font-size: 0.75rem; }
</style>

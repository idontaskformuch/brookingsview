---
/** A short template sentence built from data ("Dry until 3pm"). The caller only renders it when its rule fires; never pass prose that was not built from fields. */
import Icon from './Icon.astro';
import type { IconName } from '../../lib/ui/icons';

interface Props { icon?: IconName }
const { icon } = Astro.props;
---
<p class="ui-insight">{icon && <Icon name={icon} size={18} />}<span><slot /></span></p>
<style>
  .ui-insight { margin: 0; display: flex; align-items: baseline; gap: var(--ui-2); font-family: var(--font-ui); font-size: var(--ui-primary);
    font-weight: var(--ui-primary-weight); color: var(--ink); font-variant-numeric: tabular-nums; }
  .ui-insight :global(.ui-icon) { color: var(--accent); align-self: center; }
</style>

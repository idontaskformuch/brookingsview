---
/** A short template sentence built from data ("Dry until 3pm"). The caller only renders it when its rule fires; never pass prose that was not built from fields.
 *  Markup is built by lib/ui/ui-html.ts (insightHtml); styles: design/ui-components.css. */
import { insightHtml } from '../../lib/ui/ui-html';
import type { IconName } from '../../lib/ui/icons';

interface Props { icon?: IconName; attrs?: Record<string, unknown>; class?: string }
const { icon, attrs = {}, class: extra } = Astro.props;
const html = await Astro.slots.render('default');
---
<Fragment set:html={insightHtml({ icon, attrs, class: extra, html })} />

---
/** The one dominant element of a view (principle 1): "62°", "in 26 min". 2-3x the size of anything near it. `sub` is the meta line under it.
 *  `rootAttrs`/`valueAttrs`/`unitAttrs` are spread on the elements so a page's script can find and update them (data-* hooks, hidden).
 *  Markup is built by lib/ui/ui-html.ts (heroHtml) so a script can redraw it; styles: design/ui-components.css. */
import { heroHtml, type HeroProps } from '../../lib/ui/ui-html';

interface Props extends HeroProps {}
const props = Astro.props;
---
<Fragment set:html={heroHtml(props)} />

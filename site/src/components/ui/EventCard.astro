---
/** Designsystem Fas 1 (owner 2026-11-20): THE event card, as What's On's marquee card: the image on top (only an allowed image the caller
 *  already resolved, lib/images.ts; no placeholder, no new hotlink), then where · when, the title, distance and price. Without an image
 *  it is the same card with the text only. `priority` only for the one card that is the page's LCP candidate. */
import type { ImageRef } from '../../lib/images';
import ImageAttribution from '../ImageAttribution.astro';

interface Props {
  title: string;
  href: string | null;
  rel?: string | null;
  image?: ImageRef | null;
  /** The venue (left of the date line). */
  where: string;
  /** The date line, e.g. "Sat, Nov 21 · 7:30 PM" or a run "6 dates, ...". */
  when?: string | null;
  datetime?: string | null;
  /** Facts under the title (distance, price). */
  facts?: (string | null | undefined)[];
  priority?: boolean;
}
const { title, href, rel = null, image = null, where, when = null, datetime = null, facts = [], priority = false } = Astro.props;
const ImageLink = href ? 'a' : 'span';
const factLine = facts.filter(Boolean).join(' · ');
---
<article class:list={['ev-card', { 'ev-card--text': !image }]}>
  {image && (
    <ImageLink class="ev-card__image-link" href={href ?? undefined} rel={href ? (rel ?? undefined) : undefined} tabindex={href ? '-1' : undefined} aria-hidden="true">
      <img class="ev-card__image" src={image.path} alt={image.alt} width={image.width} height={image.height}
        loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
    </ImageLink>
  )}
  <div class="ev-card__body">
    {image && <ImageAttribution image={image} />}
    <p class="ev-card__meta">
      <span class="ev-card__where">{where}</span>
      {when && <time class="ev-card__when" datetime={datetime ?? undefined}>{when}</time>}
    </p>
    <h3 class="ev-card__title">{href ? <a href={href} rel={rel ?? undefined}>{title}</a> : title}</h3>
    {factLine && <p class="ev-card__facts">{factLine}</p>}
  </div>
</article>
<style>
  .ev-card { display: flex; flex-direction: column; min-width: 0; }
  .ev-card__image-link { display: block; border-radius: 3px; overflow: hidden; }
  .ev-card__image { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; }
  .ev-card__body { padding-top: 0.75rem; }
  .ev-card--text .ev-card__body { border-top: 3px solid var(--rule-strong); }
  .ev-card__meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.625rem; margin: 0 0 0.25rem; font-family: var(--font-ui); font-size: 0.8125rem; }
  .ev-card__where { font-weight: 600; color: var(--ink); }
  .ev-card__when { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .ev-card__title { margin: 0; font-family: var(--font-head); font-size: 1.375rem; line-height: 1.2; }
  .ev-card__title a { color: var(--ink); text-decoration: none; }
  .ev-card__title a:hover { text-decoration: underline; }
  .ev-card__facts { margin: 0.375rem 0 0; font-family: var(--font-ui); font-size: 0.8125rem; color: var(--ink-soft); }
</style>

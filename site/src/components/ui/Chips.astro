---
/** Filter chips as buttons (aria-pressed). Pass the raw counts; planChips (lib/ui/ui-helpers.ts) decides whether the row exists at all
 *  (>= 3 items per chip, >= 2 chips, no numbers in labels), so a caller never needs its own check. */
import { planChips } from '../../lib/ui/ui-helpers';

/** Two modes. `counts`: the row is planned here. `plan`: a page that re-plans live in the browser (Tonight) passes its own `order`/`visible`/`showRow`
 *  (built from the same CHIP_MIN_* constants) and the row is always in the HTML, hidden or not. `dataKey` names the data-* hook the page script
 *  reads ("tc-chip" -> data-tc-chip); `navAttrs` are spread on the nav; `class` is passed through. */
interface Plan { order: string[]; visible: string[]; showRow: boolean }
interface Props { counts?: Record<string, number>; plan?: Plan; allLabel?: string; label?: string; dataKey?: string; navAttrs?: Record<string, unknown>; class?: string }
const { counts, plan, allLabel = 'All', label = 'Filter', dataKey = 'ui-chip', navAttrs = {}, class: extra } = Astro.props;
const order = plan ? plan.order : planChips(counts ?? {});
const visible = plan ? plan.visible : order;
const hook = (v: string) => ({ [`data-${dataKey}`]: v });
---
{order.length > 0 && (
  <nav class:list={['ui-chips', extra]} aria-label={label} hidden={plan && !plan.showRow ? true : undefined} {...navAttrs}>
    <button type="button" class="ui-chip" {...hook('')} aria-pressed="true">{allLabel}</button>
    {order.map((c) => <button type="button" class="ui-chip" {...hook(c)} aria-pressed="false" hidden={visible.includes(c) ? undefined : true}>{c}</button>)}
  </nav>
)}
<style>
  .ui-chips { display: flex; gap: var(--ui-2); overflow-x: auto; padding: var(--ui-1) 0; scrollbar-width: none; }
  .ui-chips[hidden], .ui-chip[hidden] { display: none; }
  .ui-chip { flex: none; font: inherit; font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: var(--ui-primary-weight); color: var(--ink);
    background: var(--ui-surface-2); border: 0; border-radius: 999px; padding: 0.45rem 0.9rem; min-height: 2.75rem; white-space: nowrap; cursor: pointer;
    transition: background var(--ui-dur) var(--ui-ease), color var(--ui-dur) var(--ui-ease); }
  .ui-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .ui-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

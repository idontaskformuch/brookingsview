---
/** Filter chips as buttons (aria-pressed). Pass the raw counts; planChips (lib/ui/ui-helpers.ts) decides whether the row exists at all
 *  (>= 3 items per chip, >= 2 chips, no numbers in labels), so a caller never needs its own check. */
import { planChips } from '../../lib/ui/ui-helpers';

interface Props { counts: Record<string, number>; allLabel?: string; label?: string }
const { counts, allLabel = 'All', label = 'Filter' } = Astro.props;
const chips = planChips(counts);
---
{chips.length > 0 && (
  <nav class="ui-chips" aria-label={label}>
    <button type="button" class="ui-chip" data-ui-chip="" aria-pressed="true">{allLabel}</button>
    {chips.map((c) => <button type="button" class="ui-chip" data-ui-chip={c} aria-pressed="false">{c}</button>)}
  </nav>
)}
<style>
  .ui-chips { display: flex; gap: var(--ui-2); overflow-x: auto; padding: var(--ui-1) 0; scrollbar-width: none; }
  .ui-chip { flex: none; font: inherit; font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: var(--ui-primary-weight); color: var(--ink);
    background: var(--ui-surface-2); border: 0; border-radius: 999px; padding: 0.5rem var(--ui-3); min-height: 2.5rem; cursor: pointer;
    transition: background var(--ui-dur) var(--ui-ease), color var(--ui-dur) var(--ui-ease); }
  .ui-chip[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .ui-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

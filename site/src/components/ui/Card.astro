---
/** Raised surface with a 4 px top edge in the category colour. The whole card is the link when `href` is set. No bordered box (principle 7). */
import { CATEGORIES, type Category } from '../../lib/ui/ui-helpers';

interface Props { cat?: Category; href?: string; lg?: boolean }
const { cat, href, lg = false } = Astro.props;
if (cat && !CATEGORIES.includes(cat)) throw new Error(`ui/Card: unknown category ${cat}`);
const Tag = href ? 'a' : 'div';
const external = !!href && /^https?:/i.test(href);
---
<Tag class:list={['ui-card', { 'ui-card--lg': lg }]} style={cat ? `--c: var(--cat-${cat})` : '--c: var(--accent)'}
  href={href} rel={external ? 'noopener' : undefined}><slot /></Tag>
<style>
  .ui-card { display: flex; flex-direction: column; gap: var(--ui-1); padding: var(--ui-3); background: var(--ui-surface-1); color: inherit; text-decoration: none;
    border-top: 4px solid var(--c); border-radius: var(--ui-radius); box-shadow: 0 1px 0 var(--rule), 0 6px 16px -12px rgba(0, 0, 0, 0.35);
    font-family: var(--font-ui); transition: background var(--ui-dur) var(--ui-ease); }
  .ui-card--lg { padding: var(--ui-4); }
  a.ui-card:hover { background: var(--ui-surface-2); }
  a.ui-card:focus-visible { outline: 3px solid var(--c); outline-offset: 2px; }
</style>

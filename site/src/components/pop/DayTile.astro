---
/** The date tile on the left of an event or calendar row: weekday and month in small capitals, the day large and bold in the town's accent.
 *  A range inside one month is "25–29" under the month; a range over a month boundary is "DEC 31 – JAN 2" in a smaller size. Fixed width, so the
 *  texts of every row start in one column. `blank` is the same box without content, for the 2nd, 3rd... row of a day. The model comes from
 *  lib/event-pop.ts dayTile(); this component prints it and decides nothing. */
import type { DayTileModel } from '../../lib/event-pop';
interface Props { model?: DayTileModel; blank?: boolean }
const { model, blank = false } = Astro.props;
---
{blank || !model ? <span class="tile tile--blank" aria-hidden="true"></span> : (
  <span class={`tile tile--${model.kind}`} title={model.label}>
    <span class="tile__sr">{model.label}</span>
    {model.kind === 'cross'
      ? <span class="tile__span" aria-hidden="true">{model.span}</span>
      : <>
          <span class="tile__kicker" aria-hidden="true">{model.kicker}</span>
          <span class="tile__day" aria-hidden="true">{model.day}</span>
        </>}
  </span>
)}
<style>
  .tile { flex: 0 0 var(--tile-w, 3.75rem); width: var(--tile-w, 3.75rem); display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
          text-align: center; font-family: var(--font-ui); font-variant-numeric: tabular-nums; line-height: 1; }
  .tile--blank { min-height: 1px; }
  .tile__kicker { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; color: var(--ink-soft); white-space: nowrap; }
  .tile__day { margin-top: 0.1875rem; font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; color: var(--brand-accent, var(--accent)); white-space: nowrap; }
  .tile--range .tile__day { font-size: 1.375rem; }
  .tile__span { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.03em; line-height: 1.25; color: var(--brand-accent, var(--accent)); text-wrap: balance; }
  .tile__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

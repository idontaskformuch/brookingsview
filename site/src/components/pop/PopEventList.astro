---
/** Event list with a date tile on the left of each day's first row; the following rows of the same day line up under it without a tile. One flat
 *  list in time order across days (no heading per day: the tile is the day). Each row is a card on --surface-raised (a step lighter than the page; no
 *  border in dark). Relative words ("Today", "In 3 days") and the removal of rows that are over (as the old lists did) are set in the browser from the town's clock
 *  (lib/event-pop-client.ts); without JavaScript there is neither. The first row of each day keeps id="day-YYYY-MM-DD" for the day strip's anchors. */
import DayTile from './DayTile.astro';
import TimeTile from './TimeTile.astro';
import CategoryDot from './CategoryDot.astro';
import Pill from '../ui/Pill.astro';
import { dayTile, timeTile } from '../../lib/event-pop';
import { popCategory } from '../../lib/pop-categories';
import type { PopDay, PopRow } from '../../lib/pop-days';
import { itemLink } from '../../lib/events';
import { siteConfig } from '../../lib/site-config';

/** `noteOf` replaces the area on a row's meta line (e.g. "4 mi away" in the Nearby list). A row's `note` is an extra line under the meta line. */
/** `tile` 'time' (single-day lists: /tonight, /this-weekend) prints the start time in the tile slot, and no relative-day label.
 *  `listAttrs` go on the <ul> (the pages' own hooks, e.g. data-hide-ended); a row's `attrs` go on its <li>. `keepOver` is for archive lists (a past week
 *  keeps every row): the rows then carry no start/end, so nothing in the browser removes them.
 *  `live` (/tonight): each row gets an empty [data-tc-time] label in the top-right slot of the time-tile list; lib/tonight-cards-client.ts fills it every minute
 *  with "On now" or "in N min" (nothing otherwise) and sets .is-now / .is-soon on the row. Same slot the date list uses for "Today", so the layout does not move. */
interface Props { days: PopDay[]; tz?: string; idPrefix?: string; noteOf?: (r: PopRow) => string | null; tile?: 'date' | 'time'; listAttrs?: Record<string, string | undefined>; keepOver?: boolean; live?: boolean }
const { days, tz = siteConfig.timezone, idPrefix = 'day', noteOf, tile = 'date', listAttrs = {}, keepOver = false, live = false } = Astro.props;
const country = siteConfig.country === 'gb' ? 'gb' : 'us';
const hrefOf = (r: PopRow) => r.href ?? (r.item ? itemLink(r.item) ?? undefined : undefined);
const place = (r: PopRow) => [r.venue, noteOf?.(r) ?? r.area].filter(Boolean).join(' · ');
const repeats = (r: PopRow) => (r.recurrence === 'weekly' ? 'Repeats weekly' : r.recurrence === 'monthly' ? 'Repeats monthly' : null);
const rows = days.flatMap((d) => d.rows.map((r, i) => ({ r, first: i === 0, key: d.dayKey })));
---
<ul class="pl" data-pop-list data-tz={tz} {...listAttrs}>
  {rows.map(({ r, first, key }) => {
    const href = hrefOf(r);
    const cat = popCategory(r.cat);
    const Tag = href ? 'a' : 'div';
    return (
      <li class="pl__li" data-pop-row data-day-key={key} data-start={keepOver ? undefined : r.start} data-end={keepOver ? undefined : (r.end ?? undefined)} data-tz={tz} id={first ? `${idPrefix}-${key}` : undefined} {...r.attrs}>
        <Tag class="pl__card" href={href}>
          {tile === 'time' ? <TimeTile model={timeTile(r.start, tz)} /> : <DayTile model={r.tileFrom ? dayTile(r.tileFrom, r.end ?? r.start, tz, country) : dayTile(r.start, r.end, tz, country)} dup={!first} />}
          <span class="pl__main">
            <span class="pl__top">
              {cat.name ? <CategoryDot name={cat.name} token={cat.token} /> : <span></span>}
              {tile === 'date' ? <span class="pl__rel" data-pop-rel hidden></span> : live ? <span class="pl__live" data-tc-time data-tc-live-only hidden></span> : <span></span>}
            </span>
            <span class="pl__title">{r.title}{repeats(r) && <span class="pl__rep" title={repeats(r) ?? ''}> ↻</span>}</span>
            <span class="pl__meta">{[r.timeLabel, place(r)].filter(Boolean).join(' · ')}</span>
            {r.note && <span class="pl__meta">{r.note}</span>}
            {(r.free || r.kids || r.teens || (r.tags?.length ?? 0) > 0) && (
              <span class="pl__pills">
                {r.free && <Pill tone="ok">Free</Pill>}
                {r.kids && <Pill>Kids &amp; families</Pill>}
                {r.teens && <Pill>Teens</Pill>}
                {r.tags?.map((t) => <Pill>{t}</Pill>)}
              </span>
            )}
          </span>
        </Tag>
      </li>
    );
  })}
</ul>
<script>
  import { applyEventPop } from '../../lib/event-pop-client';
  const root = document.querySelector<HTMLElement>('[data-pop-list]');
  const tick = () => applyEventPop(document, new Date(), root?.dataset.tz || 'America/Chicago');
  tick();
  setInterval(tick, 60_000);
</script>
<style>
  .pl { list-style: none; margin: 0; padding: 0; }
  .pl__li { margin-bottom: var(--ui-2); scroll-margin-top: var(--ui-5); }
  /* A card: --surface-raised, thin hairline in light, none in dark (the lighter surface carries it). */
  .pl__card { display: flex; gap: var(--ui-3); align-items: flex-start; padding: var(--ui-3); background: var(--surface-raised); border: var(--card-border-w, 1px) solid var(--rule);
              border-radius: var(--ui-radius); color: inherit; text-decoration: none; }
  a.pl__card:hover .pl__title { text-decoration: underline; }
  .pl__main { display: flex; flex-direction: column; gap: 0.125rem; min-width: 0; flex: 1; }
  .pl__top { display: flex; align-items: center; justify-content: space-between; gap: var(--ui-2); min-height: 1.125rem; }
  .pl__rel { font-family: var(--font-ui); font-size: 0.75rem; font-weight: 700; color: var(--brand-accent-ink, var(--accent)); white-space: nowrap; }
  .pl__live { font-family: var(--font-ui); font-size: 0.75rem; font-weight: 700; color: var(--brand-accent-ink, var(--accent)); white-space: nowrap; }
  .pl__li.is-now .pl__live::before { content: ''; display: inline-block; width: 0.55em; height: 0.55em; margin-right: 0.35em; border-radius: 50%; background: currentColor; vertical-align: 0.04em; }
  /* "On now": a thin bar on the card's left edge, drawn inside (inset shadow), so nothing is resized */
  .pl__li.is-now .pl__card { box-shadow: inset 3px 0 0 var(--brand-accent-ink, var(--accent)); }
  .pl__title { font-family: var(--font-head); font-size: 1.1875rem; line-height: 1.25; color: var(--ink); }
  .pl__rep { color: var(--ink-soft); }
  .pl__meta { font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .pl__pills { display: flex; flex-wrap: wrap; gap: var(--ui-1); margin-top: var(--ui-1); }
  @media (max-width: 26rem) { .pl__card { padding: var(--ui-3) 0.75rem; gap: 0.625rem; } }
</style>

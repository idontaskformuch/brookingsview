---
/** Theme-grouped, deterministic list of a week's items (lib/week-groups.ts): "Fri 7pm · Volleyball vs South Dakota · venue",
 *  each row linked to the source page. Used by the university digest page (/s/university-digest-*); the city roundup page
 *  (/this-week/<week>/) renders the same groups with its own markup. Empty groups are never passed in. */
import type { WeekGroup } from '../lib/week-groups';

interface Props { groups: WeekGroup[]; idPrefix?: string }
const { groups, idPrefix = 'wk' } = Astro.props;
---
<div class="wk-groups">
  {groups.map((group) => (
    <section class="wk-group" aria-labelledby={`${idPrefix}-${group.id}`}>
      <h2 class="wk-group__heading" id={`${idPrefix}-${group.id}`}>{group.label}</h2>
      <ul class="wk-list" data-hide-ended data-hide-section>
        {group.rows.map((row) => (
          <li class="wk-row" data-start={row.start} data-end={row.end ?? undefined}>
            <span class="wk-when">{row.when}</span>
            <span class="wk-sep" aria-hidden="true"> · </span>
            {row.href ? (
              <a href={row.href} target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener' : undefined}>{row.title}</a>
            ) : <span>{row.title}</span>}
            {row.venue && <span class="wk-venue"> · {row.venue}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
.wk-groups { margin-top: 2rem; display: grid; gap: 1.75rem; max-width: 42rem; }
.wk-group__heading { font-size: 1.0625rem; margin: 0 0 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--rule); }
.wk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.wk-row { line-height: 1.45; }
.wk-when { font-family: var(--font-ui); font-weight: 600; font-size: 0.875rem; }
.wk-sep, .wk-venue { color: var(--ink-soft); }
.wk-venue { font-size: 0.875rem; }
</style>

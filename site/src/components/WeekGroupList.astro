---
/** Theme-grouped, deterministic list of a week's items (lib/week-groups.ts): the heading names the theme, each row is a row of the date-tile list
 *  (components/pop/PopEventList.astro: date tile, the clock time on the meta line, venue), linked to the source page. Used by the university digest page
 *  (/s/university-digest-*) and the city roundup page (/this-week/<week>/). Empty groups are never passed in.
 *  `keepOver`: an archive week keeps every row (nothing is removed in the browser); the digest drops rows that are over and a group with none left. */
import PopEventList from './pop/PopEventList.astro';
import { weekPopDays } from '../lib/pop-days';
import { siteConfig } from '../lib/site-config';
import type { WeekGroup } from '../lib/week-groups';

interface Props { groups: WeekGroup[]; idPrefix?: string; keepOver?: boolean; tz?: string }
const { groups, idPrefix = 'wk', keepOver = false, tz = siteConfig.timezone } = Astro.props;
---
<div class="wk-groups">
  {groups.map((group) => (
    <section class="wk-group" aria-labelledby={`${idPrefix}-${group.id}`}>
      <h2 class="wk-group__heading" id={`${idPrefix}-${group.id}`}>{group.label}</h2>
      <PopEventList days={weekPopDays(group.rows, tz)} tz={tz} idPrefix={`${idPrefix}-${group.id}`} keepOver={keepOver}
        listAttrs={keepOver ? {} : { 'data-hide-ended': '', 'data-hide-section': '' }} />
    </section>
  ))}
</div>

<style>
.wk-groups { margin-top: 2rem; display: grid; gap: 1.75rem; max-width: 42rem; }
.wk-group__heading { font-size: 1.0625rem; margin: 0 0 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--rule); }
</style>

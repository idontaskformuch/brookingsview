---
/** What's On -- the dense "Also on" list row. Used to also render the
 *  larger Marquee cards too (see the old `compact` prop); that role now
 *  belongs to MarqueeCard.astro (sitewide presentation-layer pass, R5 "time
 *  is the left rail" applied here: a fixed-width time column instead of a
 *  kicker+time line stacked above the title, matching StoryCard.astro's own
 *  R5 rework for the same reason). This component is now Also-on-only --
 *  no image, ever, by design (the Marquee tier is exactly where imagery
 *  earns its keep; Also-on stays dense on purpose).
 *
 *  Reuses this site's existing typography/spacing conventions (the shared
 *  .kicker/.data classes in BaseLayout.astro's global styles) rather than
 *  inventing a new visual language. */
import { siteConfig } from '../lib/site-config';
import { distanceLabel, type TicketmasterFeedItem } from '../lib/ticketmaster';
import { ticketmasterSlug } from '../lib/whats-on';

interface Props {
  item: TicketmasterFeedItem;
  /** What's On Phase 5 follow-up ("Tour-Run Collapsing"): total number of
   *  dates in this run when `item` is a collapsed MarqueeEntry's primary
   *  (e.g. 6 for "Disney On Ice presents Find Your Hero") -- omitted or 1
   *  for a standalone event, which keeps the single-date display exactly
   *  as it was before this follow-up. `lastOccursAt` is the run's LATEST
   *  date, needed to render a real range rather than just a count. */
  runSize?: number;
  lastOccursAt?: string | null;
}
const { item, runSize = 1, lastOccursAt = null } = Astro.props;
const e = item.ticketmasterEvent;

const href = `/whats-on/${ticketmasterSlug(e)}/`;
const distance = distanceLabel(e.venueDistanceMiles, siteConfig.cityName);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', {
    weekday: 'short', month: 'short', day: 'numeric', timeZone: siteConfig.timezone,
  });
}
function formatDayOnly(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: siteConfig.timezone });
}

const dateLabel = runSize > 1 && item.occurs_at && lastOccursAt
  ? `${runSize} dates, ${formatDate(item.occurs_at)} – ${formatDate(lastOccursAt)}`
  : null;
// R5's left-rail column: a SHORT label (fits a 46px column), not the full
// weekday+month+day string dateLabel uses for the multi-date-run case --
// that longer string still renders, but as ordinary meta text, not
// squeezed into the rail.
const railLabel = item.occurs_at ? formatDayOnly(item.occurs_at) : null;
---
<article class="whats-on-row">
  <div class="whats-on-row__rail">
    {railLabel && <time class="whats-on-row__when data" datetime={item.occurs_at ?? undefined}>{railLabel}</time>}
  </div>
  <div class="whats-on-row__body">
    <h3 class="whats-on-row__title"><a href={href}>{e.title}</a></h3>
    <p class="whats-on-row__meta">
      <span class="kicker">{e.venueName ?? 'Venue TBA'}</span>
      {dateLabel && <span class="whats-on-row__daterange data">{dateLabel}</span>}
      {distance && <span class="whats-on-row__distance">{distance}</span>}
      {e.priceRangeText && <span class="whats-on-row__price">{e.priceRangeText}</span>}
    </p>
  </div>
</article>

<style>
.whats-on-row {
  display: flex;
  gap: 0.875rem;
  padding-block: 0.75rem;
  border-bottom: 0.5px solid var(--rule);
}
.whats-on-row:last-child { border-bottom: 0; }
.whats-on-row__rail {
  flex: 0 0 46px;
  width: 46px;
  padding-top: 0.1875rem;
}
.whats-on-row__when {
  font-size: 0.75rem;
  color: var(--ink-faint, var(--ink-soft));
  line-height: 1.3;
}
.whats-on-row__body { min-width: 0; flex: 1 1 auto; }
.whats-on-row__title { margin: 0 0 0.25rem; font-size: 1rem; line-height: 1.3; font-family: var(--font-head); }
.whats-on-row__title a { color: var(--ink); text-decoration: none; }
.whats-on-row__title a:hover { text-decoration: underline; }
.whats-on-row__meta {
  display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 0.375rem 0.625rem; margin: 0; font-size: 0.8125rem; color: var(--ink-soft);
}
.whats-on-row__daterange { font-size: 0.75rem; }
.whats-on-row__distance { font-size: 0.8125rem; }
.whats-on-row__price { font-size: 0.8125rem; }
</style>

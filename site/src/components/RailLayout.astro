---
/** RailLayout (Fas 2): the main column and a right rail from 62rem; one column below that, in source order (the mobile order does not change).
 *  Slots, in source order: `lead` (the front page's lead), `now` (Right Now), default (the main column), `rail` (the aside) and `after`
 *  (the rest of the main column). From 62rem: main ≈ 2fr, rail ≈ 1fr (min 18rem); the lead spans the first two rows so the rail column
 *  (Right Now, then the rail) starts level with the lead, and the rail's extra height goes into the last row's 1fr track only, so the main
 *  column never gets a gap. Not sticky. An empty `rail` slot (no module has data) gives no aside and the main column takes the full width. */
const hasRail = Astro.slots.has('rail');
const hasNow = Astro.slots.has('now');
const hasLead = Astro.slots.has('lead');
const hasAfter = Astro.slots.has('after');
const railHtml = hasRail ? (await Astro.slots.render('rail')).trim() : '';
const nowHtml = hasNow ? (await Astro.slots.render('now')).trim() : '';
const withSide = railHtml !== '' || nowHtml !== '';
---
<div class:list={['rail-layout', withSide && 'rail-layout--side']}>
  {hasLead && <div class="rail-layout__lead"><slot name="lead" /></div>}
  {nowHtml !== '' && <div class="rail-layout__now"><Fragment set:html={nowHtml} /></div>}
  <div class="rail-layout__main"><slot /></div>
  {railHtml !== '' && <aside class="rail-layout__rail" aria-label="At a glance"><Fragment set:html={railHtml} /></aside>}
  {hasAfter && <div class="rail-layout__after"><slot name="after" /></div>}
</div>
<style>
  .rail-layout__rail { display: flex; flex-direction: column; gap: var(--ui-4, 1rem); margin-bottom: 1.75rem; }
  .rail-layout__main, .rail-layout__lead, .rail-layout__after { min-width: 0; }
  @media (min-width: 62rem) {
    .rail-layout--side {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: 2rem;
      align-items: start;
    }
    .rail-layout--side > .rail-layout__lead { grid-column: 1; grid-row: 1 / span 2; }
    .rail-layout--side > .rail-layout__now { grid-column: 2; grid-row: 1; }
    .rail-layout--side > .rail-layout__main { grid-column: 1; grid-row: 3; }
    .rail-layout--side > .rail-layout__rail { grid-column: 2; grid-row: 2 / -1; }
    .rail-layout--side > .rail-layout__after { grid-column: 1; grid-row: 4; }
    /* Without a lead the main column starts at the top, beside Right Now and the rail. */
    .rail-layout--side:not(:has(> .rail-layout__lead)) > .rail-layout__main { grid-row: 1 / span 3; }
    .rail-layout--side:not(:has(> .rail-layout__now)) > .rail-layout__rail { grid-row: 1 / -1; }
  }
</style>

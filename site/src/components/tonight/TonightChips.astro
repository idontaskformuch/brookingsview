---
/** The area chips: region names only, no numbers (the header's count is events; a chip's count would be events + Open late and the two
 *  would disagree). `plan` says which chips show and whether the row shows at all (lib/tonight-cards.ts chipPlan); the browser re-plans from
 *  the live clock. Rendered by the library's Chips; the sticky placement is Tonight's own (TonightStyles .tc-chips). */
import Chips from '../ui/Chips.astro';
import type { ChipPlan } from '../../lib/tonight-cards';

interface Props { order: string[]; plan: ChipPlan }
const { order, plan } = Astro.props;
---
<Chips class="tc-chips" label="Filter by area" dataKey="tc-chip" navAttrs={{ 'data-tc-chips': '' }} plan={{ order, visible: plan.visible, showRow: plan.showRow }} />

---
/** The events of one evening as the date-tile list with the start time in the tile slot (components/pop/PopEventList.astro, no pictures), time order,
 *  the category as a dot. Each row keeps the hooks the browser script filters and counts by (data-card, data-id, data-area, data-scope, data-big;
 *  lib/tonight-cards-client.ts), inside a [data-tc-rows] list. Then the Open tonight row (open after 18:00, "Open until 23:00" as the big line where the
 *  hours are recent enough, otherwise no time): places, not events, so they stay as swipe cards. */
import TonightCard from './TonightCard.astro';
import PopEventList from '../pop/PopEventList.astro';
import type { EveningEntry } from '../../lib/evening-items';
import { groupLabel } from '../../lib/evening-items';
import type { OpenLateRow } from '../../lib/osm-open-late';
import { OPEN_LATE_MAX_ROWS } from '../../lib/osm-open-late';
import { eveningPopDays } from '../../lib/pop-days';
import { bucketOf, isBigShow, cityScope, regionOf, type CardTown, type Regions } from '../../lib/tonight-cards';

interface Props { id: string; entries: EveningEntry[]; late: OpenLateRow[]; tz: string; regions?: Regions; town: CardTown; osmChecked: string; /** The first evening says "Open tonight", the next one "Open tomorrow night". */ tonight?: boolean }
const { id, entries, late, tz, regions = {}, town, osmChecked, tonight = true } = Astro.props;
const lateRows = late.slice(0, OPEN_LATE_MAX_ROWS);
const attrsOf = (e: EveningEntry) => ({
  'data-card': '', 'data-id': e.id, 'data-bucket': bucketOf(e.group), 'data-area': regionOf(e.area, regions) ?? undefined,
  'data-scope': town.cityLabels ? cityScope(e.venueCity, town.homeCity) : undefined, 'data-big': isBigShow(e, town.bigShows) ? '1' : undefined,
  'data-group': e.group ? groupLabel(e.group, town.country) : '',
});
const days = eveningPopDays(entries, tz, town.country, attrsOf);
---
{entries.length > 0 && (
  <section class="tc-events" aria-label="Events">
    <PopEventList days={days} tile="time" idPrefix={id} listAttrs={{ 'data-tc-rows': '', 'data-hide-ended': '' }} />
  </section>
)}
{lateRows.length > 0 && (
  <section class="tc-cat" data-tc-cat data-bucket="late" style="--c: var(--tc-late)" aria-labelledby={`${id}-late`}>
    <header class="tc-cat-head">
      <h3 id={`${id}-late`}>{tonight ? 'Open tonight' : 'Open tomorrow night'} <span class="tc-cat-count" data-tc-cat-count>{lateRows.length}</span></h3>
      <button type="button" class="tc-all" data-tc-toggle aria-expanded="false" hidden>See all</button>
    </header>
    <ul class="tc-row tc-row--late" data-tc-rows data-hide-ended>
      {lateRows.map((p) => <TonightCard town={town} place={p} tz={tz} region={regionOf(p.area, regions)} />)}
    </ul>
    <p class="tc-attr">Hours © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>, read {osmChecked}.</p>
  </section>
)}

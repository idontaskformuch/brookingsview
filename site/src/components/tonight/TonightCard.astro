---
/** One Open tonight card of /tonight (spec .claude/specs/tonight-cards.md): a place, not an event (events are rows of the date-tile list, see TonightRows).
 *  The whole card is the link. The big line is the closing time; the category colour is the top edge and the tag. */
import { bucketLabel, BUCKET_CATEGORY, type CardTown } from '../../lib/tonight-cards';
import Card from '../ui/Card.astro';
import type { OpenLateRow } from '../../lib/osm-open-late';

interface Props { place: OpenLateRow; tz: string; /** Coarse area the chips filter by (lib/tonight-cards.ts regionOf); null = only under All. */ region?: string | null; town: CardTown }
const { place, region = null, town } = Astro.props;
const meta = [place.kind, place.area].filter(Boolean).join(' · ');
const cat = BUCKET_CATEGORY.late;
---
<li class="tc-card" data-card data-bucket="late" data-id={place.osmId} data-start={place.start} data-end={place.end ?? undefined} data-area={region ?? undefined}
  data-late="" style="--c: var(--tc-late)">
  <Card cat={cat ?? undefined} neutral={!cat} href={place.website ?? undefined} class="tc-link">
    {place.closing && <span class="tc-time" data-tc-time>{place.closing}</span>}
    <span class="tc-title">{place.name}</span>
    {meta && <span class="tc-meta">{meta}</span>}
    <span class="tc-foot">
      <span class="tc-tag">{bucketLabel('late', town.country)}</span>
    </span>
  </Card>
</li>

---
/** En post i nyhetsströmmen. Avdelad med hårfin linje, inte inramad som ett
 *  kort -- kortramar plattar ut hierarkin och får allt att se lika viktigt ut. */
import type { Story } from '../lib/db';
import { formatDate, formatTime, formatMeetingDate, CATEGORY_LABELS } from '../lib/db';
import ShareButtons from './ShareButtons.astro';
import { siteConfig } from '../lib/site-config';
import { categoryForSourceType, splitEventTitleAndVenue, type ImageCategory } from '../lib/images';
import { SECTION_THEME } from '../lib/section-theme';
import { relativeTime, dayTimeKicker } from '../lib/time';
import { storyHref } from '../lib/content-slugs';

// Dense card lists never render a per-item image (see NEEDS-HUMAN-REVIEW.md
// "Venue & Category Image Identity", rendering-rules table) -- a small
// colour chip + icon stands in for it instead, cheap enough to repeat 20+
// times on one page without the weight (or repetitiveness) of 20 identical
// category images. Deliberately not the same code path as resolveImage()'s
// tier 3: this is a lightweight visual hint, not a resolved image.
//
// Colors for the 5 categories that also have a section landing page (see
// NEEDS-HUMAN-REVIEW.md "Liveliness Spec" §3) are pulled from
// lib/section-theme.ts -- one color per concept across the site, not two
// independently-invented palettes that happen to both mean "traffic".
// Categories with no section identity keep their own standalone color --
// named here (consistency pass, 2026-09-10) rather than as bare hex in the
// CHIP map below, so a reader doesn't have to guess whether e.g. "#5c4a99"
// is arbitrary or a deliberate, remembered choice.
const JOBS_CHIP_COLOR = '#5c4a99'; // muted violet -- jobs has no SECTION_THEME entry to match
// Shared by sports AND school_alerts on purpose (both are "civic/community
// competitive-or-institutional maroon", neither has its own section page) --
// one named constant, not two copies of the same hex.
const MAROON_CHIP_COLOR = '#a1272f';

const CHIP: Partial<Record<ImageCategory, { icon: string; color: string }>> = {
  city_hall: { icon: '🏛️', color: 'var(--navy)' },
  events: { icon: '📅', color: SECTION_THEME.events.accent },
  traffic: { icon: '🚗', color: SECTION_THEME.traffic.accent },
  home_sales: { icon: '🏠', color: SECTION_THEME.home_sales.accent },
  jobs: { icon: '💼', color: JOBS_CHIP_COLOR },
  sports: { icon: '🏈', color: MAROON_CHIP_COLOR },
  school_alerts: { icon: '🎒', color: MAROON_CHIP_COLOR },
  weather_alert: { icon: '⚠️', color: 'var(--alert)' },
  workplace_watch: { icon: '🏭', color: SECTION_THEME.workplace_watch.accent },
  university: { icon: '🎓', color: SECTION_THEME.university.accent },
};

interface Props {
  story: Story;
  compact?: boolean;
  /** Extern länk-override -- för adapterade icke-story-poster (t.ex. SDSU
   *  arts_culture-events, se events.astro) som inte har en egen /s/[slug]-
   *  sida att länka till. Satt: titel/bild länkar hit i stället, och
   *  ShareButtons (som delar sajtens EGEN /s/slug-URL) hoppas över, se
   *  nedan. */
  href?: string;
  /** Kicker-override -- för samma adapterade poster, som inte har en
   *  meningsfull source_type att härleda en kicker-etikett ur. */
  kicker?: string;
}
const { story, compact = false, href: hrefOverride, kicker: kickerOverride } = Astro.props;
const href = hrefOverride ?? storyHref(story.slug);
const isExternal = Boolean(hrefOverride);
const shareUrl = new URL(storyHref(story.slug), siteConfig.siteUrl).href;

const isAlert = story.source_type === 'alert';
const isMeeting = story.source_type === 'meeting' || story.source_type === 'meeting_followup';
const isEvent = story.source_type === 'event';
// 2026-10-02, item C4: strip a "{Town}: " / "{VENUE IN CAPS}: " prefix from
// an event's displayed title (confirmed live: 1,063 of 1,068 Moreno Valley
// event titles carry one) -- see splitEventTitleAndVenue()'s own doc
// comment for why this is scoped to events only (a non-event title's own
// colon punctuation, e.g. a movie review's "Spider-Man: Brand New Day",
// must never be mangled). The venue renders as its own line below the
// title instead of staying silently baked into it.
const { displayTitle, venue } = isEvent
  ? splitEventTitleAndVenue(story.title, siteConfig.cityName)
  : { displayTitle: story.title, venue: null };
// Content Track-innehåll (krönikor, recensioner, recept m.fl.) har alltid byline
// satt -- occurs_at är bara now() vid genereringstillfället för de typerna, så
// den ska aldrig användas som tidsangivelse. Publiceringsdatum är den rätta.
const hasByline = Boolean(story.byline);
const when = story.occurs_at;
const now = new Date();
// Relative time language (see NEEDS-HUMAN-REVIEW.md "Liveliness Spec" §2):
// applied to content-track published_at and event/announcement occurs_at,
// both real timestamptz instants. TWO deliberate exceptions, per §2's own
// rules:
//   - alerts keep their exact date/time, never relative-formatted -- §2:
//     "Never relative-format an alert's effective window."
//   - meetings keep formatMeetingDate(), NOT relativeTime() -- relativeTime()'s
//     zoned calendar-day math assumes a genuine instant, which is only true
//     for SOME towns' meeting_date (see siteConfig.meetingsHaveTime and
//     formatMeetingDate()'s own comment in db.ts: Brookings/Legistar's is a
//     bare UTC-midnight calendar date with no real time-of-day, Broomfield/
//     Moreno Valley's is a real tz-aware instant). Timezone-converting a
//     bare calendar date (or failing to convert a real one) has been a
//     repeated real bug in this codebase (events.astro, weekly.py, the
//     Legistar parser, the AgendaLink parser all hit some version of it).
// published_at is typed as always-set (`string`, not `string | null`), but
// real data has NULL rows for some content-track stories -- confirmed live
// (2026-08-26): 10+ culture_essay/editorial/vardagsmiddag rows on Moreno
// Valley alone. The old formatDate(story.published_at) tolerated this
// silently (its own `if (!value) return ''` guard) -- relativeTime() has
// no such guard (a null `date` isn't `typeof 'string'`, so it's passed
// through as null and crashes on `.getTime()`), so the call site needs the
// same explicit guard formatDate's caller got for free.
// 2026-10-02, item C1: an event's own kicker is dayTimeKicker()'s absolute
// "{DAY} · {TIME}" ("Thu · 7:30 PM"), not relativeTime()'s relative prose --
// see that function's own doc comment for why a dense list is scanned, not
// read. Also sidesteps item C2 for events specifically: an absolute
// day+time never says "just now" in the first place, so the narrower
// in-progress check only still matters for the final relativeTime() branch
// below (non-event, non-meeting, non-alert rows with an occurs_at, e.g.
// announcements) -- story.ends_at is threaded through there too.
const timeLabel = hasByline
  ? (story.published_at ? relativeTime(story.published_at, now, siteConfig.timezone) : '')
  : !when
    ? ''
    : isMeeting
      ? formatMeetingDate(when)  // meetingsHaveTime-medveten -- se db.ts
      : isAlert
        ? `${formatDate(when)}${formatTime(when) ? ` · ${formatTime(when)}` : ''}`
        : isEvent
          ? dayTimeKicker(when, siteConfig.timezone)
          : relativeTime(when, now, siteConfig.timezone, story.ends_at);
// .toISOString(), not a raw passthrough of the source value: the DB driver
// returns a real Date object for timestamptz columns at runtime despite
// the `string` type annotation in db.ts. Passed straight into
// datetime={...}, Astro just calls the value's default toString(), which
// for a Date renders in the BUILD MACHINE's own local timezone ("Thu Aug
// 27 2026 02:00:00 GMT+0200 (...)"), not a valid machine-readable value.
// relativeTime() above already tolerates either shape internally
// (`typeof date === 'string' ? new Date(date) : date`), so only this raw
// attribute value needed normalizing.
const timeSource = hasByline ? story.published_at : when;
const timeMachineValue = timeSource ? new Date(timeSource).toISOString() : null;

// R4 (sitewide presentation-layer pass): a plain 'event' row's kicker used
// to say the literal word "Events" -- zero differentiating information,
// exactly the handoff's own "EVENTS, EVENTS, EVENTS" example, since every
// page that lists these rows already establishes "this is about events" via
// its own heading/SectionRule. Every OTHER kicker value below still carries
// REAL information in a mixed list -- a meeting reads differently from an
// event; a content-track category; an explicit per-caller override (e.g.
// events.astro's "Arts & Culture" vs "Around Town" distinguishing two real
// sub-groups on the SAME page) -- so only the generic fallback is dropped,
// nothing else. `null` here means "no kicker line at all" for that row, not
// an empty string.
const kicker = kickerOverride ?? (isAlert ? 'Alert' : isMeeting ? 'City hall'
  : hasByline ? (CATEGORY_LABELS[story.source_type] ?? 'Feature') : null);

// The chip is the SAME information as `kicker`, just as a colored dot --
// showing one without the other would just move the redundancy from text
// to color, so it's gated on `kicker` being present too.
const chip = kicker ? (CHIP[categoryForSourceType(story.source_type) as ImageCategory] ?? null) : null;
---
<article class:list={['item', { 'item--alert': isAlert }]}>
  {/* 2026-10-02, item C1: the 46px fixed-width time RAIL (R5) is gone --
      it collided with long titles (confirmed on real Moreno Valley titles,
      which run longer once a venue line is no longer baked into them, see
      C4 above) and, per its own now-removed comment, already needed a
      mobile-only escape hatch for the exact same reason. Every row
      (alert or not) now shares ONE kicker-line-above-title structure --
      the alert branch already looked like this; this just generalizes it,
      so there's one layout to reason about instead of two. */}
  <p class="item__kicker">
    {chip && <span class="item__chip" style={`--chip-color: ${chip.color}`} aria-hidden="true">{chip.icon}</span>}
    {kicker && <span class="kicker">{kicker}</span>}
    {timeLabel && timeMachineValue && (
      <time class="item__when data" datetime={timeMachineValue}>{timeLabel}</time>
    )}
  </p>
  <h3 class="item__title"><a href={href} rel={isExternal ? 'noopener' : undefined}>{displayTitle}</a></h3>
  {venue && <p class="item__venue data">{venue}</p>}
  {!compact && <p class="item__body">{story.body}</p>}
  {!compact && hasByline && !isExternal && (
    <ShareButtons url={shareUrl} title={story.title} />
  )}
</article>

<style>
.item {
  border-bottom: 1px solid var(--rule);
  padding-block: 0.875rem;
}
.item:first-child { padding-top: 0; }
.item--alert {
  border-left: 4px solid var(--alert);
  background: var(--alert-tint);
  padding: 0.875rem 1rem;
  border-bottom: 0;
  margin-bottom: 0.75rem;
}
.item--alert .kicker { color: var(--alert); }

/* 2026-10-02, item C1: R5's fixed-width 46px rail is gone (see the
   template's own comment) -- every row, alert or not, is single-column
   now: a kicker line (chip + category + day/time), then the title, same
   structure the alert branch already used. No per-row-type width/layout
   split left to maintain, and nothing left to collide with a long title. */
.item__kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.5rem 0.75rem;
  margin: 0 0 0.3125rem;
}
.item__chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  font-size: 0.75rem;
  line-height: 1;
  border-radius: 50%;
  background: color-mix(in srgb, var(--chip-color) 15%, transparent);
}
.item__when {
  font-size: 0.8125rem;
  color: var(--ink-faint, var(--ink-soft));
}
.item__title { margin: 0; font-size: 1.1875rem; line-height: 1.15; }
.item__title a { color: inherit; text-decoration: none; }
.item__title a:hover { color: var(--navy); text-decoration: underline; }
/* 2026-10-02, item C4: the venue line a stripped "VENUE IN CAPS:" title
   prefix becomes -- same visual weight as item__body's own color, placed
   between title and body so it reads as "where", not as part of the name. */
.item__venue {
  margin: 0.125rem 0 0;
  font-size: 0.8125rem;
  color: var(--ink-soft);
}
.item__body {
  margin: 0.375rem 0 0;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--ink-soft);
}
</style>

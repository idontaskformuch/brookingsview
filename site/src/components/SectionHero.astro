---
/** Hero image for a section landing page (/events/, /today/, /city-hall/,
 *  /closures/, /farm-report/, ...). The image comes from lib/section-hero.ts's
 *  getSectionHero(): the same seasonal / holiday rotation as the homepage's
 *  "This week" image, never the homepage's own image that week, and a
 *  different image per section. The section's curated category photo is only
 *  a reserve for a date whose pool is empty; with neither, the build fails.
 */
import { getSectionHero, type HeroSection } from '../lib/section-hero';
import { resolveThisWeekImage } from '../lib/db';
import { weekInfoForInstant } from '../lib/this-week';
import { seasonForMonth } from '../lib/this-week-images';
import { thisWeekImagesFor } from '../config/this-week-images';
import { siteConfig } from '../lib/site-config';
import ImageAttribution from './ImageAttribution.astro';

interface Props { section: HeroSection; /** A shorter hero for pages where the content must start near the top (/today). */ compact?: boolean; }
const { section, compact = false } = Astro.props;

const now = new Date();
const week = weekInfoForInstant(now, siteConfig.timezone);
// The homepage's pick for this exact week (history-backed, persisted) -- read
// so a section can never show the same picture as the homepage that week.
// A pre-launch town (SiteConfig.noindexSite) with no photo pool yet shows no hero at all, rather than failing
// the build (resolveThisWeekImage throws on an empty pool by design for launched towns).
const noPool = !!siteConfig.noindexSite && thisWeekImagesFor(siteConfig.townId).length === 0;
const homepage = noPool ? null : await resolveThisWeekImage(
  week.slug, seasonForMonth(week.monday.m), thisWeekImagesFor(siteConfig.townId), week.monday, week.sunday,
);
const image = homepage
  ? getSectionHero(siteConfig.townId, section, now, { timezone: siteConfig.timezone, homepageImageId: homepage.id }).image
  : null;
---
{image && (
  <>
    <img
      class:list={['section-hero', { 'section-hero--compact': compact }]}
      src={image.path}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="eager"
      decoding="async"
    />
    <ImageAttribution image={image} />
  </>
)}

<style>
.section-hero {
  display: block;
  width: 100%;
  height: auto;
  max-height: 22rem;
  object-fit: cover;
  border-radius: 0.375rem;
  margin: 0 0 1.25rem;
}
.section-hero--compact { max-height: 14rem; }
/* On a phone the hero must never push the page content off the first screen:
   at most about a third of the viewport height (svh = small viewport, so the
   browser toolbar does not change it), a fifth for the compact /today one. */
@media (max-width: 640px) {
  .section-hero { max-height: 32vh; max-height: 32svh; }
  .section-hero--compact { max-height: 20vh; max-height: 20svh; }
}
</style>

---
/** Shared template for the holiday pages (/thanksgiving/ now; /christmas/, /new-years/, /hogmanay/ later).
 *  Rendered from data only (lib/holiday-page.ts): one table per section with What / Details / Source / Checked,
 *  an empty section is not rendered, no introduction. Owner-ordered 2026-11-04, .claude/specs/holiday-layer.md.
 *
 *  Resident question it answers: what is open, closed or changed around this holiday, and where do I check
 *  what is not confirmed yet? */
import BaseLayout from '../layouts/BaseLayout.astro';
import HolidayTable from './HolidayTable.astro';
import { siteConfig } from '../lib/site-config';
import {
  SECTION_ORDER, sectionHeading, buildHolidayMeta, buildHolidayEventsJsonLd, lastChecked, formatIsoDate,
  eventWhenWhere, regularHours, type HolidayPageData, type HolidayFact, type HolidayEvent, type HolidayRow,
} from '../lib/holiday-page';

interface Props {
  page: HolidayPageData;
  /** "Thanksgiving" */
  holidayLabel: string;
  noindex?: boolean;
  /** Link to /closures/ (towns with a closure watch). */
  hasClosures?: boolean;
}
const { page, holidayLabel, noindex = false, hasClosures = false } = Astro.props;

const meta = buildHolidayMeta(page, holidayLabel, siteConfig.cityName);
const checked = lastChecked(page);
const jsonLd = buildHolidayEventsJsonLd(page, siteConfig.timezone, siteConfig.country === 'gb' ? 'GB' : 'US');
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl).href;
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: meta.title,
  url: pageUrl,
  dateModified: checked,
};

const year = page.year;
const ungrouped = page.linkOnly.filter((l) => !l.group);
const groups = [...new Set(page.linkOnly.flatMap((l) => (l.group ? [l.group] : [])))];
const hours = regularHours(page);
const sections = SECTION_ORDER.map((id) => ({
  id,
  heading: sectionHeading(id, page.locale),
  facts: id === 'events' ? [] : page.facts.filter((f) => f.section === id),
  events: id === 'events' ? page.events : [],
})).filter((s) => s.facts.length > 0 || s.events.length > 0);

const factRow = (f: HolidayFact): HolidayRow => ({
  what: f.label, value: f.status === 'confirmed' ? f.value : null, clarify: f.clarify,
  usual: f.status === 'unconfirmed' ? f.usual : undefined,
  lastYear: f.status === 'unconfirmed' ? f.lastYear : undefined,
  checkAt: f.status === 'unconfirmed' ? f.checkAt : undefined,
  source: f.source, checkedOn: f.checkedOn,
});
const eventRow = (e: HolidayEvent): HolidayRow => ({
  what: e.name, value: e.status === 'confirmed' ? eventWhenWhere(e, page.locale) : null, clarify: e.clarify,
  extra: e.status === 'confirmed' ? e.details : undefined,
  lastYear: e.status === 'unconfirmed' ? e.lastYear : undefined,
  checkAt: e.status === 'unconfirmed' ? e.checkAt : undefined,
  source: e.source, checkedOn: e.checkedOn,
});
---
<BaseLayout title={meta.title} description={meta.description} wide noindex={noindex} modified={checked}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(webPage)} />
  {jsonLd.map((ld) => <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ld)} />)}

  <header class="hp-head">
    <h1>{meta.h1}</h1>
    <p class="hp-checked">Last checked: <time datetime={checked}>{formatIsoDate(checked, true, page.locale)}</time></p>
  </header>

  {sections.map((s) => (
    <section aria-labelledby={`hp-${s.id}`}>
      <h2 id={`hp-${s.id}`}>{s.heading}</h2>
      <HolidayTable rows={s.id === 'events' ? s.events.map(eventRow) : s.facts.map(factRow)} year={year} locale={page.locale} />
    </section>
  ))}

  {(page.linkOnly.length > 0 || page.related.length > 0 || hours.length > 0) && (
    <section aria-labelledby="hp-more">
      <h2 id="hp-more">More</h2>
      {hours.length > 0 && (
        <>
          <h3>Regular hours</h3>
          <HolidayTable rows={hours.map(factRow)} year={year} locale={page.locale} />
        </>
      )}
      {groups.map((g) => (
        <>
          <h3>{g}</h3>
          <ul class="hp-links">
            {page.linkOnly.filter((l) => l.group === g).map((l) => <li>{l.label}: <a href={l.url} rel="noopener">{l.linkText}</a></li>)}
          </ul>
        </>
      ))}
      <ul class="hp-links">
        {ungrouped.map((l) => <li>{l.label}: see the <a href={l.url} rel="noopener">{l.linkText}</a></li>)}
        {page.related.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {hasClosures && <li><a href="/closures/">School closures</a></li>}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hp-head h1 { margin-bottom: 0.25rem; }
  .hp-checked { margin: 0 0 1.25rem; font-size: 0.9rem; color: var(--ink-soft); }
  section { margin: 0 0 1.75rem; }
  h3 { font-size: 1.0625rem; margin: 0 0 0.4rem; }
  .hp-links { padding-left: 1.1rem; }
  .hp-links li { margin: 0.35rem 0; }
</style>

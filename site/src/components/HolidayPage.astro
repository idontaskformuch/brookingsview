---
/** Shared template for the holiday pages (/thanksgiving/, /veterans-day/, /christmas/), built on the ui/ library and rendered
 *  from data only (lib/holiday-page.ts for the data, lib/holiday-view.ts for the view): hero "<Holiday> is <weekday>" with
 *  the number of places closed, then the rows grouped Closed / Schedule changes / Open as usual / Good to know / Events /
 *  Not confirmed yet. No tables, no repeated source or check date per row; sources once at the bottom, "Last checked" once
 *  under the heading. Owner-ordered 2026-11-04 (.claude/specs/holiday-layer.md), rebuilt 2026-11-06 (.claude/standards.md "Helgsidor").
 *
 *  Resident question it answers: what is open, closed or changed around this holiday, and where do I check
 *  what is not confirmed yet? */
import BaseLayout from '../layouts/BaseLayout.astro';
import HolidayRows from './HolidayRows.astro';
import HeroStat from './ui/HeroStat.astro';
import InsightLine from './ui/InsightLine.astro';
import SectionHeader from './ui/SectionHeader.astro';
import AboutThisPage from './ui/AboutThisPage.astro';
import { siteConfig } from '../lib/site-config';
import { countryProfile } from '../lib/country-profile';
import {
  buildHolidayMeta, buildHolidayEventsJsonLd, lastChecked, formatIsoDate, localToday, type HolidayPageData,
} from '../lib/holiday-page';
import { buildGroups, regularHoursRows, holidayHero, holidayInsights, groupSources } from '../lib/holiday-view';
import { evergreenLines, occurrenceDay, type HolidayPageState } from '../lib/holiday-calendar';
import type { HolidayPageDef } from '../config/holiday-pages/calendar';

interface Props {
  page: HolidayPageData;
  def: HolidayPageDef;
  /** Active = this season's wording; evergreen = the same facts under a standing, year-free title. Never noindex. */
  state: Extract<HolidayPageState, { kind: 'active' | 'evergreen' }>;
  /** Link to /closures/ (towns with a closure watch). */
  hasClosures?: boolean;
}
const { page, def, state, hasClosures = false } = Astro.props;
const evergreen = state.kind === 'evergreen';
const lines = state.kind === 'evergreen' ? evergreenLines(def, page.year, state, page.locale) : null;
const today = localToday(Date.now(), siteConfig.timezone);

const meta = buildHolidayMeta(page, def.label, siteConfig.cityName, evergreen);
const checked = lastChecked(page);
const jsonLd = buildHolidayEventsJsonLd(page, siteConfig.timezone, countryProfile(siteConfig.country).addressCountry, today);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl).href;
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: meta.title,
  url: pageUrl,
  dateModified: page.dataUpdatedOn,
};

const hero = holidayHero(page, def.label, occurrenceDay(def, page.year), today);
const insights = holidayInsights(page);
const groups = buildGroups(page, today);
const hours = regularHoursRows(page);
const ungrouped = page.linkOnly.filter((l) => !l.group);
const linkGroups = [...new Set(page.linkOnly.flatMap((l) => (l.group ? [l.group] : [])))];
const sources = groupSources(page);
---
<BaseLayout title={meta.title} description={meta.description} wide modified={page.dataUpdatedOn}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(webPage)} />
  {jsonLd.map((ld) => <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ld)} />)}

  <header class="hp-title">
    <h1>{meta.h1}</h1>
    <p class="hp-checked">Last checked <time datetime={checked}>{formatIsoDate(checked, true, page.locale)}</time></p>
  </header>

  <HeroStat value={hero.value} unit={hero.unit} label={hero.label} sub={hero.sub} tone="accent" />
  {insights.map((line) => <InsightLine>{line}</InsightLine>)}
  {lines && (
    <p class="hp-state">
      {lines.note && <>{lines.note}<br /></>}
      {lines.next}
    </p>
  )}

  {groups.map((g) => (
    <section class="hp-group" aria-label={g.heading}>
      <SectionHeader title={g.heading} />
      <HolidayRows rows={g.rows} locale={page.locale} />
    </section>
  ))}

  {(page.linkOnly.length > 0 || page.related.length > 0 || hours.length > 0 || hasClosures) && (
    <section class="hp-group" aria-label="More">
      <SectionHeader title="More" />
      {hours.length > 0 && (
        <>
          <SectionHeader title="Regular hours" level={3} />
          <HolidayRows rows={hours} locale={page.locale} />
        </>
      )}
      {linkGroups.map((g) => (
        <>
          <SectionHeader title={g} level={3} />
          <ul class="hp-links">
            {page.linkOnly.filter((l) => l.group === g).map((l) => <li>{l.label}: <a href={l.url} rel="noopener">{l.linkText}</a></li>)}
          </ul>
        </>
      ))}
      <ul class="hp-links">
        {ungrouped.map((l) => <li>{l.label}: see the <a href={l.url} rel="noopener">{l.linkText}</a></li>)}
        {page.related.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {hasClosures && <li><a href="/closures/">School closures</a></li>}
      </ul>
    </section>
  )}

  <AboutThisPage sources={sources} />
</BaseLayout>

<style>
  .hp-title h1 { margin-bottom: 0.25rem; }
  .hp-checked { margin: 0 0 var(--ui-3); font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .hp-state { margin: var(--ui-3) 0 0; font-family: var(--font-ui); font-size: var(--ui-meta); color: var(--ink-soft); }
  .hp-group { margin: var(--ui-group-gap) 0 0; }
  .hp-links { padding-left: 1.1rem; font-family: var(--font-ui); }
  .hp-links li { margin: 0.35rem 0; }
</style>

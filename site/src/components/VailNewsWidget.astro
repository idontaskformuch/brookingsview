---
/** Front-page promo card for the Vail Resorts newsroom feed, see
 *  /vail-resorts. Broomfield only -- caller (index.astro) decides whether
 *  to render at all, same convention as WorkplaceWatchWidget.astro.
 *
 *  Text-only, deliberately never rendering item.image_url (2026-09-10):
 *  that field is a hotlinked Vail Resorts CDN URL, and Vail Resorts'
 *  newsroom carries a blanket "All Rights Reserved" notice with no stated
 *  hotlink/embed permission anywhere -- the same "no expressed permission
 *  means no permission" call already made for Street View earlier this
 *  session. Same "omit rather than risk it" rule already applied to
 *  facility photos and content-track illustrations. A real photo may come
 *  back once someone has actually emailed Vail Resorts' media contact and
 *  gotten a yes -- see NEEDS-HUMAN-REVIEW.md. Until then this renders an
 *  icon, same treatment as the other three promo cards. */
import type { VailNewsItem } from '../lib/db';

interface Props { item: VailNewsItem; }
const { item } = Astro.props;
---

<a href="/vail-resorts/" class="vnw-widget" aria-label="See Vail Resorts Newsroom: the company's own news feed">
  <div class="vnw-icon" aria-hidden="true">🏔️</div>
  <div class="vnw-text">
    <div class="vnw-label">Vail Resorts Newsroom</div>
    <div class="vnw-title">{item.title}</div>
    <div class="vnw-date data">{item.published_label}</div>
  </div>
</a>

<style>
  /* Consistency pass (2026-09-10) -- previously unreported instance of the
     same saturated-gradient pattern found and fixed sitewide (Jackrabbit/
     BurroBonanza/WorkplaceWatch widgets) -- see JackrabbitWidget.astro's
     identical comment. */
  .vnw-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .vnw-widget:hover { border-color: var(--rule-strong); }
  .vnw-icon { font-size: 1.5rem; flex-shrink: 0; }
  .vnw-text { flex: 1; min-width: 0; }
  .vnw-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .vnw-title {
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.25;
    margin-top: 0.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .vnw-date { font-size: 0.75rem; color: var(--ink-soft); margin-top: 0.1875rem; }
</style>

---
/** Front-page promo card for the Vail Resorts newsroom feed, see
 *  /vail-resorts. Broomfield only -- caller (index.astro) decides whether
 *  to render at all, same convention as WorkplaceWatchWidget.astro.
 *
 *  Unlike StoryCard.astro's dense list (which deliberately never shows a
 *  per-item image, see that file's own comment), this is a SINGLE item, so
 *  a thumbnail earns its place. image_url is a hotlinked Vail Resorts CDN
 *  URL, may be null (rendered text-only when absent -- see vail-resorts.astro
 *  for why this never falls back to the OG card as a substitute hero). */
import type { VailNewsItem } from '../lib/db';

interface Props { item: VailNewsItem; }
const { item } = Astro.props;
---

<a href="/vail-resorts/" class="vnw-widget" aria-label="See Vail Resorts Newsroom: the company's own news feed">
  {item.image_url ? <img class="vnw-thumb" src={item.image_url} alt="" loading="lazy" /> : <div class="vnw-icon" aria-hidden="true">🏔️</div>}
  <div class="vnw-text">
    <div class="vnw-label">Vail Resorts Newsroom</div>
    <div class="vnw-title">{item.title}</div>
    <div class="vnw-date data">{item.published_label}</div>
  </div>
</a>

<style>
  /* Consistency pass (2026-09-10) -- previously unreported instance of the
     same saturated-gradient pattern found and fixed sitewide (Jackrabbit/
     BurroBonanza/WorkplaceWatch widgets) -- see JackrabbitWidget.astro's
     identical comment. */
  .vnw-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .vnw-widget:hover { border-color: var(--rule-strong); }
  .vnw-thumb {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .vnw-icon { font-size: 1.5rem; flex-shrink: 0; }
  .vnw-text { flex: 1; min-width: 0; }
  .vnw-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .vnw-title {
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.25;
    margin-top: 0.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .vnw-date { font-size: 0.75rem; color: var(--ink-soft); margin-top: 0.1875rem; }
</style>

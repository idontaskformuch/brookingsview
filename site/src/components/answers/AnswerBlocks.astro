---
/** Renders an answer's data blocks (config/city-answers/types.ts). Dated lines and seasons are resolved against the town's today at build
 *  time (pages are built twice a day). Inline text goes through lib/city-answers.ts inlineHtml (**bold**, [link](href), all else escaped). */
import type { AnswerBlock, AnswerFacility } from '../../config/city-answers/types';
import { inlineHtml, upcomingDated, seasonText } from '../../lib/city-answers';
import { facilityRows } from '../../lib/answer-facility';
import BrookingsTrashPicker from './BrookingsTrashPicker.astro';
import BrookingsTrashHolidays from './BrookingsTrashHolidays.astro';

interface Props { blocks: AnswerBlock[]; today: string; facility?: AnswerFacility }
const { blocks, today, facility } = Astro.props;
const COMPONENTS = { 'brookings-trash-picker': BrookingsTrashPicker, 'brookings-trash-holidays': BrookingsTrashHolidays } as const;
---
{blocks.map((b) => {
  if (b.kind === 'p') return <p class:list={[{ 'ans-note': b.note }]} set:html={inlineHtml(b.text)} />;
  if (b.kind === 'list') return <ul class={b.className}>{b.items.map((i) => <li set:html={inlineHtml(i)} />)}</ul>;
  if (b.kind === 'facts') return <dl class="ans-dl">{b.rows.map((r) => <><dt set:html={inlineHtml(r.label)} /><dd set:html={inlineHtml(r.value)} /></>)}</dl>;
  if (b.kind === 'table') return (
    <table class="ans-table">
      <caption class="sr-only">{b.caption}</caption>
      <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{b.rows.map((r) => <tr><th scope="row" set:html={inlineHtml(r.th)} />{r.cells.map((c) => <td set:html={inlineHtml(c)} />)}</tr>)}</tbody>
    </table>
  );
  if (b.kind === 'cols') return <div class="ans-cols">{b.cols.map((c) => <section><h3>{c.heading}</h3><Astro.self blocks={c.blocks} today={today} facility={facility} /></section>)}</div>;
  if (b.kind === 'dated') {
    const left = upcomingDated(b.items, today);
    return left.length > 0
      ? <>{b.intro && <p set:html={inlineHtml(b.intro)} />}<ul>{left.map((i) => <li set:html={inlineHtml(i.text)} />)}</ul></>
      : <p set:html={inlineHtml(b.none)} />;
  }
  // The page's `facility` as rows and as dated closed days: the same fields as its title and meta (lib/answer-facility.ts).
  if (b.kind === 'facility-facts' && facility) return <dl class="ans-dl">{facilityRows(facility).map((r) => <><dt set:html={inlineHtml(r.label)} /><dd set:html={inlineHtml(r.value)} /></>)}</dl>;
  if (b.kind === 'facility-closed' && facility) {
    const left = upcomingDated(facility.closed ?? [], today);
    return left.length > 0
      ? <>{b.intro && <p set:html={inlineHtml(b.intro)} />}<ul>{left.map((i) => <li set:html={inlineHtml(i.text)} />)}</ul></>
      : <p set:html={inlineHtml(b.none)} />;
  }
  if (b.kind === 'season') return <p class:list={[{ 'ans-note': b.note }]} set:html={inlineHtml(seasonText(b, today))} />;
  if (b.kind === 'component') { const C = COMPONENTS[b.name]; return <C />; }
  return null;
})}
<style>
  .ans-note { font-size: 0.9rem; max-width: 46rem; }
  .ans-table { border-collapse: collapse; width: 100%; max-width: 46rem; margin: 0 0 0.75rem; }
  .ans-table th, .ans-table td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--rule, #ddd); }
  @media (max-width: 30rem) { .ans-table th, .ans-table td { padding: 0.4rem 0.3rem; font-size: 0.875rem; overflow-wrap: anywhere; } }
  .ans-cols { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); max-width: 62rem; }
  .ans-cols h3 { margin: 0 0 0.4rem; }
  .ans-dl dt { font-weight: 600; margin-top: 1rem; }
  .ans-dl dd { margin: 0.25rem 0 0; max-width: 46rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

---
/** One schedule/results table for /jackrabbits. Rows come from lib/jackrabbits-view.ts; the wording from strings/{us,gb}/sports.json. */
import { formatDate, formatTime } from '../lib/db';
import type { GameRow } from '../lib/jackrabbits-view';
import type { SportTerms } from '../lib/sport-strings';

interface Props { rows: GameRow[]; terms: SportTerms; section: 'results' | 'schedule'; }
const { rows, terms, section } = Astro.props;
---
<table class="sched">
  <thead>
    <tr><th scope="col">Date</th><th scope="col">Opponent</th>
        <th scope="col" class="where">Where</th><th scope="col">Result</th></tr>
  </thead>
  <tbody>
    {rows.map((game) => (
      <tr data-sport={game.sport} data-start={game.startAt.toISOString()} data-tz={game.tz} data-status={game.status}
          data-tba={game.timeTba ? '1' : '0'} data-result={game.result ? '1' : '0'} data-section={section}>
        <td class="data">{formatDate(game.startAt.toISOString())} <span class="t">{game.timeTba ? terms.time_tba : formatTime(game.startAt.toISOString())}</span></td>
        <td>{game.prefix} {game.opponent}
          {game.exhibition && <span class="tag">{terms.exhibition}</span>}
          {game.neutralSite && <span class="tag">{terms.neutral_site}</span>}
        </td>
        <td class="where">{game.venue ?? '—'}</td>
        <td class="data" data-note>{game.result ?? (game.note ? terms[game.note] : '—')}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
.sched { width: 100%; border-collapse: collapse; background: var(--surface); font-size: 0.9375rem; }
.sched th {
  text-align: left;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  font-weight: 600;
  padding: 0.625rem 0.875rem;
  border-bottom: 1px solid var(--rule);
}
.sched td { padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
.sched tr:last-child td { border-bottom: 0; }
.sched .t { display: block; font-size: 0.75rem; color: var(--ink-soft); }
.tag {
  display: inline-block; margin-left: 0.375rem; padding: 0 0.375rem;
  font-family: var(--font-ui); font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--ink-soft); border: 1px solid var(--rule); border-radius: 2px; vertical-align: 0.05em;
}
.where { color: var(--ink-soft); font-size: 0.875rem; }
@media (max-width: 40rem) { .where { display: none; } }
/* Phone: the table was 7 px wider than the screen (QA web.hscroll); tighter cells that may wrap. */
@media (max-width: 30rem) { .sched th, .sched td { padding: 0.5rem 0.4rem; overflow-wrap: anywhere; } }
</style>

---
/** The top of /city-hall/: the next meeting as a hero ("in 5 days") with its agenda under it, then "This week" (the following 7 days) and
 *  "Coming up", with organ chips over the lists when there are enough meetings to filter. An organ group the town folds away (Glasgow's Area
 *  Partnerships) sits in one fold under the lists. With no meeting ahead: one designed line and a link to the town's own agenda page.
 *  The build knows "today" only as of the build, so a small script re-reads it from the clock: "in 5 days" stays right, a meeting that is over
 *  hides itself, and the chips filter the lists. Without JS everything shows. */
import SectionRule from '../SectionRule.astro';
import HeroStat from '../ui/HeroStat.astro';
import EmptyState from '../ui/EmptyState.astro';
import Chips from '../ui/Chips.astro';
import MeetingCard from './MeetingCard.astro';
import { daysBetween, relativeDays, chipCounts, meetingTitle, type MeetingView } from '../../lib/meetings-view';

interface Props {
  meetings: MeetingView[];
  todayYmd: string;
  timezone: string;
  commentBodyKeys: string[];
  commentHref: string | null;
  portal: { href: string; label: string } | null;
  emptyNote: string | null;
}
const { meetings, todayYmd, timezone, commentBodyKeys, commentHref, portal, emptyNote } = Astro.props;
const main = meetings.filter((m) => !m.collapsedGroup);
const folded = meetings.filter((m) => m.collapsedGroup);
// A quorum notice or a cancelled meeting is shown in the lists but never as the meeting to plan around.
const isReal = (m: MeetingView) => !m.quorumNotice && !m.cancelled && !m.postponed;
const next = main.find(isReal) ?? folded.find(isReal) ?? main[0] ?? folded[0];
const others = meetings.filter((m) => m !== next);
const week = others.filter((m) => !m.collapsedGroup && daysBetween(todayYmd, m.ymd) <= 7);
const later = others.filter((m) => !m.collapsedGroup && daysBetween(todayYmd, m.ymd) > 7);
const foldedOthers = others.filter((m) => m.collapsedGroup);
const foldGroups = [...new Set(foldedOthers.map((m) => m.collapsedGroup!))];
const hrefFor = (m: MeetingView) => (commentHref && commentBodyKeys.includes(m.bodyKey) ? commentHref : null);
const nextEnd = next?.startMs != null ? next.startMs + 3 * 3_600_000 : null;
---
<section class="up" data-mtg-root data-tz={timezone}>
  <SectionRule label="Next up" />
  {next ? (
    <article class="up__next" data-ymd={next.ymd} data-end={nextEnd ?? undefined}>
      <HeroStat
        label={meetingTitle(next)}
        value={relativeDays(daysBetween(todayYmd, next.ymd))}
        sub={`${next.dateLabel}${next.time ? ` · ${next.time}` : ''}`}
        meta={next.location ?? undefined}
        valueAttrs={{ 'data-mtg-rel': next.ymd }}
      />
      <MeetingCard m={next} bare todayYmd={todayYmd} commentHref={hrefFor(next)} portal={portal} />
    </article>
  ) : (
    <EmptyState href={portal?.href} linkLabel={portal?.label}>
      {`No meetings posted yet.${emptyNote ? ` ${emptyNote}` : ''}`}
    </EmptyState>
  )}

  <Chips counts={chipCounts(others)} label="Filter upcoming meetings" dataKey="mtg-chip" navAttrs={{ 'data-mtg-chips': '' }} class="up__chips" />

  {week.length > 0 && (
    <>
      <SectionRule label="This week" />
      <div class="up__stack" data-mtg-list>{week.map((m) => <MeetingCard m={m} todayYmd={todayYmd} commentHref={hrefFor(m)} portal={portal} />)}</div>
    </>
  )}
  {later.length > 0 && (
    <>
      <SectionRule label="Coming up" />
      <div class="up__stack" data-mtg-list>{later.map((m) => <MeetingCard m={m} todayYmd={todayYmd} commentHref={hrefFor(m)} portal={portal} />)}</div>
    </>
  )}
  {foldGroups.map((g) => (
    <details class="up__fold" data-mtg-group={g}>
      <summary>{g} · {foldedOthers.filter((m) => m.collapsedGroup === g).length} {foldedOthers.filter((m) => m.collapsedGroup === g).length === 1 ? 'meeting' : 'meetings'}</summary>
      <div class="up__stack" data-mtg-list>{foldedOthers.filter((m) => m.collapsedGroup === g).map((m) => <MeetingCard m={m} todayYmd={todayYmd} commentHref={hrefFor(m)} portal={portal} />)}</div>
    </details>
  ))}
</section>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-mtg-root]');
    if (!root) return;
    var tz = root.getAttribute('data-tz') || 'UTC';
    var now = Date.now();
    var today;
    try { today = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(now)); } catch (e) { return; }
    function days(a, b) { var x = a.split('-'), y = b.split('-'); return Math.round((Date.UTC(+y[0], +y[1] - 1, +y[2]) - Date.UTC(+x[0], +x[1] - 1, +x[2])) / 86400000); }
    var cards = root.querySelectorAll('article[data-ymd]');
    for (var i = 0; i < cards.length; i++) {
      var c = cards[i], ymd = c.getAttribute('data-ymd'), end = c.getAttribute('data-end');
      if (end ? now > +end : ymd < today) { c.hidden = true; continue; }
      var n = days(today, ymd), rel = c.querySelector('[data-mtg-rel]');
      if (rel) rel.textContent = n === 0 ? 'today' : n === 1 ? 'tomorrow' : 'in ' + n + ' days';
    }
    var chips = root.querySelector('[data-mtg-chips]');
    if (!chips) return;
    chips.addEventListener('click', function (e) {
      var b = e.target.closest('[data-mtg-chip]');
      if (!b) return;
      var key = b.getAttribute('data-mtg-chip');
      var all = chips.querySelectorAll('[data-mtg-chip]');
      for (var j = 0; j < all.length; j++) all[j].setAttribute('aria-pressed', all[j] === b ? 'true' : 'false');
      var lists = root.querySelectorAll('[data-mtg-list] article');
      for (var k = 0; k < lists.length; k++) lists[k].classList.toggle('mtg--off', !!key && lists[k].getAttribute('data-organ') !== key);
      var folds = root.querySelectorAll('details[data-mtg-group]');
      for (var f = 0; f < folds.length; f++) {
        var g = folds[f].getAttribute('data-mtg-group');
        folds[f].classList.toggle('mtg--off', !!key && g !== key);
        if (key) folds[f].open = g === key;
      }
    });
  })();
</script>

<style>
  .up__next { max-width: 44rem; display: grid; gap: var(--ui-3); }
  .up__stack { display: grid; gap: var(--ui-row-gap); max-width: 44rem; }
  .up__fold { margin-top: var(--ui-group-gap); max-width: 44rem; }
  .up__fold > summary { cursor: pointer; font-family: var(--font-ui); font-size: var(--ui-primary); font-weight: var(--ui-primary-weight); padding: var(--ui-2) 0; min-height: 2.75rem; display: flex; align-items: center; }
  .up__fold > .up__stack { margin-top: var(--ui-2); }
  .up :global(.up__chips) { max-width: 44rem; margin-top: var(--ui-3); }
  .up :global(.mtg--off) { display: none; }
</style>

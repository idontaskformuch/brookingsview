---
/** One upcoming meeting, straight from the meetings table: organ (and kind of meeting), when, where, the first agenda titles verbatim, links. No
 *  generated prose. `bare` is the body of the "Next up" block, whose organ, date and place the hero above already shows. A button shows only when
 *  its link exists; a meeting with agenda lines but no link of its own gets the town's public agenda page (config), a closed session gets neither. */
import Card from '../ui/Card.astro';
import Pill from '../ui/Pill.astro';
import { storyHref } from '../../lib/content-slugs';
import { relativeDays, daysBetween, canCalendar, agendaNote, type MeetingView } from '../../lib/meetings-view';

interface Props {
  m: MeetingView;
  bare?: boolean;
  todayYmd: string;
  /** where the how-to-comment guide lives for this organ, when the town has one */
  commentHref?: string | null;
  /** the town's own public agenda page, offered when this meeting has no agenda link */
  portal?: { href: string; label: string } | null;
}
const { m, bare = false, todayYmd, commentHref = null, portal = null } = Astro.props;
const SHOWN = 3;
const first = m.items.slice(0, SHOWN);
const rest = m.items.slice(SHOWN);
const days = daysBetween(todayYmd, m.ymd);
const isPdf = !!m.agendaUrl && /\.pdf(\?|$)/i.test(m.agendaUrl);
const endMs = m.startMs != null ? m.startMs + 3 * 3_600_000 : null;
const note = agendaNote(m);
// Only where there is an agenda to read but no link of its own to it; a meeting with nothing published says so instead of pointing at a page that has nothing either.
const portalLink = !m.agendaUrl && !m.closed && m.items.length > 0 ? portal : null;
---
<article class="mtg" id={`meeting-${m.id}`} data-organ={m.chipLabel} data-mtg-unknown={m.unknownOrgan ? m.bodyLabel : undefined} data-ymd={bare ? undefined : m.ymd} data-end={bare ? undefined : (endMs ?? undefined)}>
  <Card cat="civic">
    {!bare && (
      <>
        <p class="mtg__organ">
          {m.quorumNotice ? `${m.bodyLabel} – quorum notice` : m.bodyLabel}
          {m.quorumNotice ? <Pill>Quorum notice</Pill> : m.typeLabel && <Pill>{m.typeLabel}</Pill>}
          {m.cancelled && <Pill tone="alert">Cancelled</Pill>}
          {m.postponed && !m.cancelled && <Pill tone="warn">Postponed</Pill>}
          {m.jointWith && <span class="mtg__joint">Joint with {m.jointWith}</span>}
        </p>
        <h3 class="mtg__when">
          <span class="mtg__date">{m.dateLabel}</span>{m.time && <span class:list={['mtg__time', { 'mtg__time--off': m.cancelled || m.postponed }]}> · {m.time}</span>}
        </h3>
        <p class="mtg__sub">
          <span class="mtg__rel" data-mtg-rel={m.ymd}>{relativeDays(days)}</span>{m.location && <> · <span class="mtg__where">{m.location}</span></>}
        </p>
      </>
    )}

    {first.length > 0 && (
      <>
        <ul class="mtg__items">{first.map((t) => <li>{t}</li>)}</ul>
        {rest.length > 0 && (
          <details class="mtg__more">
            <summary>+ {rest.length} more</summary>
            <ul class="mtg__items">{rest.map((t) => <li>{t}</li>)}</ul>
          </details>
        )}
      </>
    )}
    {note && <p class="mtg__note">{note}</p>}
    {m.topics.length > 0 && <p class="mtg__topics" aria-label="Topics on the agenda">{m.topics.join(' · ')}</p>}

    <p class="mtg__links">
      {m.agendaUrl && <a class="mtg__btn" href={m.agendaUrl} rel="noopener">Agenda{isPdf ? ' (PDF)' : ''}</a>}
      {portalLink && <a class="mtg__btn" href={portalLink.href} rel="noopener">{portalLink.label}</a>}
      {m.videoUrl && <a class="mtg__btn" href={m.videoUrl} rel="noopener">Watch live</a>}
      {commentHref && <a class="mtg__btn" href={commentHref}>How to comment</a>}
      {canCalendar(m) && <a class="mtg__btn" href={`/city-hall/calendar/${m.id}.ics`} download>Add to calendar</a>}
      {m.storySlug && <a class="mtg__text" href={storyHref(m.storySlug)}>Plain-language summary →</a>}
    </p>
  </Card>
</article>

<style>
  .mtg { max-width: 44rem; }
  .mtg[hidden] { display: none; }
  .mtg__organ { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--ui-1) var(--ui-2); font-family: var(--font-ui); font-size: var(--ui-meta); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .mtg__joint { font-weight: 600; letter-spacing: 0.02em; text-transform: none; }
  .mtg__when { margin: var(--ui-1) 0 0; font-family: var(--font-head); font-size: 1.375rem; line-height: 1.2; font-weight: 700; color: var(--ink); }
  .mtg__time { font-weight: 600; }
  .mtg__time--off { text-decoration: line-through; color: var(--ink-soft); }
  .mtg__sub { margin: var(--ui-1) 0 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .mtg__rel { font-weight: 600; color: var(--ink); }
  .mtg__items { margin: var(--ui-3) 0 0; padding-left: 1.1rem; font-family: var(--font-ui); font-size: 0.9375rem; line-height: 1.45; color: var(--ink); }
  .mtg__items li { margin: 0.2rem 0; overflow-wrap: anywhere; }
  .mtg__more { margin: var(--ui-1) 0 0; }
  .mtg__more summary { cursor: pointer; font-size: 0.9375rem; font-weight: 600; color: var(--accent); padding: 0.4rem 0; min-height: 1.5rem; }
  .mtg__note { margin: var(--ui-3) 0 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .mtg__topics { margin: var(--ui-3) 0 0; font-size: var(--ui-meta); font-weight: 600; letter-spacing: 0.02em; color: var(--ink-soft); }
  .mtg__links { margin: var(--ui-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--ui-2); align-items: center; }
  .mtg__btn {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.9rem; font-size: 0.9375rem; font-weight: 600;
    color: var(--accent); background: var(--ui-surface-1); border: 1.5px solid var(--rule-strong); border-radius: 6px; text-decoration: none;
  }
  .mtg__btn:hover { border-color: var(--accent); }
  .mtg__text { font-size: 0.9375rem; font-weight: 600; color: var(--accent); padding: 0.5rem 0.25rem; }
</style>

---
/** The front page's lead and its secondaries (lib/front-page.ts selectFrontPage). Headline and deck are templates over data fields.
 *  The town's photo of the week (lib/city-face.ts) is the lead's surface, with the kicker and headline on its scrim; on an alert day the
 *  lead has no photo and the photo goes to the first secondary when that is a holiday or the weekend (cityImageSlot). A holiday secondary
 *  with insight lines from its page is a compact card with the page's own photo as a thumbnail (Fas 1c).
 *  The secondary grid has exactly as many columns as there are secondaries (1, 2 or 3), so there is never an empty slot. */
import type { FrontPage, FrontPageItem, FrontPageType } from '../lib/front-page';
import { cityImageSlot, type CityImage } from '../lib/city-face';
import CityPhoto from './CityPhoto.astro';

interface Props {
  page: FrontPage;
  /** The week's front-page photo; null when the town has no pool yet. */
  cityImage: CityImage | null;
  /** The linked holiday page's band photo, for the holiday card's thumbnail. */
  holidayThumb?: CityImage | null;
}
const { page, cityImage, holidayThumb = null } = Astro.props;
const KICKER: Record<FrontPageType, string> = {
  alert: 'Alert', holiday: 'Holiday', weekend: 'This weekend', game_day: 'Game day', meeting: 'Meeting', tonight: 'Tonight', guide: 'Guide',
};
const kicker = (it: FrontPageItem) => it.kicker ?? KICKER[it.type];
const slot = cityImage ? cityImageSlot(page) : null;
const n = Math.min(Math.max(page.secondaries.length, 1), 3);
const isCard = (s: FrontPageItem, idx: number) => s.type === 'holiday' && (s.insights?.length ?? 0) > 0 && !(slot === 'secondary' && idx === 0);
---
<div class="front" data-lead={page.lead.type} data-photo={slot ?? 'none'}>
  <article class="lead">
    {slot === 'lead' && cityImage ? (
      <CityPhoto image={cityImage} variant="lead" priority>
        <p class="lead__kicker lead__kicker--photo">{kicker(page.lead)}</p>
        <h2 class="lead__title lead__title--photo"><a href={page.lead.url}>{page.lead.headline}</a></h2>
      </CityPhoto>
    ) : (
      <>
        <p class="lead__kicker">{kicker(page.lead)}</p>
        <h2 class="lead__title"><a href={page.lead.url}>{page.lead.headline}</a></h2>
      </>
    )}
    <div class="lead__body">
      {page.lead.deck.map((d) => <p class="lead__deck">{d}</p>)}
      <a class="lead__more" href={page.lead.url}>{page.lead.type === 'alert' ? 'Details' : 'See the details'} &rarr;</a>
    </div>
  </article>
  {page.secondaries.length > 0 && (
    <div class={`front__secondary front__secondary--${n}`} data-count={page.secondaries.length}>
      {page.secondaries.map((s, idx) => (
        <article class:list={['secondary', { 'secondary--card': isCard(s, idx) }]} data-type={s.type}>
          {slot === 'secondary' && idx === 0 && cityImage && <CityPhoto image={cityImage} variant="card" />}
          {isCard(s, idx) && holidayThumb ? (
            <div class="secondary__card">
              <a class="secondary__thumb" href={s.url} tabindex="-1" aria-hidden="true"><CityPhoto image={holidayThumb} variant="thumb" /></a>
              <div>
                <p class="secondary__kicker">{kicker(s)}</p>
                <h3 class="secondary__title"><a href={s.url}>{s.headline}</a></h3>
                {s.deck[0] && <p class="secondary__deck">{s.deck[0]}</p>}
              </div>
            </div>
          ) : (
            <>
              <p class="secondary__kicker">{kicker(s)}</p>
              <h3 class="secondary__title"><a href={s.url}>{s.headline}</a></h3>
              {s.deck[0] && <p class="secondary__deck">{s.deck[0]}</p>}
            </>
          )}
          {isCard(s, idx) && <ul class="secondary__insights">{s.insights!.map((line) => <li>{line}</li>)}</ul>}
        </article>
      ))}
    </div>
  )}
</div>

<style>
.front { margin-bottom: 1.75rem; }
.lead { border-bottom: 2px solid var(--rule-strong); padding-bottom: 1.25rem; }
.lead__kicker, .secondary__kicker {
  margin: 0 0 0.5rem; font-family: var(--font-ui); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--brand-accent-ink, var(--ink-soft));
}
.lead__kicker--photo { color: var(--brand-accent-on-dark, #fff); margin-bottom: 0.375rem; }
.lead__title { font-size: clamp(1.75rem, 4.2vw, 2.625rem); line-height: 1.05; margin: 0 0 0.625rem; }
.lead__title--photo { font-size: clamp(1.5rem, 4.2vw, 2.625rem); margin: 0; color: #fff; }
.lead__title a, .secondary__title a { color: inherit; text-decoration: none; }
.lead__title a:hover, .secondary__title a:hover { color: var(--navy); }
.lead__title--photo a:hover { color: #fff; text-decoration: underline; }
.lead__body { margin-top: 0.75rem; }
.lead__deck { margin: 0 0 0.375rem; font-size: 1.125rem; line-height: 1.55; max-width: 38rem; }
.lead__more {
  display: inline-block; margin-top: 0.625rem; font-family: var(--font-ui); font-size: 0.75rem; font-weight: 600;
  letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; color: var(--accent);
}
.lead__more:hover { text-decoration: underline; }
.front__secondary { display: grid; gap: 1.5rem; margin-top: 1.75rem; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 40rem) {
  .front__secondary--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .front__secondary--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
.secondary :global(.city-photo--card) { margin-bottom: 0.75rem; }
.secondary__title { font-size: 1.25rem; line-height: 1.2; margin: 0 0 0.375rem; }
.secondary__deck { margin: 0; font-size: 0.9375rem; line-height: 1.45; color: var(--ink-soft); }
.secondary__card { display: flex; gap: 0.875rem; align-items: flex-start; }
.secondary__thumb { flex: 0 0 auto; }
.secondary__insights {
  margin: 0.625rem 0 0; padding: 0; list-style: none; font-family: var(--font-ui); font-size: 0.875rem; line-height: 1.4;
}
.secondary__insights li { padding-left: 0.75rem; border-left: 3px solid var(--brand-accent, var(--accent)); margin-top: 0.25rem; }
</style>

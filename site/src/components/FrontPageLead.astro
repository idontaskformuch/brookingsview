---
/** The front page's lead and its secondaries (lib/front-page.ts selectFrontPage). Headline and deck are templates over data fields.
 *  Fas 2 (front page as a hub, owner 2026-11-19): from 62rem the lead (≈2fr) and a column of 3-4 secondaries (≈1fr) side by side; below that
 *  the lead, then the secondaries as a list. Every secondary has a 3:2 thumbnail (`thumbs`, resolved by the page: the holiday page's own
 *  photo, the week's photo on an alert day, else a category photo from the town's pools, never one already shown). The town's photo of the
 *  week (lib/city-face.ts) is the lead's surface, with the kicker and headline on its scrim; on an alert day the lead has no photo
 *  (cityImageSlot). A holiday secondary keeps its insight lines (Fas 1c). Only the lead photo loads with priority; thumbnails are lazy. */
import type { FrontPage, FrontPageItem, FrontPageType } from '../lib/front-page';
import { cityImageSlot, responsiveSrc, type CityImage } from '../lib/city-face';
import type { BlockImage } from '../lib/home-blocks';
import CityPhoto from './CityPhoto.astro';

interface Props {
  page: FrontPage;
  /** The week's front-page photo; null when the town has no pool yet. */
  cityImage: CityImage | null;
  /** One thumbnail per secondary, same order (null: none could be found). */
  thumbs: (BlockImage | null)[];
}
const { page, cityImage, thumbs } = Astro.props;
const KICKER: Record<FrontPageType, string> = {
  alert: 'Alert', holiday: 'Holiday', weekend: 'This weekend', game_day: 'Game day', big_event: 'Coming up', meeting: 'Meeting', tonight: 'Tonight', guide: 'Guide',
};
const kicker = (it: FrontPageItem) => it.kicker ?? KICKER[it.type];
const slot = cityImage ? cityImageSlot(page) : null;
const hasInsights = (s: FrontPageItem) => s.type === 'holiday' && (s.insights?.length ?? 0) > 0;
---
<div class="front" data-lead={page.lead.type} data-photo={slot ?? 'none'}>
  <article class="lead">
    {slot === 'lead' && cityImage ? (
      <CityPhoto image={cityImage} variant="lead" priority>
        <p class="lead__kicker lead__kicker--photo">{kicker(page.lead)}</p>
        <h2 class="lead__title lead__title--photo"><a href={page.lead.url}>{page.lead.headline}</a></h2>
      </CityPhoto>
    ) : (
      <>
        <p class="lead__kicker">{kicker(page.lead)}</p>
        <h2 class="lead__title"><a href={page.lead.url}>{page.lead.headline}</a></h2>
      </>
    )}
    <div class="lead__body">
      {page.lead.deck.slice(0, 2).map((d) => <p class="lead__deck">{d}</p>)}
      <a class="lead__more" href={page.lead.url}>{page.lead.type === 'alert' ? 'Details' : 'See the details'} &rarr;</a>
    </div>
  </article>
  {page.secondaries.length > 0 && (
    <ul class="front__secondary" data-count={page.secondaries.length}>
      {page.secondaries.map((s, idx) => {
        const t = thumbs[idx];
        const r = t ? responsiveSrc(t.path) : null;
        return (
          <li class="secondary" data-type={s.type}>
            {t && r && (
              <a class="secondary__thumb" href={s.url} tabindex="-1" aria-hidden="true">
                <img src={r.src} srcset={r.srcset} sizes={r.srcset ? '8rem' : undefined} alt="" width={t.width} height={t.height} loading="lazy" decoding="async" />
              </a>
            )}
            <div class="secondary__text">
              <p class="secondary__kicker">{kicker(s)}</p>
              <h3 class="secondary__title"><a href={s.url}>{s.headline}</a></h3>
              {hasInsights(s)
                ? <ul class="secondary__insights">{s.insights!.map((line) => <li>{line}</li>)}</ul>
                : s.deck[0] && <p class="secondary__deck">{s.deck[0]}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  )}
</div>

<style>
.front { margin-bottom: 1.75rem; }
.lead { padding-bottom: 1.25rem; }
.lead__kicker, .secondary__kicker {
  margin: 0 0 0.375rem; font-family: var(--font-ui); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--brand-accent-ink, var(--ink-soft));
}
.lead__kicker--photo { color: var(--brand-accent-on-dark, #fff); margin-bottom: 0.375rem; }
.lead__title { font-size: clamp(1.75rem, 4.2vw, 2.625rem); line-height: 1.05; margin: 0 0 0.625rem; }
.lead__title--photo { font-size: clamp(1.5rem, 3.4vw, 2.375rem); margin: 0; color: #fff; }
.lead__title a, .secondary__title a { color: inherit; text-decoration: none; }
.lead__title a:hover, .secondary__title a:hover { color: var(--navy); }
.lead__title--photo a:hover { color: #fff; text-decoration: underline; }
.lead__body { margin-top: 0.75rem; }
.lead__deck { margin: 0 0 0.375rem; font-size: 1.125rem; line-height: 1.55; max-width: 38rem; }
.lead__more {
  display: inline-block; margin-top: 0.625rem; font-family: var(--font-ui); font-size: 0.75rem; font-weight: 600;
  letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; color: var(--accent);
}
.lead__more:hover { text-decoration: underline; }
.front__secondary { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 2px solid var(--rule-strong); }
.secondary { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.875rem; align-items: start; padding: 0.875rem 0; border-bottom: 1px solid var(--rule); }
.secondary:not(:has(.secondary__thumb)) { grid-template-columns: minmax(0, 1fr); }
.secondary__thumb img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; background: var(--ui-surface-2, var(--rule)); }
/* Fixed text heights (title 2 lines, deck 2 lines, insights 1 line each): a row is the same height before and after the web font
   arrives, so swapping the font moves nothing below it (CLS 0). */
.secondary__title {
  font-size: 1.125rem; line-height: 1.2; margin: 0 0 0.25rem; height: 2.4em;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.secondary__deck {
  margin: 0; font-family: var(--font-ui); font-size: 0.8125rem; line-height: 1.4; color: var(--ink-soft); height: 2.8em;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.secondary__insights { margin: 0.25rem 0 0; padding: 0; list-style: none; font-family: var(--font-ui); font-size: 0.8125rem; line-height: 1.35; }
.secondary__insights li {
  padding-left: 0.5rem; border-left: 3px solid var(--brand-accent, var(--accent)); margin-top: 0.25rem;
  height: 1.35em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
@media (min-width: 62rem) {
  .front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); column-gap: 2rem; align-items: start; }
  .lead { padding-bottom: 0; }
  .front__secondary { border-top: 0; }
  .secondary:first-child { padding-top: 0; }
}
</style>

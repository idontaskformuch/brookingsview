---
// Front-page promo card for the Burro Bonanza match-3 game, see /burro-bonanza.
---

<a href="/burro-bonanza/" class="burro-widget" aria-label="Play the Burro Bonanza match-3 game">
  <div class="bb-icon" aria-hidden="true">🐴</div>
  <div class="bb-text">
    <div class="bb-title">Play Burro Bonanza</div>
    <div class="bb-sub">Our free match-3 game — help Dusty clear the trail</div>
  </div>
</a>

<style>
  /* Consistency pass (2026-09-10) -- see JackrabbitWidget.astro's
     identical comment for the full reasoning. */
  .burro-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .burro-widget:hover { border-color: var(--rule-strong); }
  .bb-icon { font-size: 1.5rem; flex-shrink: 0; }
  .bb-text { flex: 1; }
  .bb-title { font-weight: 700; font-size: 0.95rem; }
  .bb-sub { font-size: 0.78rem; color: var(--ink-soft); }
</style>

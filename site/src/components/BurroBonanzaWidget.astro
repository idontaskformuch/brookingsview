<style>
  .burro-widget {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: linear-gradient(135deg, #C16E4F, #9C4E33);
    color: #FFF7E8;
    text-decoration: none;
    border: 2px solid #F2C438;
    transition: transform 0.15s ease;
  }
  .burro-widget:hover {
    transform: translateY(-2px);
  }
  .bb-icon { font-size: 1.6rem; }
  .bb-text { flex: 1; }
  .bb-title { font-weight: 700; font-size: 0.95rem; }
  .bb-sub { font-size: 0.78rem; opacity: 0.85; }
  .bb-arrow { color: #F2C438; font-weight: 700; }

---
/** Secondary front-page card -- see NEEDS-HUMAN-REVIEW.md "Liveliness
 *  Spec" §1. Image + headline only, no body excerpt: two of these sit
 *  beside each other under the lead, so the emphasis has to come from
 *  scale (bigger than a dense StoryCard row, smaller than the lead), not
 *  from repeating the same amount of text at a smaller size. */
import type { Story, Facility } from '../lib/db';
import { formatDate, formatTime, formatCalendarDate, CATEGORY_LABELS } from '../lib/db';
import { resolveImage } from '../lib/images';
import { CATEGORY_IMAGES } from '../config/category-images';
import { siteConfig } from '../lib/site-config';
import { relativeTime } from '../lib/time';

interface Props { story: Story; facilities: Facility[]; }
const { story, facilities } = Astro.props;

const isMeeting = story.source_type === 'meeting';
const isAlert = story.source_type === 'alert';
const hasByline = Boolean(story.byline);
const when = story.occurs_at;
const now = new Date();
// Relative time (Liveliness Spec §2) -- same exceptions as StoryCard.astro/
// LeadStory.astro: alerts keep exact times, meetings keep formatCalendarDate().
// published_at is typed as always-set but isn't in real data -- see
// StoryCard.astro's own comment for the confirmed live count.
const timeLabel = hasByline
  ? (story.published_at ? relativeTime(story.published_at, now, siteConfig.timezone) : '')
  : !when
    ? ''
    : isMeeting
      ? formatCalendarDate(when)
      : isAlert
        ? `${formatDate(when)}${formatTime(when) ? ` · ${formatTime(when)}` : ''}`
        : relativeTime(when, now, siteConfig.timezone);
// .toISOString(), not a raw passthrough -- see StoryCard.astro's own
// comment for why (the DB driver returns a real Date object at runtime
// despite db.ts's `string` type annotation; passed raw into
// datetime={...}, that renders in the build machine's local timezone).
const timeSource = hasByline ? story.published_at : when;
const timeMachineValue = timeSource ? new Date(timeSource).toISOString() : null;
const kicker = isAlert ? 'Alert' : isMeeting ? 'City hall'
  : hasByline ? (CATEGORY_LABELS[story.source_type] ?? 'Feature') : 'Events';

// Same resolution as the lead -- a secondary card can be the "fail down"
// destination for a would-be lead with no image anywhere (§1), so this
// must degrade the same honest way: no image, no <img> tag, never /og/.
const heroImage = resolveImage(story, {
  town: siteConfig.townId as 'brookings_sd' | 'moreno_valley_ca',
  cityName: siteConfig.cityName,
  facilities,
  categoryImages: CATEGORY_IMAGES[siteConfig.townId as 'brookings_sd' | 'moreno_valley_ca'],
});
---
<article class="secondary">
  {heroImage && (
    <a class="secondary__image-link" href={`/s/${story.slug}/`} tabindex="-1" aria-hidden="true">
      <img
        class="secondary__image"
        src={heroImage.path}
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        decoding="async"
      />
    </a>
  )}
  <p class="secondary__kicker">
    <span class="kicker">{kicker}</span>
    {timeLabel && timeMachineValue && (
      <time class="secondary__when data" datetime={timeMachineValue}>{timeLabel}</time>
    )}
  </p>
  <h3 class="secondary__title"><a href={`/s/${story.slug}/`}>{story.title}</a></h3>
</article>

<style>
.secondary { display: flex; flex-direction: column; }
.secondary__image-link { display: block; }
.secondary__image { display: block; width: 100%; height: auto; margin: 0 0 0.75rem; }
.secondary__kicker {
  display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 0.5rem 0.75rem; margin: 0 0 0.375rem;
}
.secondary__when {
  font-size: 0.6875rem; letter-spacing: 0.04em;
  text-transform: uppercase; color: var(--ink-soft);
}
.secondary__title {
  font-size: 1.25rem;
  line-height: 1.15;
  margin: 0;
}
.secondary__title a { color: inherit; text-decoration: none; }
.secondary__title a:hover { color: var(--navy); }
</style>

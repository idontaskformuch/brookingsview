---
import type { Game } from '../lib/db';
import { formatDate, formatTime } from '../lib/db';
import { sportTerms } from '../lib/sport-strings';
import { siteConfig } from '../lib/site-config';

/** Either a legacy `game` (sports_games row) or the sport_events fields passed one by one (/jackrabbits). */
interface Props {
  game?: Game; feature?: boolean;
  sport?: string; opponent?: string; prefix?: 'vs' | 'at'; startAt?: string; timeTba?: boolean; venue?: string | null;
  /** Replaces "Home"/"Away" in the kicker (e.g. "Neutral site"). */
  kicker?: string;
  /** A small label after the title ("Exhibition", "In progress"). */
  tag?: string;
  /** Always render an empty tag the page script can fill ("In progress") when the game starts after the build. */
  tagSlot?: boolean;
}
const { game, feature = false, tagSlot = false } = Astro.props;
const legacy = game !== undefined;
const terms = sportTerms(siteConfig.country);
// A sport_events game carries its own neutral-site and exhibition flags; callers can still override both.
const kicker = Astro.props.kicker ?? (legacy && game.home_away === 'neutral' ? terms.neutral_site : undefined);
const tag = Astro.props.tag ?? (legacy && game.exhibition ? terms.exhibition : legacy && game.phase === 'inProgress' ? terms.in_progress : undefined);
const home = legacy ? game.home_away !== 'away' : Astro.props.prefix === 'vs';
const sportName = legacy
  ? (game.sport === 'mbb' ? "men's basketball" : game.sport === 'wbb' ? "women's basketball" : game.sport.replace(/_/g, ' '))
  : (Astro.props.sport ?? '').toLowerCase();
const opponent = legacy ? game.opponent : Astro.props.opponent;
const startsAt = legacy ? game.starts_at : (Astro.props.startAt ?? null);
const venue = legacy ? game.venue : Astro.props.venue;
const result = legacy ? game.result : null;
const timeText = (legacy ? game.time_tba : Astro.props.timeTba) ? 'TBA' : (startsAt ? formatTime(startsAt) : '');
---
<div class:list={['game', feature && 'game--feature']}>
  <p class="game__meta"><span class="kicker" data-nx="kicker">{kicker ?? (home ? 'Home' : 'Away')} &middot; {sportName}</span></p>
  <p class="game__title">Jackrabbits <span data-nx="prefix">{home ? 'vs' : 'at'}</span> <span data-nx="opp">{opponent}</span>{tag ? <span class="game__tag" data-next-tag> · {tag}</span> : tagSlot ? <span class="game__tag" data-next-tag hidden></span> : null}</p>
  <p class="game__when data">
    <span data-nx="when">{formatDate(startsAt)}{timeText && ` · ${timeText}`}</span>
    {venue && <span class="game__venue" data-nx="venue">{venue}</span>}
    {!venue && tagSlot && <span class="game__venue" data-nx="venue" hidden></span>}
  </p>
  {result && <p class="game__result data">Final: {result}</p>}
</div>

<style>
.game { border-bottom: 1px solid var(--rule); padding-block: 0.75rem; }
.game--feature {
  border: 0;
  border-left: 4px solid var(--navy);
  background: var(--navy-tint);
  padding: 0.875rem 1rem;
}
.game__meta { margin: 0 0 0.25rem; }
.game__title {
  margin: 0 0 0.25rem;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.1875rem;
  letter-spacing: -0.01em;
  line-height: 1.15;
}
.game__venue { display: block; }
.game__venue[hidden] { display: none; }
.game__tag { font-weight: 500; font-size: 0.875rem; color: var(--ink-soft); }
.game__when { margin: 0; font-size: 0.75rem; color: var(--ink-soft); line-height: 1.45; }
.game__result { margin: 0.375rem 0 0; font-size: 0.8125rem; font-weight: 500; }
</style>

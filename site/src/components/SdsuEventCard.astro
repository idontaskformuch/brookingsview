---
/** Rail-kortet för nästa SDSU-"marquee"-evenemang (Athletics/Music) på
 *  förstasidan -- samma roll och stil som GameCard.astro/RegionalGameCard.astro,
 *  men mot SdsuEvent-formen. Konkurrerar om samma rail-slot som Jackrabbits
 *  nästa match för Brookings, se index.astro:s tie-break-logik
 *  (whichever is chronologically sooner). */
import type { SdsuEvent } from '../lib/db';
import { formatDate, formatTime } from '../lib/db';

interface Props { event: SdsuEvent; feature?: boolean; }
const { event, feature = false } = Astro.props;
---
<div class:list={['event', feature && 'event--feature']}>
  <p class="event__meta"><span class="kicker">{event.primary_category ?? 'SDSU'}</span></p>
  <p class="event__title">{event.title}</p>
  <p class="event__when data">
    {event.starts_at && formatDate(event.starts_at)}{event.starts_at && ` · ${formatTime(event.starts_at)}`}
    {event.location && <><br />{event.location}</>}
  </p>
</div>

<style>
.event { border-bottom: 1px solid var(--rule); padding-block: 0.75rem; }
.event--feature {
  border: 0;
  border-left: 4px solid var(--navy);
  background: var(--navy-tint);
  padding: 0.875rem 1rem;
}
.event__meta { margin: 0 0 0.25rem; }
.event__title {
  margin: 0 0 0.25rem;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.1875rem;
  letter-spacing: -0.01em;
  line-height: 1.15;
}
.event__when { margin: 0; font-size: 0.75rem; color: var(--ink-soft); line-height: 1.45; }
</style>

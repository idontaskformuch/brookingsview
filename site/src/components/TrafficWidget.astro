---
/** Kompakt "aktuella trafikincidenter"-ruta för förstasidans högerfält --
 *  samma roll som RegionalGameCard/getNextRegionalGame fyller för sport.
 *  Se lib/db.ts (getActiveTrafficIncidents) och
 *  scrapers/parsers/traffic_v1.py.
 *
 *  Villkorad rendering ägs av ANROPAREN (index.astro) -- tomt läge ska vara
 *  "ingen ruta", inte en tom ruta, samma mönster som övriga rail-widgets. */
import type { TrafficIncident } from '../lib/db';
import { formatTime } from '../lib/db';

interface Props { incidents: TrafficIncident[]; limit?: number; }
const { incidents, limit = 3 } = Astro.props;
const shown = incidents.slice(0, limit);

const typeLabel = (t: string) => (t === 'lane_closure' ? 'Closure' : 'Incident');
---
<div class="traffic">
  <p class="traffic__label">Traffic</p>
  <ul class="traffic__list">
    {shown.map((incident) => (
      <li class="traffic__item">
        <span class="traffic__type">{typeLabel(incident.incident_type)}</span>
        <span class="traffic__title">{incident.road ? `${incident.road}: ` : ''}{incident.title}</span>
        <span class="traffic__when data">{formatTime(incident.last_seen_at)}</span>
      </li>
    ))}
  </ul>
  {incidents.length > limit && (
    <p class="traffic__more">+{incidents.length - limit} more</p>
  )}
</div>

<style>
.traffic { border-top: 1px solid var(--rule); padding-top: 0.75rem; }
.traffic__label {
  margin: 0 0 0.375rem;
  font-family: var(--font-ui);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.traffic__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.traffic__item { display: grid; gap: 0.0625rem; }
.traffic__type {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--alert);
}
.traffic__title { font-size: 0.875rem; line-height: 1.3; }
.traffic__when { font-size: 0.75rem; color: var(--ink-soft); }
.traffic__more { margin: 0.375rem 0 0; font-size: 0.75rem; color: var(--ink-soft); }
</style>

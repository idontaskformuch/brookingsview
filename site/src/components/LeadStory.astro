---
/** Ettan. Dominerar sidan i skala -- det är så en tidning uttrycker redaktionell
 *  bedömning visuellt, i stället för att ge varje post lika stor vikt. */
import type { Story, Facility } from '../lib/db';
import { formatDate, formatTime, formatMeetingDate, CATEGORY_LABELS } from '../lib/db';
import { resolveImage, splitEventTitleAndVenue, type ImageRef } from '../lib/images';
import { categoryImagesFor } from '../config/category-images';
import ImageAttribution from './ImageAttribution.astro';
import { siteConfig } from '../lib/site-config';
import { relativeTime } from '../lib/time';
import { storyHref } from '../lib/content-slugs';

// `image`: optional pre-resolved override -- undefined (the default, every
// call site but index.astro's front-page cards) means self-resolve as
// before. A caller juggling several image-bearing cards on one page (see
// index.astro's dedupeConsecutiveImages() pass) can pass the ALREADY-
// deduped result instead, including an explicit null to suppress a repeat
// -- distinguished from "not passed" via `'image' in Astro.props`, since a
// plain `image?:` default would treat null and undefined the same.
interface Props { story: Story; facilities: Facility[]; image?: ImageRef | null; }
const { story, facilities } = Astro.props;
const imageOverride = 'image' in Astro.props ? Astro.props.image : undefined;

const isMeeting = story.source_type === 'meeting';
const isAlert = story.source_type === 'alert';
const isEvent = story.source_type === 'event';
// Item C4 -- see StoryCard.astro's identical comment for the full reasoning.
const { displayTitle, venue } = isEvent
  ? splitEventTitleAndVenue(story.title, siteConfig.cityName)
  : { displayTitle: story.title, venue: null };
// Se StoryCard.astro för samma resonemang: byline betyder Content Track-innehåll,
// och då är occurs_at inte en riktig tidsangivelse -- publiceringsdatum är rätt.
const hasByline = Boolean(story.byline);
const when = story.occurs_at;
const now = new Date();
// Relative time (Liveliness Spec §2) -- same two exceptions as
// StoryCard.astro: alerts keep exact times, meetings keep
// formatMeetingDate() (meetingsHaveTime-aware -- see StoryCard.astro's own
// comment and db.ts's formatMeetingDate() for the timezone landmine).
// published_at is typed as always-set but isn't in real data -- see
// StoryCard.astro's own comment for the confirmed live count.
const timeLabel = hasByline
  ? (story.published_at ? relativeTime(story.published_at, now, siteConfig.timezone) : '')
  : !when
    ? ''
    : isMeeting
      ? formatMeetingDate(when)
      : isAlert
        ? `${formatDate(when)}${formatTime(when) ? ` · ${formatTime(when)}` : ''}`
        : relativeTime(when, now, siteConfig.timezone, story.ends_at);
// .toISOString(), not a raw passthrough -- see StoryCard.astro's own
// comment for why (the DB driver returns a real Date object at runtime
// despite db.ts's `string` type annotation; passed raw into
// datetime={...}, that renders in the build machine's local timezone).
const timeSource = hasByline ? story.published_at : when;
const timeMachineValue = timeSource ? new Date(timeSource).toISOString() : null;
const kicker = isAlert ? 'Alert' : isMeeting ? 'City hall'
  : hasByline ? (CATEGORY_LABELS[story.source_type] ?? 'Feature') : 'Events';
// Front-page hero: one image per place/category, reused -- see
// lib/images.ts and NEEDS-HUMAN-REVIEW.md "Venue & Category Image
// Identity". Never falls back to the /og/ social card; null just means no
// <img> renders below (honest gap, not a broken one -- also what a
// suppressed-repeat imageOverride of null means, see Props above).
const heroImage = imageOverride !== undefined ? imageOverride : resolveImage(story, {
  town: siteConfig.townId,
  cityName: siteConfig.cityName,
  facilities,
  categoryImages: categoryImagesFor(siteConfig.townId),
});
---
<article class="lead">
  <p class="lead__kicker">
    <span class="kicker">{kicker}</span>
    {timeLabel && timeMachineValue && (
      <time class="lead__when data" datetime={timeMachineValue}>{timeLabel}</time>
    )}
  </p>
  {heroImage && (
    <a class="lead__image-link" href={storyHref(story.slug)} tabindex="-1" aria-hidden="true">
      <img
        class="lead__image"
        src={heroImage.path}
        alt={heroImage.alt}
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        decoding="async"
      />
    </a>
  )}
  {heroImage && <ImageAttribution image={heroImage} />}
  <h2 class="lead__title"><a href={storyHref(story.slug)}>{displayTitle}</a></h2>
  {venue && <p class="lead__venue data">{venue}</p>}
  <p class="lead__body">{story.body}</p>
  <a class="lead__more" href={storyHref(story.slug)}>Read more &rarr;</a>
</article>

<style>
.lead { border-bottom: 2px solid var(--rule-strong); padding-bottom: 1.25rem; }
.lead__kicker {
  display: flex; flex-wrap: wrap; align-items: baseline;
  gap: 0.5rem 0.75rem; margin: 0 0 0.5rem;
}
.lead__when {
  font-size: 0.6875rem; letter-spacing: 0.04em;
  text-transform: uppercase; color: var(--ink-soft);
}
.lead__image-link { display: block; }
.lead__image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0.875rem 0 1.125rem;
}
.lead__title {
  font-size: clamp(1.75rem, 4.2vw, 2.625rem);
  line-height: 1.05;
  margin: 0 0 0.625rem;
}
.lead__title a { color: inherit; text-decoration: none; }
.lead__title a:hover { color: var(--navy); }
.lead__venue { margin: -0.25rem 0 0.625rem; font-size: 0.9375rem; color: var(--ink-soft); }
.lead__body {
  margin: 0;
  font-size: 1.125rem;
  line-height: 1.55;
  max-width: 38rem;
}
.lead__more {
  display: inline-block;
  margin-top: 0.625rem;
  font-family: var(--font-ui);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
}
.lead__more { color: var(--accent); }
.lead__more:hover { text-decoration: underline; }
</style>

---
/** The shared "what's happening today" block -- Recurring-traffic layer
 *  handoff, Phase 1. ONE component, TWO mount points (pages/today.astro's
 *  own page, and the top of index.astro), per that spec's own instruction.
 *  Pure presentational: every prop is already-fetched/already-computed data,
 *  no DB calls in here -- same split this codebase already uses for
 *  StoryCard/TrafficWidget/HeatAdvisoryWidget, all reused below rather than
 *  reimplemented.
 *
 *  RIGHT NOW / TONIGHT / TOMORROW, each independently omittable:
 *   - Active alerts: every town has this capability (weather_alerts is
 *     always on) -- 0 active renders nothing (owner 2026-11-07: no empty messages);
 *     
 *   - Temperature + HeatAdvisoryWidget: shown together whenever a current
 *     temperature reading exists; omitted (not a misleading "Safe") if
 *     weather data itself is unavailable.
 *   - School status: `closureStatus` is null for a town without Closure
 *     Watch (Broomfield, until its own Phase 2 lands) -- omitted entirely,
 *     never a fake "no data" row. See rightNowHasContent below for what
 *     happens if EVERY RIGHT NOW row is absent for a given town.
 *   - Traffic: `traffic` is null when the town has no real source
 *     (Brookings/Broomfield today) -- omitted entirely, never an empty or
 *     zeroed row. Present-but-quiet (Moreno Valley, no active incidents)
 *     renders nothing either (owner 2026-11-07), via TrafficWidget's
 *     own empty list, not a hidden section -- source presence and a quiet
 *     day are different states, and must read differently.
 *  TONIGHT/TOMORROW: event-scraping capability is universal across all three
 *  towns, so these are never "absent" -- but a bucket with no events is HIDDEN
 *  (no bare heading); if all are empty the nearest upcoming events of the week are listed under "Coming up".
 *  Decided in the browser, see the script at the bottom.
 *
 *  Phase 2 addition: City Hall open/closed. The one facility category
 *  every town has exactly one of (unlike Library, which Moreno Valley has
 *  three branches of -- no unambiguous single row to show), so it's the
 *  only facility-hours row that fits a town-wide "right now" summary
 *  without inventing a selection rule. Caller passes whichever facility
 *  its own getFacilities() found with category 'city_hall' (or null if
 *  none), never a hardcoded slug -- see today.astro/index.astro's own
 *  `.find(f => f.category === 'city_hall')`. Omitted when that facility
 *  has no hours_text at all, or its hours_text couldn't be confidently
 *  parsed (hours_needs_review) -- cityHallKnown below covers both, same
 *  fallback rule as the /facilities pages themselves.
 *
 *  Open/Closed badge client-side move (2026-10-15): the open/closed TEXT
 *  is no longer computed here. asOf can be up to half a day stale (static site,
 *  scrape.yml cron), so a build-time computation would have the same
 *  staleness bug facilities/[slug].astro's own script comment describes.
 *  cityHallKnown only asks whether hours data exists at all (a
 *  time-independent, build-time-safe fact) to decide whether the row
 *  renders; the live text is filled in by the script near the bottom of
 *  this component, from a fresh now.
 */
import TrafficWidget from './TrafficWidget.astro';
import HeatAdvisoryWidget from './HeatAdvisoryWidget.astro';
import type { EventEntry } from '../lib/event-entries';
import { entryDays, joinTimes, seriesLabel } from '../lib/event-entries';
import { eventClock } from '../lib/time';
import EventRow from './ui/EventRow.astro';
import DayGroup from './ui/DayGroup.astro';
import { rowFromFeedItem, rowFromTodayShow, rowEnvFor, mixedCategories, dayKey, dayLabel, type EventRowData } from '../lib/event-row';
import { makeRowFacts } from '../lib/event-row-facts';
import { areasFor } from '../lib/areas';
import type { Story, TrafficIncident, Facility } from '../lib/db';
import type { StoredHours } from '../lib/hours-spec';
import type { TodayShow } from '../lib/today-shows';
import type { ClosureWatchStatus } from '../lib/closure-watch';
import { ownPageHref } from '../lib/ai-text';
import { formatAlertUntil } from '../lib/alerts';
import { siteConfig } from '../lib/site-config';
import { formatClockCompact } from '../lib/country-profile';
import { bucketOf, liveOccurrence } from '../lib/local-day';
import EventFeature from './ui/EventFeature.astro';
import { isRecurring, isRun, withoutNearbyWord } from '../lib/day-digest';
import { planBucket, type BucketRow } from '../lib/today-buckets';
import { ownVenueCity } from '../lib/events';
import { cleanCity } from '../lib/evening-items';

export interface Props {
  cityName: string;
  timezone: string;
  /** Real build/render timestamp -- see module docstring: the twice-a-day
   *  collection means this can be up to half a day stale, so it must be
   *  shown, not implied. */
  asOf: Date;
  temperature: number | null;
  activeAlerts: Pick<Story, 'slug' | 'title' | 'ends_at' | 'generated_by'>[];
  /** null = Closure Watch not live for this town yet -- omit the row. */
  closureStatus: ClosureWatchStatus | null;
  /** null = no real traffic source for this town -- omit the row. Present
   *  (even with an empty `incidents` array) means the source exists. */
  traffic: { incidents: TrafficIncident[] } | null;
  cityHallFacility: { hours_structured: StoredHours | null; name: string; slug: string } | null;
  /** Item C4 (corrected) -- only needed to resolve an event's venue line via
   *  ground-truth facility alias matching, same reasoning as StoryCard.astro's
   *  own facilities prop. */
  facilities?: Facility[];
  /** The week's events, one entry per real event (lib/event-entries.ts; pages/today.astro), in order of their first unfinished time.
   *  The browser buckets each by that time (data-occ). */
  candidates: EventEntry[];
  /** Ticketmaster shows in the town (gb only, at most 3; lib/today-shows.ts). Bucketed in the browser like the candidates. */
  tmShows?: TodayShow[];
  /** gb: the built one-line forecast (lib/weather-format.ts forecastLine); the browser replaces it with /api/weather's when that answers. */
  forecastText?: string;
  /** The dedicated /today/ page wants its own <h1>+chrome around this
   *  block; the homepage mount wants a plain heading, no page-level
   *  semantics duplicated inside a component that isn't the page itself. */
  headingLevel?: 'h1' | 'h2';
  /** Sitewide title/H1/lede handoff: the dedicated /today/ page's own H1
   *  text comes from resolvePageMeta('today', ...) ("What's Happening in
   *  {Town} Today"), NOT this component's default -- the homepage's h2
   *  mount keeps the original "Today in {cityName}" wording, since that's
   *  a section label inside a bigger page, not the page's own H1 subject
   *  to the handoff's rules. Optional, defaults to the pre-existing text
   *  so the homepage mount (which never passes this) is unaffected. */
  headingText?: string;
  /** /today/ of a town with SiteConfig.todayPage (lib/today-page.ts): the build instant. Today's and tonight's events are then written into
   *  the HTML (the browser re-sorts them from a fresh clock as before) and there is no "Turn on JavaScript" line. */
  serverNow?: Date;
  /** The town's date, shown under the heading ("Thursday, November 12"). */
  dateLine?: { iso: string; label: string };
  /** Candidates in another town (lib/events-town-view.ts nearby): each bucket's own Nearby block, never featured (owner 2026-11-26 (10)). */
  nearby?: Set<EventEntry>;
}

const {
  cityName, timezone, asOf, temperature, activeAlerts, closureStatus, traffic,
  cityHallFacility, facilities = [], candidates, tmShows = [], forecastText, headingLevel = 'h2', headingText, serverNow, dateLine,
  nearby = new Set<EventEntry>(),
} = Astro.props;

// Server-written buckets (serverNow): the same split the browser makes (lib/today-buckets.ts), from the build instant.
const BUCKET_LIMIT = 5;
const inBucket = (start: string | null | undefined, end: string | null | undefined, which: 'today' | 'tonight') =>
  !!serverNow && !!start && bucketOf({ start, end: end ?? null }, serverNow, timezone) === which;
const serverBucket = (which: 'today' | 'tonight') => ({
  items: candidates.filter((e) => { const o = serverNow ? liveOccurrence(e.occ, serverNow, timezone) : null; return !!o && inBucket(o.start, o.end, which); }),
  shows: tmShows.filter((s) => inBucket(s.start, s.end, which)),
});
const serverToday = serverBucket('today');
const serverTonight = serverBucket('tonight');

const Heading = headingLevel;
const resolvedHeadingText = headingText ?? `Today in ${cityName}`;

// Time-independent: mirrors computeOpenStatus's own no-hours-data rule,
// just without calling it, since whether hours_structured exists doesn't
// depend on now at all -- only the actual open/closed text does, computed
// client-side below.
const cityHallKnown = cityHallFacility?.hours_structured != null;

const asOfLabel = siteConfig.country === 'gb'
  ? formatClockCompact(asOf, timezone)
  : asOf.toLocaleTimeString('en-US', {
    hour: 'numeric', minute: '2-digit', hour12: true, timeZone: timezone,
  });

const CLOSURE_LABEL: Record<ClosureWatchStatus['state'], string> = {
  confirmed: 'Schools closed',
  watch: 'Watch — no closure announced yet',
  clear: 'Schools open, no closures reported',
};

type AlertItem = Pick<Story, 'slug' | 'title' | 'ends_at' | 'generated_by'>;

// Designsystem Fas 1 (owner 2026-11-20): every event is one EventRow (time, title, place) under its bucket's DayGroup; the bucket says the
// day, so a row never does. A row carries its town day (data-day / data-day-label) for the "Coming up" list, which spans several days.
const rowEnv = rowEnvFor({ timezone, cityName, country: siteConfig.country }, asOf);
const facts = makeRowFacts({ cityName, facilities, areas: areasFor(siteConfig.townId) });
// An entry's row is placed by its first unfinished time; several times that day read "3 PM & 7 PM", a series adds its dates ("Nov 20–21").
const rowNow = serverNow ?? asOf;
const rowOf = (e: EventEntry): EventRowData => {
  const row = rowFromFeedItem(e.item, rowEnv, facts);
  const o = liveOccurrence(e.occ, rowNow, timezone) ?? e.occ[e.occ.length - 1];
  const day = dayKey(o.start, timezone);
  const sameDay = e.occ.filter((x) => dayKey(x.start, timezone) === day);
  const series = seriesLabel(entryDays(e, timezone), siteConfig.country === 'gb');
  return {
    ...row, start: o.start, end: o.end ?? null,
    time: sameDay.length > 1 ? joinTimes(sameDay.map((x) => eventClock(x.start, timezone, x.end, rowEnv.allDayLabel, rowEnv.lowerClock))) : (o.start === row.start ? row.time : eventClock(o.start, timezone, o.end, rowEnv.allDayLabel, rowEnv.lowerClock)),
    extra: series ? [series, ...row.extra] : row.extra,
  };
};
const occAttr = (e: EventEntry) => (e.occ.length > 1 ? JSON.stringify(e.occ) : undefined);
// The day block (design lift rollout b, owner 2026-11-26 (10)): each bucket opens with its digest, then the town's featured event, its rows,
// and its Nearby block (lib/today-buckets.ts planBucket, the same plan in the browser). A row's data-* carry what the plan reads.
const topPatterns = (siteConfig.topEvents?.patterns ?? []).map((p) => p.toLowerCase());
const keyOf = new Map(candidates.map((e, i) => [e, String(i)]));
const nearbyCity = (e: EventEntry): string | null => (e.item.sourceKind === 'ticketmaster' ? cleanCity(e.item.ticketmasterEvent.venueCity) : ownVenueCity(e.item, facilities));
const meta = (e: EventEntry, row: EventRowData) => {
  const near = nearby.has(e);
  const rank = near || !row.href || isRecurring(row) ? null
    : topPatterns.some((p) => row.title.toLowerCase().includes(p)) ? 0 : isRun(row) ? 2 : 1;
  return { near, rank, city: near ? nearbyCity(e) : null, ticket: e.item.sourceKind === 'ticketmaster' };
};
const planAttrs = (e: EventEntry, row: EventRowData) => {
  const m = meta(e, row);
  return {
    'data-key': keyOf.get(e), 'data-rank': m.rank === null ? '' : String(m.rank), 'data-cat': row.category ?? '',
    'data-free': row.extra.some((x) => /^free\b/i.test(x)) ? '1' : undefined,
    ...(m.near ? { 'data-nearby': m.city ?? '', 'data-ticket': m.ticket ? '1' : '' } : {}),
  };
};
const rowFor = (e: EventEntry): EventRowData => {
  const row = rowOf(e);
  if (!nearby.has(e)) return row;
  // Inside the Nearby block the place says the town once ("Farm House Collective · Riverside", owner 2026-11-26 (10)).
  const city = nearbyCity(e);
  const place = row.place.map(withoutNearbyWord).filter(Boolean);
  return { ...row, place: city && !place.includes(city) ? [...place, city] : place };
};
const planRow = (e: EventEntry): BucketRow & { e: EventEntry; row: EventRowData } => {
  const row = rowFor(e);
  const m = meta(e, row);
  return { e, row, nearby: m.near ? { city: m.city, ticket: m.ticket } : null, rank: m.rank, category: row.category, free: row.extra.some((x) => /^free\b/i.test(x)) };
};
const showRows = tmShows.map((s) => rowFromTodayShow(s, cityName));
const showCategory = mixedCategories([...candidates.map(rowOf), ...showRows]);
const dayAttrs = (start: string | null) => (start ? { 'data-day': dayKey(start, timezone), 'data-day-label': dayLabel(start, timezone, asOf, rowEnv.country) } : {});
// The bucket labels are one level under the block's heading; the row titles one under them.
const groupLevel = headingLevel === 'h1' ? 2 : 3;
const rowLevel = headingLevel === 'h1' ? 3 : 4;

// A town with Met Office warnings always has a Right now line (filled in the browser from /api/weather-warnings).
const metWarningsLine = siteConfig.hasMetOfficeWarnings === true;

// Owner 2026-11-07: no empty messages. A quiet alert / closure / incident state renders nothing (the old consolidated "No weather alerts
// or traffic incidents" line is gone), and "Right now" is drawn only when something in it has content.
const trafficHasIncidents = !!traffic && traffic.incidents.length > 0;
const rightNowHasContent = activeAlerts.length > 0 || metWarningsLine || (closureStatus !== null && closureStatus.state !== 'clear')
  || cityHallKnown || temperature !== null || trafficHasIncidents;

const closureState = closureStatus?.state;
const showClosureLine = closureState !== undefined && closureState !== 'clear';
const activeClosureLabel = showClosureLine && closureState ? CLOSURE_LABEL[closureState] : null;
const activeClosureClass = showClosureLine && closureState ? `today-block__closure--${closureState}` : null;
// ---- Notes on the template below (moved here 2026-11-25: a JS comment inside an Astro template can drop all CSS from a
// build; scripts/verify_astro_template_comments.mjs). Each note names the markup it is about.
// [at: <li id="today-cityhall" class="today-block__cityhall" hidden>]
//   Hidden until the script below fills in a live status from a
// [at: <li id="today-cityhall" class="today-block__cityhall" hidden>]
//   fresh now -- see this component's own module comment.
// [at: <noscript>]
//   The noscript row is the only thing a non-JS visitor sees here:
// [at: <noscript>]
//   no badge, just a link to where the real hours live.
// [at: {[{ id: 'today-now', label: 'Today', more: 'today', b: serverToday }, { id: 'today-tonight]
//   Tonight / Tomorrow are decided in the BROWSER (script at the bottom), from
//         data-start/data-end instants and the town's timezone -- the page can be
//         hours old, and an event that has already ended must never sit under
//         Tonight. The <template> holds every candidate event for the build day
//         and the two days after it; nothing is visible until the script runs. A
//         bucket with no events stays hidden (no empty heading); when both are
//         empty one quiet line links to What's On instead.
// [at: const row = rowOf(item);]
//   ISO instants (row.start/end), not the driver's Date: Astro prints a Date in the build machine's own zone.
// [at: <script type="application/json" id="today-cityhall-data" is:inline set:html={JSON.stringif]
//   Open/Closed badge client-side move (2026-10-15) -- see this
// [at: <script type="application/json" id="today-cityhall-data" is:inline set:html={JSON.stringif]
//   component's own module comment. Only the decision data is baked in
// [at: <script type="application/json" id="today-cityhall-data" is:inline set:html={JSON.stringif]
//   at build time; what time it is right now is read in the browser.
// [at: <script>]
//   Module script (not is:inline) -- Astro/Vite bundles this for the
//       browser, same pattern as components/ShareButton.astro's own inline
//       client script, reusing the exact same, already-tested
//       computeOpenStatus() the server used to call. Deliberately NOT wrapped in
//       {cityHallKnown && ...}: a conditionally rendered <script> made Astro drop
//       the OTHER (Tonight/Tomorrow) script from pages where it did not render
//       (Broomfield /today/ shipped without it, 2026-10-21). The script already
//       does nothing when the city-hall elements are absent.
// [at: <script>]
//   "Right now" is only honest while the data is fresh: the page is built at asOf, so after an hour the label says "As of <time>" instead
//       (owner 2026-10-23). The check runs in the browser against its own clock, and again every minute.
// [at: <script>]
//   Met Office warnings (Glasgow): the "Right now" line is filled from /api/weather-warnings, never a static "No weather alerts".
---

<section class="today-block" aria-label={`Today in ${cityName}`}>
  <Heading class="today-block__heading">
    {resolvedHeadingText} <span class="today-block__asof">Updated {asOfLabel}</span>
  </Heading>
  {dateLine && <p class="today-block__date"><time datetime={dateLine.iso}>{dateLine.label}</time></p>}

  {forecastText !== undefined && <p class="today-block__forecast" data-weather-today hidden={!forecastText}>{forecastText}</p>}

  {rightNowHasContent && (
    <div class="today-block__right-now">
      <p class="today-block__section-label" data-right-now-label data-asof={asOf.toISOString()}>Right now</p>

      <ul class="today-block__list">
        {metWarningsLine && <li id="today-met-line" data-met-line hidden></li>}

        {activeAlerts.length > 0 && activeAlerts.map((alert: AlertItem) => (
          <li data-ends={alert.ends_at ?? undefined} data-alert-slug={alert.slug}>
            <a href={ownPageHref(alert) ?? '/weather/'}>{alert.title}</a>
            {alert.ends_at && <span class="today-block__until"> · {formatAlertUntil(new Date(alert.ends_at), timezone, siteConfig.country)}</span>}
          </li>
        ))}

        {activeClosureLabel && (
          <li class:list={[activeClosureClass]}>{activeClosureLabel}</li>
        )}

        {cityHallKnown && cityHallFacility && (
          <li id="today-cityhall" class="today-block__cityhall" hidden>
            <span data-open-status-text></span>
          </li>
        )}
      </ul>
      {cityHallKnown && cityHallFacility && (
        <noscript>
          <p class="today-block__cityhall">
            <a href={`/facilities/${cityHallFacility.slug}/`}>City Hall hours</a>
          </p>
        </noscript>
      )}

      {temperature !== null && (
        <HeatAdvisoryWidget tempF={temperature} activeAlertTitles={activeAlerts.map((a: AlertItem) => a.title)} />
      )}

      {traffic && trafficHasIncidents && (
        <TrafficWidget incidents={traffic.incidents} limit={3} />
      )}
    </div>
  )}

  {[{ id: 'today-now', label: 'Today', more: 'today', b: serverToday }, { id: 'today-tonight', label: 'Tonight', more: 'tonight', b: serverTonight }].map(({ id, label, more, b }) => {
    const plan = planBucket(b.items.map(planRow), BUCKET_LIMIT);
    const li = (r: { e: EventEntry; row: EventRowData }, feature = false) => (
      <li {...dayAttrs(r.row.start)} data-start={r.row.start ?? undefined} data-end={r.row.end ?? undefined} data-occ={occAttr(r.e)}>
        {feature ? <EventFeature row={r.row} showCategory={showCategory} level={rowLevel} /> : <EventRow row={r.row} showCategory={showCategory} level={rowLevel} />}
      </li>
    );
    return (
      <DayGroup id={id} label={label} level={groupLevel} hidden={b.items.length === 0} digest={plan.digest || undefined}>
        {plan.featured && li(plan.featured, true)}
        {plan.shown.map((r) => li(r))}
        <Fragment slot="after">
          {plan.more > 0 && <p class="day-group__more">+{plan.more} more {more}</p>}
          {plan.near.shown.length > 0 && (
            <div class="nearby-block" data-nearby-block>
              <p class="nearby-block__h">{plan.near.heading}</p>
              <ul class="day-group__rows">{plan.near.shown.map((r) => li(r))}</ul>
              {plan.near.moreOwn.length > 0 && <p class="day-group__more">+{plan.near.moreOwn.length} more nearby</p>}
              {plan.near.moreTickets > 0 && siteConfig.hasWhatsOn && <p class="nearby-block__more"><a href="/whats-on/">More nearby shows →</a></p>}
            </div>
          )}
        </Fragment>
      </DayGroup>
    );
  })}

  <DayGroup id="today-tomorrow" label="Tomorrow" level={groupLevel} hidden />
  <DayGroup id="today-later" label="Coming up" level={groupLevel} hidden />
  {!serverNow && <noscript>
    <p class="today-block__quiet">Turn on JavaScript to see today's and tomorrow's events, or <a href="/events/">browse all events</a>.</p>
  </noscript>}
  <template id="today-event-items" data-tz={timezone} data-whats-on={siteConfig.hasWhatsOn ? '/whats-on/' : undefined}>
    {candidates.map((item) => {
      const row = rowFor(item);
      return (
        <li {...dayAttrs(row.start)} data-start={row.start ?? undefined} data-end={row.end ?? undefined} data-occ={occAttr(item)} {...planAttrs(item, row)}>
          <EventRow row={row} showCategory={showCategory} level={rowLevel} />
        </li>
      );
    })}
    {tmShows.map((s, i) => (
      <li {...dayAttrs(s.start)} data-start={s.start} data-end={s.end}><EventRow row={showRows[i]} showCategory={showCategory} level={rowLevel} /></li>
    ))}
  </template>
  <template id="today-event-features">
    {candidates.filter((item) => meta(item, rowFor(item)).rank !== null).map((item) => {
      const row = rowFor(item);
      return (
        <li {...dayAttrs(row.start)} data-start={row.start ?? undefined} data-end={row.end ?? undefined} data-occ={occAttr(item)} {...planAttrs(item, row)}>
          <EventFeature row={row} showCategory={showCategory} level={rowLevel} />
        </li>
      );
    })}
  </template>
  {cityHallKnown && cityHallFacility && (
    <script type="application/json" id="today-cityhall-data" is:inline set:html={JSON.stringify({
      hours: cityHallFacility.hours_structured, timezone, gb: siteConfig.country === 'gb',
    })} />
  )}
</section>
<script>
  import { fillTodayBuckets } from '../lib/today-buckets';
  fillTodayBuckets(document);
</script>
<script>
    import { computeOpenStatus } from '../lib/facility-hours';
    import type { StoredHours } from '../lib/hours-spec';

    const dataEl = document.getElementById('today-cityhall-data');
    const row = document.getElementById('today-cityhall');
    const text = row?.querySelector<HTMLElement>('[data-open-status-text]');
    if (dataEl && row && text) {
      const payload = JSON.parse(dataEl.textContent || '{}') as { hours: StoredHours | null; timezone: string; gb?: boolean };
      const status = computeOpenStatus(payload.hours, new Date(), payload.timezone, !!payload.gb);
      if (status.known) {
        row.hidden = false;
        row.classList.toggle('today-block__cityhall--open', status.isOpen);
        text.textContent = status.isOpen
          ? `City Hall open — closes ${status.closesAt}`
          : `City Hall closed — opens ${status.opensAt} ${status.opensLabel}`;
      }
    }
</script>
<script>
  const rn = document.querySelector<HTMLElement>('[data-right-now-label]');
  if (rn && rn.dataset.asof) {
    const asOf = Date.parse(rn.dataset.asof);
    const sync = () => {
      const stale = Date.now() - asOf > 3_600_000;
      rn.textContent = stale ? 'Latest check' : 'Right now'; // the one timestamp on the page is the heading's "Updated ..."
    };
    sync();
    setInterval(sync, 60_000);
  }
</script>
<script>
  import { fetchWarnings } from '../lib/met-warnings-client';
  import { isInForce, sortWarnings, formatValidity, warningName } from '../lib/met-warnings';

  const line = document.querySelector<HTMLElement>('[data-met-line]');
  if (line) {
    const paint = async () => {
      const got = await fetchWarnings();
      if (got === null) return; // API unreachable: say nothing rather than claim there are no warnings
      const live = sortWarnings(got.filter((w) => isInForce(w, new Date())));
      line.replaceChildren();
      if (live.length === 0) {
        line.hidden = true; // no warnings: nothing is drawn (no "No weather warnings" message)
        return;
      } else {
        line.className = 'today-block__met';
        for (const w of live) {
          const item = document.createElement('span');
          item.className = `today-block__met-item today-block__met-item--${w.level}`;
          item.append(`${warningName(w)} · ${formatValidity(w.validFrom, w.validTo, 'Europe/London').replace(/^Valid /, '')} · `);
          const a = document.createElement('a');
          a.href = '/weather/#weather-warnings';
          a.textContent = 'Details';
          item.appendChild(a);
          line.appendChild(item);
        }
      }
      line.hidden = false;
    };
    paint();
    setInterval(paint, 60_000);
  }
</script>

